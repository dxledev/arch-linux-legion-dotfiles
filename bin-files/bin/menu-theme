#!/usr/bin/env bash
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/themes"
THEME_DIR_RESOLVED="$(/usr/bin/readlink -f "$THEME_DIR" 2>/dev/null || /usr/bin/printf '%s' "$THEME_DIR")"
MENU_ID="menu-theme-alt"
PID_FILE="/tmp/menu-rofi.pid"
ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/theme.rasi"
ICON_CACHE_DIR="${MENU_THEME_ALT_ICON_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/menu-theme-alt/icons}"
ICON_BASE_SIZE="${MENU_THEME_ALT_ICON_SIZE:-38}"
ICON_CACHE_VERSION="${MENU_THEME_ALT_ICON_CACHE_VERSION:-wheel-v14}"
SEARCH_ICON="󰏘"

ROFI_BIN="$(command -v rofi || true)"
MAGICK_BIN="$(command -v magick || true)"
MKDIR_BIN="$(command -v mkdir || true)"
NOTIFY_SEND_BIN="/home/dxle/bin/notify-send"

notify_error() {
    local message="$1"

    if [[ -x "$NOTIFY_SEND_BIN" ]]; then
        "$NOTIFY_SEND_BIN" -t 4000 "Theme" "$message"
    fi
}

require_command() {
    local command_path="$1"
    local command_name="$2"

    if [[ -z "$command_path" ]]; then
        notify_error "$command_name is not installed."
        exit 1
    fi
}

format_theme_display() {
    local theme_name="${1//-/ }"
    local display_name=""
    local word

    theme_name="${theme_name//_/ }"

    if [[ "$1" == "rose-pine" ]]; then
        printf 'Rosé Pine\n'
        return
    fi

    for word in $theme_name; do
        display_name+="${word^} "
    done

    printf '%s\n' "${display_name% }"
}

escape_rofi_string() {
    /usr/bin/printf '%s\n' "$1" | /usr/bin/sed \
        -e 's/\\/\\\\/g' \
        -e 's/"/\\"/g'
}

validate_icon_base_size() {
    if [[ ! "$ICON_BASE_SIZE" =~ ^[1-9][0-9]*$ ]]; then
        notify_error "MENU_THEME_ALT_ICON_SIZE must be a positive integer."
        exit 1
    fi
}

current_rofi_font_family() {
    local line
    local font_value=""

    if [[ -f "$ROFI_THEME" ]]; then
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*font:[[:space:]]*\"(.+)[[:space:]]+[0-9][0-9.]*\"\;[[:space:]]*$ ]]; then
                font_value="${BASH_REMATCH[1]}"
                break
            fi
        done <"$ROFI_THEME"
    fi

    if [[ -n "$font_value" ]]; then
        printf '%s\n' "$font_value"
        return
    fi

    printf 'CaskaydiaMono Nerd Font\n'
}

current_rofi_font_size() {
    local line
    local font_size=""

    if [[ -f "$ROFI_THEME" ]]; then
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*font:[[:space:]]*\".+[[:space:]]+([0-9][0-9.]*)\"\;[[:space:]]*$ ]]; then
                font_size="${BASH_REMATCH[1]}"
                break
            fi
        done <"$ROFI_THEME"
    fi

    if [[ "$font_size" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$font_size"
        return
    fi

    printf '16\n'
}

element_font_size() {
    local font_size="$1"
    local smaller_size=$((font_size - 1))

    ((smaller_size < 1)) && smaller_size=1
    printf '%s\n' "$smaller_size"
}

kitty_color_candidates() {
    local kitty_conf="$1"

    [[ -r "$kitty_conf" ]] || return 0

    /usr/bin/awk '
        $1 == "background" || $1 == "foreground" || $1 ~ /^color([0-9]|1[0-5])$/ {
            if ($2 ~ /^#[0-9A-Fa-f]{6}$/) {
                print 1, tolower($2)
            }
        }
    ' "$kitty_conf"
}

theme_variable_color_candidates() {
    local theme_path="$1"

    [[ -d "$theme_path" ]] || return 0

    /usr/bin/find -L "$theme_path" -type f \
        ! -path "*/wallpapers/*" \
        ! -iname "*.png" \
        ! -iname "*.jpg" \
        ! -iname "*.jpeg" \
        ! -iname "*.webp" \
        ! -iname "*.gif" \
        ! -iname "*.svg" \
        -print0 |
        /usr/bin/xargs -0 -r /usr/bin/awk '
            function normalize_hex(color) {
                color = tolower(color)
                if (color !~ /^#/) {
                    color = "#" color
                }

                return substr(color, 1, 7)
            }

            function print_weighted_colors(line, weight,    match_text) {
                while (match(line, /#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?/)) {
                    print weight, normalize_hex(substr(line, RSTART, RLENGTH))
                    line = substr(line, RSTART + RLENGTH)
                }

                while (match(line, /(^|[^#[:alnum:]])[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?([^[:alnum:]]|$)/)) {
                    match_text = substr(line, RSTART, RLENGTH)
                    if (match(match_text, /[0-9A-Fa-f]{6}/)) {
                        print weight, normalize_hex(substr(match_text, RSTART, RLENGTH))
                    }
                    line = substr(line, RSTART + RLENGTH)
                }
            }

            tolower($0) ~ /(^|[-_$[:space:]])(color[-_])?primary([-_]color)?([[:space:]]|:|=|$)/ {
                print_weighted_colors($0, 10)
                next
            }

            tolower($0) ~ /(^|[-_$[:space:]])(color[-_])?accent([-_]color)?([[:space:]]|:|=|$)/ {
                print_weighted_colors($0, 9)
                next
            }

            tolower($0) ~ /(^|[-_$[:space:]])(color[-_])?secondary([-_]color)?([[:space:]]|:|=|$)/ {
                print_weighted_colors($0, 8)
            }
        '
}

select_primary_colors() {
    local max_colors="$1"

    /usr/bin/awk -v max_colors="$max_colors" '
        function hex_digit(value) {
            return index("0123456789abcdef", value) - 1
        }

        function channel(value) {
            return hex_digit(substr(value, 1, 1)) * 16 + hex_digit(substr(value, 2, 1))
        }

        function max3(a, b, c) {
            max = a
            if (b > max) max = b
            if (c > max) max = c
            return max
        }

        function min3(a, b, c) {
            min = a
            if (b < min) min = b
            if (c < min) min = c
            return min
        }

        function abs(value) {
            return value < 0 ? -value : value
        }

        function analyze_color(color) {
            value = substr(color, 2)
            r = channel(substr(value, 1, 2)) / 255
            g = channel(substr(value, 3, 2)) / 255
            b = channel(substr(value, 5, 2)) / 255
            max = max3(r, g, b)
            min = min3(r, g, b)
            chroma = max - min
            lightness = (max + min) / 2

            if (chroma == 0) {
                hue = 361 + lightness
            } else if (max == r) {
                hue = 60 * (((g - b) / chroma) % 6)
            } else if (max == g) {
                hue = 60 * (((b - r) / chroma) + 2)
            } else {
                hue = 60 * (((r - g) / chroma) + 4)
            }

            if (hue < 0) hue += 360
        }

        function color_distance(a, b,    av, bv, ar, ag, ab, br, bg, bb, dr, dg, db) {
            av = substr(a, 2)
            bv = substr(b, 2)
            ar = channel(substr(av, 1, 2)) / 255
            ag = channel(substr(av, 3, 2)) / 255
            ab = channel(substr(av, 5, 2)) / 255
            br = channel(substr(bv, 1, 2)) / 255
            bg = channel(substr(bv, 3, 2)) / 255
            bb = channel(substr(bv, 5, 2)) / 255
            dr = ar - br
            dg = ag - bg
            db = ab - bb
            return sqrt((dr * dr) + (dg * dg) + (db * db))
        }

        {
            color = tolower($2)
            if (color ~ /^#[0-9a-f]{6}$/) {
                score[color] += $1
            }
        }

        END {
            for (color in score) {
                analyze_color(color)

                if (lightness < 0.08 || lightness > 0.94) {
                    color_weight = 0.28
                } else if (chroma < 0.06) {
                    color_weight = 0.48
                } else {
                    color_weight = 0.85 + chroma
                }

                adjusted_score = score[color] * color_weight * (1 - (abs(lightness - 0.52) * 0.35))
                printf "%012.3f %s\n", adjusted_score, color
            }
        }
    ' | /usr/bin/sort -nr -k1,1 | /usr/bin/awk -v max_colors="$max_colors" '
        {
            count++
            color[count] = $2
        }

        function color_channel(value) {
            return index("0123456789abcdef", value) - 1
        }

        function channel(value) {
            return color_channel(substr(value, 1, 1)) * 16 + color_channel(substr(value, 2, 1))
        }

        function color_distance(a, b,    av, bv, ar, ag, ab, br, bg, bb, dr, dg, db) {
            av = substr(a, 2)
            bv = substr(b, 2)
            ar = channel(substr(av, 1, 2)) / 255
            ag = channel(substr(av, 3, 2)) / 255
            ab = channel(substr(av, 5, 2)) / 255
            br = channel(substr(bv, 1, 2)) / 255
            bg = channel(substr(bv, 3, 2)) / 255
            bb = channel(substr(bv, 5, 2)) / 255
            dr = ar - br
            dg = ag - bg
            db = ab - bb
            return sqrt((dr * dr) + (dg * dg) + (db * db))
        }

        function far_enough(candidate, threshold,    row) {
            for (row = 1; row <= total; row++) {
                if (color_distance(candidate, output[row]) < threshold) {
                    return 0
                }
            }

            return 1
        }

        function select_color(row, threshold) {
            if (total >= max_colors || selected[color[row]] || !far_enough(color[row], threshold)) {
                return
            }

            selected[color[row]] = 1
            output[++total] = color[row]
        }

        END {
            for (row = 1; row <= count && total < max_colors; row++) {
                select_color(row, 0.24)
            }

            for (row = 1; row <= count && total < max_colors; row++) {
                select_color(row, 0.14)
            }

            for (row = 1; row <= count && total < max_colors; row++) {
                select_color(row, 0)
            }

            for (row = 1; row <= total; row++) {
                print output[row]
            }
        }
    '
}

select_prevalent_colors() {
    local max_colors="$1"

    /usr/bin/awk -v max_colors="$max_colors" '
        {
            color = tolower($2)
            if (color ~ /^#[0-9a-f]{6}$/) {
                score[color] += $1
            }
        }

        END {
            for (color in score) {
                printf "%012.3f %s\n", score[color], color
            }
        }
    ' | /usr/bin/sort -nr -k1,1 | /usr/bin/awk -v max_colors="$max_colors" '
        !seen[$2]++ && count < max_colors {
            print $2
            count++
        }
    '
}

derive_palette_colors() {
    /usr/bin/awk '
        function hex_digit(value) {
            return index("0123456789abcdef", value) - 1
        }

        function hex_pair(value) {
            value = int(value + 0.5)
            if (value < 0) value = 0
            if (value > 255) value = 255
            return substr(hex_chars, int(value / 16) + 1, 1) substr(hex_chars, (value % 16) + 1, 1)
        }

        function channel(value) {
            return hex_digit(substr(value, 1, 1)) * 16 + hex_digit(substr(value, 2, 1))
        }

        function shade(color,    value, r, g, b, lightness, target, ratio) {
            value = substr(color, 2)
            r = channel(substr(value, 1, 2))
            g = channel(substr(value, 3, 2))
            b = channel(substr(value, 5, 2))
            lightness = (r + g + b) / 765
            target = lightness < 0.45 ? 255 : 0
            ratio = 0.22

            return "#" hex_pair(r + ((target - r) * ratio)) hex_pair(g + ((target - g) * ratio)) hex_pair(b + ((target - b) * ratio))
        }

        BEGIN {
            hex_chars = "0123456789abcdef"
        }

        /^#[0-9a-f]{6}$/ && !seen[$0]++ {
            print $0
            derived = shade($0)
            if (!seen[derived]++) {
                print derived
            }
        }
    '
}

algorithm_palette() {
    /usr/bin/awk -v max_colors="$1" '
        BEGIN {
            fallback_count = split("#d72638 #f46036 #ffba08 #2e933c", fallback_colors, " ")
        }

        {
            if (!seen[$0]++) {
                colors[++count] = $0
            }
        }

        END {
            for (row = 1; row <= count && row <= max_colors; row++) {
                print colors[row]
            }

            for (row = 1; row <= fallback_count && count < max_colors; row++) {
                if (!seen[fallback_colors[row]]++) {
                    print fallback_colors[row]
                    count++
                }
            }
        }
    '
}

theme_palette() {
    local theme_path="$1"
    local kitty_conf="$theme_path/kitty.conf"

    {
        theme_variable_color_candidates "$theme_path" | select_prevalent_colors 2 | derive_palette_colors
        kitty_color_candidates "$kitty_conf" | select_primary_colors 4
    } | algorithm_palette 4
}

cached_palette_icon_path() {
    local theme="$1"
    local safe_theme="${theme//[^[:alnum:]._-]/_}"

    printf '%s/%s-%s-%s.png\n' "$ICON_CACHE_DIR" "$ICON_CACHE_VERSION" "$ICON_BASE_SIZE" "$safe_theme"
}

write_palette_svg() {
    /usr/bin/awk -v size="$ICON_BASE_SIZE" '
        BEGIN {
            pi = atan2(0, -1)
            radius = (size / 2) - 1
            wedge_radius = radius + 1.5
            center = size / 2
            print "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" size "\" height=\"" size "\" viewBox=\"0 0 " size " " size "\">"
            printf "<defs><clipPath id=\"wheel\"><circle cx=\"%.3f\" cy=\"%.3f\" r=\"%.3f\"/></clipPath></defs>\n", center, center, radius
            print "<g clip-path=\"url(#wheel)\">"
        }

        {
            colors[NR] = $0
        }

        END {
            count = NR
            if (count < 1) {
                print "</svg>"
                exit
            }

            if (count == 1) {
                printf "<circle cx=\"%.3f\" cy=\"%.3f\" r=\"%.3f\" fill=\"%s\"/>\n", center, center, wedge_radius, colors[1]
                print "</g>"
                print "</svg>"
                exit
            }

            for (i = 1; i <= count; i++) {
                start = (((i - 1) * 360 / count) - 90) * pi / 180
                finish = ((i * 360 / count) - 90) * pi / 180
                x1 = center + wedge_radius * cos(start)
                y1 = center + wedge_radius * sin(start)
                x2 = center + wedge_radius * cos(finish)
                y2 = center + wedge_radius * sin(finish)
                large_arc = (360 / count > 180) ? 1 : 0

                printf "<path d=\"M %.3f %.3f L %.3f %.3f A %.3f %.3f 0 %d 1 %.3f %.3f Z\" fill=\"%s\"/>\n", center, center, x1, y1, wedge_radius, wedge_radius, large_arc, x2, y2, colors[i]
            }

            print "</g>"
            print "</svg>"
        }
    '
}

write_icon_file() {
    local icon_path="$1"
    shift

    /usr/bin/printf '%s\n' "$@" |
        write_palette_svg |
        "$MAGICK_BIN" -background none svg:- \
            "PNG32:$icon_path"
}

palette_icon() {
    local theme="$1"
    local theme_path="$2"
    local kitty_conf="$theme_path/kitty.conf"
    local cache_icon
    local colors=()

    cache_icon="$(cached_palette_icon_path "$theme")"
    if [[ -r "$cache_icon" ]]; then
        printf '%s\n' "$cache_icon"
        return
    fi

    "$MKDIR_BIN" -p "$ICON_CACHE_DIR"

    mapfile -t colors < <(theme_palette "$theme_path")
    write_icon_file "$cache_icon" "${colors[@]}"

    printf '%s\n' "$cache_icon"
}

print_menu_rows() {
    local theme
    local pretty
    local icon

    for theme in "${THEMES[@]}"; do
        pretty="$(format_theme_display "$theme")"

        if [[ "$theme" == "$CURRENT_THEME" ]]; then
            pretty="<i>$pretty</i>"
        fi

        icon="$(palette_icon "$theme" "$THEME_DIR_RESOLVED/$theme")"
        printf "%s\0icon\x1f%s\n" "$pretty" "$icon"
    done
}

require_command "$ROFI_BIN" "rofi"
require_command "$MAGICK_BIN" "ImageMagick"
require_command "$MKDIR_BIN" "mkdir"
validate_icon_base_size

if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
    exit 0
fi

trap '"$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"' EXIT

if [[ ! -d "$THEME_DIR_RESOLVED" ]]; then
    notify_error "Themes directory not found: $THEME_DIR"
    exit 1
fi

CURRENT_THEME_PATH="$(/usr/bin/readlink -f "$THEME_DIR_RESOLVED/current")"
CURRENT_THEME="${CURRENT_THEME_PATH##*/}"

THEMES=()
for theme_path in "$THEME_DIR_RESOLVED"/*; do
    [[ -d "$theme_path" ]] || continue
    theme="${theme_path##*/}"
    [[ "$theme" != "current" && "$theme" != .* ]] || continue
    THEMES+=("$theme")
done

[[ ${#THEMES[@]} -gt 0 ]] || exit 0

MENU_FONT_FAMILY="$(escape_rofi_string "$(current_rofi_font_family)")"
ELEMENT_FONT_SIZE="$(element_font_size "$(current_rofi_font_size)")"

CHOSEN_INDEX="$(
    print_menu_rows |
        "$ROFI_BIN" -dmenu -i -show-icons -markup-rows \
            -pid "$PID_FILE" \
            -p "$SEARCH_ICON" \
            -format i \
            -no-custom \
            -theme-str "
                window {
                    width: 755px;
                    border-radius: 0px;
                    padding: 12px;
                }
                mainbox {
                    spacing: 7px;
                }
                inputbar {
                    children: [ prompt, entry ];
                    spacing: 10px;
                    padding: 10px 16px;
                }
                prompt {
                    width: 28px;
                    horizontal-align: 0.5;
                    vertical-align: 0.5;
                    margin: -4px 0px 4px 0px;
                    padding: 0px 4px;
                }
                entry {
                    placeholder: \"Theme…\";
                }
                listview {
                    columns: 4;
                    lines: 4;
                    spacing: 2px;
                    cycle: false;
                    dynamic: false;
                    fixed-columns: true;
                    scrollbar: false;
                    flow: horizontal;
                    layout: vertical;
                }
                element {
                    orientation: vertical;
                    children: [ element-icon, element-text ];
                    spacing: 2px;
                    padding: 14px 4px;
                    border-radius: 0px;
                }
                element-icon {
                    size: ${ICON_BASE_SIZE}px;
                    horizontal-align: 0.5;
                }
                element-text {
                    width: 160px;
                    horizontal-align: 0.5;
                    padding: 4px 2px;
                    font: \"${MENU_FONT_FAMILY} ${ELEMENT_FONT_SIZE}\";
                }
            "
)"

[[ -n "$CHOSEN_INDEX" ]] || exit 0

SELECTED="${THEMES[CHOSEN_INDEX]:-}"

[[ -n "$SELECTED" ]] || exit 0
[[ "$SELECTED" != "$CURRENT_THEME" ]] || exit 0

"$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"
trap - EXIT

if [[ -x /usr/bin/setsid ]]; then
    THEME_SUPPRESS_NOTIFY="${THEME_SUPPRESS_NOTIFY:-0}" /usr/bin/setsid -f "$SCRIPT_DIR/theme" "$SELECTED" >/dev/null 2>&1 || true
else
    THEME_SUPPRESS_NOTIFY="${THEME_SUPPRESS_NOTIFY:-0}" /usr/bin/nohup "$SCRIPT_DIR/theme" "$SELECTED" >/dev/null 2>&1 &
fi
