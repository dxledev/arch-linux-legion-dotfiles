#!/usr/bin/env bash
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/themes"
THEME_DIR_RESOLVED="$(/usr/bin/readlink -f "$THEME_DIR" 2>/dev/null || /usr/bin/printf '%s' "$THEME_DIR")"
MENU_ID="menu-theme-alt"
PID_FILE="/tmp/menu-rofi.pid"
ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/theme.rasi"
ICON_CACHE_DIR="${MENU_THEME_ALT_ICON_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/menu-theme-alt/icons}"
ICON_BASE_SIZE="${MENU_THEME_ALT_ICON_SIZE:-38}"
SEARCH_ICON="󰏘"

ROFI_BIN="$(command -v rofi || true)"
MAGICK_BIN="$(command -v magick || true)"
SHA256SUM_BIN="$(command -v sha256sum || true)"
STAT_BIN="$(command -v stat || true)"
MKDIR_BIN="$(command -v mkdir || true)"
NOTIFY_SEND_BIN="/home/dxle/bin/notify-send"

notify_error() {
    local message="$1"

    if [[ -x "$NOTIFY_SEND_BIN" ]]; then
        "$NOTIFY_SEND_BIN" -t 4000 "Theme" "$message"
    fi
}

require_command() {
    local command_path="$1"
    local command_name="$2"

    if [[ -z "$command_path" ]]; then
        notify_error "$command_name is not installed."
        exit 1
    fi
}

format_theme_display() {
    /usr/bin/printf '%s\n' "$1" | /usr/bin/sed -E '
        s/rose-pine/Rosé Pine/;
        s/[-_]/ /g;
        s/\b(.)/\U\1/g
    '
}

escape_rofi_string() {
    /usr/bin/printf '%s\n' "$1" | /usr/bin/sed \
        -e 's/\\/\\\\/g' \
        -e 's/"/\\"/g'
}

validate_icon_base_size() {
    if [[ ! "$ICON_BASE_SIZE" =~ ^[1-9][0-9]*$ ]]; then
        notify_error "MENU_THEME_ALT_ICON_SIZE must be a positive integer."
        exit 1
    fi
}

current_rofi_font_family() {
    local font_value=""

    if [[ -f "$ROFI_THEME" ]]; then
        font_value="$(
            /usr/bin/sed -nE 's/^[[:space:]]*font:[[:space:]]*"(.+) [0-9][0-9.]*";[[:space:]]*$/\1/p' "$ROFI_THEME" |
                /usr/bin/head -n 1
        )"
    fi

    if [[ -n "$font_value" ]]; then
        /usr/bin/printf '%s\n' "$font_value"
        return
    fi

    /usr/bin/printf 'CaskaydiaMono Nerd Font\n'
}

current_rofi_font_size() {
    local font_size=""

    if [[ -f "$ROFI_THEME" ]]; then
        font_size="$(
            /usr/bin/sed -nE 's/^[[:space:]]*font:[[:space:]]*".+ ([0-9][0-9.]*)";[[:space:]]*$/\1/p' "$ROFI_THEME" |
                /usr/bin/head -n 1
        )"
    fi

    if [[ "$font_size" =~ ^[0-9]+$ ]]; then
        /usr/bin/printf '%s\n' "$font_size"
        return
    fi

    /usr/bin/printf '16\n'
}

element_font_size() {
    local font_size="$1"
    local smaller_size=$((font_size - 1))

    ((smaller_size < 1)) && smaller_size=1
    /usr/bin/printf '%s\n' "$smaller_size"
}

theme_palette() {
    local kitty_conf="$1"
    local waybar_css="$2"
    local kitty_color_count=0

    if [[ -r "$kitty_conf" ]]; then
        kitty_color_count="$(
            /usr/bin/awk '
                $1 == "background" || $1 == "foreground" || $1 ~ /^color([0-9]|1[0-5])$/ {
                    if ($2 ~ /^#[0-9A-Fa-f]{6}$/) {
                        print tolower($2)
                    }
                }
            ' "$kitty_conf" | /usr/bin/sort -u | /usr/bin/wc -l
        )"
    fi

    {
        if [[ -r "$kitty_conf" ]]; then
            /usr/bin/awk '
                $1 == "background" || $1 == "foreground" || $1 ~ /^color([0-9]|1[0-5])$/ {
                    if ($2 ~ /^#[0-9A-Fa-f]{6}$/) {
                        print $2
                    }
                }
            ' "$kitty_conf"
        fi

        if [[ -r "$waybar_css" && "$kitty_color_count" -lt 8 ]]; then
            /usr/bin/grep -Eio '#[0-9a-f]{6}' "$waybar_css" || true
        fi
    } | /usr/bin/awk '
        function hex_digit(value) {
            return index("0123456789abcdef", value) - 1
        }

        function channel(value) {
            return hex_digit(substr(value, 1, 1)) * 16 + hex_digit(substr(value, 2, 1))
        }

        function max3(a, b, c) {
            max = a
            if (b > max) max = b
            if (c > max) max = c
            return max
        }

        function min3(a, b, c) {
            min = a
            if (b < min) min = b
            if (c < min) min = c
            return min
        }

        function abs(value) {
            return value < 0 ? -value : value
        }

        function analyze_color(color) {
            value = substr(color, 2)
            r = channel(substr(value, 1, 2)) / 255
            g = channel(substr(value, 3, 2)) / 255
            b = channel(substr(value, 5, 2)) / 255
            max = max3(r, g, b)
            min = min3(r, g, b)
            chroma = max - min
            lightness = (max + min) / 2

            if (chroma == 0) {
                hue = 361 + lightness
            } else if (max == r) {
                hue = 60 * (((g - b) / chroma) % 6)
            } else if (max == g) {
                hue = 60 * (((b - r) / chroma) + 2)
            } else {
                hue = 60 * (((r - g) / chroma) + 4)
            }

            if (hue < 0) hue += 360
        }

        {
            color = tolower($0)
            if (!seen[color]++) {
                analyze_color(color)

                if (chroma >= 0.18 && lightness >= 0.16 && lightness <= 0.88) {
                    group = 0
                } else if (chroma >= 0.12 && lightness >= 0.12 && lightness <= 0.92) {
                    group = 1
                } else {
                    group = 2
                }

                sector = int((hue + 22.5) / 45) % 8
                score = (chroma * 2) - abs(lightness - 0.55)
                print group, sector, score, color
            }
        }
    ' | /usr/bin/sort -n -k1,1 -k3,3r | /usr/bin/awk '
        {
            count++
            group[count] = $1
            color_sector[count] = $2
            color[count] = $4

            if ($1 < 2 && !(color_sector[count] in best_color)) {
                best_index[color_sector[count]] = count
                best_color[color_sector[count]] = color[count]
            }
        }

        function select_color(row) {
            if (total >= 8 || selected[color[row]]) {
                return
            }

            selected[color[row]] = 1
            output[++total] = color[row]
        }

        END {
            for (sector = 0; sector < 8; sector++) {
                if (sector in best_color) {
                    select_color(best_index[sector])
                }
            }

            for (row = 1; row <= count && total < 8; row++) {
                if (group[row] < 2) {
                    select_color(row)
                }
            }

            for (row = 1; row <= count && total < 8; row++) {
                select_color(row)
            }

            for (row = 1; row <= total; row++) {
                print output[row]
            }
        }
    '
}

fill_palette() {
    /usr/bin/awk '
        BEGIN {
            fallback_count = split("#d72638 #f46036 #ffba08 #2e933c #1b998b #2e86ab #5f4bb6 #db2b8f", fallback_colors, " ")
        }

        {
            if (!seen[$0]++) {
                colors[++count] = $0
            }
        }

        END {
            for (row = 1; row <= count && row <= 8; row++) {
                print colors[row]
            }

            for (row = 1; row <= fallback_count && count < 8; row++) {
                if (!seen[fallback_colors[row]]++) {
                    print fallback_colors[row]
                    count++
                }
            }
        }
    '
}

cached_palette_icon_path() {
    local theme="$1"
    local kitty_conf="$2"
    local waybar_css="$3"
    local source_mtime="missing"
    local waybar_mtime="missing"
    local cache_key

    if [[ -r "$kitty_conf" ]]; then
        source_mtime="$("$STAT_BIN" -c '%Y' "$kitty_conf")"
    fi

    if [[ -r "$waybar_css" ]]; then
        waybar_mtime="$("$STAT_BIN" -c '%Y' "$waybar_css")"
    fi

    cache_key="$(
        {
            /usr/bin/printf '%s|%s|%s|%s|wheel-v8\n' "$theme" "$source_mtime" "$waybar_mtime" "$ICON_BASE_SIZE"
            theme_palette "$kitty_conf" "$waybar_css" | fill_palette
        } |
            "$SHA256SUM_BIN" |
            /usr/bin/awk '{ print $1 }'
    )"

    /usr/bin/printf '%s/%s.png\n' "$ICON_CACHE_DIR" "$cache_key"
}

write_palette_svg() {
    /usr/bin/awk -v size="$ICON_BASE_SIZE" '
        BEGIN {
            pi = atan2(0, -1)
            radius = (size / 2) - 1
            wedge_radius = radius + 1.5
            center = size / 2
            print "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" size "\" height=\"" size "\" viewBox=\"0 0 " size " " size "\">"
            printf "<defs><clipPath id=\"wheel\"><circle cx=\"%.3f\" cy=\"%.3f\" r=\"%.3f\"/></clipPath></defs>\n", center, center, radius
            print "<g clip-path=\"url(#wheel)\">"
        }

        {
            colors[NR] = $0
        }

        END {
            count = NR
            if (count < 1) {
                print "</svg>"
                exit
            }

            if (count == 1) {
                printf "<circle cx=\"%.3f\" cy=\"%.3f\" r=\"%.3f\" fill=\"%s\"/>\n", center, center, wedge_radius, colors[1]
                print "</g>"
                print "</svg>"
                exit
            }

            for (i = 1; i <= count; i++) {
                start = (((i - 1) * 360 / count) - 90) * pi / 180
                finish = ((i * 360 / count) - 90) * pi / 180
                x1 = center + wedge_radius * cos(start)
                y1 = center + wedge_radius * sin(start)
                x2 = center + wedge_radius * cos(finish)
                y2 = center + wedge_radius * sin(finish)
                large_arc = (360 / count > 180) ? 1 : 0

                printf "<path d=\"M %.3f %.3f L %.3f %.3f A %.3f %.3f 0 %d 1 %.3f %.3f Z\" fill=\"%s\"/>\n", center, center, x1, y1, wedge_radius, wedge_radius, large_arc, x2, y2, colors[i]
            }

            print "</g>"
            print "</svg>"
        }
    '
}

palette_icon() {
    local theme="$1"
    local theme_path="$2"
    local kitty_conf="$theme_path/kitty.conf"
    local waybar_css="$theme_path/waybar.css"
    local cache_icon
    local colors=()

    cache_icon="$(cached_palette_icon_path "$theme" "$kitty_conf" "$waybar_css")"
    if [[ -r "$cache_icon" ]]; then
        /usr/bin/printf '%s\n' "$cache_icon"
        return
    fi

    "$MKDIR_BIN" -p "$ICON_CACHE_DIR"

    mapfile -t colors < <(theme_palette "$kitty_conf" "$waybar_css" | fill_palette)

    /usr/bin/printf '%s\n' "${colors[@]}" |
        write_palette_svg |
        "$MAGICK_BIN" -background none svg:- \
            "PNG32:$cache_icon"

    /usr/bin/printf '%s\n' "$cache_icon"
}

print_menu_rows() {
    local theme
    local pretty
    local icon

    for theme in "${THEMES[@]}"; do
        pretty="$(format_theme_display "$theme")"

        if [[ "$theme" == "$CURRENT_THEME" ]]; then
            pretty="<i>$pretty</i>"
        fi

        icon="$(palette_icon "$theme" "$THEME_DIR_RESOLVED/$theme")"
        /usr/bin/printf "%s\0icon\x1f%s\n" "$pretty" "$icon"
    done
}

require_command "$ROFI_BIN" "rofi"
require_command "$MAGICK_BIN" "ImageMagick"
require_command "$SHA256SUM_BIN" "sha256sum"
require_command "$STAT_BIN" "stat"
require_command "$MKDIR_BIN" "mkdir"
validate_icon_base_size

if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
    exit 0
fi

trap '"$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"' EXIT

if [[ ! -d "$THEME_DIR_RESOLVED" ]]; then
    notify_error "Themes directory not found: $THEME_DIR"
    exit 1
fi

CURRENT_THEME="$(/usr/bin/basename "$(/usr/bin/readlink -f "$THEME_DIR_RESOLVED/current")")"

mapfile -t THEMES < <(
    /usr/bin/find "$THEME_DIR_RESOLVED" -mindepth 1 -maxdepth 1 -type d \
        ! -name "current" \
        ! -name ".*" \
        -printf "%f\n" | /usr/bin/sort
)

[[ ${#THEMES[@]} -gt 0 ]] || exit 0

MENU_FONT_FAMILY="$(escape_rofi_string "$(current_rofi_font_family)")"
ELEMENT_FONT_SIZE="$(element_font_size "$(current_rofi_font_size)")"

CHOSEN_INDEX="$(
    print_menu_rows |
        "$ROFI_BIN" -dmenu -i -show-icons -markup-rows \
            -pid "$PID_FILE" \
            -p "$SEARCH_ICON" \
            -format i \
            -no-custom \
            -theme-str "
                window {
                    width: 755px;
                    border-radius: 0px;
                    padding: 12px;
                }
                mainbox {
                    spacing: 7px;
                }
                inputbar {
                    children: [ prompt, entry ];
                    spacing: 10px;
                    padding: 10px 16px;
                }
                prompt {
                    width: 28px;
                    horizontal-align: 0.5;
                    vertical-align: 0.5;
                    margin: -4px 0px 4px 0px;
                    padding: 0px 4px;
                }
                entry {
                    placeholder: \"Theme…\";
                }
                listview {
                    columns: 4;
                    lines: 4;
                    spacing: 2px;
                    cycle: false;
                    dynamic: false;
                    fixed-columns: true;
                    scrollbar: false;
                    flow: horizontal;
                    layout: vertical;
                }
                element {
                    orientation: vertical;
                    children: [ element-icon, element-text ];
                    spacing: 2px;
                    padding: 14px 4px;
                    border-radius: 0px;
                }
                element-icon {
                    size: ${ICON_BASE_SIZE}px;
                    horizontal-align: 0.5;
                }
                element-text {
                    width: 160px;
                    horizontal-align: 0.5;
                    padding: 4px 2px;
                    font: \"${MENU_FONT_FAMILY} ${ELEMENT_FONT_SIZE}\";
                }
            "
)"

[[ -n "$CHOSEN_INDEX" ]] || exit 0

SELECTED="${THEMES[CHOSEN_INDEX]:-}"

[[ -n "$SELECTED" ]] || exit 0
[[ "$SELECTED" != "$CURRENT_THEME" ]] || exit 0

"$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"
trap - EXIT

if [[ -x /usr/bin/setsid ]]; then
    THEME_SUPPRESS_NOTIFY="${THEME_SUPPRESS_NOTIFY:-0}" /usr/bin/setsid -f "$SCRIPT_DIR/theme" "$SELECTED" >/dev/null 2>&1 || true
else
    THEME_SUPPRESS_NOTIFY="${THEME_SUPPRESS_NOTIFY:-0}" /usr/bin/nohup "$SCRIPT_DIR/theme" "$SELECTED" >/dev/null 2>&1 &
fi
