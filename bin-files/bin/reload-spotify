#!/usr/bin/env bash

set -euo pipefail

APP_CLASS=spotify
HYPRCTL_BIN=/usr/bin/hyprctl
JQ_BIN=/usr/bin/jq

find_spotify_address() {
    "$HYPRCTL_BIN" clients -j | "$JQ_BIN" -r '
        map(select((.class | ascii_downcase) == "'"$APP_CLASS"'"))[0].address // empty
    '
}

spotify_address="$(find_spotify_address)"

if [ -z "$spotify_address" ]; then
    exit 0
fi

"$HYPRCTL_BIN" dispatch "hl.dsp.send_shortcut({ mods = \"CTRL SHIFT\", key = \"R\", window = \"address:$spotify_address\" })" >/dev/null
