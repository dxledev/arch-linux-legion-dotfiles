#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib-hypr-lua"

HYPR_CONF="$(hypr_config_path "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/decorations.conf")"
HYPRCTL_BIN="${HYPRCTL_BIN:-/usr/bin/hyprctl}"
MENU_ID="menu-border-radius"
PID_FILE="/tmp/menu-rofi.pid"
RELOAD_HYPRLAND="${MENU_BORDER_RADIUS_RELOAD_HYPRLAND:-0}"
HYPR_AUTORELOAD_SUSPENDED=0
BORDER_RADIUS_MIN=0
BORDER_RADIUS_MAX=25

if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
    exit 0
fi

trap 'cleanup' EXIT

get_current_value() {
    hypr_get_config_value "$HYPR_CONF" "decoration" "rounding"
}

normalize_value() {
    local input="$1"

    awk -v value="$input" -v min_value="$BORDER_RADIUS_MIN" -v max_value="$BORDER_RADIUS_MAX" '
        BEGIN {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

            if (value !~ /^[+-]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))$/) {
                exit 1
            }

            number = value + 0
            floored = (number >= 0 || number == int(number)) ? int(number) : int(number) - 1

            if (floored < min_value) {
                floored = min_value
            } else if (floored > max_value) {
                floored = max_value
            }

            print floored
        }
    '
}

update_value() {
    local new_value="$1"

    hypr_set_config_value "$HYPR_CONF" "decoration" "rounding" "$new_value"
}

should_reload_hyprland() {
    hypr_is_enabled_value "$RELOAD_HYPRLAND"
}

suspend_hyprland_autoreload() {
    hypr_suspend_autoreload "$HYPRCTL_BIN" || return 0
    HYPR_AUTORELOAD_SUSPENDED=1
}

restore_hyprland_autoreload() {
    [[ "$HYPR_AUTORELOAD_SUSPENDED" -eq 1 ]] || return 0

    HYPR_AUTORELOAD_SUSPENDED=0
    hypr_restore_autoreload "$HYPRCTL_BIN"
}

apply_runtime_value() {
    local new_value="$1"

    hypr_apply_keyword "$HYPRCTL_BIN" "decoration:rounding" "$new_value"
}

cleanup() {
    restore_hyprland_autoreload
    "$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID" || true
}

[[ -f "$HYPR_CONF" ]] || {
    notify-send -t 4000 "Border" "Config not found: $HYPR_CONF"
    exit 1
}

while true; do
    current_value="$(get_current_value)"
    current_value="${current_value:-0}"

    selected="$(
        printf '' | rofi -dmenu -i \
            -pid "$PID_FILE" \
            -p "" \
            -mesg "Current Roundness = $current_value" \
            -theme-str '
                window { width: 380px; }
                mainbox { children: [ inputbar, message, listview ]; }
                inputbar { children: [ entry ]; }
                entry { placeholder: "Enter Border Roundness…"; }
                message {
                    padding: 0px 8px 8px 8px;
                }
                textbox {
                    horizontal-align: 0.0;
                }
                listview {
                    lines: 0;
                    spacing: 0px;
                    padding: 0px;
                }
                element {
                    orientation: horizontal;
                    children: [ element-text ];
                    spacing: 0px;
                    padding: 8px 8px;
                }
                element-text {
                    horizontal-align: 0.0;
                    padding-left: 0px;
                }
            '
    )"

    [[ -n "$selected" ]] || exit 0

    if ! new_value="$(normalize_value "$selected")"; then
        notify-send -t 4000 "Border" "Enter a valid number."
        continue
    fi

    suspend_hyprland_autoreload

    update_value "$new_value"
    apply_runtime_value "$new_value" || notify-send -t 4000 "Border" "Roundness updated, but runtime apply failed."
    restore_hyprland_autoreload

    if should_reload_hyprland; then
        "$HYPRCTL_BIN" reload >/dev/null 2>&1 || notify-send -t 4000 "Border" "Roundness updated, but Hyprland reload failed."
    fi

    notify-send -t 3000 "Border" "Roundness set to $new_value"
    exit 0
done
