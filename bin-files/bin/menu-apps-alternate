#!/usr/bin/env bash
set -euo pipefail

APP_LIST="${APP_LIST:-$HOME/.config/apps.list}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MENU_ID="menu-apps"
PID_FILE="/tmp/menu-rofi.pid"
GTK4_SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini"
GTK3_SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
ICON_CACHE_DIR="${MENU_APPS_ALTERNATE_ICON_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/menu-apps-alternate/icons}"
ICON_BASE_SIZE="${MENU_APPS_ALTERNATE_ICON_SIZE:-26}"

MAGICK_BIN="$(command -v magick || true)"
SHA256SUM_BIN="$(command -v sha256sum || true)"
STAT_BIN="$(command -v stat || true)"
MKDIR_BIN="$(command -v mkdir || true)"

require_command() {
    local command_path="$1"
    local command_name="$2"

    if [[ -z "$command_path" ]]; then
        notify-send -t 4000 "Apps" "$command_name is not installed."
        exit 1
    fi
}

trim_value() {
    printf '%s\n' "$1" | /usr/bin/sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

validate_icon_base_size() {
    if [[ ! "$ICON_BASE_SIZE" =~ ^[1-9][0-9]*$ ]]; then
        notify-send -t 4000 "Apps" "MENU_APPS_ALTERNATE_ICON_SIZE must be a positive integer."
        exit 1
    fi
}

valid_icon_scale() {
    local icon_scale="$1"

    [[ "$icon_scale" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]] || return 1

    /usr/bin/awk -v scale="$icon_scale" 'BEGIN { exit !(scale > 0) }'
}

scale_is_default() {
    local icon_scale="$1"

    [[ -z "$icon_scale" ]] && return 0
    /usr/bin/awk -v scale="$icon_scale" 'BEGIN { exit !(scale == 1) }'
}

icon_override_enabled() {
    local value=""

    value="$(
        /usr/bin/awk -F'=' '
            /^[[:space:]]*icon-override[[:space:]]*=/ {
                value = $2
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                print tolower(value)
                exit
            }
        ' "$APP_LIST"
    )"

    case "$value" in
        "" | true)
            return 0
            ;;
        false)
            return 1
            ;;
        *)
            exit 1
            ;;
    esac
}

current_gtk_icon_theme() {
    local settings_file
    local icon_theme=""

    for settings_file in "$GTK4_SETTINGS" "$GTK3_SETTINGS"; do
        [[ -r "$settings_file" ]] || continue

        icon_theme="$(
            /usr/bin/awk -F'=' '
                /^[[:space:]]*gtk-icon-theme-name[[:space:]]*=/ {
                    value = $2
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
                    print value
                    exit
                }
            ' "$settings_file"
        )"

        [[ -n "$icon_theme" ]] && break
    done

    printf '%s\n' "$icon_theme"
}

desktop_file_path() {
    local launcher="$1"
    local desktop_file

    for desktop_file in \
        "${XDG_DATA_HOME:-$HOME/.local/share}/applications/$launcher" \
        "/usr/local/share/applications/$launcher" \
        "/usr/share/applications/$launcher"; do
        if [[ -r "$desktop_file" ]]; then
            printf '%s\n' "$desktop_file"
            return 0
        fi
    done

    return 1
}

desktop_icon_name() {
    local launcher="$1"
    local desktop_file

    desktop_file="$(desktop_file_path "$launcher" || true)"
    [[ -n "$desktop_file" ]] || return 1

    /usr/bin/awk -F'=' '
        /^[[:space:]]*Icon[[:space:]]*=/ {
            value = $2
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            print value
            exit
        }
    ' "$desktop_file"
}

theme_directory() {
    local theme="$1"
    local base_dir

    for base_dir in \
        "${XDG_DATA_HOME:-$HOME/.local/share}/icons" \
        "$HOME/.icons" \
        "/usr/local/share/icons" \
        "/usr/share/icons"; do
        if [[ -d "$base_dir/$theme" ]]; then
            printf '%s\n' "$base_dir/$theme"
            return 0
        fi
    done

    return 1
}

theme_inherits() {
    local theme_dir="$1"

    [[ -r "$theme_dir/index.theme" ]] || return 0

    /usr/bin/awk -F'=' '
        /^[[:space:]]*Inherits[[:space:]]*=/ {
            value = $2
            gsub(/[[:space:]]/, "", value)
            gsub(/,/, "\n", value)
            print value
            exit
        }
    ' "$theme_dir/index.theme"
}

icon_exists_in_theme() {
    local icon_name="$1"
    local theme="$2"
    local theme_dir

    theme_dir="$(theme_directory "$theme" || true)"
    [[ -n "$theme_dir" ]] || return 1

    /usr/bin/find "$theme_dir" -type f \( \
        -name "$icon_name.png" -o \
        -name "$icon_name.svg" -o \
        -name "$icon_name.xpm" \
    \) -print -quit | /usr/bin/grep -q .
}

icon_path_in_theme() {
    local icon_name="$1"
    local theme="$2"
    local theme_dir

    theme_dir="$(theme_directory "$theme" || true)"
    [[ -n "$theme_dir" ]] || return 1

    /usr/bin/find "$theme_dir" -type f \( \
        -name "$icon_name.png" -o \
        -name "$icon_name.svg" -o \
        -name "$icon_name.xpm" \
    \) -print -quit
}

gtk_icon_exists() {
    local icon_name="$1"
    local gtk_icon_theme="$2"
    local theme
    local inherited_theme
    local -a checked_themes=()
    local -a pending_themes=()

    [[ -n "$icon_name" && "$icon_name" != /* ]] || return 1
    [[ -n "$gtk_icon_theme" ]] || return 1

    pending_themes=("$gtk_icon_theme" hicolor)

    while ((${#pending_themes[@]} > 0)); do
        theme="${pending_themes[0]}"
        pending_themes=("${pending_themes[@]:1}")

        [[ -n "$theme" ]] || continue
        [[ " ${checked_themes[*]} " == *" $theme "* ]] && continue
        checked_themes+=("$theme")

        if icon_exists_in_theme "$icon_name" "$theme"; then
            return 0
        fi

        while IFS= read -r inherited_theme; do
            [[ -n "$inherited_theme" ]] && pending_themes+=("$inherited_theme")
        done < <(theme_inherits "$(theme_directory "$theme" || true)")
    done

    return 1
}

gtk_icon_file() {
    local icon_name="$1"
    local gtk_icon_theme="$2"
    local theme
    local icon_file
    local inherited_theme
    local -a checked_themes=()
    local -a pending_themes=()

    [[ -n "$icon_name" && "$icon_name" != /* ]] || return 1
    [[ -n "$gtk_icon_theme" ]] || return 1

    pending_themes=("$gtk_icon_theme" hicolor)

    while ((${#pending_themes[@]} > 0)); do
        theme="${pending_themes[0]}"
        pending_themes=("${pending_themes[@]:1}")

        [[ -n "$theme" ]] || continue
        [[ " ${checked_themes[*]} " == *" $theme "* ]] && continue
        checked_themes+=("$theme")

        icon_file="$(icon_path_in_theme "$icon_name" "$theme" || true)"
        if [[ -n "$icon_file" ]]; then
            printf '%s\n' "$icon_file"
            return 0
        fi

        while IFS= read -r inherited_theme; do
            [[ -n "$inherited_theme" ]] && pending_themes+=("$inherited_theme")
        done < <(theme_inherits "$(theme_directory "$theme" || true)")
    done

    return 1
}

row_icon() {
    local launcher="$1"
    local defined_icon="$2"
    local icon_override="$3"
    local gtk_icon_theme="$4"
    local desktop_icon

    if [[ "$icon_override" == "true" ]]; then
        printf '%s\n' "$defined_icon"
        return
    fi

    desktop_icon="$(desktop_icon_name "$launcher" || true)"
    if gtk_icon_exists "$desktop_icon" "$gtk_icon_theme"; then
        printf '%s\n' "$desktop_icon"
        return
    fi

    printf '%s\n' "$defined_icon"
}

icon_source_file() {
    local icon="$1"
    local gtk_icon_theme="$2"
    local icon_file

    if [[ "$icon" == /* && -r "$icon" ]]; then
        printf '%s\n' "$icon"
        return 0
    fi

    icon_file="$(gtk_icon_file "$icon" "$gtk_icon_theme" || true)"
    [[ -n "$icon_file" ]] || return 1

    printf '%s\n' "$icon_file"
}

scaled_icon_dimension() {
    local icon_scale="$1"

    /usr/bin/awk -v size="$ICON_BASE_SIZE" -v scale="$icon_scale" 'BEGIN {
        scaled = int((size * scale) + 0.5)
        if (scaled < 1) {
            scaled = 1
        }
        print scaled
    }'
}

cached_scaled_icon_path() {
    local source_icon="$1"
    local icon_scale="$2"
    local source_mtime
    local cache_key

    source_mtime="$("$STAT_BIN" -c '%Y' "$source_icon")"
    cache_key="$(
        printf '%s|%s|%s|%s\n' "$source_icon" "$source_mtime" "$ICON_BASE_SIZE" "$icon_scale" |
            "$SHA256SUM_BIN" |
            /usr/bin/awk '{ print $1 }'
    )"

    printf '%s/%s.png\n' "$ICON_CACHE_DIR" "$cache_key"
}

scaled_icon() {
    local icon="$1"
    local icon_scale="$2"
    local gtk_icon_theme="$3"
    local source_icon
    local cache_icon
    local scaled_dimension

    icon_scale="$(trim_value "$icon_scale")"
    scale_is_default "$icon_scale" && {
        printf '%s\n' "$icon"
        return
    }

    if ! valid_icon_scale "$icon_scale"; then
        notify-send -t 4000 "Apps" "Invalid icon scale '$icon_scale' in $APP_LIST."
        exit 1
    fi

    require_command "$MAGICK_BIN" "ImageMagick"
    require_command "$SHA256SUM_BIN" "sha256sum"
    require_command "$STAT_BIN" "stat"
    require_command "$MKDIR_BIN" "mkdir"

    source_icon="$(icon_source_file "$icon" "$gtk_icon_theme" || true)"
    if [[ -z "$source_icon" ]]; then
        printf '%s\n' "$icon"
        return
    fi

    "$MKDIR_BIN" -p "$ICON_CACHE_DIR"

    cache_icon="$(cached_scaled_icon_path "$source_icon" "$icon_scale")"
    if [[ -r "$cache_icon" ]]; then
        printf '%s\n' "$cache_icon"
        return
    fi

    scaled_dimension="$(scaled_icon_dimension "$icon_scale")"
    "$MAGICK_BIN" "$source_icon" \
        -resize "${scaled_dimension}x${scaled_dimension}" \
        -background none \
        -gravity center \
        -extent "${ICON_BASE_SIZE}x${ICON_BASE_SIZE}" \
        "$cache_icon"

    printf '%s\n' "$cache_icon"
}

print_menu_rows() {
    local icon_override="$1"
    local gtk_icon_theme="$2"
    local launcher
    local defined_icon
    local app_name
    local icon_scale
    local resolved_icon

    while IFS='|' read -r launcher defined_icon app_name icon_scale _; do
        [[ -n "$launcher" && -n "$defined_icon" && -n "$app_name" ]] || continue

        resolved_icon="$(row_icon "$launcher" "$defined_icon" "$icon_override" "$gtk_icon_theme")"
        resolved_icon="$(scaled_icon "$resolved_icon" "${icon_scale:-}" "$gtk_icon_theme")"
        printf "%s\0icon\x1f%s\n" "$app_name" "$resolved_icon"
    done < <(/usr/bin/awk -F'|' 'NF >= 3 { print }' "$APP_LIST")
}

launch_app() {
    local launcher="$1"

    [[ -n "$launcher" ]] || exit 0

    if [[ "$launcher" == *.desktop ]]; then
        setsid gtk-launch "${launcher%.desktop}" >/dev/null 2>&1 &
    elif [[ -x "$SCRIPT_DIR/$launcher" ]]; then
        setsid "$SCRIPT_DIR/$launcher" >/dev/null 2>&1 &
    elif command -v "$launcher" >/dev/null 2>&1; then
        setsid "$launcher" >/dev/null 2>&1 &
    fi
}

if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
    exit 0
fi

validate_icon_base_size

trap '"$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"' EXIT

mapfile -t launchers < <(/usr/bin/awk -F'|' 'NF >= 3 { print $1 }' "$APP_LIST")

[[ ${#launchers[@]} -gt 0 ]] || exit 0

ICON_OVERRIDE="true"
GTK_ICON_THEME="$(current_gtk_icon_theme)"

if ! icon_override_enabled; then
    ICON_OVERRIDE="false"
fi

chosen_index=$(
print_menu_rows "$ICON_OVERRIDE" "$GTK_ICON_THEME" |
rofi -dmenu -i -show-icons \
    -pid "$PID_FILE" \
    -p "" \
    -format i \
    -no-custom \
    -theme-str '
        window { width: 300px; }
        entry { placeholder: "Launch…"; }
        element {
            orientation: horizontal;
            children: [ element-icon, element-text ];
            spacing: 8px;
            padding: 8px 8px;
        }
        element-icon {
            size: '"${ICON_BASE_SIZE}"'px;
        }
        element-text {
            horizontal-align: 0.0;
            padding: 0px 6px;
        }
    '
)

[[ -n "$chosen_index" ]] || exit 0

launch_app "${launchers[chosen_index]:-}"
