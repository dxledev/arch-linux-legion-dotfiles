#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib-hypr-lua"

ROFI_BIN="/usr/bin/rofi"
NOTIFY_BIN="/home/dxle/bin/notify-send"
AWK_BIN="/usr/bin/awk"
MKDIR_BIN="/usr/bin/mkdir"
MKTEMP_BIN="/usr/bin/mktemp"
MV_BIN="/usr/bin/mv"
RM_BIN="/usr/bin/rm"
HYPRCTL_BIN="${HYPRCTL_BIN:-/usr/bin/hyprctl}"
SLEEP_BIN="${SLEEP_BIN:-/usr/bin/sleep}"
READLINK_BIN="/usr/bin/readlink"
HYPR_CONF="$(hypr_config_path "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/decorations.conf")"
ANIMATIONS_CONF="$(hypr_config_path "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/animations.conf")"
XDG_STATE_HOME_DEFAULT="${HOME}/.local/state"
STATE_DIR="${XDG_STATE_HOME:-$XDG_STATE_HOME_DEFAULT}/menu-layout"
AXIS_STATE_FILE="${STATE_DIR}/workspace-axis.state"
MENU_ID="menu-layouts"
PID_FILE="/tmp/menu-rofi.pid"
NOTIFY_SUCCESS_DELAY="${MENU_LAYOUT_NOTIFY_SUCCESS_DELAY:-0.2}"
DRY_RUN=0
SELECTED_LAYOUT=""
ROFI_MENU_ACTIVE=0
HYPR_AUTORELOAD_SUSPENDED=0
LAYOUTS=("dwindle" "scrolling" "master" "monocle")

usage() {
    printf 'Usage: %s [--layout master|dwindle|scrolling|monocle] [--config PATH] [--animations-config PATH] [--dry-run]\n' "$(basename "$0")"
}

notify() {
    "$NOTIFY_BIN" -t 4000 "Layout" "$1" >/dev/null 2>&1 || true
}

notify_success() {
    (
        "$SLEEP_BIN" "$NOTIFY_SUCCESS_DELAY"
        notify "$1"
    ) >/dev/null 2>&1 &
    disown || true
}

is_valid_layout() {
    local candidate="$1"
    local layout=""

    for layout in "${LAYOUTS[@]}"; do
        [[ "$candidate" == "$layout" ]] && return 0
    done

    return 1
}

format_layout_display() {
    case "$1" in
        master)
            printf 'Master\n'
            ;;
        dwindle)
            printf 'Dwindle\n'
            ;;
        scrolling)
            printf 'Scrolling\n'
            ;;
        monocle)
            printf 'Monocle\n'
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

require_config() {
    [[ -f "$HYPR_CONF" ]] || {
        notify "Config not found: $HYPR_CONF"
        exit 1
    }

    [[ -f "$ANIMATIONS_CONF" ]] || {
        notify "Config not found: $ANIMATIONS_CONF"
        exit 1
    }

}

resolve_config_path() {
    local resolved_path=""

    resolved_path="$("$READLINK_BIN" -f "$HYPR_CONF" 2>/dev/null || true)"
    [[ -n "$resolved_path" ]] && HYPR_CONF="$resolved_path"

    resolved_path="$("$READLINK_BIN" -f "$ANIMATIONS_CONF" 2>/dev/null || true)"
    [[ -n "$resolved_path" ]] && ANIMATIONS_CONF="$resolved_path"

}

get_current_layout() {
    hypr_lua_unquote "$(hypr_get_config_value "$HYPR_CONF" "general" "layout")"
}

normalize_layout() {
    printf '%s\n' "$1"
}

get_applied_layout() {
    local layout="$1"

    printf '%s\n' "$layout"
}

get_current_axis() {
    local style=""

    style="$(hypr_get_animation_style "$ANIMATIONS_CONF")" || return 1
    if [[ "$style" == *slidevert* ]]; then
        printf 'vertical\n'
        return
    fi
    if [[ "$style" == *slide* ]]; then
        printf 'horizontal\n'
    fi
}

axis_to_animation_style() {
    case "$1" in
        horizontal)
            printf 'slide\n'
            ;;
        vertical)
            printf 'slidevert\n'
            ;;
        *)
            return 1
            ;;
    esac
}

is_valid_axis() {
    case "$1" in
        horizontal|vertical)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

read_previous_axis() {
    local previous_axis=""

    [[ -r "$AXIS_STATE_FILE" ]] || return 1

    previous_axis="$("$AWK_BIN" 'NR == 1 { print; exit }' "$AXIS_STATE_FILE")"
    is_valid_axis "$previous_axis" || return 1

    printf '%s\n' "$previous_axis"
}

write_previous_axis() {
    local previous_axis="$1"
    local tmp_file=""

    is_valid_axis "$previous_axis" || return 1

    "$MKDIR_BIN" -p "$STATE_DIR"
    tmp_file="$("$MKTEMP_BIN" "${STATE_DIR}/.workspace-axis.XXXXXX")"
    printf '%s\n' "$previous_axis" > "$tmp_file"
    "$MV_BIN" "$tmp_file" "$AXIS_STATE_FILE"
}

clear_previous_axis() {
    "$RM_BIN" -f "$AXIS_STATE_FILE"
}

choose_layout() {
    local current_layout="$1"
    local display_layouts=()
    local layout=""
    local pretty=""
    local chosen_index=""

    for layout in "${LAYOUTS[@]}"; do
        pretty="$(format_layout_display "$layout")"

        if [[ "$layout" == "$current_layout" ]]; then
            pretty="<i>$pretty</i>"
        fi

        display_layouts+=("$pretty")
    done

    chosen_index="$(
        printf '%s\n' "${display_layouts[@]}" | "$ROFI_BIN" -dmenu -i -markup-rows -format i \
            -pid "$PID_FILE" \
            -p "" \
            -theme-str '
                window { width: 250px; }
                entry { placeholder: "Layout…"; }
                element {
                    orientation: horizontal;
                    children: [ element-text ];
                    spacing: 0px;
                    padding: 8px 8px;
                }
                element-text {
                    horizontal-align: 0.0;
                    padding-left: 0px;
                    margin: 0 2px;
                }
            '
    )" || return 1

    [[ "$chosen_index" =~ ^[0-9]+$ ]] || return 1
    [[ "$chosen_index" -lt "${#LAYOUTS[@]}" ]] || return 1

    printf '%s\n' "${LAYOUTS[chosen_index]}"
}

update_layout() {
    local new_layout="$1"
    local lua_layout=""

    lua_layout="$(hypr_lua_quote "$new_layout")"
    hypr_set_config_value "$HYPR_CONF" "general" "layout" "$lua_layout" "$new_layout"
}

update_workspace_animation() {
    local target_style="$1"
    hypr_set_animation_style "$ANIMATIONS_CONF" "$target_style"
}

reload_hyprland() {
    [[ -x "$HYPRCTL_BIN" ]] || return 0
    "$HYPRCTL_BIN" reload >/dev/null 2>&1
}

suspend_hyprland_autoreload() {
    [[ -x "$HYPRCTL_BIN" ]] || return 0
    "$HYPRCTL_BIN" keyword misc:disable_autoreload true >/dev/null 2>&1 || return 0
    HYPR_AUTORELOAD_SUSPENDED=1
}

restore_hyprland_autoreload() {
    [[ "$HYPR_AUTORELOAD_SUSPENDED" -eq 1 ]] || return 0

    HYPR_AUTORELOAD_SUSPENDED=0
    [[ -x "$HYPRCTL_BIN" ]] || return 0
    "$HYPRCTL_BIN" keyword misc:disable_autoreload false >/dev/null 2>&1 || true
}

apply_runtime_layout() {
    local applied_layout="$1"

    [[ -x "$HYPRCTL_BIN" ]] || return 0
    "$HYPRCTL_BIN" keyword general:layout "$applied_layout" >/dev/null 2>&1
}

get_workspace_animation_rule() {
    local style=""

    style="$(hypr_get_animation_style "$ANIMATIONS_CONF")" || return 1
    printf 'workspaces, 1, 4.9, overshot, %s\n' "$style"
}

apply_runtime_workspace_animation() {
    local animation_rule=""

    [[ -x "$HYPRCTL_BIN" ]] || return 0

    animation_rule="$(get_workspace_animation_rule)"
    [[ -n "$animation_rule" ]] || return 1

    "$HYPRCTL_BIN" keyword animation "$animation_rule" >/dev/null 2>&1
}

apply_runtime_changes() {
    local applied_layout="$1"
    local layout_changed="$2"
    local workspace_animation_changed="$3"

    if [[ "$layout_changed" -eq 1 ]]; then
        apply_runtime_layout "$applied_layout" || return 1
    fi

    if [[ "$workspace_animation_changed" -eq 1 ]]; then
        apply_runtime_workspace_animation || return 1
    fi
}

cleanup() {
    restore_hyprland_autoreload

    if [[ "$ROFI_MENU_ACTIVE" -eq 1 ]]; then
        "$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID" || true
    fi
}

trap cleanup EXIT

while [[ $# -gt 0 ]]; do
    case "$1" in
        --layout)
            [[ $# -ge 2 ]] || {
                usage
                exit 1
            }
            SELECTED_LAYOUT="$2"
            shift 2
            ;;
        --config)
            [[ $# -ge 2 ]] || {
                usage
                exit 1
            }
            HYPR_CONF="$2"
            shift 2
            ;;
        --animations-config)
            [[ $# -ge 2 ]] || {
                usage
                exit 1
            }
            ANIMATIONS_CONF="$2"
            shift 2
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

resolve_config_path
require_config

CURRENT_APPLIED_LAYOUT="$(get_current_layout)"
[[ -n "$CURRENT_APPLIED_LAYOUT" ]] || {
    notify "Failed to detect current layout."
    exit 1
}

CURRENT_LAYOUT="$(normalize_layout "$CURRENT_APPLIED_LAYOUT")"

CURRENT_AXIS="$(get_current_axis)"
[[ -n "$CURRENT_AXIS" ]] || {
    notify "Failed to detect current workspace axis."
    exit 1
}

if [[ -z "$SELECTED_LAYOUT" ]]; then
    if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
        exit 0
    fi

    ROFI_MENU_ACTIVE=1

    SELECTED_LAYOUT="$(choose_layout "$CURRENT_LAYOUT" || true)"
    [[ -n "$SELECTED_LAYOUT" ]] || exit 0
fi

SELECTED_LAYOUT="$(normalize_layout "$SELECTED_LAYOUT")"

is_valid_layout "$SELECTED_LAYOUT" || {
    notify "Invalid layout: $SELECTED_LAYOUT"
    exit 1
}

TARGET_APPLIED_LAYOUT="$(get_applied_layout "$SELECTED_LAYOUT")"

if [[ "$SELECTED_LAYOUT" == "$CURRENT_LAYOUT" && "$TARGET_APPLIED_LAYOUT" == "$CURRENT_APPLIED_LAYOUT" && "$SELECTED_LAYOUT" != "scrolling" ]]; then
    exit 0
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
    printf 'Would set layout to %s in %s\n' "$TARGET_APPLIED_LAYOUT" "$HYPR_CONF"

    if [[ "$CURRENT_LAYOUT" != "scrolling" && "$SELECTED_LAYOUT" == "scrolling" ]]; then
        printf 'Would save previous workspace axis as %s in %s\n' "$CURRENT_AXIS" "$AXIS_STATE_FILE"
        printf 'Would force workspace axis to vertical (slidevert) in %s\n' "$ANIMATIONS_CONF"
    fi

    if [[ "$CURRENT_LAYOUT" == "scrolling" && "$SELECTED_LAYOUT" != "scrolling" ]]; then
        if PREVIOUS_AXIS="$(read_previous_axis)"; then
            printf 'Would restore previous workspace axis to %s in %s\n' "$PREVIOUS_AXIS" "$ANIMATIONS_CONF"
        else
            printf 'No saved previous workspace axis to restore from %s\n' "$AXIS_STATE_FILE"
        fi
    fi

    exit 0
fi

LAYOUT_CHANGED=0
WORKSPACE_ANIMATION_CHANGED=0

suspend_hyprland_autoreload

if [[ "$CURRENT_LAYOUT" != "scrolling" && "$SELECTED_LAYOUT" == "scrolling" ]]; then
    write_previous_axis "$CURRENT_AXIS" || {
        notify "Failed to save previous workspace axis."
        exit 1
    }
fi

if [[ "$TARGET_APPLIED_LAYOUT" != "$CURRENT_APPLIED_LAYOUT" ]]; then
    update_layout "$TARGET_APPLIED_LAYOUT" || {
        notify "Failed to update layout."
        exit 1
    }

    LAYOUT_CHANGED=1
fi

if [[ "$SELECTED_LAYOUT" == "scrolling" ]]; then
    update_workspace_animation "slidevert" || {
        notify "Failed to force vertical workspace axis."
        exit 1
    }

    WORKSPACE_ANIMATION_CHANGED=1
fi

if [[ "$CURRENT_LAYOUT" == "scrolling" && "$SELECTED_LAYOUT" != "scrolling" ]]; then
    if PREVIOUS_AXIS="$(read_previous_axis)"; then
        TARGET_STYLE="$(axis_to_animation_style "$PREVIOUS_AXIS")"

        update_workspace_animation "$TARGET_STYLE" || {
            notify "Failed to restore previous workspace axis."
            exit 1
        }

        WORKSPACE_ANIMATION_CHANGED=1
        clear_previous_axis
    fi
fi

apply_runtime_changes "$TARGET_APPLIED_LAYOUT" "$LAYOUT_CHANGED" "$WORKSPACE_ANIMATION_CHANGED" || true
restore_hyprland_autoreload

if ! reload_hyprland; then
    notify "Set to <b><span foreground=\"var(--border-color)\">$(format_layout_display "$SELECTED_LAYOUT")</span></b>, but Hyprland reload failed."
    exit 1
fi

notify_success "Set to <b><span foreground=\"var(--secondary-color)\">$(format_layout_display "$SELECTED_LAYOUT")</span></b>."
