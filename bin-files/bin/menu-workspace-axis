#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib-hypr-lua"

ROFI_BIN="/usr/bin/rofi"
NOTIFY_BIN="/home/dxle/bin/notify-send"
AWK_BIN="/usr/bin/awk"
MKTEMP_BIN="/usr/bin/mktemp"
MV_BIN="/usr/bin/mv"
HYPRCTL_BIN="/usr/bin/hyprctl"
HYPR_CONF="$(hypr_config_path "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/animations.conf")"
LAYOUT_CONF="$(hypr_config_path "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/decorations.conf")"
MENU_ID="menu-workspace-axis"
PID_FILE="/tmp/menu-rofi.pid"
RELOAD_HYPRLAND="${MENU_WORKSPACE_AXIS_RELOAD_HYPRLAND:-0}"
DRY_RUN=0
SELECTED_AXIS=""
HYPR_AUTORELOAD_SUSPENDED=0
AXES=("horizontal" "vertical")

usage() {
    printf 'Usage: %s [--axis horizontal|vertical] [--config PATH] [--layout-config PATH] [--reload] [--dry-run]\n' "$(basename "$0")"
}

notify() {
    "$NOTIFY_BIN" -t 4000 "Workspace Axis" "$1" >/dev/null 2>&1 || true
}

format_axis_display() {
    case "$1" in
        horizontal)
            printf 'Horizontal\n'
            ;;
        vertical)
            printf 'Vertical\n'
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

is_valid_axis() {
    local candidate="$1"
    local axis=""

    for axis in "${AXES[@]}"; do
        [[ "$candidate" == "$axis" ]] && return 0
    done

    return 1
}

axis_to_animation_style() {
    case "$1" in
        horizontal)
            printf 'slide\n'
            ;;
        vertical)
            printf 'slidevert\n'
            ;;
        *)
            return 1
            ;;
    esac
}

get_current_axis() {
    local style=""

    style="$(hypr_get_animation_style "$HYPR_CONF")" || return 1
    if [[ "$style" == *slidevert* ]]; then
        printf 'vertical\n'
        return
    fi
    if [[ "$style" == *slide* ]]; then
        printf 'horizontal\n'
    fi
}

get_current_layout() {
    hypr_lua_unquote "$(hypr_get_config_value "$LAYOUT_CONF" "general" "layout")"
}

normalize_layout() {
    case "$1" in
        scrollingfix)
            printf 'scrolling\n'
            ;;
        *)
            printf '%s\n' "$1"
            ;;
    esac
}

choose_axis() {
    local current_axis="$1"
    local display_axes=()
    local axis=""
    local pretty=""
    local chosen_index=""

    for axis in "${AXES[@]}"; do
        pretty="$(format_axis_display "$axis")"

        if [[ "$axis" == "$current_axis" ]]; then
            pretty="<i>$pretty</i>"
        fi

        display_axes+=("$pretty")
    done

    chosen_index="$(
        printf '%s\n' "${display_axes[@]}" | "$ROFI_BIN" -dmenu -i -markup-rows -format i \
            -pid "$PID_FILE" \
            -p "" \
            -theme-str '
                window { width: 260px; }
                entry { placeholder: "WS Axis…"; }
                element {
                    orientation: horizontal;
                    children: [ element-text ];
                    spacing: 0px;
                    padding: 8px 8px;
                }
                element-text {
                    horizontal-align: 0.0;
                    padding-left: 0px;
                    margin: 0 2px;
                }
            '
    )" || return 1

    [[ "$chosen_index" =~ ^[0-9]+$ ]] || return 1
    [[ "$chosen_index" -lt "${#AXES[@]}" ]] || return 1

    printf '%s\n' "${AXES[chosen_index]}"
}

update_workspace_animation() {
    local target_style="$1"
    hypr_set_animation_style "$HYPR_CONF" "$target_style"
}

reload_hyprland() {
    [[ -x "$HYPRCTL_BIN" ]] || return 0
    "$HYPRCTL_BIN" reload >/dev/null 2>&1
}

should_reload_hyprland() {
    hypr_is_enabled_value "$RELOAD_HYPRLAND"
}

suspend_hyprland_autoreload() {
    hypr_suspend_autoreload "$HYPRCTL_BIN" || return 0
    HYPR_AUTORELOAD_SUSPENDED=1
}

restore_hyprland_autoreload() {
    [[ "$HYPR_AUTORELOAD_SUSPENDED" -eq 1 ]] || return 0

    HYPR_AUTORELOAD_SUSPENDED=0
    hypr_restore_autoreload "$HYPRCTL_BIN"
}

apply_runtime_workspace_animation() {
    local target_style="$1"

    hypr_apply_animation_rule "$HYPRCTL_BIN" "workspaces, 1, 4.9, overshot, ${target_style} 100%"
}

cleanup() {
    restore_hyprland_autoreload
}

trap cleanup EXIT

while [[ $# -gt 0 ]]; do
    case "$1" in
        --axis)
            [[ $# -ge 2 ]] || {
                usage
                exit 1
            }
            SELECTED_AXIS="$2"
            shift 2
            ;;
        --config)
            [[ $# -ge 2 ]] || {
                usage
                exit 1
            }
            HYPR_CONF="$2"
            shift 2
            ;;
        --layout-config)
            [[ $# -ge 2 ]] || {
                usage
                exit 1
            }
            LAYOUT_CONF="$2"
            shift 2
            ;;
        --reload)
            RELOAD_HYPRLAND=1
            shift
            ;;
        --dry-run)
            DRY_RUN=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 1
            ;;
    esac
done

[[ -f "$HYPR_CONF" ]] || {
    notify "Config not found: $HYPR_CONF"
    exit 1
}

[[ -f "$LAYOUT_CONF" ]] || {
    notify "Config not found: $LAYOUT_CONF"
    exit 1
}

CURRENT_AXIS="$(get_current_axis)"
[[ -n "$CURRENT_AXIS" ]] || {
    notify "Could not detect current workspace axis."
    exit 1
}

CURRENT_LAYOUT="$(get_current_layout)"
[[ -n "$CURRENT_LAYOUT" ]] || {
    notify "Could not detect current layout."
    exit 1
}
CURRENT_LAYOUT="$(normalize_layout "$CURRENT_LAYOUT")"

if [[ "$CURRENT_LAYOUT" == "scrolling" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf 'Scrolling layout is active; would force workspace axis to vertical (slidevert) in %s\n' "$HYPR_CONF"
        if should_reload_hyprland; then
            printf 'Would reload Hyprland after applying runtime changes\n'
        fi
        exit 0
    fi

    if [[ "$CURRENT_AXIS" != "vertical" ]]; then
        suspend_hyprland_autoreload

        update_workspace_animation "slidevert" || {
            notify "Failed to force vertical workspace axis."
            exit 1
        }

        apply_runtime_workspace_animation "slidevert" || {
            notify "Saved vertical axis, but failed to apply runtime changes."
            exit 1
        }

        restore_hyprland_autoreload

        if should_reload_hyprland; then
            reload_hyprland || {
                notify "Forced vertical axis for scrolling, but reload failed."
                exit 1
            }
        fi
    fi

    notify "Workspace axis locked to Vertical while layout is Scrolling."
    exit 0
fi

if [[ -z "$SELECTED_AXIS" ]]; then
    if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
        exit 0
    fi

    trap 'cleanup; "$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"' EXIT

    SELECTED_AXIS="$(choose_axis "$CURRENT_AXIS" || true)"
    [[ -n "$SELECTED_AXIS" ]] || exit 0
fi

is_valid_axis "$SELECTED_AXIS" || {
    notify "Invalid axis: $SELECTED_AXIS"
    exit 1
}

[[ "$SELECTED_AXIS" != "$CURRENT_AXIS" ]] || exit 0

TARGET_STYLE="$(axis_to_animation_style "$SELECTED_AXIS")"

if [[ "$DRY_RUN" -eq 1 ]]; then
    printf 'Would set workspace axis to %s (%s) in %s\n' "$SELECTED_AXIS" "$TARGET_STYLE" "$HYPR_CONF"
    if should_reload_hyprland; then
        printf 'Would reload Hyprland after applying runtime changes\n'
    fi
    exit 0
fi

suspend_hyprland_autoreload

update_workspace_animation "$TARGET_STYLE" || {
    notify "Failed to update workspace animation."
    exit 1
}

apply_runtime_workspace_animation "$TARGET_STYLE" || {
    notify "Saved $(format_axis_display "$SELECTED_AXIS"), but failed to apply runtime changes."
    exit 1
}

restore_hyprland_autoreload

if should_reload_hyprland; then
    if ! reload_hyprland; then
        notify "Set to $(format_axis_display "$SELECTED_AXIS"), but reload failed."
        exit 1
    fi
fi

notify "Set to $(format_axis_display "$SELECTED_AXIS")."
