#!/usr/bin/env bash
set -euo pipefail

: "${TERMINAL:=ghostty}"

HYPRCTL_BIN="${HYPRCTL_BIN:-/usr/bin/hyprctl}"
JQ_BIN="${JQ_BIN:-/usr/bin/jq}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

term_bin="${TERMINAL%% *}"

WIDTH="${1:-1200}"
HEIGHT="${2:-800}"

if [[ "${1:-}" =~ ^[0-9]+$ && "${2:-}" =~ ^[0-9]+$ ]]; then
    shift 2
fi

if ! command -v "$term_bin" >/dev/null 2>&1; then
    term_bin=ghostty
fi

lua_string() {
    local value="$1"

    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"

    printf '"%s"' "$value"
}

find_window_address_by_marker() {
    local class_marker="$1"
    local title_marker="$2"

    "$HYPRCTL_BIN" clients -j | "$JQ_BIN" -r \
        --arg class_marker "$class_marker" \
        --arg title_marker "$title_marker" '
        map(
            select(
                (.class // "") == $class_marker
                or (.initialClass // "") == $class_marker
                or (.title // "") == $title_marker
                or (.initialTitle // "") == $title_marker
            )
        )[0].address // empty
    '
}

apply_floating_layout() {
    local window_address="$1"

    "$SCRIPT_DIR/hypr-dispatch" focuswindow "address:$window_address"
    "$SCRIPT_DIR/hypr-dispatch" setfloating
    "$SCRIPT_DIR/hypr-dispatch" resizeactive exact "$WIDTH" "$HEIGHT"
    "$SCRIPT_DIR/hypr-dispatch" centerwindow
    "$SCRIPT_DIR/hypr-dispatch" movetoworkspacesilent special:floating
}

launch_terminal() {
    local class_marker="$1"
    local title_marker="$2"
    local command=""
    shift 2

    printf -v command "%q " "$@"
    command="${command% }"

    "$HYPRCTL_BIN" dispatch "hl.dsp.exec_cmd($(lua_string "$command"), {
        float = true,
        size = { ${WIDTH}, ${HEIGHT} },
        center = true,
        workspace = \"special:floating\"
    })"

}

case "$term_bin" in
    alacritty|foot|xterm)
        class_marker="scratchterm-$RANDOM-$$"
        title_marker="$class_marker"
        if [[ "$#" -eq 0 ]]; then
            launch_terminal "$class_marker" "$title_marker" "$term_bin"
        else
            launch_terminal "$class_marker" "$title_marker" "$term_bin" -e "$@"
        fi
        ;;
    ghostty)
        class_marker="scratchterm-$RANDOM-$$"
        title_marker="$class_marker"
        if [[ "$#" -eq 0 ]]; then
            launch_terminal "$class_marker" "$title_marker" "$term_bin" "--class=$class_marker" "--title=$title_marker"
        else
            launch_terminal "$class_marker" "$title_marker" "$term_bin" "--class=$class_marker" "--title=$title_marker" -e "$@"
        fi
        ;;
    wezterm)
        class_marker="scratchterm-$RANDOM-$$"
        title_marker="$class_marker"
        if [[ "$#" -eq 0 ]]; then
            launch_terminal "$class_marker" "$title_marker" "$term_bin" start --always-new-process
        else
            launch_terminal "$class_marker" "$title_marker" "$term_bin" start --always-new-process -- "$@"
        fi
        ;;
    gnome-terminal)
        class_marker="scratchterm-$RANDOM-$$"
        title_marker="$class_marker"
        if [[ "$#" -eq 0 ]]; then
            launch_terminal "$class_marker" "$title_marker" "$term_bin"
        else
            launch_terminal "$class_marker" "$title_marker" "$term_bin" -- "$@"
        fi
        ;;
    konsole)
        class_marker="scratchterm-$RANDOM-$$"
        title_marker="$class_marker"
        if [[ "$#" -eq 0 ]]; then
            launch_terminal "$class_marker" "$title_marker" "$term_bin"
        else
            launch_terminal "$class_marker" "$title_marker" "$term_bin" -e "$@"
        fi
        ;;
    xfce4-terminal)
        class_marker="scratchterm-$RANDOM-$$"
        title_marker="$class_marker"
        if [[ "$#" -eq 0 ]]; then
            launch_terminal "$class_marker" "$title_marker" "$term_bin"
        else
            launch_terminal "$class_marker" "$title_marker" "$term_bin" --command="$*"
        fi
        ;;
    *)
        class_marker="scratchterm-$RANDOM-$$"
        title_marker="$class_marker"
        if [[ "$#" -eq 0 ]]; then
            launch_terminal "$class_marker" "$title_marker" alacritty
        else
            launch_terminal "$class_marker" "$title_marker" alacritty -e "$@"
        fi
        ;;
esac
