#!/usr/bin/env bash
set -euo pipefail

HOLD_TIME="${KNOB_HOLD_TIME:-0.3}"
PRESSED_FILE="${KNOB_PRESSED_FILE:-/tmp/knob_pressed}"
RM_BIN="${RM_BIN:-/usr/bin/rm}"
SLEEP_BIN="${SLEEP_BIN:-/usr/bin/sleep}"
TOUCH_BIN="${TOUCH_BIN:-/usr/bin/touch}"
dry_run=0
action=()

usage() {
    printf 'Usage: knob-press [--dry-run] -- COMMAND [ARG ...]\n'
}

parse_args() {
    if [[ "${1:-}" == "--dry-run" ]]; then
        dry_run=1
        shift
    fi

    [[ "${1:-}" == "--" ]] || { usage >&2; exit 2; }
    shift
    (( $# > 0 )) || { usage >&2; exit 2; }
    action=("$@")
}

validate_inputs() {
    [[ "$HOLD_TIME" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || exit 1
    [[ "$PRESSED_FILE" == /* ]] || exit 1

    for executable in "$RM_BIN" "$SLEEP_BIN" "$TOUCH_BIN" "${action[0]}"; do
        [[ "$executable" == /* && -x "$executable" ]] || exit 1
    done
}

run_hold() {
    "$TOUCH_BIN" -- "$PRESSED_FILE"

    (
        "$SLEEP_BIN" "$HOLD_TIME"
        if [[ -f "$PRESSED_FILE" ]]; then
            "$RM_BIN" -- "$PRESSED_FILE"
            "${action[@]}"
        fi
    ) &

    wait "$!"
}

main() {
    parse_args "$@"
    validate_inputs

    if (( dry_run )); then
        printf '%q ' "${action[@]}"
        printf '\n'
        return
    fi

    run_hold
}

main "$@"
