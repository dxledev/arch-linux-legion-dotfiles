#!/usr/bin/env bash

file="Makefile"
additional="$*"

cat > "$file" <<EOF
CXX := g++
CXXFLAGS := -Wall -Wextra -std=c++23 -g -MMD -MP

SOURCES := main.cpp $additional
OBJECTS := \$(SOURCES:.cpp=.o)
DEPS := \$(OBJECTS:.o=.d)

TARGET := main

\$(TARGET): \$(OBJECTS)
	\$(CXX) \$(OBJECTS) -o \$(TARGET)

%.o: %.cpp
	\$(CXX) \$(CXXFLAGS) -c \$< -o \$@

-include \$(DEPS)

clean:
	rm -f \$(OBJECTS) \$(DEPS) \$(TARGET)
EOF
