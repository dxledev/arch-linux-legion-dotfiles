#!/usr/bin/env bash

file="Makefile"
additional="$*"

cat > "$file" <<EOF
CXX := g++
CXXFLAGS := -Wall -Wextra -std=c++23 -g

SOURCES := main.cpp $additional
OBJECTS := \$(SOURCES:.cpp=.o)

DEPDIR := .deps
DEPS := \$(SOURCES:%.cpp=\$(DEPDIR)/%.d)

TARGET := main

\$(TARGET): \$(OBJECTS)
	\$(CXX) \$(OBJECTS) -o \$(TARGET)

%.o: %.cpp
	@mkdir -p \$(DEPDIR)
	\$(CXX) \$(CXXFLAGS) -MMD -MP -MF \$(DEPDIR)/\$*.d -MT \$@ -c \$< -o \$@

-include \$(DEPS)

clean:
	rm -f \$(OBJECTS) \$(TARGET)
	rm -rf \$(DEPDIR)
EOF
