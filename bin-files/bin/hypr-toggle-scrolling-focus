#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib-hypr-lua"

HYPRCTL_BIN="${HYPRCTL_BIN:-/usr/bin/hyprctl}"
NOTIFY_SEND_BIN="${NOTIFY_SEND_BIN:-/home/dxle/bin/notify-send}"
HYPR_DECORATIONS_CONF="$(hypr_config_path "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/decorations.conf")"

DRY_RUN=0

usage() {
    cat <<'USAGE'
Usage: hypr-toggle-scrolling-focus [--dry-run]

Toggle scrolling:focus_fit_method between 0 (Center) and 1 (Fit).
USAGE
}

notify_status() {
    local text="$1"

    "$NOTIFY_SEND_BIN" \
        -a "hypr-toggle-scrolling-focus" \
        -h "string:x-dunst-stack-tag:hypr-toggle-scrolling-focus" \
        -t 2500 \
        "Hyprland" \
        "$text" >/dev/null 2>&1 || true
}

get_focus_method() {
    local option_json=""
    local method=""

    option_json="$("$HYPRCTL_BIN" getoption scrolling:focus_fit_method -j 2>/dev/null || true)"
    method="$(printf '%s\n' "$option_json" | /usr/bin/awk -F'[:,]' '
        /"int"[[:space:]]*:/ {
            for (i = 1; i <= NF; i++) {
                if ($i ~ /"int"/) {
                    value = $(i + 1)
                    gsub(/[^0-9-]/, "", value)
                    print value
                    exit
                }
            }
        }
    ')"

    if [[ "$method" == "0" || "$method" == "1" ]]; then
        printf '%s\n' "$method"
        return 0
    fi

    method="$(hypr_get_config_value "$HYPR_DECORATIONS_CONF" "scrolling" "focus_fit_method" 2>/dev/null || true)"
    case "$method" in
        0|1)
            printf '%s\n' "$method"
            return 0
            ;;
    esac

    return 1
}

set_focus_method() {
    local value="$1"
    local column_width=""

    case "$value" in
        0) column_width="0.95" ;;
        1) column_width="0.5" ;;
        *) return 1 ;;
    esac

    hypr_set_config_value "$HYPR_DECORATIONS_CONF" "scrolling" "focus_fit_method" "$value" "$value"
    hypr_set_config_value "$HYPR_DECORATIONS_CONF" "scrolling" "column_width" "$column_width" "$column_width"
    "$HYPRCTL_BIN" eval "hl.config({ scrolling = { focus_fit_method = ${value}, column_width = ${column_width} } })" >/dev/null
}

label_for_method() {
    case "$1" in
        0) printf 'Center\n' ;;
        1) printf 'Fit\n' ;;
        *) printf 'Unknown\n' ;;
    esac
}

for arg in "$@"; do
    case "$arg" in
        --dry-run|-n)
            DRY_RUN=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

if [[ ! -x "$HYPRCTL_BIN" ]]; then
    notify_status "Missing hyprctl binary"
    exit 1
fi

if [[ ! -f "$HYPR_DECORATIONS_CONF" ]]; then
    notify_status "Missing config: $HYPR_DECORATIONS_CONF"
    exit 1
fi

current_method="$(get_focus_method)" || {
    notify_status "Could not read scrolling focus method"
    exit 1
}

case "$current_method" in
    0) next_method=1 ;;
    1) next_method=0 ;;
    *)
        notify_status "Unsupported scrolling focus method: $current_method"
        exit 1
        ;;
esac

next_label="$(label_for_method "$next_method")"
case "$next_method" in
    0) next_column_width="0.95" ;;
    1) next_column_width="0.5" ;;
esac

if (( DRY_RUN )); then
    printf 'Would set scrolling:focus_fit_method from %s to %s (%s) and scrolling:column_width to %s in %s\n' "$current_method" "$next_method" "$next_label" "$next_column_width" "$HYPR_DECORATIONS_CONF"
    exit 0
fi

set_focus_method "$next_method"

applied_method="$(get_focus_method)" || {
    notify_status "Could not verify scrolling focus method"
    exit 1
}

if [[ "$applied_method" != "$next_method" ]]; then
    notify_status "Scrolling Focus unchanged: expected $next_method, got $applied_method"
    exit 1
fi

notify_status "Set Scrolling Focus to: <b>${next_label}</b>"
