#!/usr/bin/env bash

set -euo pipefail

FILTER="${SYSTEM_NIGHTLIGHT_FILTER:-4500}"
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/system-toggle-nightlight.state"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SWAYOSD_MONITOR="${SWAYOSD_MONITOR:-HDMI-A-1}"

# Exposing configuration for binary paths to support custom environments
PGREP_BIN="${PGREP_BIN:-/usr/bin/pgrep}"
HYPRCTL_BIN="${HYPRCTL_BIN:-/usr/bin/hyprctl}"
HYPRSUNSET_BIN="${HYPRSUNSET_BIN:-/usr/bin/hyprsunset}"
SLEEP_BIN="${SLEEP_BIN:-/usr/bin/sleep}"
SWAYOSD_CLIENT_BIN="${SWAYOSD_CLIENT_BIN:-/home/dxle/bin/swayosd-client}"

# Use swayosd-client for uniform visual style with system brightness/volume OSDs
notify() {
  local message="$1"
  local icon="$2"

  "$SWAYOSD_CLIENT_BIN" \
    --duration 2000 \
    --monitor "$SWAYOSD_MONITOR" \
    --custom-message "$message" \
    --custom-icon "$icon"
}

ensure_hyprsunset() {
  if "$PGREP_BIN" -x hyprsunset >/dev/null 2>&1; then
    return
  fi

  if [ -x "$SCRIPT_DIR/launch-hyprsunset" ]; then
    "$SCRIPT_DIR/launch-hyprsunset"
  else
    # Run hyprsunset in background to start the nightlight daemon if not running
    "$HYPRSUNSET_BIN" >/dev/null 2>&1 &
    disown
  fi

  "$SLEEP_BIN" 0.2
}

state="off"
if "$PGREP_BIN" -x hyprsunset >/dev/null 2>&1 && [ -f "$STATE_FILE" ]; then
  state="$(<"$STATE_FILE")"
fi

if [ "$state" = "on" ]; then
  "$HYPRCTL_BIN" hyprsunset identity
  notify "Nightlight: OFF" "night-light-disabled-symbolic"
  printf 'off\n' > "$STATE_FILE"
else
  ensure_hyprsunset
  "$HYPRCTL_BIN" hyprsunset temperature "$FILTER"
  notify "Nightlight: ON" "night-light-symbolic"
  printf 'on\n' > "$STATE_FILE"
fi
