#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mode_script="${SHELL_MODE_SCRIPT:-$HOME/bin/toggle-shell-mode}"
menu_id="menu-shell-mode"
pid_file="/tmp/menu-rofi.pid"

usage() {
    printf 'Usage: menu-shell-mode\n'
}

[[ $# -eq 0 ]] || { usage >&2; exit 2; }
[[ -x "$mode_script" ]] || { printf 'menu-shell-mode: missing %s\n' "$mode_script" >&2; exit 1; }

if "$script_dir/rofi-toggle-pidfile" begin "$menu_id"; then
    exit 0
fi

menu_active=1
clear_menu() {
    if (( menu_active )); then
        menu_active=0
        "$script_dir/rofi-toggle-pidfile" clear "$menu_id" || true
    fi
}
trap clear_menu EXIT

if ! current="$("$mode_script" --status)"; then
    printf 'menu-shell-mode: could not read active shell mode\n' >&2
    exit 1
fi

case "$current" in
    waybar) active_waybar='<i>Waybar</i>' ;;
    caelestia) active_waybar='Waybar'; active_caelestia='<i>Caelestia</i>' ;;
    noctalia) active_waybar='Waybar'; active_noctalia='<i>Noctalia</i>' ;;
    *) printf 'menu-shell-mode: unknown shell mode: %s\n' "$current" >&2; exit 1 ;;
esac
: "${active_waybar:=Waybar}"
: "${active_caelestia:=Caelestia}"
: "${active_noctalia:=Noctalia}"

chosen="$({
    printf '%s\n' "$active_waybar"
    printf '%s\n' "$active_caelestia"
    printf '%s\n' "$active_noctalia"
} | "$script_dir/rofi-nerd-markup" | /usr/bin/rofi -dmenu -i -markup-rows \
    -pid "$pid_file" -p '' \
    -theme-str '
        window { width: 300px; }
        entry { placeholder: "Shell mode…"; }
        element {
            orientation: horizontal;
            children: [ element-text ];
            spacing: 0px;
            padding: 8px 10px;
        }
        element-text {
            horizontal-align: 0.0;
            padding-left: 0px;
        }
    ' || true)"

clear_menu
chosen="${chosen//<i>/}"
chosen="${chosen//<\/i>/}"

case "$chosen" in
    Waybar)
        [[ "$current" == waybar ]] || "$mode_script" --waybar
        ;;
    Caelestia)
        [[ "$current" == caelestia ]] || "$mode_script" --caelestia
        ;;
    Noctalia)
        [[ "$current" == noctalia ]] || "$mode_script" --noctalia
        ;;
esac
