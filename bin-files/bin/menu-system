#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MENU_ID="menu-system"
PID_FILE="/tmp/menu-rofi.pid"

if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
    exit 0
fi

options="  Install
󰚰  System Update
󰂄  Battery
󱐋  Power Profile
󰐥  Shutdown
󰤁  Reboot
  Lock"

chosen=$(printf '%b\n' "$options" | "$SCRIPT_DIR/rofi-nerd-markup" | rofi -dmenu -i \
    -markup-rows \
    -pid "$PID_FILE" \
    -p "" \
    -theme-str '
        window { width: 300px; }
        entry { placeholder: "System…"; }
        element { 
            orientation: horizontal;
            children: [ element-text ];
            spacing: 0px;
            padding: 8px 10px;
        }
        element-text { 
            horizontal-align: 0.0;
            padding-left: 0px;
        }
    ' || true)

"$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"

case "$chosen" in
  *System\ Update)
    "$SCRIPT_DIR/launch-pacman-update"
    ;;
  *Install)
    "$SCRIPT_DIR/menu-install"
    ;;
  *Battery)
    "$SCRIPT_DIR/menu-battery"
    ;;
  *Power\ Profile)
    "$SCRIPT_DIR/menu-power-profile"
    ;;
  *Shutdown)
    if printf '%s\n' "Shutdown?" | "$SCRIPT_DIR/menu-confirmation"; then
        "$SCRIPT_DIR/notify-send" "System" "<b><span foreground=\"var(--primary-color)\">Shutting down…</span></b>"
        "$SCRIPT_DIR/system-shutdown"
    fi
    ;;
  *Reboot)
    "$SCRIPT_DIR/system-reboot"
    ;;
  *Lock)
    sleep 0.1
    "$HOME/.config/hyprlock/scripts/launch-lock-screen.sh"
    ;;
esac
