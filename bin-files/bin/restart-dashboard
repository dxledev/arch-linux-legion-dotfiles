#!/usr/bin/env bash
set -euo pipefail

TOPDASH_BIN="${TOPDASH_BIN:-/home/dxle/builds/dashboard/build/topdash}"
AWK_BIN="/usr/bin/awk"
KILL_BIN="/usr/bin/kill"
PGREP_BIN="/usr/bin/pgrep"
PKILL_BIN="/usr/bin/pkill"
READLINK_BIN="/usr/bin/readlink"
SLEEP_BIN="/usr/bin/sleep"
FLOCK_BIN="/usr/bin/flock"
SETSID_BIN="/usr/bin/setsid"
NOHUP_BIN="/usr/bin/nohup"
NOTIFY_SEND_BIN="/home/dxle/bin/notify-send"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
LOCK_FILE="${TOPDASH_RESTART_LOCK_FILE:-$RUNTIME_DIR/restart-dashboard.v2.lock}"
TERM_WAIT_ATTEMPTS="${TERM_WAIT_ATTEMPTS:-6}"
TERM_WAIT_SECONDS="${TERM_WAIT_SECONDS:-0.05}"
START_WAIT_ATTEMPTS="${START_WAIT_ATTEMPTS:-10}"
START_WAIT_SECONDS="${START_WAIT_SECONDS:-0.05}"
WAIT_FOR_START="${WAIT_FOR_START:-0}"

usage() {
    printf 'Usage: restart-dashboard [--dry-run]\n'
}

notify_error() {
    if [[ -x "$NOTIFY_SEND_BIN" ]]; then
        "$NOTIFY_SEND_BIN" -t 4000 "Dashboard" "$1" >/dev/null 2>&1 || true
    fi
}

validate_positive_integer() {
    local name="$1"
    local value="$2"

    if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
        notify_error "$name must be a positive integer."
        exit 1
    fi
}

validate_positive_number() {
    local name="$1"
    local value="$2"

    if [[ ! "$value" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]]; then
        notify_error "$name must be a positive number."
        exit 1
    fi
}

validate_inputs() {
    if [[ -z "$TOPDASH_BIN" ]]; then
        notify_error "topdash binary path is empty."
        exit 1
    fi

    if [[ ! -x "$TOPDASH_BIN" ]]; then
        notify_error "topdash binary not found: $TOPDASH_BIN"
        exit 1
    fi

    if [[ -z "$LOCK_FILE" ]]; then
        notify_error "restart lock path is empty."
        exit 1
    fi

    validate_positive_integer "TERM_WAIT_ATTEMPTS" "$TERM_WAIT_ATTEMPTS"
    validate_positive_number "TERM_WAIT_SECONDS" "$TERM_WAIT_SECONDS"
    validate_positive_integer "START_WAIT_ATTEMPTS" "$START_WAIT_ATTEMPTS"
    validate_positive_number "START_WAIT_SECONDS" "$START_WAIT_SECONDS"
    if [[ "$WAIT_FOR_START" != "0" && "$WAIT_FOR_START" != "1" ]]; then
        notify_error "WAIT_FOR_START must be 0 or 1."
        exit 1
    fi
}

topdash_real_path() {
    "$READLINK_BIN" -f -- "$TOPDASH_BIN"
}

collect_topdash_pids() {
    local expected_exe=""

    expected_exe="$(topdash_real_path)"

    {
        "$PGREP_BIN" -x topdash 2>/dev/null || true
        "$PGREP_BIN" -f -- "$expected_exe" 2>/dev/null || true
    } | "$AWK_BIN" -v self="$$" 'NF && $1 != self { print $1 }' | "$AWK_BIN" '!seen[$1]++'
}

stop_topdash() {
    local pids=()

    mapfile -t pids < <(collect_topdash_pids)
    [[ ${#pids[@]} -gt 0 ]] || return 0

    "$PKILL_BIN" -x topdash >/dev/null 2>&1 || true
    "$PKILL_BIN" -f -- "$(topdash_real_path)" >/dev/null 2>&1 || true

    for ((attempt = 0; attempt < TERM_WAIT_ATTEMPTS; attempt++)); do
        mapfile -t pids < <(collect_topdash_pids)
        [[ ${#pids[@]} -eq 0 ]] && return 0
        "$SLEEP_BIN" "$TERM_WAIT_SECONDS"
    done

    mapfile -t pids < <(collect_topdash_pids)
    if [[ ${#pids[@]} -gt 0 ]]; then
        "$KILL_BIN" -9 "${pids[@]}" >/dev/null 2>&1 || true
    fi

    for ((attempt = 0; attempt < TERM_WAIT_ATTEMPTS; attempt++)); do
        mapfile -t pids < <(collect_topdash_pids)
        [[ ${#pids[@]} -eq 0 ]] && return 0
        "$SLEEP_BIN" "$TERM_WAIT_SECONDS"
    done

    notify_error "Failed to stop topdash."
    exit 1
}

start_topdash() {
    if [[ -x "$SETSID_BIN" ]]; then
        "$SETSID_BIN" -f "$TOPDASH_BIN" >/dev/null 2>&1
    else
        "$NOHUP_BIN" "$TOPDASH_BIN" >/dev/null 2>&1 &
    fi
}

wait_for_topdash() {
    local pids=()

    for ((attempt = 0; attempt < START_WAIT_ATTEMPTS; attempt++)); do
        mapfile -t pids < <(collect_topdash_pids)
        if [[ ${#pids[@]} -gt 0 ]]; then
            return 0
        fi
        "$SLEEP_BIN" "$START_WAIT_SECONDS"
    done

    notify_error "Failed to start topdash."
    exit 1
}

restart_topdash() {
    stop_topdash
    start_topdash
    if [[ "$WAIT_FOR_START" == "1" ]]; then
        wait_for_topdash
    fi
}

main() {
    local dry_run=0
    local locked=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --locked)
                locked=1
                shift
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                usage
                exit 1
                ;;
        esac
    done

    validate_inputs

    if [[ "$dry_run" -eq 1 ]]; then
        return 0
    fi

    if [[ "$locked" -eq 1 ]]; then
        restart_topdash
        return 0
    fi

    "$FLOCK_BIN" -n -o "$LOCK_FILE" "$0" --locked
}

main "$@"
