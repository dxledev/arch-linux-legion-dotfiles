#!/usr/bin/env bash
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/bin:/bin"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
THEME_DIR="$HOME/.config/themes"
CURRENT_LINK="$THEME_DIR/current"
NOTIFY_SEND_BIN="/home/dxle/bin/notify-send"
THEME_APPLY_SCRIPT="${THEME_APPLY_SCRIPT:-$SCRIPT_DIR/theme-apply}"
SHELL_THEME_SCRIPT="${SHELL_THEME_SCRIPT:-$HOME/.config/quickshell/active/integration/shell-theme}"
NOCTALIA_BIN="${NOCTALIA_BIN:-$HOME/.config/noctalia/.runtime/bin/noctalia}"

[[ $# == 1 ]] || { printf 'Usage: theme <theme-name>\n' >&2; exit 2; }
THEME_NAME="$1"
[[ -n "$THEME_NAME" && "$THEME_NAME" != current && "$THEME_NAME" != .* && "$THEME_NAME" != */* && "$THEME_NAME" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || {
    printf 'theme: Invalid named theme: %s\n' "$THEME_NAME" >&2
    exit 1
}
THEME_ROOT="$(/usr/bin/readlink -f -- "$THEME_DIR")"
NEW_THEME="$(/usr/bin/readlink -f -- "$THEME_DIR/$THEME_NAME" 2>/dev/null || true)"
[[ -d "$NEW_THEME" && "${NEW_THEME%/*}" == "$THEME_ROOT" && "${NEW_THEME##*/}" == "$THEME_NAME" ]] || {
    printf "theme: Theme '%s' does not exist as an immediate named theme in %s\n" "$THEME_NAME" "$THEME_DIR" >&2
    exit 1
}
[[ "$THEME_APPLY_SCRIPT" == /* && -x "$THEME_APPLY_SCRIPT" ]] || { printf 'theme: Invalid theme coordinator.\n' >&2; exit 1; }

static_theme_mode() {
    [[ "$1" == akaito ]] && printf '%s\n' light || printf '%s\n' dark
}

TEMPORARY_DIR="$(/usr/bin/mktemp -d "$THEME_DIR/.current.XXXXXX")"
/usr/bin/ln -s -- "$NEW_THEME" "$TEMPORARY_DIR/link"
/usr/bin/mv -Tf -- "$TEMPORARY_DIR/link" "$CURRENT_LINK"
/usr/bin/rmdir -- "$TEMPORARY_DIR"

if [[ "${THEME_SET_SHELL_SOURCE:-0}" == 1 ]]; then
    [[ "$SHELL_THEME_SCRIPT" == /* && -x "$SHELL_THEME_SCRIPT" ]] || { printf 'theme: Invalid shell theme controller.\n' >&2; exit 1; }
    "$SHELL_THEME_SCRIPT" set-source system
else
    "$THEME_APPLY_SCRIPT" system
fi
/usr/bin/qs ipc call theme reloadColors >/dev/null 2>&1 || true

if [[ "${NOCTALIA_THEME_SYNC:-0}" != 1 && "$NOCTALIA_BIN" == /* && -x "$NOCTALIA_BIN" ]]; then
    "$NOCTALIA_BIN" msg color-scheme-set custom "$THEME_NAME" >/dev/null 2>&1 || true
fi

if [[ "$NOCTALIA_BIN" == /* && -x "$NOCTALIA_BIN" ]]; then
    "$NOCTALIA_BIN" msg theme-mode-set "$(static_theme_mode "$THEME_NAME")" >/dev/null 2>&1 || true
    "$NOCTALIA_BIN" msg wallpaper-set "$CURRENT_LINK/wallpaper.png" >/dev/null 2>&1 || true
fi

if [[ "${THEME_SUPPRESS_NOTIFY:-0}" != "1" ]]; then
    # Pretty notification
    if [[ "$THEME_NAME" == "rose-pine" ]]; then
        FORMATTED_NAME="Rosé Pine"
    else
        FORMATTED_NAME=$(printf '%s\n' "$THEME_NAME" | /usr/bin/tr '-' ' ' | /usr/bin/sed -E 's/\b(.)/\U\1/g')
    fi

    (
        if [[ "$("$SCRIPT_DIR/toggle-shell-mode" --status 2>/dev/null)" == waybar ]]; then
            /usr/bin/systemctl --user start ward.service || true
        fi

        if [[ -x "$NOTIFY_SEND_BIN" ]]; then
            "$NOTIFY_SEND_BIN" -t 5000 "Theme" "Updated to <b><span foreground=\"var(--primary-color)\">$FORMATTED_NAME</span></b>." >/dev/null 2>&1 || true
        fi
    ) >/dev/null 2>&1 &
fi
