#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MENU_ID="${MENU_CONFIRMATION_ID:-menu-confirmation}"
PID_FILE="${MENU_CONFIRMATION_PID_FILE:-/tmp/menu-rofi.pid}"
PROMPT="${MENU_CONFIRMATION_PROMPT:-Confirm…}"
CONFIRM_LABEL="${MENU_CONFIRMATION_CONFIRM_LABEL:-Confirm}"
CANCEL_LABEL="${MENU_CONFIRMATION_CANCEL_LABEL:-Cancel}"
WIDTH="${MENU_CONFIRMATION_WIDTH:-300px}"

usage() {
    printf 'Usage: %s [--prompt TEXT] [--confirm-label TEXT] [--cancel-label TEXT]\n' "${0##*/}" >&2
}

read_subject() {
    local subject=""

    if [[ ! -t 0 ]]; then
        subject="$(/usr/bin/cat)"
    fi

    subject="${subject//$'\n'/ }"
    subject="${subject#"${subject%%[![:space:]]*}"}"
    subject="${subject%"${subject##*[![:space:]]}"}"

    printf '%s' "$subject"
}

escape_rofi_string() {
    local value="$1"

    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"

    printf '%s' "$value"
}

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --prompt)
            [[ "$#" -ge 2 ]] || {
                usage
                exit 64
            }
            PROMPT="$2"
            shift 2
            ;;
        --confirm-label)
            [[ "$#" -ge 2 ]] || {
                usage
                exit 64
            }
            CONFIRM_LABEL="$2"
            shift 2
            ;;
        --cancel-label)
            [[ "$#" -ge 2 ]] || {
                usage
                exit 64
            }
            CANCEL_LABEL="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage
            exit 64
            ;;
    esac
done

if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
    exit 1
fi

cleanup() {
    "$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"
}
trap cleanup EXIT

subject="$(read_subject)"
if [[ -n "$subject" ]]; then
    PROMPT="$subject"
fi
escaped_prompt="$(escape_rofi_string "$PROMPT")"

options="󰄬  $CONFIRM_LABEL
󰅖  $CANCEL_LABEL"

chosen="$(printf '%b\n' "$options" | "$SCRIPT_DIR/rofi-nerd-markup" | rofi -dmenu -i \
    -markup-rows \
    -pid "$PID_FILE" \
    -p "" \
    -theme-str "
        window { width: $WIDTH; }
        entry { placeholder: \"$escaped_prompt\"; }
        element {
            orientation: horizontal;
            children: [ element-text ];
            spacing: 0px;
            padding: 8px 10px;
        }
        element-text {
            horizontal-align: 0.0;
            padding-left: 0px;
        }
    ")" || exit 1

label="${chosen#*  }"

[[ "$label" == "$CONFIRM_LABEL" ]]
