#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ALACRITTY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
MENU_ID="menu-font"
PID_FILE="/tmp/menu-rofi.pid"

if "$SCRIPT_DIR/rofi-toggle-pidfile" begin "$MENU_ID"; then
    exit 0
fi

trap '"$SCRIPT_DIR/rofi-toggle-pidfile" clear "$MENU_ID"' EXIT

CURRENT_FONT=""
if [[ -f "$ALACRITTY_CONF" ]]; then
    CURRENT_FONT="$(
        awk '
            /^\[font\.normal\]$/ { in_normal = 1; next }
            /^\[/ { in_normal = 0 }
            in_normal && /^[[:space:]]*family[[:space:]]*=/ {
                value = $0
                sub(/^[^=]+=[[:space:]]*/, "", value)
                gsub(/^"|"$/, "", value)
                print value
                exit
            }
        ' "$ALACRITTY_CONF"
    )"
fi

FONTS="$(bash "$SCRIPT_DIR/font-families")"

escape_markup() {
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

DISPLAY=""

while IFS= read -r font; do
    [[ -n "$font" ]] || continue
    pretty="$(printf '%s' "$font" | escape_markup)"

    if [[ "$font" = "$CURRENT_FONT" ]]; then
        pretty="<i>$pretty</i>"
    fi

    DISPLAY+="$pretty\n"
done <<< "$FONTS"

DISPLAY="${DISPLAY%\\n}"
SELECTED_DISPLAY="$(printf '%b' "$DISPLAY" | rofi -dmenu -i \
    -markup-rows \
    -pid "$PID_FILE" \
    -p "" \
    -theme-str '
        window { width: 500px; }
        entry { placeholder: "Font…"; }
        element {
            orientation: horizontal;
            children: [ element-text ];
            spacing: 0px;
            padding: 8px 8px;
        }
        element-text {
            horizontal-align: 0.0;
            padding-left: 0px;
            margin: 0 2px;
        }
    ')"

[[ -z "$SELECTED_DISPLAY" ]] && exit 0

SELECTED="$(printf '%s' "$SELECTED_DISPLAY" | sed -E 's/<[^>]+>//g; s/&lt;/</g; s/&gt;/>/g; s/&amp;/\&/g')"

"$SCRIPT_DIR/font" "$@" "$SELECTED"
