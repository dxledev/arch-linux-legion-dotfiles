#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_INCLUDE_MAKO=0
DEFAULT_INCLUDE_WARD=0
INCLUDE_MAKO="$DEFAULT_INCLUDE_MAKO"
INCLUDE_WARD="$DEFAULT_INCLUDE_WARD"

usage() {
    echo "Usage: font [--include-mako|-m] [--include-ward|-w] <font-name>"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --include-mako|-m)
            INCLUDE_MAKO=1
            shift
            ;;
        --include-ward|-w)
            INCLUDE_WARD=1
            shift
            ;;
        --help|-h)
            usage
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            ;;
        *)
            break
            ;;
    esac
done

[[ $# -eq 0 ]] && usage

FONT_NAME="$*"

if ! bash "$SCRIPT_DIR/font-families" --include-omitted | grep -Fxq "$FONT_NAME"; then
    echo "Font not found: $FONT_NAME"
    exit 1
fi

WAYBAR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/waybar"
DASHBOARD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/dashboard"
ALACRITTY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
GHOSTTY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config.ghostty"
ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/theme.rasi"
MAKO_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/mako/config"
WARD_STYLE="${XDG_CONFIG_HOME:-$HOME/.config}/ward/style.css"

set_css_font() {
    local file="$1"
    local family="$2"

    FONT_FAMILY="$family" perl -0pi -e 's/font-family:\s*[^;]+;/font-family: $ENV{FONT_FAMILY};/' "$file"
}

waybar_font_stack() {
    local include_font_awesome="${1:-0}"
    local include_symbols="${2:-0}"

    if [[ "$include_font_awesome" -eq 1 ]]; then
        printf '"%s", "Font Awesome 6 Free", sans-serif' "$FONT_NAME"
    elif [[ "$include_symbols" -eq 1 ]]; then
        printf '"%s", "JetBrainsMono Nerd Font", "Symbols Nerd Font Mono"' "$FONT_NAME"
    else
        printf '"%s"' "$FONT_NAME"
    fi
}

set_alacritty_font() {
    local file="$1"
    local family="$2"

    FONT_NAME="$family" perl -0pi -e 's/(\[font\.normal\][^\[]*?family\s*=\s*")[^"]*(")/$1$ENV{FONT_NAME}$2/s' "$file"
}

set_ghostty_font() {
    local file="$1"
    local family="$2"

    if grep -Eq '^[[:space:]]*font-family[[:space:]]*=' "$file"; then
        FONT_NAME="$family" perl -0pi -e 's/^[[:space:]]*font-family[[:space:]]*=.*$/font-family = "$ENV{FONT_NAME}"/m' "$file"
    else
        printf '\nfont-family = "%s"\n' "$family" >> "$file"
    fi
}

for file in "$WAYBAR_DIR"/styles/*.css; do
    [[ -f "$file" ]] || continue

    case "$(basename "$file")" in
        minimal.css)
            set_css_font "$file" "$(waybar_font_stack 1 0)"
            ;;
        spaced-arrow.css|arrowline.css)
            set_css_font "$file" "$(waybar_font_stack 0 1)"
            ;;
        *)
            set_css_font "$file" "$(waybar_font_stack 0 0)"
            ;;
    esac
done

if [[ "$INCLUDE_WARD" -eq 1 && -f "$WARD_STYLE" ]]; then
    set_css_font "$WARD_STYLE" "\"$FONT_NAME\""
fi

for file in "$DASHBOARD_DIR"/styles/*.qml; do
    [[ -f "$file" ]] || continue
    FONT_NAME="$FONT_NAME" perl -0pi -e 's/property string font: "[^"]*"/property string font: "$ENV{FONT_NAME}"/' "$file"
done

if [[ -f "$ALACRITTY_CONF" ]]; then
    set_alacritty_font "$ALACRITTY_CONF" "$FONT_NAME"
fi

if [[ -f "$GHOSTTY_CONF" ]]; then
    set_ghostty_font "$GHOSTTY_CONF" "$FONT_NAME"
fi

FONT_NAME="$FONT_NAME" perl -0pi -e 's/font:\s*"[^"]*?(\s+\d+(?:\.\d+)?)";/font: "$ENV{FONT_NAME}$1";/' "$ROFI_THEME"

if [[ "$INCLUDE_MAKO" -eq 1 && -f "$MAKO_CONF" ]]; then
    FONT_NAME="$FONT_NAME" perl -0pi -e 's/^font=.*?(\s+\d+(?:\.\d+)?)$/font=$ENV{FONT_NAME}$1/m' "$MAKO_CONF"
fi

"$SCRIPT_DIR/reload-terminal" || true
"$SCRIPT_DIR/reload-waybar" || true
"$SCRIPT_DIR/reload-dashboard" || true

if [[ "$INCLUDE_MAKO" -eq 1 ]]; then
    "$SCRIPT_DIR/reload-mako" || true
fi

if [[ "$INCLUDE_WARD" -eq 1 ]]; then
    "$SCRIPT_DIR/reload-ward" || true
fi

notify-send -t 5000 "Font" "Updated to <b>$FONT_NAME</b>." >/dev/null 2>&1 || true
