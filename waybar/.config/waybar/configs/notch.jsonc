{
    "layer": "top",
    "output": "HDMI-A-1",
    "position": "top", // (top|bottom|left|right)
    "height": 40, // (to be removed for auto height)
    "width": "auto",
    "spacing": 0, // Gaps between modules
    "margin-left": 200,
    "margin-right": 200,
    "fixed-center": true,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "custom/cava",
        "custom/info",
        "custom/music",
        "custom/power",
    ],
    "modules-center": [
        "group/date",
    ],
    "modules-right": [
        "custom/nightlight",
        "custom/hypridle",
        "custom/sunshine",
        "group/monitor",
        "group/utils",
        "custom/update"
    ],
    "custom/launcher": {
		"format":"<span font_desc=\"JetBrainsMono Nerd Font\">󰣇</span>",
		"tooltip": false,
		"on-click":"~/bin/menu"
	},
    "custom/info": {
		"format":"<span font_desc=\"JetBrainsMono Nerd Font\">󰀨</span>",
		"tooltip": false,
		"on-click":"kitty -e btop"
	},
    "custom/music": {
		"format":"<span font_desc=\"JetBrainsMono Nerd Font\">󰎆</span>",
		"tooltip": false,
		"on-click":"~/bin/toggle-dashboard --open --media"
	},
    "custom/power": {
		"format":"<span font_desc=\"JetBrainsMono Nerd Font\">󱍷</span>",
		"tooltip": false,
		"on-click":"~/bin/menu-system"
	},
    "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh",
  },
    "group/date": {
        "orientation": "horizontal",
        "modules": [
            "custom/weather",
            "clock",
        ]
    },
    "group/utils": {
        "orientation": "horizontal",
        "modules": [
            "battery",
            "network",
            "pulseaudio"
        ]
    }, 
    "group/monitor": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
        ]
    },        
    "clock": {
        "interval": 1,
        "format": "{:%I:%M %p}",
        "tooltip-format": "<tt>{:%H:%M:%S}</tt>",
        "timezones": [
            "America/Los_Angeles"
        ],
        "on-click": "~/bin/toggle-dashboard --open --dashboard",
    },
    "cpu": {
        "states": {
            "warning": 75,
            "critical": 90,
        },
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\"></span> {usage}%",
        "format-critical": "<span font_desc=\"JetBrainsMono Nerd Font\">󰀦</span> {usage}%",
        "on-click": "~/bin/toggle-dashboard --open --performance",
        "tooltip": true,
        "interval": 5,
    },
    "memory": {
        "states": {
            "warning": 75,
            "critical": 90,
        },
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\"></span> {percentage}%",
        "format-critical": "<span font_desc=\"JetBrainsMono Nerd Font\">󰀦</span> {percentage}%",
        "on-click": "~/bin/toggle-dashboard --open --performance", 
        "tooltip": true,
        "tooltip-format": "Memory Used: {used:0.1f} GB / {total:0.1f} GB",
        "interval": 5,
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> {capacity}%",
        "format-full": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> {capacity}%",
        "format-charging": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> <span font_desc=\"JetBrainsMono Nerd Font\"></span> {capacity}%",
        "format-plugged": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> <span font_desc=\"JetBrainsMono Nerd Font\"></span> {capacity}%",
        "format-alt": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "on-click": "/home/dxle/bin/menu-power-profile"
    },
    "network": {
        "interval": 1000,
        "format-wifi": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> {signalStrength}%",
        "format-ethernet": "{ipaddr}/{cidr} <span font_desc=\"JetBrainsMono Nerd Font\"></span>",
        "tooltip-format": "{essid}\n{ifname} via {gwaddr}\n{ipaddr}/{cidr}",
        "format-linked": "{ifname} (No IP) <span font_desc=\"JetBrainsMono Nerd Font\"></span>",
        "format-disconnected": "<span font_desc=\"JetBrainsMono Nerd Font\">󰤭</span>",
        "format-alt": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> {signalStrength}%",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "~/bin/launch-terminal-floating 1000 800 nmtui"
    },
    "pulseaudio": {
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span>  {volume}%",
        "format-muted": "<span font_desc=\"JetBrainsMono Nerd Font\"></span>  {format_source}",
        "format-source": "<span font_desc=\"JetBrainsMono Nerd Font\"></span>",
        "format-source-muted": "<span font_desc=\"JetBrainsMono Nerd Font\"></span> ",
        "format-bluetooth": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span><span font_desc=\"JetBrainsMono Nerd Font\"></span> {format_source}",
        "format-bluetooth-muted": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span><span font_desc=\"JetBrainsMono Nerd Font\"></span> {format_source}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "󰋎",
            "phone": " ",
            "portable": " ",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "tooltip-format": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span> {volume}%\n{format_source}",
        "on-click": "~/bin/menu-audio",
        "on-click-right": "~/bin/launch-window-floating 1000 800 pavucontrol"
    },
    "hyprland/workspaces": {
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon}</span>",
        "show-special": true,
        "format-icons": {
            "active": "",
            "default": "",
            "socialspace": "<span font-size='9pt'></span>",
            "discordspace": "<span font-size='9pt'> 󱋊 </span>",
            "mediaspace": "<span font-size='8pt'> </span>",
            "scratchpad": "<span font-size='8pt'> </span>",
            "floating": "+",
        },
        "persistent-workspaces": {
          "HDMI-A-1": [ 1,2,3,4,5 ],
        },
    },
    "custom/weather": {
        "format": "{}°F",
        "tooltip": true,
        "interval": 3600,
        "exec": "wttrbar --location 'Covina, California' --nerd --date-format \"%d.%m.%Y\" -l en --fahrenheit",
        "return-type": "json",
        "on-click": "~/bin/toggle-dashboard --open --weather"
    },
    "custom/update": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "format": " {}",
        "on-click": "~/bin/launch-pacman-update",
        "interval": 600,
        "tooltip": true,
        "min-length": 1,
        "max-length": 5,
    },
    "custom/sunshine": {
        "exec": "$HOME/.config/waybar/scripts/sunshine-status.sh",
        "return-type": "json",
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon} </span>",
        "format-icons": [
            "󰶐",
            "󰍹"
        ],
        "interval": 2,
        "on-click": "~/bin/system-toggle-sunshine",
        "tooltip": true
    },
    "custom/hypridle": {
        "exec": "$HOME/.config/waybar/scripts/hypridle-status.sh",
        "return-type": "json",
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon} </span>",
        "format-icons": [
            "󱙱",
            "󰌾"
        ],
        "interval": 2,
        "on-click": "~/bin/system-toggle-idle-lock",
        "tooltip": true
    },
    "custom/nightlight": {
        "exec": "$HOME/.config/waybar/scripts/hyprsunset-status.sh",
        "return-type": "json",
        "format": "<span font_desc=\"JetBrainsMono Nerd Font\">{icon} </span>",
        "format-icons": [
            "",
            ""
        ],
        "interval": 2,
        "tooltip": true,
        "on-click": "$HOME/bin/system-toggle-nightlight"
    },
}
