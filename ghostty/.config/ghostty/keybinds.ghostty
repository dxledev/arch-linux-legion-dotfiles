# clear all global keybinds
keybind = clear

# keybinds

keybind = performable:ctrl+c=copy_to_clipboard
keybind = performable:ctrl+v=paste_from_clipboard

keybind = performable:shift+ctrl+c=copy_url_to_clipboard
keybind = performable:shift+ctrl+v=paste_from_selection

keybind = performable:ctrl+a=select_all

keybind = performable:ctrl+l=clear_screen

keybind = performable:ctrl+z=undo
keybind = performable:ctrl+r=redo

keybind = performable:ctrl+equal=increase_font_size:1.0
keybind = performable:ctrl+minus=decrease_font_size:1.0
keybind = performable:shift+ctrl+plus=reset_font_size

keybind = performable:ctrl+/=start_search
