+void IdleInhibitor::syncSystemIdleLockState(bool notify) {
+  const std::optional<bool> idleLockEnabled = systemIdleLockEnabled();
+  if (!idleLockEnabled.has_value()) {
+    return;
+  }
+
+  const bool caffeineEnabled = !*idleLockEnabled;
+  if (m_enabled == caffeineEnabled) {
+    return;
+  }
+
+  m_enabled = caffeineEnabled;
+  if (!m_enabled) {
+    m_loggedWaylandEnable = false;
+    m_loggedLogindEnable = false;
+  }
+  if (notify) {
+    notifyChanged();
+  }
+}
+
+bool IdleInhibitor::runSystemIdleLockToggle() {
+  process::RunOptions options;
+  options.timeout = std::chrono::seconds(5);
+  options.env = {
+      {"QS_BIN", "/usr/bin/true"},
+      {"NOTIFY_SEND_BIN", "/usr/bin/true"},
+  };
+
+  const auto result = process::runSync(std::vector<std::string>{systemIdleLockScriptPath()}, std::move(options));
+  if (!result) {
+    kLog.warn("idle lock script failed: exit_code={} stderr={}", result.exitCode, result.err);
+    return false;
+  }
+  return true;
+}
