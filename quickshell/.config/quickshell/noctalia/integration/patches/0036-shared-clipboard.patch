+    harness.fixture.islandPin(bytesOf("survivor"));
+    harness.clipboard.refreshShared();
+    harness.clipboard.clearUnpinnedHistory();
+    expect(harness.clipboard.history().size() == 1, "clearing kept the wrong number of entries");
+    expect(!harness.clipboard.history().empty() && harness.clipboard.history()[0].pinned, "clearing dropped the pin");
+    expect(!harness.fixture.hasRow(3) && !harness.fixture.hasRow(4), "cliphist was not wiped");
+
+    harness.fixture.addText(5, "z");
+    harness.clipboard.refreshShared();
+    harness.clipboard.clearHistory();
+    expect(harness.clipboard.history().empty(), "clear all left entries behind");
+    expect(countFiles(harness.fixture.favorites, ".payload") == 0, "clear all kept pin payloads");
+    expect(
+        !Fixture::slurp(harness.fixture.favorites / "favorites.json")
+             .contains(SharedClipboardStore::sha256Hex(bytesOf("survivor"))),
+        "clear all kept pins listed"
+    );
