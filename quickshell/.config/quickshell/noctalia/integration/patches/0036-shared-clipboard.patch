+  void testHistoryFromCliphist() {
+    Harness harness;
+    harness.fixture.addText(1, "alpha");
+    harness.fixture.addText(2, "beta  gamma\n");
+    harness.fixture.addPng(3, 0x11);
+    harness.clipboard.syncPersistence();
+
+    const auto& history = harness.clipboard.history();
+    expect(history.size() == 3, "history did not list every cliphist row");
+    if (history.size() != 3) {
+      return;
+    }
+    expect(history[0].storageId == "cliphist-3" && history[0].isImage(), "the newest row (an image) did not lead");
+    expect(history[1].storageId == "cliphist-2" && history[1].textPreview == "beta gamma", "text preview");
+    expect(history[2].storageId == "cliphist-1" && !history[2].pinned, "the oldest row was not last and unpinned");
+
+    expect(harness.clipboard.ensureEntryLoaded(1), "a history payload could not be decoded");
+    expect(
+        textOf(harness.clipboard.history()[1]) == "beta  gamma\n",
+        "decoded payload differs from cliphist's: [" + textOf(harness.clipboard.history()[1]) + "]"
+    );
+    expect(harness.clipboard.ensureEntryLoaded(0), "an image payload could not be decoded");
+    expect(harness.clipboard.history()[0].data.size() == 64, "decoded image has the wrong size");
+  }
