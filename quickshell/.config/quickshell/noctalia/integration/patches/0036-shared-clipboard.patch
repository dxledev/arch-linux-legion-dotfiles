+  void testPinAndUnpin() {
+    Harness harness;
+    harness.fixture.addText(1, "keep me");
+    harness.fixture.addText(2, "other");
+    harness.fixture.addPng(3, 0x22);
+    harness.clipboard.syncPersistence();
+
+    // Newest first: cliphist-3 (image), cliphist-2 (other), cliphist-1 (keep me).
+    std::string newId;
+    expect(harness.clipboard.setEntryPinned(2, true, &newId), "pinning a text row failed");
+    const std::string textHash = SharedClipboardStore::sha256Hex(bytesOf("keep me"));
+    expect(newId == textHash, "pinning did not report the pin's hash as its new id");
+
+    const std::string manifest = Fixture::slurp(harness.fixture.favorites / "favorites.json");
+    expect(manifest.contains(textHash) && manifest.contains("\"version\": 1"), "manifest is not in Caelestia's format");
+    const fs::path payload = harness.fixture.favorites / (textHash + ".payload");
+    expect(fs::exists(payload), "the pin's payload was not stored");
+    struct stat info{};
+    ::stat(payload.c_str(), &info);
+    expect((info.st_mode & 0777) == 0600, "the pin payload is not private");
+    ::stat(harness.fixture.favorites.c_str(), &info);
+    expect((info.st_mode & 0777) == 0700, "the favorites directory is not private");
+
+    const auto& history = harness.clipboard.history();
+    expect(history.size() == 3, "the pinned row was shown twice");
+    expect(!history.empty() && history[0].pinned && history[0].storageId == textHash, "the pin did not lead the list");
+    expect(!hasStorageId(harness.clipboard, "cliphist-1"), "the history row folded into the pin is still listed");
+
+    // Pin the image too, then a pin added by another shell must land after ours.
+    expect(harness.clipboard.setEntryPinned(1, true, &newId), "pinning an image row failed");
+    harness.fixture.islandPin(bytesOf("from island"));
+    harness.clipboard.refreshShared();
+    const auto& pinned = harness.clipboard.history();
+    expect(
+        pinned.size() == 4,
+        "four entries were expected after three pins and one row, got " + std::to_string(pinned.size())
+    );
+    if (pinned.size() == 4) {
+      expect(pinned[0].pinned && pinned[1].pinned && pinned[2].pinned && !pinned[3].pinned, "pins must lead");
+      expect(pinned[1].isImage(), "the pinned image was not recognised");
+      expect(
+          pinned[2].storageId == SharedClipboardStore::sha256Hex(bytesOf("from island")),
+          "a pin added by another shell was not appended in manifest order"
+      );
+      expect(pinned[3].storageId == "cliphist-2", "the unpinned row is wrong");
+    }
+
+    // Unpin the first: its history row returns and its files go.
+    expect(harness.clipboard.setEntryPinned(0, false, &newId), "unpinning failed");
+    expect(newId == "cliphist-1", "unpinning did not report the history row it came back as");
+    expect(!fs::exists(payload), "the unpinned payload was left behind");
+    expect(
+        !Fixture::slurp(harness.fixture.favorites / "favorites.json").contains(textHash), "unpinned hash stayed listed"
+    );
+    expect(hasStorageId(harness.clipboard, "cliphist-1"), "the unpinned entry did not return to history");
+  }
