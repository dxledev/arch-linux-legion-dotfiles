+  void testSelectionTriggersRefresh() {
+    int offerId = 0;
+    Harness harness;
+    harness.fixture.addText(1, "before");
+    harness.clipboard.syncPersistence();
+    expect(harness.clipboard.history().size() == 1, "initial history not loaded");
+
+    ClipboardPollSource source(harness.clipboard);
+    expect(source.pollTimeoutMs() < 0, "poll source asked for a timed wake with nothing pending");
+
+    // The cliphist watcher stores the copy a moment after the selection changes.
+    simulateCopy(harness.clipboard, &offerId, "text/plain;charset=utf-8", bytesOf("after"));
+    harness.fixture.addText(2, "after");
+    expect(source.pollTimeoutMs() >= 0, "no refresh was scheduled after a new selection");
+    expect(harness.clipboard.history().size() == 1, "history refreshed before the delay elapsed");
+
+    std::this_thread::sleep_for(std::chrono::milliseconds(400));
+    expect(source.pollTimeoutMs() == 0, "the scheduled refresh did not become due");
+    std::vector<pollfd> fds;
+    source.dispatch(fds, 0);
+    expect(harness.clipboard.history().size() == 2, "the scheduled refresh did not pick up the new row");
+    expect(source.pollTimeoutMs() < 0, "poll source kept requesting wakes after refreshing");
+  }
