+  std::size_t countFiles(const fs::path& dir, std::string_view extension) {
+    std::size_t count = 0;
+    std::error_code ec;
+    for (const auto& entry : fs::directory_iterator(dir, ec)) {
+      if (entry.path().extension() == extension) {
+        ++count;
+      }
+    }
+    return count;
+  }
+
+  bool hasStorageId(const ClipboardService& clipboard, std::string_view storageId) {
+    return std::ranges::any_of(clipboard.history(), [storageId](const ClipboardEntry& e) {
+      return e.storageId == storageId;
+    });
+  }
