+      std::vector<std::uint8_t> data = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A, 0, 0, 0, 13,
+                                        'I',  'H', 'D', 'R', 0,    0,    0,    8,    0, 0, 0, 8};
+      data.resize(64, filler);
+      std::ofstream(db / (std::to_string(id) + ".png"), std::ios::binary)
+          .write(reinterpret_cast<const char*>(data.data()), static_cast<std::streamsize>(data.size()));
+    }
+
+    [[nodiscard]] bool hasRow(int id) const {
+      return fs::exists(db / std::to_string(id)) || fs::exists(db / (std::to_string(id) + ".png"));
+    }
+
+    // What Island does when a user stars an entry: the payload file first, then the manifest.
+    void islandPin(const std::vector<std::uint8_t>& payload) const {
+      const std::string hash = SharedClipboardStore::sha256Hex(payload);
+      fs::create_directories(favorites);
+      std::ofstream(favorites / (hash + ".payload"), std::ios::binary)
+          .write(reinterpret_cast<const char*>(payload.data()), static_cast<std::streamsize>(payload.size()));
+      std::vector<std::string> items;
+      if (fs::exists(favorites / "favorites.json")) {
+        const std::string existing = slurp(favorites / "favorites.json");
+        std::size_t pos = 0;
+        while ((pos = existing.find('"', pos)) != std::string::npos) {
+          const std::size_t end = existing.find('"', pos + 1);
+          const std::string token = existing.substr(pos + 1, end - pos - 1);
+          if (SharedClipboardStore::isValidHash(token)) {
+            items.push_back(token);
+          }
+          pos = end + 1;
+        }
+      }
+      items.push_back(hash);
+      std::ofstream manifest(favorites / "favorites.json");
+      manifest << "{\"items\":[";
+      for (std::size_t i = 0; i < items.size(); ++i) {
+        manifest << (i ? "," : "") << '"' << items[i] << '"';
+      }
+      manifest << "],\"version\":1}";
+    }
+
+    [[nodiscard]] SharedClipboardOptions options() const {
+      return {.cliphistPath = script.string(), .historyDatabasePath = {}, .favoritesDirectory = favorites.string()};
+    }
+
+    static std::string slurp(const fs::path& path) {
+      std::ifstream in(path, std::ios::binary);
+      std::stringstream buffer;
+      buffer << in.rdbuf();
+      return buffer.str();
+    }
+  };
