+bool ClipboardService::rowDuplicatesPin(const SharedHistoryRow& row, const PinSignature& pin) {
+  const std::optional<BinaryPreview> binary = parseBinaryPreview(row.preview);
+  if (pin.image) {
+    if (!binary.has_value() || binary->extension != pin.extension) {
+      return false;
+    }
+    if (pin.width > 0 && binary->width > 0 && (binary->width != pin.width || binary->height != pin.height)) {
+      return false;
+    }
+    // The list shows the size rounded to the nearest whole unit.
+    if (std::round(static_cast<double>(pin.size) / binary->unit) != binary->value) {
+      return false;
+    }
+  } else {
+    if (binary.has_value() || row.preview.empty()) {
+      return false;
+    }
+    std::string_view preview = row.preview;
+    const bool cut = preview.ends_with(kEllipsis);
+    if (cut) {
+      preview.remove_suffix(kEllipsis.size());
+    }
+    if (preview.empty() || !pin.normalizedText.starts_with(preview)) {
+      return false;
+    }
+    if (!cut && pin.normalizedText.size() != preview.size() && !pin.sampleTruncated) {
+      return false;
+    }
+  }
+  // The preview only nominates the row; the content hash is what makes it the same item.
+  return hashOfRow(row.id) == pin.hash;
