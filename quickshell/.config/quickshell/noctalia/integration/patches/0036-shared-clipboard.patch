+    expect(!harness.fixture.hasRow(2), "cliphist still holds the deleted row");
+
+    expect(harness.clipboard.removeHistoryEntry(0), "deleting a pin failed");
+    expect(harness.clipboard.history().empty(), "deleting a pin left its history twin visible");
+    expect(!harness.fixture.hasRow(1), "cliphist still holds the deleted pin's twin");
+    expect(countFiles(harness.fixture.favorites, ".payload") == 0, "the pin payload was not deleted");
+
+    harness.fixture.addText(3, "x");
