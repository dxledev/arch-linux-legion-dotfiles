@@ -0,0 +1,71 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Noctalia shares its clipboard history and pinned entries with the other shell
+// modes instead of keeping its own copy:
+//  - history is cliphist's database (filled by the `wl-paste --watch cliphist
+//    store` watchers that run in every shell mode);
+//  - pins are the favorites store used by Caelestia and Island:
+//    <dir>/favorites.json {"version":1,"items":[sha256...]} plus one
+//    <sha256>.payload file per pin, where the hash covers the raw payload bytes.
+struct SharedClipboardOptions {
+  std::string cliphistPath = "cliphist";
+  // Empty selects cliphist's own default database.
+  std::string historyDatabasePath;
+  std::string favoritesDirectory;
+
+  // NOCTALIA_CLIPHIST_BIN, NOCTALIA_CLIPHIST_DB and NOCTALIA_CLIPBOARD_FAVORITES_DIR override
+  // the defaults; the favorites directory otherwise is $XDG_DATA_HOME/caelestia/clipboard.
+  [[nodiscard]] static SharedClipboardOptions fromEnvironment();
+};
+
+struct SharedHistoryRow {
+  std::string id;
+  std::string preview;
+};
+
+class SharedClipboardStore {
+public:
+  explicit SharedClipboardStore(SharedClipboardOptions options = SharedClipboardOptions::fromEnvironment());
+
+  [[nodiscard]] const SharedClipboardOptions& options() const noexcept { return m_options; }
+
+  // Newest first. Returns false when cliphist could not be run.
+  [[nodiscard]] bool listHistory(std::vector<SharedHistoryRow>& rows) const;
+  [[nodiscard]] std::optional<std::vector<std::uint8_t>> decodeHistory(std::string_view id, std::size_t maxBytes) const;
+  [[nodiscard]] bool deleteHistory(const std::vector<std::string>& ids) const;
+  [[nodiscard]] bool wipeHistory() const;
+
+  // Pins in manifest order. Entries with an invalid hash or without a payload are skipped. Returns
+  // nullopt when the manifest exists but cannot be parsed, which also blocks writes so a damaged
+  // store is never overwritten.
+  [[nodiscard]] std::optional<std::vector<std::string>> favoriteHashes() const;
+  [[nodiscard]] std::string favoritePayloadPath(std::string_view hash) const;
+  // Reads at most maxBytes from the start of the payload; `size` receives the full file size.
+  [[nodiscard]] std::optional<std::vector<std::uint8_t>>
+  readFavorite(std::string_view hash, std::size_t maxBytes, std::size_t* size = nullptr) const;
+  [[nodiscard]] bool addFavorite(std::string_view hash, std::span<const std::uint8_t> payload) const;
+  [[nodiscard]] bool removeFavorite(std::string_view hash) const;
+  [[nodiscard]] bool clearFavorites() const;
+  // Pin order is the manifest order and new pins join at the end, as in Caelestia and Island.
+
+  [[nodiscard]] static std::string sha256Hex(std::span<const std::uint8_t> bytes);
+  [[nodiscard]] static bool isValidHash(std::string_view hash);
+
+private:
+  [[nodiscard]] std::vector<std::string> cliphistArguments(std::vector<std::string> command) const;
+  [[nodiscard]] std::string manifestPath() const;
+  [[nodiscard]] bool ensureDirectory() const;
+  // Parses the manifest into `items`; a missing manifest is an empty store.
+  [[nodiscard]] bool readManifest(std::vector<std::string>& items) const;
+  [[nodiscard]] bool writeManifest(const std::vector<std::string>& items) const;
+
+  SharedClipboardOptions m_options;
+};
