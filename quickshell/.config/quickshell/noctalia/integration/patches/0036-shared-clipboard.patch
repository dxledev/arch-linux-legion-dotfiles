index 000000000..8a0c7730e
--- /dev/null
+++ b/src/wayland/shared_clipboard_store.cpp
@@ -0,0 +1,352 @@
+#include "wayland/shared_clipboard_store.h"
+
+#include "config/atomic_file.h"
+#include "core/log.h"
+#include "core/process/process.h"
+#include "util/file_utils.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <fcntl.h>
+#include <filesystem>
+#include <fstream>
+#include <nlohmann/json.hpp>
+#include <sodium.h>
+#include <sys/file.h>
+#include <unistd.h>
+#include <unordered_set>
+
+namespace {
+
+  constexpr Logger kLog("clipboard");
+  constexpr auto kCommandTimeout = std::chrono::seconds(5);
+  constexpr std::size_t kListOutputLimit = 16U * 1024U * 1024U;
+  constexpr std::size_t kMaxManifestBytes = 4U * 1024U * 1024U;
+
+  [[nodiscard]] std::string envOr(const char* name, std::string fallback) {
+    const char* value = std::getenv(name);
+    return value != nullptr && value[0] != '\0' ? std::string(value) : std::move(fallback);
+  }
+
+  [[nodiscard]] bool isDecimalId(std::string_view id) {
+    return !id.empty() && id.size() <= 20 && std::ranges::all_of(id, [](char c) { return c >= '0' && c <= '9'; });
+  }
+
+  // Held while the manifest is read and rewritten so two Noctalia processes cannot interleave.
+  class DirectoryLock {
+  public:
+    explicit DirectoryLock(const std::filesystem::path& directory) {
+      m_fd = ::open((directory / ".lock").c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+      if (m_fd >= 0 && ::flock(m_fd, LOCK_EX) != 0) {
+        ::close(m_fd);
+        m_fd = -1;
+      }
+    }
+    ~DirectoryLock() {
+      if (m_fd >= 0) {
+        ::close(m_fd);
+      }
+    }
+    DirectoryLock(const DirectoryLock&) = delete;
+    DirectoryLock& operator=(const DirectoryLock&) = delete;
+    [[nodiscard]] bool held() const noexcept { return m_fd >= 0; }
+
+  private:
+    int m_fd = -1;
+  };
+
+} // namespace
+
+SharedClipboardOptions SharedClipboardOptions::fromEnvironment() {
+  SharedClipboardOptions options;
+  options.cliphistPath = envOr("NOCTALIA_CLIPHIST_BIN", "cliphist");
+  options.historyDatabasePath = envOr("NOCTALIA_CLIPHIST_DB", "");
+  std::string directory = envOr("NOCTALIA_CLIPBOARD_FAVORITES_DIR", "");
+  if (directory.empty()) {
+    const char* dataHome = std::getenv("XDG_DATA_HOME");
+    const char* home = std::getenv("HOME");
+    if (dataHome != nullptr && dataHome[0] != '\0') {
+      directory = std::string(dataHome) + "/caelestia/clipboard";
+    } else if (home != nullptr && home[0] != '\0') {
+      directory = std::string(home) + "/.local/share/caelestia/clipboard";
+    }
+  }
+  options.favoritesDirectory = std::move(directory);
+  return options;
+}
+
+SharedClipboardStore::SharedClipboardStore(SharedClipboardOptions options) : m_options(std::move(options)) {}
+
+std::vector<std::string> SharedClipboardStore::cliphistArguments(std::vector<std::string> command) const {
+  std::vector<std::string> args{m_options.cliphistPath};
+  if (!m_options.historyDatabasePath.empty()) {
+    args.emplace_back("-db-path");
+    args.push_back(m_options.historyDatabasePath);
+  }
+  args.insert(args.end(), std::make_move_iterator(command.begin()), std::make_move_iterator(command.end()));
+  return args;
+}
+
+bool SharedClipboardStore::listHistory(std::vector<SharedHistoryRow>& rows) const {
+  rows.clear();
+  const auto result =
+      process::runSyncWithTimeoutAndOutputLimit(cliphistArguments({"list"}), kCommandTimeout, kListOutputLimit);
+  if (!result || result.outTruncated) {
+    kLog.warn("cliphist list failed (exit={})", result.exitCode);
+    return false;
+  }
+
+  std::string_view output = result.out;
+  while (!output.empty()) {
+    const std::size_t end = output.find('\n');
+    const std::string_view line = output.substr(0, end);
+    output = end == std::string_view::npos ? std::string_view{} : output.substr(end + 1);
+    const std::size_t tab = line.find('\t');
+    if (tab == std::string_view::npos || !isDecimalId(line.substr(0, tab))) {
+      continue;
+    }
+    rows.push_back({.id = std::string(line.substr(0, tab)), .preview = std::string(line.substr(tab + 1))});
+  }
+  return true;
+}
+
+std::optional<std::vector<std::uint8_t>>
+SharedClipboardStore::decodeHistory(std::string_view id, std::size_t maxBytes) const {
+  if (!isDecimalId(id)) {
+    return std::nullopt;
+  }
+  // The payload is the clipboard content itself, so it must not be trimmed like display text.
+  const auto result = process::runSync(
+      cliphistArguments({"decode", std::string(id)}),
+      process::RunOptions{.timeout = kCommandTimeout, .maxOutputBytes = maxBytes, .preserveOutput = true}
+  );
+  if (!result || result.outTruncated || result.out.empty()) {
+    return std::nullopt;
+  }
+  return std::vector<std::uint8_t>(result.out.begin(), result.out.end());
+}
+
+bool SharedClipboardStore::deleteHistory(const std::vector<std::string>& ids) const {
+  if (ids.empty()) {
+    return true;
+  }
+  // `cliphist delete` reads the entries to remove from stdin, one per line. The script receives
+  // the executable, database path and ids as arguments so nothing is interpolated into the shell.
+  std::vector<std::string> args{
+      "/bin/sh",
+      "-c",
+      "bin=$1; db=$2; shift 2; if [ -n \"$db\" ]; then printf '%s\\n' \"$@\" | \"$bin\" -db-path \"$db\" delete;"
+      " else printf '%s\\n' \"$@\" | \"$bin\" delete; fi",
+      "sh",
+      m_options.cliphistPath,
+      m_options.historyDatabasePath,
+  };
+  for (const std::string& id : ids) {
+    if (!isDecimalId(id)) {
+      return false;
+    }
+    args.push_back(id);
+  }
+  const auto result = process::runSyncWithTimeout(args, kCommandTimeout);
+  if (!result) {
+    kLog.warn("cliphist delete failed (exit={})", result.exitCode);
+  }
+  return static_cast<bool>(result);
+}
+
+bool SharedClipboardStore::wipeHistory() const {
+  const auto result = process::runSyncWithTimeout(cliphistArguments({"wipe"}), kCommandTimeout);
+  if (!result) {
+    kLog.warn("cliphist wipe failed (exit={})", result.exitCode);
+  }
+  return static_cast<bool>(result);
+}
+
+bool SharedClipboardStore::isValidHash(std::string_view hash) {
+  return hash.size() == 64
+      && std::ranges::all_of(hash, [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+}
+
+std::string SharedClipboardStore::sha256Hex(std::span<const std::uint8_t> bytes) {
+  std::array<unsigned char, crypto_hash_sha256_BYTES> digest{};
+  crypto_hash_sha256(digest.data(), bytes.data(), bytes.size());
+  std::string hex(digest.size() * 2, '\0');
+  sodium_bin2hex(hex.data(), hex.size() + 1, digest.data(), digest.size());
+  return hex;
+}
+
+std::string SharedClipboardStore::manifestPath() const {
+  return (std::filesystem::path(m_options.favoritesDirectory) / "favorites.json").string();
+}
+
+std::string SharedClipboardStore::favoritePayloadPath(std::string_view hash) const {
+  return (std::filesystem::path(m_options.favoritesDirectory) / (std::string(hash) + ".payload")).string();
+}
+
+bool SharedClipboardStore::ensureDirectory() const {
+  if (m_options.favoritesDirectory.empty()) {
+    return false;
+  }
+  std::error_code ec;
+  if (!FileUtils::createPrivateDirectories(m_options.favoritesDirectory, ec)) {
+    kLog.warn("failed to create clipboard favorites directory {}: {}", m_options.favoritesDirectory, ec.message());
+    return false;
+  }
+  return true;
+}
+
+bool SharedClipboardStore::readManifest(std::vector<std::string>& items) const {
+  items.clear();
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  const fs::path path = manifestPath();
+  if (!fs::exists(path, ec)) {
+    return !ec;
+  }
+  const auto size = fs::file_size(path, ec);
+  if (ec || size > kMaxManifestBytes) {
+    return false;
+  }
+  std::ifstream file(path, std::ios::binary);
+  if (!file.is_open()) {
+    return false;
+  }
+  const nlohmann::json document = nlohmann::json::parse(file, nullptr, false);
+  if (!document.is_object()
+      || document.value("version", -1) != 1
+      || !document.contains("items")
+      || !document["items"].is_array()) {
+    return false;
+  }
+  std::unordered_set<std::string> seen;
+  for (const auto& item : document["items"]) {
+    // Caelestia treats a malformed or repeated hash as a damaged store, so keep that the rule here
+    // instead of silently repairing a file another shell is about to reject.
+    if (!item.is_string()
+        || !isValidHash(item.get_ref<const std::string&>())
+        || !seen.insert(item.get<std::string>()).second) {
+      return false;
+    }
+    items.push_back(item.get<std::string>());
+  }
+  return true;
+}
+
+bool SharedClipboardStore::writeManifest(const std::vector<std::string>& items) const {
+  nlohmann::json document = {{"version", 1}, {"items", items}};
+  return writeTextFileAtomic(manifestPath(), document.dump(4) + "\n", FileUtils::privateFileMode());
+}
+
+std::optional<std::vector<std::string>> SharedClipboardStore::favoriteHashes() const {
+  std::vector<std::string> items;
+  if (!readManifest(items)) {
+    return std::nullopt;
+  }
+  std::error_code ec;
+  std::erase_if(items, [&](const std::string& hash) {
+    return !std::filesystem::is_regular_file(favoritePayloadPath(hash), ec);
+  });
+  return items;
+}
+
+std::optional<std::vector<std::uint8_t>>
+SharedClipboardStore::readFavorite(std::string_view hash, std::size_t maxBytes, std::size_t* size) const {
+  if (!isValidHash(hash)) {
+    return std::nullopt;
+  }
+  std::ifstream file(favoritePayloadPath(hash), std::ios::binary | std::ios::ate);
+  if (!file.is_open()) {
+    return std::nullopt;
+  }
+  const auto fileSize = static_cast<std::size_t>(std::max<std::streamoff>(0, file.tellg()));
+  if (size != nullptr) {
+    *size = fileSize;
+  }
+  const std::size_t toRead = std::min(fileSize, maxBytes);
+  std::vector<std::uint8_t> bytes(toRead);
+  file.seekg(0);
+  if (toRead > 0 && !file.read(reinterpret_cast<char*>(bytes.data()), static_cast<std::streamsize>(toRead))) {
+    return std::nullopt;
+  }
+  return bytes;
+}
+
+bool SharedClipboardStore::addFavorite(std::string_view hash, std::span<const std::uint8_t> payload) const {
+  if (!isValidHash(hash) || payload.empty() || !ensureDirectory()) {
+    return false;
+  }
+  const DirectoryLock lock(m_options.favoritesDirectory);
+  if (!lock.held()) {
+    return false;
+  }
+  std::vector<std::string> items;
+  if (!readManifest(items)) {
+    kLog.warn("clipboard favorites manifest is damaged; not adding a pin");
+    return false;
+  }
+  if (std::ranges::find(items, hash) != items.end()) {
+    return true;
+  }
+  // The payload lands first so the manifest never names a file that is not there yet.
+  const std::string_view content(reinterpret_cast<const char*>(payload.data()), payload.size());
+  if (!writeTextFileAtomic(favoritePayloadPath(hash), content, FileUtils::privateFileMode())) {
+    return false;
+  }
+  items.emplace_back(hash);
+  return writeManifest(items);
+}
+
+bool SharedClipboardStore::removeFavorite(std::string_view hash) const {
+  if (!isValidHash(hash) || !ensureDirectory()) {
+    return false;
+  }
+  const DirectoryLock lock(m_options.favoritesDirectory);
+  if (!lock.held()) {
+    return false;
+  }
+  std::vector<std::string> items;
+  if (!readManifest(items)) {
+    kLog.warn("clipboard favorites manifest is damaged; not removing a pin");
+    return false;
+  }
+  const auto it = std::ranges::find(items, hash);
+  if (it == items.end()) {
+    return true;
+  }
+  items.erase(it);
+  if (!writeManifest(items)) {
+    return false;
+  }
+  // Removed after the manifest so no other shell is left holding a pin without a payload.
+  std::error_code ec;
+  std::filesystem::remove(favoritePayloadPath(hash), ec);
+  return true;
+}
+
+bool SharedClipboardStore::clearFavorites() const {
+  if (!ensureDirectory()) {
+    return false;
+  }
+  const DirectoryLock lock(m_options.favoritesDirectory);
+  if (!lock.held()) {
+    return false;
+  }
+  std::vector<std::string> items;
+  if (!readManifest(items)) {
+    kLog.warn("clipboard favorites manifest is damaged; not clearing pins");
+    return false;
+  }
+  if (!writeManifest({})) {
+    return false;
+  }
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  for (const auto& entry : fs::directory_iterator(m_options.favoritesDirectory, ec)) {
+    if (entry.is_regular_file(ec) && entry.path().extension() == ".payload") {
+      fs::remove(entry.path(), ec);
+    }
+  }
+  return true;
+}
