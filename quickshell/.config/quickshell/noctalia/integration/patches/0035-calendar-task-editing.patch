+    ok = expect(added.size() == 3 && added[1].type == "daily" && added[1].value == "daily", "daily value normalised") && ok;
+    ok = expect(added.size() == 3 && added[2].days.size() == 2, "weekly days stored") && ok;
+
+    ok = expect(!addTask(editPath, "   ", "daily", "daily", error) && !error.empty(), "blank text refused") && ok;
+    ok = expect(!addTask(editPath, "x", "weekly", "Monday", error), "bad weekday refused") && ok;
+    ok = expect(!addTask(editPath, "x", "date", "2026-02-30", error), "impossible date refused") && ok;
+    ok = expect(!addTask(editPath, "x", "monthly", "1", error), "unknown recurrence refused") && ok;
+    ok = expect(!addTask(editPath, std::string(501, 'a'), "daily", "daily", error), "overlong text refused") && ok;
+    ok = expect(readTaskRules(editPath).size() == 3, "refused adds leave the file alone") && ok;
+
+    ok = expect(!removeTask(editPath, "Gym", "not-the-time", error) && error == "task not found", "remove needs both fields") && ok;
+    ok = expect(removeTask(editPath, "Stretch", added[1].createdAt, error), "remove by task and created_at") && ok;
+    const auto remaining = readTaskRules(editPath);
+    ok = expect(remaining.size() == 2 && remaining[0].task == "Pay rent" && remaining[1].task == "Gym", "only the match is removed") && ok;
+
+    // Unknown fields and entries survive an edit; a non-list file is never written.
+    {
+      std::ofstream out(editPath);
+      out << R"([{"task":"Keep","recurrence_type":"daily","recurrence_value":"daily","created_at":"2020-01-01T00:00:00Z","note":"x"}])";
+    }
+    ok = expect(addTask(editPath, "New", "daily", "daily", error), "add to hand-written file") && ok;
+    {
+      std::ifstream in(editPath);
+      const std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+      ok = expect(text.find("\"note\": \"x\"") != std::string::npos, "unknown fields preserved") && ok;
+      ok = expect(text.find("\"task\": \"Keep\"") < text.find("\"task\": \"New\""), "list stays ordered by created_at") && ok;
+    }
+    {
+      std::ofstream out(editPath);
+      out << "{\"not\": \"a list\"}";
+    }
+    {
+      std::ofstream out(editPath);
+      out << R"([{"task":" Padded ","recurrence_type":"daily","recurrence_value":"daily","created_at":"2020-01-01T00:00:00Z"}])";
+    }
+    ok = expect(removeTask(editPath, "Padded", "2020-01-01T00:00:00Z", error), "remove matches the trimmed text the UI shows") && ok;
+    {
+      std::ofstream out(editPath);
+      out << "{\"not\": \"a list\"}";
+    }
+    ok = expect(!addTask(editPath, "x", "daily", "daily", error), "object file refused") && ok;
+    ok = expect(!removeTask(editPath, "x", "y", error), "object file refused on remove") && ok;
+    std::filesystem::remove_all(editPath.parent_path());
+  }
+
   return ok ? 0 : 1;
 }
