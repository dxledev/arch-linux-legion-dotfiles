+  bool addTask(
+      const std::filesystem::path& path, const std::string& text, const std::string& type, const std::string& value,
+      std::string& error
+  ) {
+    std::string task = text;
+    std::ranges::replace(task, '\n', ' ');
+    std::ranges::replace(task, '\r', ' ');
+    task = trimmed(task);
+    if (task.empty() || codepoints(task) > 500) {
+      error = "task text must be 1-500 characters";
+      return false;
+    }
+    std::string stored = value;
+    if (type == "daily") {
+      stored = "daily";
+    } else if (type == "weekly") {
+      if (!validWeeklyValue(value)) {
+        error = "weekly value must be comma separated Mon..Sun";
+        return false;
+      }
+    } else if (type == "date") {
+      if (!validDateValue(value)) {
+        error = "date value must be yyyy-mm-dd";
+        return false;
+      }
+    } else {
+      error = "unknown recurrence " + type;
+      return false;
+    }
+
+    nlohmann::ordered_json list;
+    if (!loadTaskList(path, list, error)) {
+      return false;
+    }
+    const std::time_t now = std::time(nullptr);
+    std::tm utc{};
+    gmtime_r(&now, &utc);
+    nlohmann::ordered_json entry = nlohmann::ordered_json::object();
+    entry["task"] = task;
+    entry["recurrence_type"] = type;
+    entry["recurrence_value"] = stored;
+    entry["created_at"] = std::format("{:04d}-{:02d}-{:02d}T{:02d}:{:02d}:{:02d}Z", utc.tm_year + 1900, utc.tm_mon + 1, utc.tm_mday, utc.tm_hour, utc.tm_min, utc.tm_sec);
+    list.push_back(std::move(entry));
+    const auto createdAt = [](const nlohmann::ordered_json& item) {
+      return item.is_object() && item.contains("created_at") && item["created_at"].is_string() ? item["created_at"].get<std::string>() : std::string{};
+    };
+    std::vector<nlohmann::ordered_json> items(list.begin(), list.end());
+    std::ranges::stable_sort(items, [&](const nlohmann::ordered_json& a, const nlohmann::ordered_json& b) {
+      return createdAt(a) < createdAt(b);
+    });
+    return writeTaskList(path, nlohmann::ordered_json(items), error);
+  }
+
+  bool removeTask(
+      const std::filesystem::path& path, const std::string& task, const std::string& createdAt, std::string& error
+  ) {
+    nlohmann::ordered_json list;
+    if (!loadTaskList(path, list, error)) {
+      return false;
+    }
+    for (auto it = list.begin(); it != list.end(); ++it) {
+      if (it->is_object() && trimmed(stringField(*it, "task")) == task && stringField(*it, "created_at") == createdAt) {
+        list.erase(it);
+        return writeTaskList(path, list, error);
+      }
+    }
+    error = "task not found";
+    return false;
+  }
