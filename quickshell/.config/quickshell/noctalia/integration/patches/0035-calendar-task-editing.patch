+
+void CalendarTab::addTask() {
+  if (m_calendar == nullptr || m_taskInput == nullptr || m_selectedDay < 0) {
+    return;
+  }
+  const std::string text = m_taskInput->value();
+  if (text.find_first_not_of(" \t\r\n") == std::string::npos) {
+    return;
+  }
+  const auto selected =
+      std::chrono::year{m_selectedYear} / std::chrono::month{static_cast<unsigned>(m_selectedMonth + 1)}
+      / std::chrono::day{static_cast<unsigned>(m_selectedDay)};
+  std::string type = "date";
+  std::string value = std::format(
+      "{:04d}-{:02d}-{:02d}", m_selectedYear, m_selectedMonth + 1, m_selectedDay
+  );
+  if (m_taskRecurrenceIndex == 1) {
+    type = "daily";
+    value = "daily";
+  } else if (m_taskRecurrenceIndex == 2) {
+    static constexpr const char* kWeekdays[] = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
+    type = "weekly";
+    value = kWeekdays[std::chrono::weekday{std::chrono::sys_days{selected}}.c_encoding()];
+  }
+  std::string error;
+  if (!m_calendar->addDashboardTask(text, type, value, error)) {
+    showTaskError(error);
+    return;
+  }
+  m_taskInput->setValue("");
+  showTaskError({});
+}
+
+void CalendarTab::removeTask(const CalendarEvent& event) {
+  if (m_calendar == nullptr) {
+    return;
+  }
+  if (event.id != m_pendingRemoveId) {
+    // Removing a task removes its whole rule for the dashboard too, so it takes a second press.
+    m_pendingRemoveId = event.id;
+    m_eventsDirty = true;
+    PanelManager::instance().refresh();
+    return;
+  }
+  m_pendingRemoveId.clear();
+  std::string error;
+  if (!m_calendar->removeDashboardTask(event.title, event.taskCreatedAt, error)) {
+    showTaskError(error);
+    m_eventsDirty = true;
+    return;
+  }
+  showTaskError({});
+}
