+#include "app/runtime_profile.h"
+
+#include <cstdlib>
+#include <string_view>
+
+namespace noctalia::runtime {
+
+  Profile profile() noexcept {
+    const char* value = std::getenv("NOCTALIA_PROFILE");
+    return value != nullptr && std::string_view(value) == "lock-provider" ? Profile::LockProvider : Profile::Full;
+  }
+
+  bool isLockProvider() noexcept { return profile() == Profile::LockProvider; }
+
+  bool startLocked() noexcept {
+    const char* value = std::getenv("NOCTALIA_START_LOCKED");
+    return value != nullptr
+        && std::string_view(value) != ""
+        && std::string_view(value) != "0"
+        && std::string_view(value) != "false";
+  }
+
+  std::string_view profileName() noexcept { return isLockProvider() ? "lock-provider" : "full"; }
+
+} // namespace noctalia::runtime
