@@ -0,0 +1,41 @@
+#pragma once
+
+#include "launcher/launcher_provider.h"
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+class CatalogProvider final : public LauncherProvider {
+public:
+  CatalogProvider();
+
+  [[nodiscard]] std::string_view defaultPrefix() const override { return ""; }
+  [[nodiscard]] bool allowCustomPrefix() const override { return false; }
+  [[nodiscard]] std::string_view id() const override { return "Applications"; }
+  [[nodiscard]] std::string displayName() const override { return "Applications"; }
+  [[nodiscard]] std::string_view defaultGlyphName() const override { return "app-window"; }
+  [[nodiscard]] bool trackUsage() const override { return false; }
+
+  void initialize() override;
+  [[nodiscard]] std::vector<LauncherResult> query(std::string_view text) const override;
+  bool activate(const LauncherResult& result) override;
+
+public:
+  struct Entry {
+    std::string launcher;
+    std::string name;
+    std::string icon;
+    std::string nameLower;
+    std::string launcherLower;
+  };
+
+private:
+  void refreshIfNeeded() const;
+
+  std::string m_command;
+  std::filesystem::path m_appList;
+  mutable std::filesystem::file_time_type m_appListMtime{};
+  mutable bool m_loaded = false;
+  mutable std::vector<Entry> m_entries;
+};
