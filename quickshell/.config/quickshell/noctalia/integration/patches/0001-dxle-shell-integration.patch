diff --git a/src/launcher/catalog_provider.cpp b/src/launcher/catalog_provider.cpp
new file mode 100644
index 000000000..0539a04f1
--- /dev/null
+++ b/src/launcher/catalog_provider.cpp
@@ -0,0 +1,156 @@
+#include "launcher/catalog_provider.h"
+
+#include "core/log.h"
+#include "core/process/process.h"
+#include "util/fuzzy_match.h"
+#include "util/string_utils.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <nlohmann/json.hpp>
+#include <ranges>
+
+namespace {
+
+  constexpr Logger kLog("catalog-provider");
+  constexpr std::size_t kMaxResults = 50;
+
+  std::string homePath(std::string_view suffix) {
+    const char* home = std::getenv("HOME");
+    return std::string(home != nullptr && home[0] != '\0' ? home : ".") + std::string(suffix);
+  }
+
+  std::filesystem::file_time_type appListMtime(const std::filesystem::path& path) {
+    std::error_code error;
+    const auto mtime = std::filesystem::last_write_time(path, error);
+    return error ? std::filesystem::file_time_type{} : mtime;
+  }
+
+  double entryScore(std::string_view pattern, const CatalogProvider::Entry& entry) {
+    if (pattern.empty()) {
+      return 0.0;
+    }
+    double score = FuzzyMatch::score(pattern, entry.nameLower) * 5.0;
+    score = std::max(score, FuzzyMatch::score(pattern, entry.launcherLower) * 1.5);
+    if (FuzzyMatch::isMatch(score) && entry.nameLower.starts_with(pattern)) {
+      score += 500.0;
+    }
+    return score;
+  }
+
+} // namespace
+
+CatalogProvider::CatalogProvider() : m_command(homePath("/bin/app-list")), m_appList(homePath("/.config/apps.list")) {}
+
+void CatalogProvider::initialize() { refreshIfNeeded(); }
+
+void CatalogProvider::refreshIfNeeded() const {
+  const auto mtime = appListMtime(m_appList);
+  if (m_loaded && mtime == m_appListMtime) {
+    return;
+  }
+
+  m_loaded = true;
+  m_appListMtime = mtime;
+  m_entries.clear();
+
+  const auto result = process::runSync({m_command, "--list"});
+  if (!result) {
+    kLog.warn("app-list adapter failed: {}", result.err);
+    return;
+  }
+
+  try {
+    const auto json = nlohmann::json::parse(result.out);
+    if (!json.is_array()) {
+      kLog.warn("app-list adapter returned a non-array catalog");
+      return;
+    }
+    for (const auto& value : json) {
+      if (!value.is_object()) {
+        continue;
+      }
+      Entry entry{
+          .launcher = value.value("launcher", ""),
+          .name = value.value("name", ""),
+          .icon = value.value("icon", ""),
+      };
+      if (entry.launcher.empty() || entry.name.empty()) {
+        continue;
+      }
+      entry.nameLower = StringUtils::toLower(entry.name);
+      entry.launcherLower = StringUtils::toLower(entry.launcher);
+      m_entries.push_back(std::move(entry));
+    }
+  } catch (const std::exception& error) {
+    kLog.warn("failed to parse app-list catalog: {}", error.what());
+    m_entries.clear();
+  }
+}
+
+std::vector<LauncherResult> CatalogProvider::query(std::string_view text) const {
+  refreshIfNeeded();
+  const std::string pattern = StringUtils::toLower(text);
+
+  if (pattern.empty()) {
+    std::vector<LauncherResult> results;
+    results.reserve(m_entries.size());
+    for (const auto& entry : m_entries) {
+      LauncherResult result;
+      result.id = entry.launcher;
+      result.title = entry.name;
+      if (entry.icon.starts_with('/')) {
+        result.iconPath = entry.icon;
+      } else {
+        result.iconName = entry.icon;
+      }
+      result.score = 0.0;
+      results.push_back(std::move(result));
+    }
+    return results;
+  }
+
+  struct Scored {
+    double score;
+    const Entry* entry;
+  };
+  std::vector<Scored> scored;
+  for (const auto& entry : m_entries) {
+    const double score = entryScore(pattern, entry);
+    if (FuzzyMatch::isMatch(score)) {
+      scored.push_back({score, &entry});
+    }
+  }
+  const std::size_t limit = std::min(scored.size(), kMaxResults);
+  std::partial_sort(
+      scored.begin(), scored.begin() + static_cast<std::ptrdiff_t>(limit), scored.end(),
+      [](const Scored& lhs, const Scored& rhs) { return lhs.score > rhs.score; }
+  );
+
+  std::vector<LauncherResult> results;
+  results.reserve(limit);
+  for (std::size_t i = 0; i < limit; ++i) {
+    const Entry& entry = *scored[i].entry;
+    LauncherResult result;
+    result.id = entry.launcher;
+    result.title = entry.name;
+    if (entry.icon.starts_with('/')) {
+      result.iconPath = entry.icon;
+    } else {
+      result.iconName = entry.icon;
+    }
+    result.score = scored[i].score;
+    results.push_back(std::move(result));
+  }
+  return results;
+}
+
+bool CatalogProvider::activate(const LauncherResult& result) {
+  refreshIfNeeded();
+  const auto found = std::ranges::find_if(m_entries, [&](const Entry& entry) { return entry.launcher == result.id; });
+  if (found == m_entries.end()) {
+    return false;
+  }
+  return process::runAsync({m_command, "--launch", found->launcher});
+}
