+  void boxBlurRgba(std::vector<std::uint8_t>& pixels, int width, int height, int radius) {
+    if (width <= 0 || height <= 0 || radius <= 0) {
+      return;
+    }
+
+    std::vector<std::uint8_t> blurred(pixels.size());
+    for (int y = 0; y < height; ++y) {
+      const int top = std::max(0, y - radius);
+      const int bottom = std::min(height - 1, y + radius);
+      for (int x = 0; x < width; ++x) {
+        const int left = std::max(0, x - radius);
+        const int right = std::min(width - 1, x + radius);
+        const int sampleCount = (right - left + 1) * (bottom - top + 1);
+        std::uint32_t sums[4]{};
+        for (int sampleY = top; sampleY <= bottom; ++sampleY) {
+          for (int sampleX = left; sampleX <= right; ++sampleX) {
+            const std::size_t offset =
+                (static_cast<std::size_t>(sampleY) * static_cast<std::size_t>(width) + static_cast<std::size_t>(sampleX))
+                * 4U;
+            for (std::size_t channel = 0; channel < 4U; ++channel) {
+              sums[channel] += pixels[offset + channel];
+            }
+          }
+        }
+        const std::size_t outputOffset =
+            (static_cast<std::size_t>(y) * static_cast<std::size_t>(width) + static_cast<std::size_t>(x)) * 4U;
+        for (std::size_t channel = 0; channel < 4U; ++channel) {
+          blurred[outputOffset + channel] = static_cast<std::uint8_t>(sums[channel] / sampleCount);
+        }
+      }
+    }
+    pixels.swap(blurred);
+  }
