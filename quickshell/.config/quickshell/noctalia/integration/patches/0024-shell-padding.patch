diff --git a/src/shell/screen_geometry.h b/src/shell/screen_geometry.h
new file mode 100644
index 000000000..cd75de3eb
--- /dev/null
+++ b/src/shell/screen_geometry.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include "config/config_types.h"
+
+#include <algorithm>
+#include <cstdint>
+
+namespace shell::screen_geometry {
+
+  inline constexpr std::int32_t kMinPadding = 1;
+  inline constexpr std::int32_t kMaxPadding = 16;
+
+  struct Rect {
+    std::int32_t x = 0;
+    std::int32_t y = 0;
+    std::int32_t width = 0;
+    std::int32_t height = 0;
+
+    bool operator==(const Rect&) const = default;
+  };
+
+  [[nodiscard]] inline std::int32_t clampPadding(std::int32_t padding) noexcept {
+    return std::clamp(padding, kMinPadding, kMaxPadding);
+  }
+
+  [[nodiscard]] inline std::int32_t effectivePadding(std::int32_t padding) noexcept {
+    return padding > 0 ? clampPadding(padding) : 0;
+  }
+
+  [[nodiscard]] inline std::int32_t padding(const ShellConfig::ScreenCornersConfig& config) noexcept {
+    return config.paddingEnabled ? clampPadding(config.paddingSize) : 0;
+  }
+
+  [[nodiscard]] inline Rect usableBounds(std::int32_t width, std::int32_t height, std::int32_t padding) noexcept {
+    const auto inset = effectivePadding(padding);
+    return Rect{
+        .x = inset,
+        .y = inset,
+        .width = std::max(0, width - inset * 2),
+        .height = std::max(0, height - inset * 2),
+    };
+  }
+
+  [[nodiscard]] inline Rect
+  usableBounds(std::int32_t width, std::int32_t height, const ShellConfig::ScreenCornersConfig& config) noexcept {
+    const auto inset = padding(config);
+    if (inset == 0) {
+      return Rect{.width = std::max(0, width), .height = std::max(0, height)};
+    }
+    return usableBounds(width, height, inset);
+  }
+
+  [[nodiscard]] inline std::int32_t
+  exclusiveZone(bool reserveSpace, std::int32_t componentZone, std::int32_t padding) noexcept {
+    return reserveSpace ? std::max(0, componentZone) + effectivePadding(padding) : 0;
+  }
+
+  [[nodiscard]] inline std::int32_t autoHideLayerMargin(std::int32_t padding) noexcept {
+    return -effectivePadding(padding);
+  }
+
+} // namespace shell::screen_geometry
