diff --git a/tests/screen_padding_geometry_test.cpp b/tests/screen_padding_geometry_test.cpp
new file mode 100644
index 000000000..2358bf87d
--- /dev/null
+++ b/tests/screen_padding_geometry_test.cpp
@@ -0,0 +1,235 @@
+#include "config/config_types.h"
+#include "shell/bar/bar_reserved_zone.h"
+#include "shell/dock/dock_geometry.h"
+#include "shell/screen_geometry.h"
+#include "tests/test_check.h"
+#include "wayland/surface.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string_view>
+
+namespace {
+
+  constexpr std::int32_t kPadding = 10;
+  constexpr std::size_t kItemCount = 4;
+
+  constexpr std::array<DockEdge, 4> kDockEdges = {
+      DockEdge::Top,
+      DockEdge::Right,
+      DockEdge::Bottom,
+      DockEdge::Left,
+  };
+  constexpr std::array<std::string_view, 4> kBarPositions = {"top", "right", "bottom", "left"};
+
+  std::int32_t dockEdgeMargin(const shell::dock::DockSurfaceGeometry& geometry, DockEdge edge) {
+    switch (edge) {
+    case DockEdge::Top:
+      return geometry.marginTop;
+    case DockEdge::Right:
+      return geometry.marginRight;
+    case DockEdge::Bottom:
+      return geometry.marginBottom;
+    case DockEdge::Left:
+      return geometry.marginLeft;
+    }
+    return 0;
+  }
+
+  DockConfig dockFor(DockEdge edge, bool reserveSpace, bool autoHide, std::int32_t margin) {
+    DockConfig config;
+    config.position = edge;
+    config.reserveSpace = reserveSpace;
+    config.autoHide = autoHide;
+    config.marginEdge = margin;
+    config.shadow = false;
+    config.concaveEdgeCorners = false;
+    config.magnification = false;
+    config.showInstanceCount = false;
+    return config;
+  }
+
+  shell::dock::DockSurfaceGeometry dockGeometry(const DockConfig& config, std::int32_t padding) {
+    return shell::dock::computeSurfaceGeometry(config, ShellConfig::ShadowConfig{}, kItemCount, false, padding);
+  }
+
+  void checkSharedScreenGeometry() {
+    using namespace shell::screen_geometry;
+    TEST_CHECK(clampPadding(-8) == 1);
+    TEST_CHECK(clampPadding(10) == 10);
+    TEST_CHECK(clampPadding(80) == 16);
+
+    ShellConfig::ScreenCornersConfig config;
+    TEST_CHECK(padding(config) == 0);
+    TEST_CHECK((usableBounds(1920, 1080, config) == Rect{.width = 1920, .height = 1080}));
+
+    config.paddingEnabled = true;
+    TEST_CHECK(padding(config) == 10);
+    TEST_CHECK((usableBounds(1920, 1080, config) == Rect{.x = 10, .y = 10, .width = 1900, .height = 1060}));
+    config.paddingSize = -8;
+    TEST_CHECK(padding(config) == 1);
+    config.paddingSize = 80;
+    TEST_CHECK(padding(config) == 16);
+
+    TEST_CHECK(exclusiveZone(true, 36, kPadding) == 46);
+    TEST_CHECK(exclusiveZone(true, 36, 999) == 52);
+    TEST_CHECK(exclusiveZone(false, 36, kPadding) == 0);
+    TEST_CHECK(autoHideLayerMargin(kPadding) == -kPadding);
+    TEST_CHECK(autoHideLayerMargin(999) == -16);
+  }
+
+  void checkBarReservations() {
+    const ShellConfig::ShadowConfig shadow;
+    for (std::size_t i = 0; i < kBarPositions.size(); ++i) {
+      BarConfig bar;
+      bar.position = std::string(kBarPositions[i]);
+      bar.thickness = 32;
+      bar.marginEdge = 0;
+      bar.reserveSpace = true;
+      bar.shadow = false;
+      TEST_CHECK(reservedBarExclusiveZone(bar, shadow) == bar.thickness);
+      TEST_CHECK(reservedBarEdgeDistance(bar, shadow, kPadding) == kPadding + bar.thickness);
+
+      bar.marginEdge = 7;
+      TEST_CHECK(reservedBarExclusiveZone(bar, shadow) == bar.thickness);
+      TEST_CHECK(reservedBarEdgeDistance(bar, shadow, kPadding) == kPadding + 7 + bar.thickness);
+
+      bar.autoHide = true;
+      TEST_CHECK(reservedBarExclusiveZone(bar, shadow) == bar.thickness + 7);
+      TEST_CHECK(reservedBarEdgeDistance(bar, shadow, kPadding) == kPadding + 7 + bar.thickness);
+
+      bar.autoHide = false;
+      bar.shadow = true;
+      ShellConfig::ShadowConfig directionalShadow;
+      directionalShadow.direction = ShadowDirection::UpLeft;
+      const auto bleed = shell::surface_shadow::bleed(true, directionalShadow);
+      const auto edgeBleed = bar.position == "top" ? bleed.up
+          : bar.position == "right"                ? bleed.right
+          : bar.position == "bottom"               ? bleed.down
+                                                   : bleed.left;
+      const auto expectedZone = bar.thickness + std::min(bar.marginEdge, edgeBleed);
+      TEST_CHECK(reservedBarExclusiveZone(bar, directionalShadow) == expectedZone);
+      TEST_CHECK(
+          reservedBarEdgeDistance(bar, directionalShadow, kPadding) == kPadding + bar.thickness + bar.marginEdge
+      );
+      TEST_CHECK(reservedBarEdgeDistance(bar, directionalShadow, 999) == 16 + bar.thickness + bar.marginEdge);
+
+      bar.reserveSpace = false;
+      TEST_CHECK(reservedBarExclusiveZone(bar, directionalShadow) == 0);
+      bar.reserveSpace = true;
+    }
+  }
+
+  void checkDockEdgesAndReservations() {
+    for (const DockEdge edge : kDockEdges) {
+      for (const bool reserveSpace : {false, true}) {
+        const DockConfig attached = dockFor(edge, reserveSpace, false, 0);
+        const auto geometry = dockGeometry(attached, kPadding);
+        TEST_CHECK(dockEdgeMargin(geometry, edge) == 0);
+        TEST_CHECK(geometry.exclusiveZone == (reserveSpace ? shell::dock::dockThickness(attached) : 0));
+        const auto fractionalGeometry =
+            shell::dock::computeSurfaceGeometry(attached, ShellConfig::ShadowConfig{}, kItemCount, true, kPadding);
+        TEST_CHECK(dockEdgeMargin(fractionalGeometry, edge) == -1);
+        TEST_CHECK(fractionalGeometry.exclusiveZone == geometry.exclusiveZone);
+
+        DockConfig floating = dockFor(edge, reserveSpace, false, 7);
+        const auto floatingGeometry = dockGeometry(floating, kPadding);
+        TEST_CHECK(dockEdgeMargin(floatingGeometry, edge) == 7);
+        TEST_CHECK(floatingGeometry.exclusiveZone == geometry.exclusiveZone);
+
+        DockConfig autoHide = dockFor(edge, reserveSpace, true, 7);
+        const auto autoHideGeometry = dockGeometry(autoHide, kPadding);
+        TEST_CHECK(dockEdgeMargin(autoHideGeometry, edge) == -kPadding);
+        TEST_CHECK(autoHideGeometry.exclusiveZone == (reserveSpace ? shell::dock::dockThickness(autoHide) : 0));
+        const auto panel = shell::dock::computePanelGeometry(
+            autoHide, ShellConfig::ShadowConfig{}, static_cast<float>(autoHideGeometry.surfaceW),
+            static_cast<float>(autoHideGeometry.surfaceH), kPadding
+        );
+        if (edge == DockEdge::Top) {
+          TEST_CHECK(panel.panelY == kPadding + autoHide.marginEdge);
+        } else if (edge == DockEdge::Right) {
+          TEST_CHECK(
+              static_cast<float>(autoHideGeometry.surfaceW) - panel.panelX - panel.panelW
+              == kPadding + autoHide.marginEdge
+          );
+        } else if (edge == DockEdge::Bottom) {
+          TEST_CHECK(
+              static_cast<float>(autoHideGeometry.surfaceH) - panel.panelY - panel.panelH
+              == kPadding + autoHide.marginEdge
+          );
+        } else {
+          TEST_CHECK(panel.panelX == kPadding + autoHide.marginEdge);
+        }
+
+        const auto hiddenRegion = shell::dock::computeInputRegion(
+            autoHide, panel, static_cast<int>(autoHideGeometry.surfaceW), static_cast<int>(autoHideGeometry.surfaceH),
+            true, false
+        );
+        TEST_CHECK(hiddenRegion.size() == 1);
+        if (edge == DockEdge::Top) {
+          TEST_CHECK(hiddenRegion[0].y == 0);
+        } else if (edge == DockEdge::Right) {
+          TEST_CHECK(hiddenRegion[0].x + hiddenRegion[0].width == static_cast<int>(autoHideGeometry.surfaceW));
+        } else if (edge == DockEdge::Bottom) {
+          TEST_CHECK(hiddenRegion[0].y + hiddenRegion[0].height == static_cast<int>(autoHideGeometry.surfaceH));
+        } else {
+          TEST_CHECK(hiddenRegion[0].x == 0);
+        }
+
+        DockConfig oversizedPadding = dockFor(edge, reserveSpace, true, 0);
+        const auto cappedGeometry =
+            shell::dock::computeSurfaceGeometry(oversizedPadding, ShellConfig::ShadowConfig{}, kItemCount, false, 999);
+        TEST_CHECK(dockEdgeMargin(cappedGeometry, edge) == -16);
+        const auto cappedPanel = shell::dock::computePanelGeometry(
+            oversizedPadding, ShellConfig::ShadowConfig{}, static_cast<float>(cappedGeometry.surfaceW),
+            static_cast<float>(cappedGeometry.surfaceH), 999
+        );
+        if (edge == DockEdge::Top) {
+          TEST_CHECK(cappedPanel.panelY == 16);
+        } else if (edge == DockEdge::Right) {
+          TEST_CHECK(static_cast<float>(cappedGeometry.surfaceW) - cappedPanel.panelX - cappedPanel.panelW == 16);
+        } else if (edge == DockEdge::Bottom) {
+          TEST_CHECK(static_cast<float>(cappedGeometry.surfaceH) - cappedPanel.panelY - cappedPanel.panelH == 16);
+        } else {
+          TEST_CHECK(cappedPanel.panelX == 16);
+        }
+      }
+    }
+  }
+
+  void checkDockShadowsAndConcavity() {
+    for (const DockEdge edge : kDockEdges) {
+      DockConfig plain = dockFor(edge, true, false, 0);
+      DockConfig concave = plain;
+      concave.concaveEdgeCorners = true;
+      concave.radiusTopLeft = 22;
+      concave.radiusTopRight = 22;
+      concave.radiusBottomLeft = 22;
+      concave.radiusBottomRight = 22;
+      const auto plainGeometry = dockGeometry(plain, kPadding);
+      const auto concaveGeometry = dockGeometry(concave, kPadding);
+      TEST_CHECK(
+          concaveGeometry.surfaceW > plainGeometry.surfaceW || concaveGeometry.surfaceH > plainGeometry.surfaceH
+      );
+
+      DockConfig shadowed = plain;
+      shadowed.shadow = true;
+      ShellConfig::ShadowConfig shadow;
+      shadow.direction = ShadowDirection::UpLeft;
+      const auto shadowGeometry = shell::dock::computeSurfaceGeometry(shadowed, shadow, kItemCount, false, kPadding);
+      TEST_CHECK(shadowGeometry.surfaceW > plainGeometry.surfaceW);
+      TEST_CHECK(shadowGeometry.surfaceH > plainGeometry.surfaceH);
+      TEST_CHECK(shadowGeometry.exclusiveZone == plainGeometry.exclusiveZone);
+    }
+  }
+
+} // namespace
+
+int main() {
+  checkSharedScreenGeometry();
+  checkBarReservations();
+  checkDockEdgesAndReservations();
+  checkDockShadowsAndConcavity();
+  return 0;
+}
