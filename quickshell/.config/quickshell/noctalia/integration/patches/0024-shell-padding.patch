diff --git a/src/shell/shell_padding.cpp b/src/shell/shell_padding.cpp
new file mode 100644
index 000000000..deb4c9a9b
--- /dev/null
+++ b/src/shell/shell_padding.cpp
@@ -0,0 +1,277 @@
+#include "shell/shell_padding.h"
+
+#include "config/config_service.h"
+#include "core/ui_phase.h"
+#include "render/scene/node.h"
+#include "shell/screen_geometry.h"
+#include "ui/controls/box.h"
+#include "ui/palette.h"
+#include "wayland/wayland_connection.h"
+
+#include <algorithm>
+#include <ranges>
+
+namespace {
+
+  constexpr std::uint32_t kReservationAnchors[4] = {
+      LayerShellAnchor::Top,
+      LayerShellAnchor::Right,
+      LayerShellAnchor::Bottom,
+      LayerShellAnchor::Left,
+  };
+
+  constexpr std::uint32_t kStripAnchors[4] = {
+      LayerShellAnchor::Top | LayerShellAnchor::Left | LayerShellAnchor::Right,
+      LayerShellAnchor::Top | LayerShellAnchor::Bottom | LayerShellAnchor::Right,
+      LayerShellAnchor::Bottom | LayerShellAnchor::Left | LayerShellAnchor::Right,
+      LayerShellAnchor::Top | LayerShellAnchor::Bottom | LayerShellAnchor::Left,
+  };
+
+  bool outputEligible(const WaylandOutput& output) noexcept {
+    return output.done && output.output != nullptr && output.hasUsableGeometry();
+  }
+
+  std::unique_ptr<Box> makeBox(std::uint32_t width, std::uint32_t height, bool visible) {
+    auto box = std::make_unique<Box>();
+    box->setFill(visible ? ColorSpec{.role = ColorRole::Surface, .alpha = 1.0F} : clearColorSpec());
+    box->setSize(
+        static_cast<float>(std::max<std::uint32_t>(1, width)), static_cast<float>(std::max<std::uint32_t>(1, height))
+    );
+    return box;
+  }
+
+} // namespace
+
+void ShellPadding::initialize(WaylandConnection& wayland, ConfigService* config, RenderContext* renderContext) {
+  m_wayland = &wayland;
+  m_config = config;
+  m_renderContext = renderContext;
+  m_paletteConn = paletteChanged().connect([this]() { updatePalette(); });
+  if (m_config != nullptr) {
+    m_visualPadding = currentPadding();
+    m_lastShadow = m_config->config().shell.shadow;
+    m_config->addReloadCallback(
+        [this]() {
+          if (m_config != nullptr && m_config->lastChange().shell) {
+            onReservationsOutputChange();
+          }
+        },
+        "shell-padding-reservations"
+    );
+  }
+}
+
+std::int32_t ShellPadding::currentPadding() const noexcept {
+  if (m_config == nullptr) {
+    return 0;
+  }
+  return shell::screen_geometry::padding(m_config->config().shell.screenCorners);
+}
+
+void ShellPadding::reconcileOutputs() {
+  if (m_wayland == nullptr || m_config == nullptr || m_renderContext == nullptr) {
+    return;
+  }
+
+  const auto& outputs = m_wayland->outputs();
+  std::erase_if(m_instances, [&outputs](const auto& instance) {
+    return std::ranges::none_of(outputs, [&instance](const WaylandOutput& output) {
+      return output.output == instance->output && outputEligible(output);
+    });
+  });
+
+  for (const auto& output : outputs) {
+    if (!outputEligible(output)) {
+      continue;
+    }
+    auto found = std::ranges::find(m_instances, output.output, [](const auto& instance) { return instance->output; });
+    if (found == m_instances.end()) {
+      auto instance = std::make_unique<OutputInstance>();
+      instance->output = output.output;
+      instance->scale = output.scale;
+      instance->scaleNumerator = output.configuredScaleNumerator;
+      m_instances.push_back(std::move(instance));
+      continue;
+    }
+
+    auto& instance = **found;
+    if (instance.scale != output.scale || instance.scaleNumerator != output.configuredScaleNumerator) {
+      destroyReservations(instance);
+      destroyStrips(instance);
+      instance.scale = output.scale;
+      instance.scaleNumerator = output.configuredScaleNumerator;
+    }
+  }
+}
+
+void ShellPadding::onReservationsOutputChange() {
+  reconcileOutputs();
+  const auto padding = currentPadding();
+  for (auto& instance : m_instances) {
+    if (padding == 0) {
+      destroyReservations(*instance);
+    } else {
+      ensureReservations(*instance, padding);
+    }
+  }
+}
+
+void ShellPadding::onVisualsOutputChange() {
+  reconcileOutputs();
+  const auto padding = currentPadding();
+  for (auto& instance : m_instances) {
+    destroyStrips(*instance);
+    if (padding > 0) {
+      ensureStrips(*instance, padding);
+    }
+  }
+  m_visualPadding = padding;
+  if (m_config != nullptr) {
+    m_lastShadow = m_config->config().shell.shadow;
+  }
+}
+
+void ShellPadding::onVisualsConfigReload() {
+  if (m_config == nullptr) {
+    return;
+  }
+  const auto padding = currentPadding();
+  const auto& change = m_config->lastChange();
+  const auto& shadow = m_config->config().shell.shadow;
+  const bool stackingMayHaveChanged = change.bars
+      || change.widgets
+      || change.dock
+      || change.plugins
+      || padding != m_visualPadding
+      || shadow != m_lastShadow;
+  for (auto& instance : m_instances) {
+    if (padding == 0) {
+      destroyStrips(*instance);
+    } else {
+      if (stackingMayHaveChanged) {
+        destroyStrips(*instance);
+      }
+      ensureStrips(*instance, padding);
+    }
+  }
+  m_visualPadding = padding;
+  m_lastShadow = shadow;
+}
+
+void ShellPadding::shutdown() {
+  m_paletteConn.disconnect();
+  m_instances.clear();
+  m_visualPadding = 0;
+}
+
+void ShellPadding::ensureReservations(OutputInstance& instance, std::int32_t padding) {
+  for (std::size_t edge = 0; edge < instance.reservations.size(); ++edge) {
+    if (instance.reservations[edge] == nullptr) {
+      createReservation(instance, edge, padding);
+    } else {
+      instance.reservations[edge]->setExclusiveZone(padding);
+    }
+  }
+}
+
+void ShellPadding::destroyReservations(OutputInstance& instance) {
+  instance.reservations = {};
+  instance.reservationRoots = {};
+}
+
+void ShellPadding::ensureStrips(OutputInstance& instance, std::int32_t padding) {
+  for (std::size_t edge = 0; edge < instance.strips.size(); ++edge) {
+    if (instance.strips[edge].surface == nullptr) {
+      createStrip(instance, edge, padding);
+    }
+  }
+}
+
+void ShellPadding::destroyStrips(OutputInstance& instance) { instance.strips = {}; }
+
+void ShellPadding::createReservation(OutputInstance& instance, std::size_t edge, std::int32_t padding) {
+  LayerSurfaceConfig config{
+      .nameSpace = "noctalia-shell-padding-reservation",
+      .layer = LayerShellLayer::Background,
+      .anchor = kReservationAnchors[edge],
+      .width = 1,
+      .height = 1,
+      .exclusiveZone = padding,
+      .keyboard = LayerShellKeyboard::None,
+      .defaultWidth = 1,
+      .defaultHeight = 1,
+  };
+  auto surface = std::make_unique<LayerSurface>(*m_wayland, std::move(config));
+  surface->setRenderContext(m_renderContext);
+  auto* surfacePtr = surface.get();
+  auto* root = &instance.reservationRoots[edge];
+  surface->setConfigureCallback([surfacePtr](std::uint32_t, std::uint32_t) { surfacePtr->requestLayout(); });
+  surface->setPrepareFrameCallback([surfacePtr, root](bool, bool) {
+    auto& target = surfacePtr->renderTarget();
+    if (*root == nullptr) {
+      UiPhaseScope layoutPhase(UiPhase::Layout);
+      *root = makeBox(target.logicalWidth(), target.logicalHeight(), false);
+      surfacePtr->setSceneRoot(root->get());
+    }
+  });
+  if (!surface->initialize(instance.output)) {
+    return;
+  }
+  surface->setInputRegion({});
+  instance.reservations[edge] = std::move(surface);
+}
+
+void ShellPadding::createStrip(OutputInstance& instance, std::size_t edge, std::int32_t padding) {
+  const bool horizontal = edge == 0 || edge == 2;
+  const auto* output = m_wayland->findOutputByWl(instance.output);
+  if (output == nullptr) {
+    return;
+  }
+  LayerSurfaceConfig config{
+      .nameSpace = "noctalia-shell-padding",
+      .layer = LayerShellLayer::Top,
+      .anchor = kStripAnchors[edge],
+      .width = horizontal ? 0U : static_cast<std::uint32_t>(padding),
+      .height = horizontal ? static_cast<std::uint32_t>(padding) : 0U,
+      .exclusiveZone = -1,
+      .marginTop = edge == 1 || edge == 3 ? padding : 0,
+      .marginBottom = edge == 1 || edge == 3 ? padding : 0,
+      .keyboard = LayerShellKeyboard::None,
+      .defaultWidth = static_cast<std::uint32_t>(std::max(1, output->effectiveLogicalWidth())),
+      .defaultHeight = static_cast<std::uint32_t>(std::max(1, output->effectiveLogicalHeight())),
+  };
+  auto surface = std::make_unique<LayerSurface>(*m_wayland, std::move(config));
+  surface->setRenderContext(m_renderContext);
+  auto* strip = &instance.strips[edge];
+  strip->surface = std::move(surface);
+  strip->surface->setConfigureCallback([strip](std::uint32_t, std::uint32_t) { strip->surface->requestLayout(); });
+  strip->surface->setPrepareFrameCallback([this, strip, edge, padding](bool, bool) {
+    auto& target = strip->surface->renderTarget();
+    const std::uint32_t width =
+        target.logicalWidth() == 0 ? (edge == 1 || edge == 3 ? padding : 1U) : target.logicalWidth();
+    const std::uint32_t height =
+        target.logicalHeight() == 0 ? (edge == 0 || edge == 2 ? padding : 1U) : target.logicalHeight();
+    if (strip->sceneRoot == nullptr || strip->builtWidth != width || strip->builtHeight != height) {
+      UiPhaseScope layoutPhase(UiPhase::Layout);
+      strip->sceneRoot = makeBox(width, height, true);
+      strip->builtWidth = width;
+      strip->builtHeight = height;
+      strip->surface->setSceneRoot(strip->sceneRoot.get());
+    }
+  });
+  if (!strip->surface->initialize(instance.output)) {
+    strip->surface.reset();
+    return;
+  }
+  strip->surface->setInputRegion({});
+}
+
+void ShellPadding::updatePalette() {
+  for (auto& instance : m_instances) {
+    for (auto& strip : instance->strips) {
+      if (strip.surface != nullptr) {
+        strip.surface->requestRedraw();
+      }
+    }
+  }
+}
diff --git a/src/shell/shell_padding.h b/src/shell/shell_padding.h
new file mode 100644
index 000000000..5516c9d1e
--- /dev/null
+++ b/src/shell/shell_padding.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include "config/config_types.h"
+#include "ui/signal.h"
+#include "wayland/layer_surface.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+class ConfigService;
+class RenderContext;
+class WaylandConnection;
+
+class ShellPadding {
+public:
+  ShellPadding() = default;
+  ~ShellPadding() = default;
+
+  ShellPadding(const ShellPadding&) = delete;
+  ShellPadding& operator=(const ShellPadding&) = delete;
+
+  void initialize(WaylandConnection& wayland, ConfigService* config, RenderContext* renderContext);
+  void onReservationsOutputChange();
+  void onVisualsOutputChange();
+  void onVisualsConfigReload();
+  void shutdown();
+
+private:
+  struct Strip {
+    std::unique_ptr<Node> sceneRoot;
+    std::unique_ptr<LayerSurface> surface;
+    std::uint32_t builtWidth = 0;
+    std::uint32_t builtHeight = 0;
+  };
+
+  struct OutputInstance {
+    wl_output* output = nullptr;
+    std::int32_t scale = 0;
+    std::int32_t scaleNumerator = 0;
+    std::array<std::unique_ptr<Node>, 4> reservationRoots;
+    std::array<std::unique_ptr<LayerSurface>, 4> reservations;
+    std::array<Strip, 4> strips;
+  };
+
+  [[nodiscard]] std::int32_t currentPadding() const noexcept;
+  void reconcileOutputs();
+  void ensureReservations(OutputInstance& instance, std::int32_t padding);
+  void destroyReservations(OutputInstance& instance);
+  void ensureStrips(OutputInstance& instance, std::int32_t padding);
+  void destroyStrips(OutputInstance& instance);
+  void createReservation(OutputInstance& instance, std::size_t edge, std::int32_t padding);
+  void createStrip(OutputInstance& instance, std::size_t edge, std::int32_t padding);
+  void updatePalette();
+
+  WaylandConnection* m_wayland = nullptr;
+  ConfigService* m_config = nullptr;
+  RenderContext* m_renderContext = nullptr;
+  std::int32_t m_visualPadding = 0;
+  ShellConfig::ShadowConfig m_lastShadow;
+  std::vector<std::unique_ptr<OutputInstance>> m_instances;
+  Signal<>::ScopedConnection m_paletteConn;
+};
