+void WallpaperTile::updateCurrentGlowStyle() {
+  if (m_currentGlow == nullptr) {
+    return;
+  }
+
+  const float glowSpread = 4.0F * m_contentScale;
+  const float frameRadius = Style::scaledRadiusLg(m_contentScale);
+  m_currentGlow->setStyle(RoundedRectStyle{
+      .fill = resolveColorSpec(colorSpecFromRole(ColorRole::Secondary, 0.18F)),
+      .border = clearColor(),
+      .fillMode = FillMode::Solid,
+      .radius = frameRadius + glowSpread,
+      .softness = 3.0F * m_contentScale,
+      .outerShadow = true,
+      .shadowExclusion = true,
+      .shadowExclusionOffsetX = -glowSpread,
+      .shadowExclusionOffsetY = -glowSpread,
+      .shadowExclusionWidth = m_thumbFrameWidth,
+      .shadowExclusionHeight = m_thumbFrameHeight,
+      .shadowExclusionRadius = frameRadius,
+  });
+}
