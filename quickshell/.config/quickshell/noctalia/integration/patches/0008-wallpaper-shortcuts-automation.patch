+bool ConfigService::setWallpaperAutomation(
+    bool enabled, std::int32_t intervalSeconds, WallpaperAutomationConfig::Order order
+) {
+  if (m_overridesPath.empty() || intervalSeconds <= 0) {
+    return false;
+  }
+
+  auto* wallpaperTbl = ensureTable(m_overridesTable, "wallpaper");
+  auto* automationTbl = ensureTable(*wallpaperTbl, "automation");
+  automationTbl->insert_or_assign("enabled", enabled);
+  automationTbl->insert_or_assign("interval_seconds", intervalSeconds);
+  automationTbl->insert_or_assign("order", std::string(enumToKey(kWallpaperAutomationOrders, order)));
+
+  if (!writeOverridesToFile()) {
+    kLog.warn("failed to write {}", m_overridesPath);
+    return false;
+  }
+
+  m_ownOverridesWritePending = true;
+  loadAll();
+  fireReloadCallbacks();
+  return true;
+}
