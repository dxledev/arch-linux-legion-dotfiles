+  [[nodiscard]] std::optional<std::filesystem::path> resolveRegularImage(const std::filesystem::path& path) {
+    std::error_code ec;
+    const auto resolved = std::filesystem::canonical(FileUtils::expandUserPath(path.string()), ec);
+    if (ec || !std::filesystem::is_regular_file(resolved, ec) || ec) {
+      return std::nullopt;
+    }
+    return resolved;
+  }
+
+  [[nodiscard]] bool wallpaperPathReferences(std::string_view path, const std::filesystem::path& resolvedTarget) {
+    if (path.empty() || path.starts_with("color:")) {
+      return false;
+    }
+    const auto resolved = resolveRegularImage(std::filesystem::path(path));
+    return resolved.has_value() && *resolved == resolvedTarget;
+  }
+
+  struct ThemeWallpaperLink {
+    std::filesystem::path path;
+    std::filesystem::path target;
+  };
+
+  [[nodiscard]] bool collectMatchingWallpaperLink(
+      const std::filesystem::path& linkPath, const std::filesystem::path& resolvedTarget,
+      std::vector<ThemeWallpaperLink>& links, std::string& error
+  ) {
+    std::error_code ec;
+    const auto status = std::filesystem::symlink_status(linkPath, ec);
+    if (ec == std::errc::no_such_file_or_directory || ec == std::errc::not_a_directory) {
+      return true;
+    }
+    if (ec) {
+      error = ec.message();
+      return false;
+    }
+    if (status.type() == std::filesystem::file_type::not_found) {
+      return true;
+    }
+    if (!std::filesystem::is_symlink(status)) {
+      return true;
+    }
+
+    const auto resolved = resolveRegularImage(linkPath);
+    if (!resolved.has_value() || *resolved != resolvedTarget) {
+      return true;
+    }
+    auto target = std::filesystem::read_symlink(linkPath, ec);
+    if (ec) {
+      error = ec.message();
+      return false;
+    }
+    links.push_back({.path = linkPath, .target = std::move(target)});
+    return true;
+  }
+
+  [[nodiscard]] bool collectSavedWallpaperLinks(
+      const std::filesystem::path& themesRoot, const std::filesystem::path& resolvedTarget,
+      std::vector<ThemeWallpaperLink>& links, std::string& error
+  ) {
+    std::error_code ec;
+    const bool themesExist = std::filesystem::exists(themesRoot, ec);
+    if (ec) {
+      error = ec.message();
+      return false;
+    }
+    if (themesExist) {
+      if (!std::filesystem::is_directory(themesRoot, ec) || ec) {
+        error = ec ? ec.message() : "theme config path is not a directory";
+        return false;
+      }
+
+      std::filesystem::directory_iterator it(themesRoot, ec);
+      if (ec) {
+        error = ec.message();
+        return false;
+      }
+      for (const std::filesystem::directory_iterator end; it != end; it.increment(ec)) {
+        if (ec) {
+          error = ec.message();
+          return false;
+        }
+        std::error_code dirEc;
+        const auto dirStatus = it->symlink_status(dirEc);
+        if (dirEc) {
+          error = dirEc.message();
+          return false;
+        }
+        if (!std::filesystem::is_directory(dirStatus) || it->path().filename().string().starts_with('.')) {
+          continue;
+        }
+
+        const auto linkPath = it->path() / "wallpaper.png";
+        if (!collectMatchingWallpaperLink(linkPath, resolvedTarget, links, error)) {
+          return false;
+        }
+      }
+    }
+
+    const std::string stateDir = FileUtils::stateDir();
+    return stateDir.empty()
+        || collectMatchingWallpaperLink(
+            std::filesystem::path(stateDir) / "dynamic-wallpaper", resolvedTarget, links, error
+        );
+  }
+
+  [[nodiscard]] bool atomicallySetSymlink(
+      const std::filesystem::path& linkPath, const std::filesystem::path& target, std::filesystem::path* previousTarget,
+      std::string& error
+  ) {
+    std::error_code ec;
+    if (previousTarget != nullptr) {
+      const auto status = std::filesystem::symlink_status(linkPath, ec);
+      if (ec || !std::filesystem::is_symlink(status)) {
+        error = ec ? ec.message() : "saved wallpaper link changed";
+        return false;
+      }
+      *previousTarget = std::filesystem::read_symlink(linkPath, ec);
+      if (ec) {
+        error = ec.message();
+        return false;
+      }
+    }
+
+    static std::atomic<std::uint64_t> sequence{0};
+    for (int attempt = 0; attempt < 8; ++attempt) {
+      auto temporaryLink = linkPath;
+      temporaryLink += ".noctalia-delete." + std::to_string(sequence.fetch_add(1));
+      std::filesystem::create_symlink(target, temporaryLink, ec);
+      if (ec == std::errc::file_exists) {
+        ec.clear();
+        continue;
+      }
+      if (ec) {
+        error = ec.message();
+        return false;
+      }
+      std::filesystem::rename(temporaryLink, linkPath, ec);
+      if (!ec) {
+        return true;
+      }
+      std::error_code cleanupEc;
+      std::filesystem::remove(temporaryLink, cleanupEc);
+      error = ec.message();
+      return false;
+    }
+    error = "could not allocate a temporary wallpaper link";
+    return false;
+  }
+
+  [[nodiscard]] std::string trashFailureDetail(const process::RunResult& result) {
+    std::string detail = result.err.empty() ? result.out : result.err;
+    for (char& value : detail) {
+      const auto ch = static_cast<unsigned char>(value);
+      if (ch < 0x20U || ch == 0x7fU) {
+        value = ' ';
+      }
+    }
+    const auto first = detail.find_first_not_of(' ');
+    if (first == std::string::npos) {
+      detail =
+          result.timedOut ? "trash-put timed out" : "trash-put exited with status " + std::to_string(result.exitCode);
+    } else {
+      detail.erase(0, first);
+      const auto last = detail.find_last_not_of(' ');
+      detail.resize(last + 1);
+      if (detail.size() > 512) {
+        detail.resize(512);
+      }
+    }
+    return detail;
+  }
+
+  struct WallpaperPathChange {
+    std::optional<std::string> connector;
+    std::string previousPath;
+  };
+
+  class WallpaperDeleteTransaction {
+  public:
+    WallpaperDeleteTransaction(
+        ConfigService& config, std::filesystem::path target, std::filesystem::path replacement,
+        std::filesystem::path replacementOriginal
+    )
+        : m_config(config), m_target(std::move(target)), m_replacement(std::move(replacement)),
+          m_replacementOriginal(std::move(replacementOriginal)) {}
+
+    ~WallpaperDeleteTransaction() {
+      if (m_changesApplied && !restore()) {
+        kLog.warn("failed to restore wallpaper state after an incomplete delete transaction");
+      }
+    }
+
+    [[nodiscard]] bool prepare(std::string& error) {
+      const std::string defaultPath = m_config.getDefaultWallpaperPath();
+      if (wallpaperPathReferences(defaultPath, m_target)) {
+        m_wallpaperChanges.push_back({.connector = std::nullopt, .previousPath = defaultPath});
+      }
+      for (const auto& [connector, path] : m_config.monitorWallpaperPaths()) {
+        if (wallpaperPathReferences(path, m_target)) {
+          m_wallpaperChanges.push_back({.connector = connector, .previousPath = path});
+        }
+      }
+      m_previousLast = m_config.getLastWallpaperPath();
+      m_updateLast = wallpaperPathReferences(m_previousLast, m_target);
+
+      const auto themesRoot = FileUtils::expandXdgBaseDir("$XDG_CONFIG_HOME/themes");
+      if (!collectSavedWallpaperLinks(themesRoot, m_target, m_themeLinks, error)) {
+        return false;
+      }
+      for (const auto& favorite : m_config.wallpaperFavorites()) {
+        if (wallpaperPathReferences(favorite.path, m_target)) {
+          m_matchingFavorites.push_back(favorite.path);
+        }
+      }
+      return true;
+    }
+
+    [[nodiscard]] bool apply(std::string& error) {
+      m_changesApplied = true;
+      for (const auto& link : m_themeLinks) {
+        const auto currentTarget = resolveRegularImage(link.path);
+        if (!currentTarget.has_value() || *currentTarget != m_target) {
+          error = "a saved theme wallpaper link changed";
+          return restoreWithError(error);
+        }
+        std::filesystem::path oldTarget;
+        if (!atomicallySetSymlink(link.path, m_replacementOriginal, &oldTarget, error)) {
+          return restoreWithError(error);
+        }
+        m_changedThemeLinks.push_back({.path = link.path, .target = std::move(oldTarget)});
+      }
+
+      if (!applyWallpaperSettings(error) || !replacementSettingsMatch(error)) {
+        return restoreWithError(error);
+      }
+      return true;
+    }
+
+    [[nodiscard]] bool trash(std::string& error) {
+      const process::RunResult result =
+          process::runSync(std::vector<std::string>{"/usr/bin/trash-put", "--", m_target.string()});
+      if (!result) {
+        error = trashFailureDetail(result);
+        return restoreWithError(error);
+      }
+      for (const auto& favoritePath : m_matchingFavorites) {
+        m_config.removeWallpaperFavorite(favoritePath);
+      }
+      m_committed = true;
+      m_changesApplied = false;
+      return true;
+    }
+
+  private:
+    [[nodiscard]] bool applyWallpaperSettings(std::string& error) {
+      ConfigService::WallpaperBatch batch(m_config);
+      const std::string replacement = m_replacement.string();
+      for (const auto& change : m_wallpaperChanges) {
+        if (!m_config.setWallpaperPath(change.connector, replacement, false, false)) {
+          error = "could not save the replacement wallpaper settings";
+          return false;
+        }
+      }
+      if (m_updateLast && !m_config.setLastWallpaperPath(replacement)) {
+        error = "could not save the replacement wallpaper history";
+        return false;
+      }
+      return true;
+    }
+
+    [[nodiscard]] bool replacementSettingsMatch(std::string& error) const {
+      const std::string replacement = m_replacement.string();
+      for (const auto& change : m_wallpaperChanges) {
+        if (change.connector.has_value()) {
+          const auto it = m_config.monitorWallpaperPaths().find(*change.connector);
+          if (it == m_config.monitorWallpaperPaths().end() || it->second != replacement) {
+            error = "the replacement wallpaper was not applied to a monitor";
+            return false;
+          }
+        } else if (m_config.getDefaultWallpaperPath() != replacement) {
+          error = "the replacement wallpaper was not applied as the default";
+          return false;
+        }
+      }
+      return true;
+    }
+
+    [[nodiscard]] bool restoreWithError(std::string& error) {
+      if (!restore()) {
+        error += "; some previous wallpaper settings could not be restored";
+      }
+      return false;
+    }
+
+    [[nodiscard]] bool restore() {
+      if (!m_changesApplied || m_committed) {
+        return true;
+      }
+      bool restored = true;
+      for (auto it = m_changedThemeLinks.rbegin(); it != m_changedThemeLinks.rend(); ++it) {
+        const auto currentTarget = resolveRegularImage(it->path);
+        if (currentTarget.has_value() && *currentTarget == m_target) {
+          continue;
+        }
+        if (!currentTarget.has_value() || *currentTarget != m_replacementOriginal) {
+          restored = false;
+          continue;
+        }
+        std::string restoreError;
+        if (!atomicallySetSymlink(it->path, it->target, nullptr, restoreError)) {
+          restored = false;
+          kLog.warn("failed to restore saved wallpaper link {}: {}", it->path.string(), restoreError);
+        }
+      }
+      {
+        ConfigService::WallpaperBatch batch(m_config);
+        for (auto it = m_wallpaperChanges.rbegin(); it != m_wallpaperChanges.rend(); ++it) {
+          restored = m_config.setWallpaperPath(it->connector, it->previousPath, false, false) && restored;
+        }
+      }
+      if (m_updateLast) {
+        restored = m_config.setLastWallpaperPath(m_previousLast) && restored;
+      }
+      if (restored) {
+        m_changesApplied = false;
+      }
+      return restored;
+    }
+
+    ConfigService& m_config;
+    std::filesystem::path m_target;
+    std::filesystem::path m_replacement;
+    std::filesystem::path m_replacementOriginal;
+    std::string m_previousLast;
+    bool m_updateLast = false;
+    bool m_changesApplied = false;
+    bool m_committed = false;
+    std::vector<WallpaperPathChange> m_wallpaperChanges;
+    std::vector<ThemeWallpaperLink> m_themeLinks;
+    std::vector<ThemeWallpaperLink> m_changedThemeLinks;
+    std::vector<std::string> m_matchingFavorites;
+  };
+
 } // namespace
 
