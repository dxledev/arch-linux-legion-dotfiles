+  if (m_deleteConfirmError != nullptr) {
+    m_deleteConfirmError->setText("");
+    m_deleteConfirmError->setVisible(false);
+    m_deleteConfirmError->setParticipatesInLayout(false);
+  }
+  if (m_deleteConfirmPanel != nullptr) {
