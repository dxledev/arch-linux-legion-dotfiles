+void WallpaperPanel::performConfirmedDelete() {
+  if (m_config == nullptr || m_pendingDeleteOriginalPath.empty()) {
+    return;
+  }
+  if (!hasVisibleSelection()
+      || m_selectedVisibleIndex != m_pendingDeleteVisibleIndex
+      || selectedWallpaperPath() != m_pendingDeleteSelectedPath) {
+    cancelDeleteConfirmation();
+    PanelManager::instance().refresh();
+    return;
+  }
+
+  const auto target = resolveRegularImage(m_pendingDeleteSelectedPath);
+  if (!target.has_value() || *target != m_pendingDeleteOriginalPath) {
+    setDeleteConfirmationError("the selected file changed after confirmation");
+    return;
+  }
+
+  const std::size_t selectedIndex = m_pendingDeleteVisibleIndex;
+  std::optional<std::filesystem::path> replacementPath;
+  std::optional<std::filesystem::path> replacementOriginalPath;
+  for (std::size_t offset = 1; offset <= m_visibleEntries.size(); ++offset) {
+    const std::size_t candidateIndex = (selectedIndex + offset) % m_visibleEntries.size();
+    const auto& entry = m_visibleEntries[candidateIndex];
+    if (entry.isDir) {
+      continue;
+    }
+    const auto candidate = resolveRegularImage(entry.absPath);
+    if (!candidate.has_value() || *candidate == m_pendingDeleteOriginalPath) {
+      continue;
+    }
+    replacementPath = entry.absPath;
+    replacementOriginalPath = *candidate;
+    break;
+  }
+  if (!replacementPath.has_value()) {
+    const auto bundledWallpaper = paths::assetPath("noctalia-wallpaper.png");
+    const auto bundledOriginal = resolveRegularImage(bundledWallpaper);
+    if (bundledOriginal.has_value() && *bundledOriginal != m_pendingDeleteOriginalPath) {
+      replacementPath = bundledWallpaper;
+      replacementOriginalPath = *bundledOriginal;
+    }
+  }
+  if (!replacementPath.has_value() || !replacementOriginalPath.has_value()) {
+    setDeleteConfirmationError("no usable replacement wallpaper is available");
+    return;
+  }
+
+  WallpaperDeleteTransaction transaction(
+      *m_config, m_pendingDeleteOriginalPath, *replacementPath, *replacementOriginalPath
+  );
+  std::string error;
+  if (!transaction.prepare(error) || !transaction.apply(error) || !transaction.trash(error)) {
+    setDeleteConfirmationError(error);
+    return;
+  }
+
+  m_pendingDeleteReselectIndex = selectedIndex;
+  m_pendingDeleteNeedsFreshScan = m_scanner != nullptr;
+  cancelDeleteConfirmation();
+  resetSelection();
+  if (m_scanner != nullptr) {
+    m_scanner->invalidate();
+  }
+  refreshVisibleEntries();
+  rebindGrid();
+  if (!m_scanPending) {
+    m_pendingDeleteNeedsFreshScan = false;
+    restoreSelectionAfterDeleteScan();
+  }
+  syncBrowseChrome();
+  m_dirty = true;
+  PanelManager::instance().refresh();
+}
