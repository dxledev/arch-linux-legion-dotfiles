diff --git a/src/notification/shared_notification_history.cpp b/src/notification/shared_notification_history.cpp
new file mode 100644
index 000000000..a80e5fc6c
--- /dev/null
+++ b/src/notification/shared_notification_history.cpp
@@ -0,0 +1,178 @@
+#include "notification/shared_notification_history.h"
+
+#include "core/log.h"
+#include "core/process/process.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <format>
+#include <nlohmann/json.hpp>
+#include <unistd.h>
+
+namespace shared_notification_history {
+
+  namespace {
+    constexpr Logger kLog("notification");
+    constexpr auto kDuplicateWindow = std::chrono::seconds(2);
+
+    std::string environment(const char* key, std::string fallback) {
+      const char* value = std::getenv(key);
+      return value && *value ? std::string(value) : std::move(fallback);
+    }
+
+    std::optional<std::string> scriptPath() {
+      const auto home = environment("HOME", "");
+      const auto path = environment(
+          "NOCTALIA_NOTIFICATION_HISTORY",
+          environment("XDG_CONFIG_HOME", home + "/.config") + "/quickshell/shared/notifications/history"
+      );
+      if (!std::filesystem::path(path).is_absolute() || ::access(path.c_str(), X_OK) != 0) {
+        return std::nullopt;
+      }
+      return path;
+    }
+
+    void run(std::vector<std::string> args) {
+      const auto script = scriptPath();
+      if (!script) {
+        return;
+      }
+      args.insert(args.begin(), *script);
+      if (!process::runAsync(args)) {
+        kLog.warn("could not update shared notification history");
+      }
+    }
+
+    std::string isoTime(WallTimePoint time) {
+      return std::format("{:%FT%TZ}", std::chrono::floor<std::chrono::milliseconds>(time));
+    }
+
+    WallTimePoint receivedAt(const Notification& notification) {
+      return notification.receivedWallClock.value_or(WallClock::now());
+    }
+
+    // Plain text comparison: tags removed, common entities decoded, whitespace collapsed.
+    std::string plain(std::string_view text) {
+      std::string stripped;
+      bool inTag = false;
+      for (const char c : text) {
+        if (c == '<') {
+          inTag = true;
+        } else if (c == '>' && inTag) {
+          inTag = false;
+        } else if (!inTag) {
+          stripped += c;
+        }
+      }
+      constexpr std::pair<std::string_view, char> kEntities[] = {
+          {"&amp;", '&'}, {"&lt;", '<'}, {"&gt;", '>'}, {"&quot;", '"'}, {"&apos;", '\''}, {"&#39;", '\''},
+          {"&nbsp;", ' '},
+      };
+      std::string decoded;
+      for (std::size_t i = 0; i < stripped.size();) {
+        bool replaced = false;
+        if (stripped[i] == '&') {
+          for (const auto& [entity, character] : kEntities) {
+            if (std::string_view(stripped).substr(i, entity.size()) == entity) {
+              decoded += character;
+              i += entity.size();
+              replaced = true;
+              break;
+            }
+          }
+        }
+        if (!replaced) {
+          decoded += stripped[i++];
+        }
+      }
+      std::string result;
+      bool space = false;
+      for (const char c : decoded) {
+        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+          space = !result.empty();
+        } else {
+          if (space) {
+            result += ' ';
+          }
+          space = false;
+          result += c;
+        }
+      }
+      return result;
+    }
+
+    std::string text(const nlohmann::json& object, const char* key) {
+      const auto it = object.find(key);
+      return it != object.end() && it->is_string() ? it->get<std::string>() : std::string();
+    }
+  } // namespace
+
+  std::optional<std::vector<Record>> list(std::size_t limit) {
+    const auto script = scriptPath();
+    if (!script) {
+      return std::nullopt;
+    }
+    const auto result = process::runSyncWithTimeout(
+        std::vector<std::string>{*script, "list", "--limit", std::to_string(limit)}, std::chrono::seconds(3)
+    );
+    if (!result) {
+      kLog.warn("could not read shared notification history");
+      return std::nullopt;
+    }
+    const auto data = nlohmann::json::parse(result.out, nullptr, false);
+    if (!data.is_array()) {
+      return std::nullopt;
+    }
+    std::vector<Record> records;
+    for (const auto& item : data) {
+      if (!item.is_object() || !item.contains("epochMs") || !item["epochMs"].is_number_integer()) {
+        continue;
+      }
+      Record record{
+          .time = WallTimePoint(std::chrono::milliseconds(item["epochMs"].get<std::int64_t>())),
+          .app = text(item, "app"),
+          .summary = text(item, "summary"),
+          .body = text(item, "body"),
+          .icon = text(item, "icon"),
+          .image = text(item, "image"),
+      };
+      if (const auto urgency = item.find("urgency"); urgency != item.end() && urgency->is_number_integer()) {
+        record.urgency = static_cast<Urgency>(std::clamp(urgency->get<int>(), 0, 2));
+      }
+      records.push_back(std::move(record));
+    }
+    return records;
+  }
+
+  void append(const Notification& notification) {
+    nlohmann::json record{
+        {"time", isoTime(receivedAt(notification))},
+        {"app", notification.appName},
+        {"summary", notification.summary},
+        {"body", notification.body},
+        {"icon", notification.icon.value_or("")},
+        {"urgency", static_cast<int>(notification.urgency)},
+    };
+    run({"append", record.dump()});
+  }
+
+  void remove(const Notification& notification) {
+    nlohmann::json match{
+        {"time", isoTime(receivedAt(notification))},
+        {"summary", notification.summary},
+        {"body", notification.body},
+    };
+    run({"remove", match.dump()});
+  }
+
+  void clear() { run({"clear"}); }
+
+  bool matches(const Notification& notification, const Record& record) {
+    const auto difference = receivedAt(notification) - record.time;
+    return std::chrono::abs(difference) <= kDuplicateWindow && plain(notification.summary) == plain(record.summary)
+        && plain(notification.body) == plain(record.body);
+  }
+
+} // namespace shared_notification_history
diff --git a/src/notification/shared_notification_history.h b/src/notification/shared_notification_history.h
new file mode 100644
index 000000000..7b0f47ce0
--- /dev/null
+++ b/src/notification/shared_notification_history.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include "notification/notification.h"
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <vector>
+
+// Notification history shared with Caelestia, Island and Waybar through
+// ~/.config/quickshell/shared/notifications/history (see its README).
+namespace shared_notification_history {
+
+  struct Record {
+    WallTimePoint time;
+    std::string app;
+    std::string summary;
+    std::string body;
+    std::string icon;
+    std::string image;
+    Urgency urgency = Urgency::Normal;
+  };
+
+  // Newest records first; nullopt when the shared store cannot be read.
+  [[nodiscard]] std::optional<std::vector<Record>> list(std::size_t limit);
+  void append(const Notification& notification);
+  void remove(const Notification& notification);
+  void clear();
+  [[nodiscard]] bool matches(const Notification& notification, const Record& record);
+
+} // namespace shared_notification_history
diff --git a/tests/notification_shared_history_test.cpp b/tests/notification_shared_history_test.cpp
new file mode 100644
index 000000000..1b8ca5413
--- /dev/null
+++ b/tests/notification_shared_history_test.cpp
@@ -0,0 +1,121 @@
+#include "notification/notification_history_store.h"
+#include "notification/notification_manager.h"
+#include "tests/test_check.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <unistd.h>
+
+namespace {
+
+  namespace fs = std::filesystem;
+
+  std::string readFile(const fs::path& path) {
+    std::ifstream input(path);
+    return {std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>()};
+  }
+
+  // Waits for the asynchronous script call that contains `needle`.
+  bool waitForCall(const fs::path& log, const std::string& needle) {
+    for (int attempt = 0; attempt < 200; ++attempt) {
+      if (readFile(log).find(needle) != std::string::npos) {
+        return true;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    return false;
+  }
+
+  NotificationHistoryEntry nativeEntry(uint32_t id, std::string summary, WallTimePoint received) {
+    return NotificationHistoryEntry{
+        .notification =
+            Notification{
+                .id = id,
+                .origin = NotificationOrigin::External,
+                .appName = "native",
+                .summary = std::move(summary),
+                .body = "body",
+                .timeout = 0,
+                .urgency = Urgency::Normal,
+                .receivedTime = Clock::now(),
+                .receivedWallClock = received,
+            },
+        .active = false,
+        .seen = false,
+        .closeReason = CloseReason::Expired,
+    };
+  }
+
+} // namespace
+
+int main() {
+  const fs::path root = fs::temp_directory_path() / ("noctalia-shared-history-" + std::to_string(::getpid()));
+  fs::remove_all(root);
+  fs::create_directories(root / "noctalia");
+  const fs::path script = root / "history";
+  const fs::path calls = root / "calls.log";
+  {
+    std::ofstream output(script);
+    output << "#!/bin/sh\n"
+           << "if [ \"$1\" = list ]; then cat '" << (root / "list.json").string() << "'; exit; fi\n"
+           << "printf '%s\\n' \"$*\" >> '" << calls.string() << "'\n";
+  }
+  fs::permissions(script, fs::perms::owner_all);
+  ::setenv("NOCTALIA_STATE_HOME", root.c_str(), 1);
+  ::setenv("NOCTALIA_NOTIFICATION_HISTORY", script.c_str(), 1);
+
+  using std::chrono::milliseconds;
+  const WallTimePoint kept{milliseconds(1'790'000'000'000)};
+  const WallTimePoint removed{milliseconds(1'790'000'100'000)};
+  std::deque<NotificationHistoryEntry> native{nativeEntry(7, "kept", kept), nativeEntry(8, "removed", removed)};
+  TEST_CHECK(saveNotificationHistoryToFile(root / "noctalia" / "notification_history.json", native, 9, 2));
+
+  // Another shell removed "removed", added "other", and the wrapper saved "kept" half a second later.
+  {
+    std::ofstream output(root / "list.json");
+    output << R"([{"epochMs":1790000200000,"app":"Island","summary":"other","body":"<b>shared</b>","icon":"bell","urgency":2},)"
+           << R"({"epochMs":1790000000500,"app":"notify-send","summary":"kept","body":"body","icon":""}])";
+  }
+
+  NotificationManager manager;
+  manager.loadPersistedHistory();
+  const auto& history = manager.history();
+  TEST_CHECK(history.size() == 2);
+  TEST_CHECK(history.front().notification.id == 7);
+  TEST_CHECK(history.front().notification.appName == "native");
+  TEST_CHECK(!history.front().seen);
+  const auto& other = history.back().notification;
+  TEST_CHECK(other.summary == "other");
+  TEST_CHECK(other.body == "<b>shared</b>");
+  TEST_CHECK(other.icon == std::optional<std::string>("bell"));
+  TEST_CHECK(other.urgency == Urgency::Critical);
+  TEST_CHECK(other.id >= 9);
+  TEST_CHECK(history.back().seen);
+  TEST_CHECK(!history.back().active);
+
+  // New notifications, removals and clearing reach the shared store.
+  manager.addOrReplace(NotificationRequest{.appName = "app", .summary = "fresh", .body = "new body", .timeout = 0});
+  TEST_CHECK(waitForCall(calls, R"("summary":"fresh")"));
+  TEST_CHECK(readFile(calls).starts_with("append "));
+  manager.removeHistoryEntry(7);
+  TEST_CHECK(waitForCall(calls, R"(remove {"body":"body","summary":"kept","time":"2026-09-21T)"));
+  manager.clearHistory();
+  TEST_CHECK(waitForCall(calls, "clear\n"));
+
+  // A manager that never loaded persisted history leaves the shared store alone.
+  fs::remove(calls);
+  NotificationManager detached;
+  detached.addOrReplace(NotificationRequest{.appName = "app", .summary = "local", .timeout = 0});
+  detached.clearHistory();
+  std::this_thread::sleep_for(milliseconds(200));
+  TEST_CHECK(!fs::exists(calls));
+
+  fs::remove_all(root);
+  return 0;
+}
