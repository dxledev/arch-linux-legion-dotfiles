+void NotificationManager::syncSharedHistory() {
+  // Other shells add and remove records while Noctalia is stopped. Keep local entries (with their
+  // images and actions) that are still shared, drop removed ones, and add records from other shells.
+  const auto records = shared_notification_history::list(kMaxHistoryEntries);
