+    for (std::size_t i = 0; i < records->size(); ++i) {
+      if (!used[i] && shared_notification_history::matches(entry.notification, (*records)[i])) {
+        used[i] = true;
+        return false;
+      }
+    }
+    return true;
+  });
+  for (std::size_t i = 0; i < records->size(); ++i) {
+    if (used[i]) {
+      continue;
+    }
+    const auto& record = (*records)[i];
+    const auto icon = !record.icon.empty() ? record.icon : record.image;
+    m_history.push_back(
+        NotificationHistoryEntry{
+            .notification =
+                Notification{
+                    .id = m_nextId++,
+                    .origin = NotificationOrigin::External,
+                    .appName = record.app,
+                    .summary = record.summary,
+                    .body = record.body,
+                    .timeout = 0,
+                    .urgency = record.urgency,
+                    .icon = icon.empty() ? std::nullopt : std::optional<std::string>(icon),
+                    .receivedTime = Clock::now(),
+                    .receivedWallClock = record.time,
+                },
+            .active = false,
+            .seen = true,
+            .closeReason = CloseReason::Expired,
+            .eventSerial = ++m_changeSerial,
+        }
+    );
+  }
+  std::ranges::stable_sort(m_history, {}, [](const NotificationHistoryEntry& entry) {
+    return entry.notification.receivedWallClock.value_or(WallTimePoint{});
+  });
+  while (m_history.size() > kMaxHistoryEntries) {
+    m_history.pop_front();
+  }
+  ++m_changeSerial;
 }
 
