+  void checkThemeWallpaperRestoration() {
+    const auto root = std::filesystem::temp_directory_path()
+        / ("noctalia-theme-wallpaper-" + std::to_string(::getpid()));
+    const auto configRoot = root / "config";
+    const auto stateRoot = root / "state";
+    std::filesystem::create_directories(configRoot / "noctalia");
+    std::filesystem::create_directories(stateRoot / "noctalia");
+    std::filesystem::create_directories(stateRoot / "caelestia");
+    std::filesystem::create_directories(configRoot / "themes" / "test-static");
+    std::filesystem::create_directories(configRoot / "themes" / "other-static");
+    ::setenv("NOCTALIA_CONFIG_HOME", configRoot.c_str(), 1);
+    ::setenv("XDG_CONFIG_HOME", configRoot.c_str(), 1);
+    ::setenv("NOCTALIA_STATE_HOME", stateRoot.c_str(), 1);
+    ::setenv("XDG_STATE_HOME", stateRoot.c_str(), 1);
+    const auto dynamicImage = root / "dynamic image.png";
+    const auto staticImage = root / "static image.png";
+    const auto otherImage = root / "other image.png";
+    for (const auto& path : {dynamicImage, staticImage, otherImage}) {
+      std::ofstream(path) << "fixture";
+    }
+    std::filesystem::create_symlink(dynamicImage, stateRoot / "caelestia" / "dynamic-wallpaper");
+    std::filesystem::create_symlink(staticImage, configRoot / "themes" / "test-static" / "wallpaper.png");
+    std::filesystem::create_symlink(otherImage, configRoot / "themes" / "other-static" / "wallpaper.png");
+    {
+      std::ofstream out(configRoot / "noctalia" / "config.toml");
+      out << "[theme]\nsource = \"custom\"\ncustom_palette = \"test-static\"\n";
+    }
+    ConfigService config;
+    config.setWallpaperPath("DP-1", staticImage.string());
+    config.setWallpaperPath("HDMI-A-1", staticImage.string());
+    int reloads = 0;
+    int wallpaperChanges = 0;
+    config.addReloadCallback([&]() {
+      ++reloads;
+      expect(config.getWallpaperPath("DP-1") == config.getDefaultWallpaperPath(), "atomic theme/default/monitor reload");
+    });
+    config.setWallpaperChangeCallback([&]() { ++wallpaperChanges; });
+    expect(config.setOverride({"theme", "source"}, std::string("wallpaper")), "Settings Static to Dynamic succeeds");
+    expect(config.getDefaultWallpaperPath() == dynamicImage.string(), "Caelestia Dynamic fallback restored");
+    expect(config.getLastWallpaperPath() == dynamicImage.string(), "last wallpaper restored");
+    expect(config.getWallpaperPath("HDMI-A-1") == dynamicImage.string(), "all monitor paths restored");
+    expect(reloads == 1 && wallpaperChanges == 1, "one reload and wallpaper notification per transition");
+    expect(config.setOverride({"theme", "source"}, std::string("custom")), "Settings Dynamic to Static succeeds");
+    expect(config.getDefaultWallpaperPath() == staticImage.string(), "selected Static wallpaper restored");
+    expect(config.setOverride({"theme", "custom_palette"}, std::string("other-static")), "Settings Static to Static succeeds");
+    expect(config.getDefaultWallpaperPath() == otherImage.string(), "other Static wallpaper restored");
+    expect(config.setOverride({"theme", "source"}, std::string("wallpaper")), "Noctalia saved Dynamic succeeds");
+    expect(config.getDefaultWallpaperPath() == dynamicImage.string(), "Noctalia saved Dynamic restored");
+    config.forceReload();
+    expect(config.getDefaultWallpaperPath() == dynamicImage.string(), "restoration survives reload");
+    expect(config.getWallpaperPath("DP-1") == dynamicImage.string(), "monitor restoration survives reload");
+    const int beforeScheme = wallpaperChanges;
+    expect(config.setOverride({"theme", "wallpaper_scheme"}, std::string("m3-content")), "Dynamic scheme change succeeds");
+    expect(wallpaperChanges == beforeScheme, "scheme change does not restore wallpaper");
+    expect(config.setOverrides({
+        {{"theme", "source"}, std::string("custom")},
+        {{"theme", "custom_palette"}, std::string("other-static")},
+    }), "grouped Settings theme change restores wallpaper");
+    std::filesystem::remove(stateRoot / "noctalia" / "dynamic-wallpaper");
+    std::filesystem::create_symlink(root / "missing.png", stateRoot / "noctalia" / "dynamic-wallpaper");
+    const int beforeFailure = reloads;
+    expect(!config.setOverride({"theme", "source"}, std::string("wallpaper")), "broken saved Dynamic rejects transition");
+    expect(config.config().theme.source == PaletteSource::Custom, "failed restore preserves theme");
+    expect(config.getDefaultWallpaperPath() == otherImage.string(), "failed restore preserves wallpaper");
+    expect(reloads == beforeFailure, "failed restore has no reload");
+    expect(!config.setOverride({"theme", "custom_palette"}, std::string("missing-static")), "missing Static wallpaper rejects transition");
+    expect(config.config().theme.customPalette == "other-static", "failed Static restore preserves selection");
+    expect(!config.savedWallpaperForTheme(PaletteSource::Custom, "../invalid").has_value(), "invalid Static name rejected");
+    ::unsetenv("NOCTALIA_CONFIG_HOME");
+    ::unsetenv("XDG_CONFIG_HOME");
+    ::unsetenv("NOCTALIA_STATE_HOME");
+    ::unsetenv("XDG_STATE_HOME");
+    std::filesystem::remove_all(root);
+  }
+
