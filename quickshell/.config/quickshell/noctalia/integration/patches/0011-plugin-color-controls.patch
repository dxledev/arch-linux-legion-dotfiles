+            const float radius = std::min(logicalWidth, logicalHeight) / 2.0F - 4.0F;
+            const float distance = std::hypot(logicalX - logicalWidth / 2.0F, logicalY - logicalHeight / 2.0F);
+            const float innerRadius = radius * 0.10F;
+            const bool insideHole = distance < innerRadius;
+            const bool onHoleBorder = insideHole && distance >= innerRadius - 1.0F;
+            const bool onOuterBorder = !insideHole && distance <= radius + 1.0F;
+            if (onHoleBorder || onOuterBorder) {
+              writePixel(pixels, width, x, y, outline);
+            } else if (insideHole) {
+              writePixel(pixels, width, x, y, center);
+            } else {
+              writePixel(pixels, width, x, y, Rgba8{0, 0, 0, 0});
