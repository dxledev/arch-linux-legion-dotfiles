+    int wheelSegmentAt(float x, float y, float width, float height) {
+      constexpr int segmentCount = 24;
+      constexpr float innerRadiusRatio = 0.10F;
+      constexpr float pi = 3.14159265358979323846F;
+      const float centerX = width / 2.0F;
+      const float centerY = height / 2.0F;
+      const float radius = std::min(width, height) / 2.0F - 4.0F;
+      if (radius <= 0.0F) {
