+      const float offsetX = x - centerX;
+      const float offsetY = y - centerY;
+      const float distance = std::hypot(offsetX, offsetY);
+      if (distance < radius * innerRadiusRatio || distance > radius) {
+        return -1;
+      }
+      float angle = std::fmod(std::atan2(offsetY, offsetX) + pi / 2.0F + 2.0F * pi, 2.0F * pi);
+      return std::clamp(static_cast<int>(std::floor(angle / (2.0F * pi) * segmentCount)), 0, segmentCount - 1);
+    }
