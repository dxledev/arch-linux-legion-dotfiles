+    Color colorFromHsv(float hue, float saturation, float value) {
+      const float h = std::fmod(std::clamp(hue, 0.0F, 1.0F) * 6.0F, 6.0F);
+      const float chroma = value * saturation;
+      const float x = chroma * (1.0F - std::abs(std::fmod(h, 2.0F) - 1.0F));
+      const float offset = value - chroma;
+      float red = 0.0F;
+      float green = 0.0F;
+      float blue = 0.0F;
+      if (h < 1.0F) {
+        red = chroma;
+        green = x;
+      } else if (h < 2.0F) {
+        red = x;
+        green = chroma;
+      } else if (h < 3.0F) {
+        green = chroma;
+        blue = x;
+      } else if (h < 4.0F) {
+        green = x;
+        blue = chroma;
+      } else if (h < 5.0F) {
+        red = x;
+        blue = chroma;
+      } else {
