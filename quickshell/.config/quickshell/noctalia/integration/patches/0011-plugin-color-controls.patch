+                  static_cast<std::uint8_t>((3U * color.g + hover.g) / 4U),
+                  static_cast<std::uint8_t>((3U * color.b + hover.b) / 4U), color.a};
+              writePixel(pixels, width, x, y, border ? hover : hoverFill);
+            } else {
+              writePixel(pixels, width, x, y, border ? outline : color);
+            }
+          }
+        }
+      }
+      return pixels;
+    }
