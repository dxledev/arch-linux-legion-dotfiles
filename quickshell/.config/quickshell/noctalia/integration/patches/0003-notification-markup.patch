+#include "notification/notification_markup.h"
+
+#include <iostream>
+#include <string_view>
+
+namespace {
+
+  bool check(std::string_view actual, std::string_view expected, const char* message) {
+    if (actual == expected) {
+      return true;
+    }
+    std::cerr << "notification_markup_test: " << message << "\nexpected: " << expected << "\nactual: " << actual << '\n';
+    return false;
+  }
+
+} // namespace
+
+int main() {
+  const notification_markup::Variables variables{
+      {"--primary-color", "#88c0d0"},
+      {"--fallback", "var(--primary-color)"},
+  };
+  bool ok = true;
+  ok = check(
+           notification_markup::formatWithVariables(
+               "<b><span foreground=\"var(--primary-color)\">Nord</span></b>", variables
+           ),
+           "<b><span foreground=\"#88C0D0\">Nord</span></b>", "resolves Pango color variables"
+       )
+      && ok;
+  ok = check(
+           notification_markup::formatWithVariables("<span style=\"color: var(--fallback)\">accent</span>", variables),
+           "<span foreground=\"#88C0D0\">accent</span>", "resolves CSS style color variables"
+       )
+      && ok;
+  ok = check(
+           notification_markup::formatWithVariables("<b>one &amp; two</b><br>three", variables),
+           "<b>one &amp; two</b><br/>three", "preserves markup and normalizes line breaks"
+       )
+      && ok;
+  ok = check(
+           notification_markup::formatWithVariables("literal < text & value", variables), "literal &lt; text &amp; value",
+           "escapes malformed markup as text"
+       )
+      && ok;
+  ok = check(
+           notification_markup::formatWithVariables("<unknown>kept</unknown>", variables), "kept",
+           "keeps text from unsupported tags"
+       )
+      && ok;
+  return ok ? 0 : 1;
+}


