+  [[nodiscard]] std::optional<std::string> resolveWallpaperLink(const std::filesystem::path& linkPath) {
+    std::error_code ec;
+    const auto imagePath = std::filesystem::canonical(linkPath, ec);
+    if (ec || !std::filesystem::is_regular_file(imagePath, ec) || ec) {
+      kLog.warn("saved wallpaper path is missing or invalid: {}", linkPath.string());
+      return std::nullopt;
+    }
+    return imagePath.string();
+  }
+
+  [[nodiscard]] std::optional<std::string> wallpaperForTheme(const WallpaperFavorite& theme) {
+    const PaletteSource source = theme.paletteSource.value_or(PaletteSource::Builtin);
+    if (source == PaletteSource::Custom) {
+      if (!isSafeStaticThemeName(theme.customPalette)) {
+        kLog.warn("cannot restore wallpaper for invalid Static theme name '{}'", theme.customPalette);
+        return std::nullopt;
+      }
+      const std::filesystem::path linkPath =
+          FileUtils::expandXdgBaseDir("$XDG_CONFIG_HOME/themes/" + theme.customPalette + "/wallpaper.png");
+      return resolveWallpaperLink(linkPath);
+    }
+    if (source != PaletteSource::Wallpaper) {
+      return std::nullopt;
+    }
+
+    const std::string stateDir = FileUtils::stateDir();
+    const std::filesystem::path savedLink = stateDir.empty()
+        ? std::filesystem::path{}
+        : std::filesystem::path(stateDir) / "dynamic-wallpaper";
+    std::error_code ec;
+    const auto savedStatus = savedLink.empty() ? std::filesystem::file_status{}
+                                               : std::filesystem::symlink_status(savedLink, ec);
+    const bool noSavedLink = savedLink.empty() || ec == std::errc::no_such_file_or_directory
+        || (!ec && savedStatus.type() == std::filesystem::file_type::not_found);
+    if (!noSavedLink) {
+      return resolveWallpaperLink(savedLink);
+    }
+
+    const std::filesystem::path generatedLink =
+        FileUtils::expandXdgBaseDir("$XDG_STATE_HOME/caelestia/dynamic-wallpaper");
+    return resolveWallpaperLink(generatedLink);
+  }
