 namespace {
   constexpr Logger kLog("config");
 
+  [[nodiscard]] bool safeThemeName(std::string_view name) {
+    if (name.empty() || std::isalnum(static_cast<unsigned char>(name.front())) == 0) {
+      return false;
+    }
+    return std::all_of(name.begin(), name.end(), [](char value) {
+      const auto ch = static_cast<unsigned char>(value);
+      return std::isalnum(ch) != 0 || value == '.' || value == '-' || value == '_';
+    });
+  }
+
+  [[nodiscard]] bool replaceableWallpaperLink(const std::filesystem::path& link) {
+    std::error_code ec;
+    const auto status = std::filesystem::symlink_status(link, ec);
+    if (ec == std::errc::no_such_file_or_directory || (!ec && status.type() == std::filesystem::file_type::not_found)) {
+      return true;
+    }
+    if (ec) {
+      kLog.warn("failed to inspect wallpaper link {}: {}", link.string(), ec.message());
+      return false;
+    }
+    if (!std::filesystem::is_symlink(status)) {
+      kLog.warn("preserving non-symlink wallpaper path {}", link.string());
+      return false;
+    }
+    return true;
+  }
+
+  [[nodiscard]] bool updateWallpaperLink(
+      const std::filesystem::path& imagePath, const std::filesystem::path& linkPath, bool createParent
+  ) {
+    const auto parent = linkPath.parent_path();
+    std::error_code ec;
+    if (createParent) {
+      std::filesystem::create_directories(parent, ec);
+      if (ec) {
+        kLog.warn("failed to create wallpaper state directory {}: {}", parent.string(), ec.message());
+        return false;
+      }
+    } else if (!std::filesystem::is_directory(parent, ec) || ec) {
+      kLog.warn("wallpaper theme directory is missing: {}", parent.string());
+      return false;
+    }
+
+    if (!replaceableWallpaperLink(linkPath)) {
+      return false;
+    }
+
+    static std::atomic<std::uint64_t> sequence{0};
+    for (int attempt = 0; attempt < 16; ++attempt) {
+      const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+      auto temporaryLink = linkPath;
+      temporaryLink += ".tmp." + std::to_string(stamp) + "." + std::to_string(sequence.fetch_add(1));
+      std::filesystem::create_symlink(imagePath, temporaryLink, ec);
+      if (ec == std::errc::file_exists) {
+        ec.clear();
+        continue;
+      }
+      if (ec) {
+        kLog.warn("failed to stage wallpaper link {}: {}", temporaryLink.string(), ec.message());
+        return false;
+      }
+
+      if (!replaceableWallpaperLink(linkPath)) {
+        std::filesystem::remove(temporaryLink, ec);
+        return false;
+      }
+      std::filesystem::rename(temporaryLink, linkPath, ec);
+      if (ec) {
+        kLog.warn("failed to update wallpaper link {}: {}", linkPath.string(), ec.message());
+        std::filesystem::remove(temporaryLink, ec);
+        return false;
+      }
+      return true;
+    }
+
+    kLog.warn("could not allocate a temporary wallpaper link for {}", linkPath.string());
+    return false;
+  }
+
+  void rememberWallpaperForTheme(
+      std::string_view path, PaletteSource source, std::string_view customPalette
+  ) {
+    if (path.empty() || path.starts_with("color:")
+        || (source != PaletteSource::Custom && source != PaletteSource::Wallpaper)) {
+      return;
+    }
+
+    std::error_code ec;
+    const auto imagePath = std::filesystem::canonical(FileUtils::expandUserPath(std::string(path)), ec);
+    if (ec || !std::filesystem::is_regular_file(imagePath, ec) || ec) {
+      return;
+    }
+
+    std::filesystem::path linkPath;
+    bool createParent = false;
+    if (source == PaletteSource::Custom) {
+      if (!safeThemeName(customPalette)) {
+        return;
+      }
+      linkPath = FileUtils::expandXdgBaseDir(
+          "$XDG_CONFIG_HOME/themes/" + std::string(customPalette) + "/wallpaper.png"
+      );
+    } else {
+      const std::string stateDir = FileUtils::stateDir();
+      if (stateDir.empty()) {
+        return;
+      }
+      linkPath = std::filesystem::path(stateDir) / "dynamic-wallpaper";
+      createParent = true;
+    }
+    (void)updateWallpaperLink(imagePath, linkPath, createParent);
+  }
+
+  void rememberWallpaperForThemeSelection(
+      std::string_view path, const ThemeConfig& currentTheme, const WallpaperFavorite* selectedTheme
+  ) {
+    PaletteSource source = currentTheme.source;
+    std::string customPalette = currentTheme.customPalette;
+    if (selectedTheme != nullptr && selectedTheme->paletteSource.has_value()) {
+      source = *selectedTheme->paletteSource;
+      if (!selectedTheme->customPalette.empty()) {
+        customPalette = selectedTheme->customPalette;
+      }
+    }
+    rememberWallpaperForTheme(path, source, customPalette);
+  }
