diff --git a/src/launcher/settings_provider.h b/src/launcher/settings_provider.h
new file mode 100644
--- /dev/null
+++ b/src/launcher/settings_provider.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "launcher/launcher_provider.h"
+
+class PanelManager;
+
+class SettingsProvider : public LauncherProvider {
+public:
+  explicit SettingsProvider(PanelManager* panelManager);
+
+  [[nodiscard]] std::string_view defaultPrefix() const override { return "settings"; }
+  [[nodiscard]] std::string_view id() const override { return "Settings"; }
+  [[nodiscard]] std::string displayName() const override;
+  [[nodiscard]] std::string_view defaultGlyphName() const override { return "settings"; }
+
+  [[nodiscard]] std::vector<LauncherResult> query(std::string_view text) const override;
+
+  bool activate(const LauncherResult& result) override;
+
+private:
+  PanelManager* m_panelManager = nullptr;
+};
diff --git a/src/launcher/settings_provider.cpp b/src/launcher/settings_provider.cpp
new file mode 100644
--- /dev/null
+++ b/src/launcher/settings_provider.cpp
@@ -0,0 +1,48 @@
+#include "launcher/settings_provider.h"
+
+#include "i18n/i18n.h"
+#include "shell/panel/panel_manager.h"
+#include "util/fuzzy_match.h"
+#include "util/string_utils.h"
+
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace {
+  constexpr std::string_view kSettingsResultId = "settings";
+  constexpr std::string_view kSettingsSearchText = "settings";
+} // namespace
+
+SettingsProvider::SettingsProvider(PanelManager* panelManager) : m_panelManager(panelManager) {}
+
+std::string SettingsProvider::displayName() const { return i18n::tr("launcher.providers.settings.title"); }
+
+std::vector<LauncherResult> SettingsProvider::query(std::string_view text) const {
+  const std::string query = StringUtils::toLower(StringUtils::trim(text));
+  const double score = query.empty() ? 0.0 : FuzzyMatch::score(query, kSettingsSearchText);
+  if (!query.empty() && !FuzzyMatch::isMatch(score)) {
+    return {};
+  }
+
+  LauncherResult result;
+  result.id = std::string(kSettingsResultId);
+  result.title = i18n::tr("launcher.providers.settings.title");
+  result.subtitle = i18n::tr("launcher.providers.settings.subtitle");
+  result.glyphName = std::string(defaultGlyphName());
+  result.score = score;
+  return {std::move(result)};
+}
+
+bool SettingsProvider::activate(const LauncherResult& result) {
+  if (m_panelManager == nullptr || result.id != kSettingsResultId) {
+    return false;
+  }
+  if (!result.providerId.empty() && result.providerId != id()) {
+    return false;
+  }
+
+  m_panelManager->openSettingsWindow("launcher");
+  return true;
+}
