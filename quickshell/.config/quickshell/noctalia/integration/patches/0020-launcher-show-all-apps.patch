+  std::unordered_set<std::string> listedAppIds() {
+    const char* home = std::getenv("HOME");
+    if (home == nullptr || *home == '\0') {
+      return {};
+    }
+
+    std::ifstream file(std::string(home) + "/.config/apps.list");
+    std::unordered_set<std::string> ids;
+    std::string line;
+    while (std::getline(file, line)) {
+      const auto separator = line.find('|');
+      std::string_view id(line.data(), separator == std::string::npos ? line.size() : separator);
+      const auto start = id.find_first_not_of(" \t\r");
+      if (start == std::string_view::npos) {
+        continue;
+      }
+      id = id.substr(start, id.find_last_not_of(" \t\r") - start + 1);
+      if (id.starts_with('#') || id.find('=') != std::string_view::npos) {
+        continue;
+      }
+      if (id.ends_with(".desktop")) {
+        id.remove_suffix(std::string_view(".desktop").size());
+      }
+      ids.emplace(id);
+    }
+    return ids;
+  }
