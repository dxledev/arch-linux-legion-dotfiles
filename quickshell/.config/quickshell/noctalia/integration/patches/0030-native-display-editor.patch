+
+using display::Json;
+namespace {
+  auto label(std::string value, ColorRole role = ColorRole::OnSurface) {
+    return ui::label({.text = std::move(value), .color = colorSpecFromRole(role)});
+  }
+  auto row(std::string title, std::unique_ptr<Node> control) {
+    return ui::row({.align = FlexAlign::Center, .gap = 10}, label(std::move(title)), ui::spacer(), std::move(control));
+  }
+  auto button(std::string title, std::function<void()> action, bool enabled = true) {
+    return ui::button({.text = std::move(title), .enabled = enabled, .onClick = std::move(action)});
+  }
+  std::string numeric(double value) { return std::format("{:g}", value); }
+} // namespace
+void DisplayWindow::numericField(
+    Flex& parent, const std::string& title, const std::string& key, double fallback, bool integer
+) {
+  const auto output = m_model.output();
+  const auto buffer = m_model.selected + ":" + key;
+  const auto currentValue = output.value(key, fallback);
+  auto control = ui::input(
+      {.value = m_textBuffers.contains(buffer) ? m_textBuffers.at(buffer) : numeric(currentValue),
+       .enabled = m_model.editable(),
+       .width = 150,
+       .onChange = [this, buffer](const std::string& text) { m_textBuffers[buffer] = text; },
+       .onSubmit =
+           [this, key, buffer, integer](const std::string& text) {
+             if (m_rebuildingScene)
+               return;
+             try {
+               std::size_t end = 0;
+               const double value = std::stod(text, &end);
+               if (end != text.size()
+                   || !std::isfinite(value)
+                   || (integer
+                       && (std::floor(value) != value
+                           || value < std::numeric_limits<int>::min()
+                           || value > std::numeric_limits<int>::max())))
+                 throw std::invalid_argument("number");
+               m_textBuffers.erase(buffer);
+               m_model.edit({{key, integer ? Json(static_cast<int>(value)) : Json(value)}});
+             } catch (const std::exception&) {
+               m_model.error = "Enter a valid " + std::string(integer ? "whole number." : "number.");
+               rebuild();
+             }
+           },
+       .submitOnFocusLoss = true,
+       .configure = [buffer](Input& input) { input.inputArea()->setTabFocusKey(buffer); }}
+  );
+  auto field = row(title, std::move(control));
+  for (const auto& saved : m_model.defaults.value("outputs", Json::array())) {
+    if (saved.value("key", "") == m_model.selected
+        && saved.value(key, Json(fallback)) != output.value(key, Json(fallback))) {
+      field->addChild(
+          button("Reset", [this, key, saved]() { m_model.edit({{key, saved.value(key, Json())}}); }, m_model.editable())
+      );
+    }
+  }
+  parent.addChild(std::move(field));
+}
+void DisplayWindow::textField(Flex& parent, const std::string& title, const std::string& key) {
+  const auto buffer = m_model.selected + ":" + key;
+  parent.addChild(
+      row(title,
+          ui::input(
+              {.value = m_textBuffers.contains(buffer) ? m_textBuffers.at(buffer) : m_model.output().value(key, ""),
+               .enabled = m_model.editable(),
+               .width = 200,
+               .onChange = [this, buffer](const std::string& value) { m_textBuffers[buffer] = value; },
+               .onSubmit =
+                   [this, buffer, key](const std::string& value) {
+                     if (m_rebuildingScene)
+                       return;
+                     m_textBuffers.erase(buffer);
+                     m_model.edit({{key, value}});
+                   },
+               .submitOnFocusLoss = true,
+               .configure = [buffer](Input& input) { input.inputArea()->setTabFocusKey(buffer); }}
+          ))
+  );
+}
+void DisplayWindow::selectField(
+    Flex& parent, const std::string& title, const std::string& key, const std::vector<std::string>& labels,
+    const std::vector<Json>& values, Json fallback
+) {
+  const auto value = m_model.output().value(key, fallback);
+  const auto match = std::ranges::find(values, value);
+  const auto index = match == values.end() ? 0U : static_cast<std::size_t>(match - values.begin());
+  parent.addChild(
+      row(title,
+          ui::select(
+              {.options = labels,
+               .selectedIndex = index,
+               .enabled = m_model.editable(),
+               .width = 200,
+               .onSelectionChanged = [this, key, values](std::size_t selected, std::string_view) {
+                 if (selected < values.size())
+                   m_model.edit({{key, values[selected]}});
+               }}
+          ))
+  );
+}
+std::unique_ptr<Flex> DisplayWindow::buildInspector() {
+  auto panel = ui::column(
+      {.align = FlexAlign::Stretch,
+       .gap = 10,
+       .padding = 14,
+       .fill = colorSpecFromRole(ColorRole::SurfaceVariant),
+       .radius = 9}
+  );
