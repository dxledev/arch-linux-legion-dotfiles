+  }
+  panel->addChild(label(m_model.label(output.value("name", ""))));
+  panel->addChild(label(output.value("description", ""), ColorRole::OnSurfaceVariant));
+  panel->addChild(
+      row("Enabled",
+          ui::toggle(
+              {.checked = output.value("enabled", true), .enabled = m_model.editable(), .onChange = [this](bool value) {
+                 m_model.edit({{"enabled", value}});
+               }}
+          ))
+  );
+  auto modes = hardware.value("available_modes", std::vector<std::string>{});
+  const auto mode = output.value("mode", "preferred");
+  if (std::ranges::find(modes, mode) == modes.end())
+    modes.insert(modes.begin(), mode);
+  std::vector<Json> modeValues(modes.begin(), modes.end());
+  selectField(*panel, "Resolution / refresh", "mode", modes, modeValues, mode);
+  numericField(*panel, "Scale", "scale", 1);
+  numericField(*panel, "Position X", "x", 0, true);
+  numericField(*panel, "Position Y", "y", 0, true);
+  selectField(
+      *panel, "Rotation / flip", "transform",
+      {"Normal", "90°", "180°", "270°", "Flipped", "Flipped 90°", "Flipped 180°", "Flipped 270°"},
+      {0, 1, 2, 3, 4, 5, 6, 7}, 0
+  );
+  std::vector<std::string> mirrors{"None"};
+  std::vector<Json> mirrorValues{""};
+  for (const auto& other : m_model.draft.value("outputs", Json::array())) {
+    if (other.value("key", "") != m_model.selected && other.value("enabled", true)) {
+      mirrors.push_back(m_model.label(other.value("name", "")));
+      mirrorValues.push_back(other.value("key", ""));
+    }
+  }
+  selectField(*panel, "Mirror", "mirror_of", mirrors, mirrorValues, "");
+  selectField(*panel, "Variable refresh rate", "vrr", {"Off", "On", "Fullscreen"}, {0, 1, 2}, 0);
+  if (m_brightness) {
+    if (const auto* brightness = m_brightness->findDisplay(output.value("name", ""));
+        brightness && brightness->controllable) {
+      const auto connector = brightness->id;
+      m_brightnessConnector = connector;
+      panel->addChild(
+          row("Brightness",
+              ui::slider(
+                  {.out = &m_brightnessSlider,
+                   .minValue = 1,
+                   .maxValue = 100,
+                   .step = 1,
+                   .value = std::round(brightness->brightness * 100),
+                   .width = 200,
+                   .onValueChanged = [this, connector](double value) {
+                     if (!m_syncBrightness)
+                       m_brightness->setBrightness(connector, static_cast<float>(value / 100));
+                   }}
+              ))
+      );
+    }
+  }
+  panel->addChild(ui::separator({}));
+  panel->addChild(label("Color and signal"));
+  selectField(*panel, "Color depth", "bitdepth", {"8 bit", "10 bit"}, {8, 10}, 8);
+  selectField(
+      *panel, "Color space / EOTF", "cm",
+      {"sRGB", "Auto", "Wide", "HDR", "HDR EDID", "DCI-P3", "Display P3", "Adobe RGB", "EDID"},
+      {"srgb", "auto", "wide", "hdr", "hdredid", "dcip3", "dp3", "adobe", "edid"}, "srgb"
+  );
+  textField(*panel, "ICC profile", "icc");
+  selectField(*panel, "Wide color support", "supports_wide_color", {"Auto", "Force off", "Force on"}, {0, -1, 1}, 0);
+  selectField(*panel, "HDR support", "supports_hdr", {"Auto", "Force off", "Force on"}, {0, -1, 1}, 0);
+  numericField(*panel, "SDR brightness", "sdr_brightness", 1);
+  numericField(*panel, "SDR saturation", "sdr_saturation", 1);
+  numericField(*panel, "SDR black level", "sdr_min_luminance", 0.2);
+  numericField(*panel, "SDR white level", "sdr_max_luminance", 80, true);
+  selectField(
+      *panel, "SDR transfer curve", "sdr_eotf", {"Default", "Gamma 2.2", "sRGB"}, {"default", "gamma22", "srgb"},
+      "default"
+  );
+  numericField(*panel, "Display black level", "min_luminance", 0);
+  numericField(*panel, "Peak luminance", "max_luminance", 0, true);
+  numericField(*panel, "Maximum frame average", "max_avg_luminance", 0, true);
+  return panel;
+}
+std::unique_ptr<Flex> DisplayWindow::buildWorkspaces() {
+  auto panel = ui::column(
+      {.align = FlexAlign::Stretch,
+       .gap = 12,
+       .padding = 14,
+       .fill = colorSpecFromRole(ColorRole::SurfaceVariant),
+       .radius = 9}
+  );
+  auto workspaces = m_model.draft.value("workspaces", Json::object());
+  const auto edit = [this, workspaces](const std::string& key, Json value) {
+    auto next = workspaces;
+    next[key] = std::move(value);
+    m_model.edit({{"workspaces", next}}, false);
+  };
+  const bool supported = m_model.document.value("workspace_persistence_supported", false);
+  if (!supported)
+    panel->addChild(label("Workspace persistence is unavailable on this compositor.", ColorRole::OnSurfaceVariant));
+  panel->addChild(
+      row("Configure workspaces",
+          ui::toggle(
+              {.checked = workspaces.value("enabled", false),
+               .enabled = m_model.editable() && supported,
+               .onChange = [edit](bool value) { edit("enabled", value); }}
+          ))
+  );
+  const std::vector<std::string> strategies{"sequential", "interleave", "manual"};
+  const auto found = std::ranges::find(strategies, workspaces.value("strategy", "sequential"));
+  panel->addChild(
+      row("Assignment",
+          ui::select(
+              {.options = std::vector<std::string>{"Sequential", "Interleaved", "Manual"},
+               .selectedIndex = found == strategies.end() ? 0U : static_cast<std::size_t>(found - strategies.begin()),
+               .enabled = m_model.editable() && supported,
+               .onSelectionChanged = [edit, strategies](std::size_t index, std::string_view) {
+                 if (index < strategies.size())
+                   edit("strategy", strategies[index]);
+               }}
+          ))
+  );
+  for (const auto& [title, key, fallback] : std::vector<std::tuple<std::string, std::string, int>>{
+           {"Workspace count", "max_workspaces", 10}, {"Group size", "group_size", 1}
+       })
+    panel->addChild(
+        row(title,
+            ui::stepper(
+                {.minValue = 1,
+                 .maxValue = 100,
+                 .value = workspaces.value(key, fallback),
+                 .enabled = m_model.editable() && supported,
+                 .onValueCommitted = [edit, key](int value) { edit(key, value); }}
+            ))
+    );
+  panel->addChild(
+      row("Persist all",
+          ui::toggle(
+              {.checked = workspaces.value("persist_all", false),
+               .enabled = m_model.editable() && supported,
+               .onChange = [edit](bool value) { edit("persist_all", value); }}
+          ))
+  );
+  buildWorkspaceOrder(*panel, workspaces);
+  if (workspaces.value("strategy", "") == "manual")
+    buildWorkspaceRules(*panel, workspaces);
+  panel->addChild(ui::separator({}));
+  panel->addChild(label("Workspace plan"));
+  for (const auto& entry : m_model.workspacePlan) {
+    std::string summary;
+    for (const auto& workspace : entry.value("workspaces", Json::array())) {
+      if (!summary.empty())
+        summary += ", ";
+      summary += workspace.get<std::string>();
+    }
+    panel->addChild(label(m_model.label(entry.value("output_name", "")) + ": " + (summary.empty() ? "—" : summary)));
+  }
+  return panel;
+}
