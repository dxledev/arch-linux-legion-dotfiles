+#pragma once
+#include "core/files/file_watcher.h"
+#include "render/animation/animation_manager.h"
+#include "render/scene/input_dispatcher.h"
+#include "shell/display/display_identify.h"
+#include "shell/display/display_model.h"
+#include "ui/controls/scroll_view.h"
+#include "wayland/toplevel_surface.h"
+
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+class ConfigService;
+class BrightnessService;
+class Slider;
+class RenderContext;
+class WaylandConnection;
+class SelectDropdownPopup;
+class Flex;
+struct PointerEvent;
+struct KeyboardEvent;
+
+class DisplayWindow {
+public:
+  DisplayWindow();
+  ~DisplayWindow();
+  void initialize(WaylandConnection& wayland, ConfigService& config, RenderContext& render, FileWatcher& watcher);
+  void open();
+  void close();
+  bool isOpen() const;
+  bool ownsKeyboardSurface(wl_surface* surface) const;
+  bool onPointerEvent(const PointerEvent& event);
+  void onKeyboardEvent(const KeyboardEvent& event);
+  void onAppearanceChanged();
+  void onBrightnessChanged();
+  void setBrightnessService(BrightnessService* service) { m_brightness = service; }
+  display::Client& client() { return m_model.client; }
+
+private:
+  void destroyWindow();
+  void rebuild();
+  void prepareFrame(bool update, bool layout);
+  void buildScene();
+  void openTui();
+  std::unique_ptr<Node> buildCanvas(float width, float height);
+  std::unique_ptr<Flex> buildInspector();
+  std::unique_ptr<Flex> buildWorkspaces();
+  void buildWorkspaceOrder(Flex& parent, const display::Json& workspaces);
+  void buildWorkspaceRules(Flex& parent, const display::Json& workspaces);
+  std::unique_ptr<Flex> buildProfiles();
+  void
+  numericField(Flex& parent, const std::string& title, const std::string& key, double fallback, bool integer = false);
+  void textField(Flex& parent, const std::string& title, const std::string& key);
+  void selectField(
+      Flex& parent, const std::string& title, const std::string& key, const std::vector<std::string>& labels,
+      const std::vector<display::Json>& values, display::Json fallback
+  );
+  float scale() const;
+  bool m_syncBrightness = false;
+  Slider* m_brightnessSlider = nullptr;
+  std::string m_brightnessConnector;
+  BrightnessService* m_brightness = nullptr;
+  WaylandConnection* m_wayland = nullptr;
+  ConfigService* m_config = nullptr;
+  RenderContext* m_render = nullptr;
+  FileWatcher* m_watcher = nullptr;
+  FileWatcher::WatchId m_nicknameWatch = 0;
+  display::Model m_model;
+  DisplayIdentify m_identify;
+  Timer m_previewClock;
+  AnimationManager m_animations;
+  std::unique_ptr<ToplevelSurface> m_surface;
+  std::unique_ptr<Node> m_scene;
+  std::unique_ptr<SelectDropdownPopup> m_popup;
+  InputDispatcher m_input;
+  Flex* m_main = nullptr;
+  ScrollViewState m_scroll;
+  std::unordered_map<std::string, std::string> m_textBuffers;
+  std::string m_page = "layout";
+  std::string m_saveName;
+  std::string m_deleteName;
+  bool m_rebuild = true;
+  bool m_rebuildingScene = false;
+  bool m_pointerInside = false;
+  bool m_confirmationOnly = false;
+  bool m_wasPreview = false;
+  std::shared_ptr<bool> m_alive = std::make_shared<bool>(true);
+};
diff --git a/src/shell/settings/settings_registry.cpp b/src/shell/settings/settings_registry.cpp
index 88d9b00..bd0d6f2 100644
--- a/src/shell/settings/settings_registry.cpp
