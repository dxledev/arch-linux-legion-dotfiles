diff --git a/src/launcher/display_provider.cpp b/src/launcher/display_provider.cpp
new file mode 100644
index 0000000..6381673
--- /dev/null
+++ b/src/launcher/display_provider.cpp
@@ -0,0 +1,33 @@
+#include "launcher/display_provider.h"
+
+#include "i18n/i18n.h"
+#include "shell/panel/panel_manager.h"
+#include "util/fuzzy_match.h"
+#include "util/string_utils.h"
+
+DisplayProvider::DisplayProvider(PanelManager* panelManager) : m_panelManager(panelManager) {}
+
+std::string DisplayProvider::displayName() const { return i18n::tr("launcher.providers.displays.title"); }
+
+std::vector<LauncherResult> DisplayProvider::query(std::string_view text) const {
+  const auto query = StringUtils::toLower(StringUtils::trim(text));
+  const double score = query.empty()
+      ? 0.0
+      : FuzzyMatch::score(query, "configure monitors displays layout resolution scale workspaces profiles");
+  if (!query.empty() && !FuzzyMatch::isMatch(score))
+    return {};
+  LauncherResult result;
+  result.id = "configure-monitors";
+  result.title = i18n::tr("control-center.display.configure-monitors");
+  result.subtitle = i18n::tr("launcher.providers.displays.subtitle");
+  result.glyphName = std::string(defaultGlyphName());
+  result.score = score;
+  return {std::move(result)};
+}
+
+bool DisplayProvider::activate(const LauncherResult& result) {
+  if (!m_panelManager || result.id != "configure-monitors" || (!result.providerId.empty() && result.providerId != id()))
+    return false;
+  m_panelManager->openSettingsWindow("display");
+  return true;
+}
