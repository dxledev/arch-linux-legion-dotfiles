+#include "shell/display/display_identify.h"
+
+#include "render/render_context.h"
+#include "ui/builders.h"
+#include "wayland/wayland_connection.h"
+void DisplayIdentify::clear() {
+  m_timeout.stop();
+  for (auto& entry : m_entries)
+    entry->surface->setSceneRoot(nullptr);
+  m_entries.clear();
+}
+void DisplayIdentify::show(WaylandConnection& wayland, RenderContext& render, const display::Model& model) {
+  clear();
+  if (!wayland.hasLayerShell() || !model.editable())
+    return;
+  for (const auto& output : wayland.outputs()) {
+    if (!output.output || !output.hasUsableGeometry())
+      continue;
+    auto entry = std::make_unique<Entry>();
+    entry->name = model.label(output.connectorName);
+    entry->description = output.description;
+    entry->surface = std::make_unique<LayerSurface>(
+        wayland,
+        LayerSurfaceConfig{
+            .nameSpace = "noctalia-display-identify",
+            .layer = LayerShellLayer::Overlay,
+            .width = 380,
+            .height = 140,
+            .exclusiveZone = -1
+        }
+    );
+    entry->surface->setRenderContext(&render);
+    entry->surface->setClickThrough(true);
+    auto* current = entry.get();
+    entry->surface->setPrepareFrameCallback([current, &render](bool, bool) {
+      render.makeCurrent(current->surface->renderTarget());
+      if (!current->scene) {
+        current->scene = ui::column(
+            {.align = FlexAlign::Center,
+             .justify = FlexJustify::Center,
+             .gap = 8,
+             .padding = 16,
+             .fill = colorSpecFromRole(ColorRole::Surface),
+             .radius = 12,
+             .border = colorSpecFromRole(ColorRole::Outline),
+             .width = static_cast<float>(current->surface->width()),
+             .height = static_cast<float>(current->surface->height())},
+            ui::label(
+                {.text = current->name,
+                 .fontSize = Style::fontSizeHeader,
+                 .color = colorSpecFromRole(ColorRole::OnSurface)}
+            ),
+            ui::label(
+                {.text = current->description,
+                 .fontSize = Style::fontSizeCaption,
+                 .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+                 .maxLines = 2}
+            )
+        );
+        current->surface->setSceneRoot(current->scene.get());
+      }
+      current->scene->layout(current->surface->renderTarget().renderer());
+    });
+    if (entry->surface->initialize(output.output))
+      m_entries.push_back(std::move(entry));
+  }
+  m_timeout.start(std::chrono::seconds(3), [this]() { clear(); });
+}
