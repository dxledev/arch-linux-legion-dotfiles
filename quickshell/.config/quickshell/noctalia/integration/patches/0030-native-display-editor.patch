+void DisplayWindow::buildWorkspaceOrder(Flex& parent, const Json& workspaces) {
+  auto* panel = &parent;
+  const auto edit = [this, workspaces](const std::string& key, Json value) {
+    auto next = workspaces;
+    next[key] = std::move(value);
+    m_model.edit({{"workspaces", next}}, false);
+  };
+  panel->addChild(label("Monitor order"));
+  auto order = workspaces.value("monitor_order", std::vector<std::string>{});
+  if (order.empty())
+    for (const auto& output : m_model.draft.value("outputs", Json::array()))
+      if (output.value("enabled", true))
+        order.push_back(output.value("key", ""));
+  for (std::size_t index = 0; index < order.size(); ++index) {
+    std::string name = order[index];
+    for (const auto& output : m_model.draft.value("outputs", Json::array()))
+      if (output.value("key", "") == name)
+        name = m_model.label(output.value("name", ""));
+    panel->addChild(
+        ui::row(
+            {.align = FlexAlign::Center, .gap = 8}, label(std::to_string(index + 1) + ". " + name), ui::spacer(),
+            button(
+                "Up",
+                [edit, order, index]() mutable {
+                  std::swap(order[index], order[index - 1]);
+                  edit("monitor_order", order);
+                },
+                m_model.editable() && index > 0
+            ),
+            button(
+                "Down",
+                [edit, order, index]() mutable {
+                  std::swap(order[index], order[index + 1]);
+                  edit("monitor_order", order);
+                },
+                m_model.editable() && index + 1 < order.size()
+            )
+        )
+    );
+  }
+}
+
+void DisplayWindow::buildWorkspaceRules(Flex& parent, const Json& workspaces) {
+  auto* panel = &parent;
+  const auto edit = [this, workspaces](const std::string& key, Json value) {
+    auto next = workspaces;
+    next[key] = std::move(value);
+    m_model.edit({{"workspaces", next}}, false);
+  };
+  panel->addChild(label("Manual assignments"));
+  const auto rules = workspaces.value("rules", Json::array());
+  std::vector<std::string> names;
+  std::vector<Json> keys;
+  for (const auto& output : m_model.draft.value("outputs", Json::array())) {
+    names.push_back(m_model.label(output.value("name", "")) + (output.value("enabled", true) ? "" : " (off)"));
+    keys.push_back(output.value("key", ""));
+  }
+  for (std::size_t index = 0; index < rules.size(); ++index) {
+    const auto rule = rules[index];
+    const auto commit = [edit, rules, index](const std::string& field, Json value) {
+      auto next = rules;
+      next[index][field] = std::move(value);
+      edit("rules", next);
+    };
+    const auto match = std::ranges::find(keys, rule.value("output_key", Json("")));
+    auto assignment = ui::column({.gap = 8});
+    const auto buffer = "workspace:" + std::to_string(index);
+    assignment->addChild(
+        ui::row(
+            {.align = FlexAlign::Center, .gap = 8},
+            ui::input(
+                {.value = m_textBuffers.contains(buffer) ? m_textBuffers.at(buffer) : rule.value("workspace", ""),
+                 .placeholder = "Number or name:label",
+                 .enabled = m_model.editable(),
+                 .width = 200,
+                 .onChange = [this, buffer](const std::string& value) { m_textBuffers[buffer] = value; },
+                 .onSubmit =
+                     [this, commit, buffer](const std::string& value) {
+                       if (m_rebuildingScene)
+                         return;
+                       m_textBuffers.erase(buffer);
+                       commit("workspace", value);
+                     },
+                 .submitOnFocusLoss = true,
+                 .configure = [buffer](Input& input) { input.inputArea()->setTabFocusKey(buffer); }}
+            ),
+            ui::select(
+                {.options = names,
+                 .selectedIndex = match == keys.end() ? 0U : static_cast<std::size_t>(match - keys.begin()),
+                 .enabled = m_model.editable(),
+                 .onSelectionChanged =
+                     [commit, keys](std::size_t selected, std::string_view) {
+                       if (selected < keys.size())
+                         commit("output_key", keys[selected]);
+                     }}
+            ),
+            button(
+                "Remove",
+                [edit, rules, index]() {
+                  auto next = rules;
+                  next.erase(index);
+                  edit("rules", next);
+                },
+                m_model.editable()
+            )
+        )
+    );
+    assignment->addChild(
+        ui::row(
+            {.gap = 16},
+            row("Default",
+                ui::toggle(
+                    {.checked = rule.value("default", false),
+                     .enabled = m_model.editable(),
+                     .onChange = [commit](bool value) { commit("default", value); }}
+                )),
+            row("Persistent",
+                ui::toggle(
+                    {.checked = rule.value("persistent", false),
+                     .enabled = m_model.editable(),
+                     .onChange = [commit](bool value) { commit("persistent", value); }}
+                ))
+        )
+    );
+    panel->addChild(std::move(assignment));
+  }
+  panel->addChild(button(
+      "Add assignment",
+      [edit, rules, keys]() {
+        if (keys.empty())
+          return;
+        auto next = rules;
+        next.push_back({{"workspace", std::to_string(next.size() + 1)}, {"output_key", keys[0]}, {"persistent", true}});
+        edit("rules", next);
+      },
+      m_model.editable() && !keys.empty()
+  ));
+}
