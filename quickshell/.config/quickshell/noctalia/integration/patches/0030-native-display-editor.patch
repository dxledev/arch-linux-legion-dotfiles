diff --git a/src/shell/display/display_model.cpp b/src/shell/display/display_model.cpp
new file mode 100644
index 0000000..b89a124
--- /dev/null
+++ b/src/shell/display/display_model.cpp
@@ -0,0 +1,267 @@
+#include "shell/display/display_model.h"
+
+#include <cstdlib>
+#include <fstream>
+
+namespace display {
+  namespace {
+    std::string environment(const char* name, std::string fallback = {}) {
+      const char* value = std::getenv(name);
+      return value != nullptr && value[0] != '\0' ? value : std::move(fallback);
+    }
+  } // namespace
+  Model::Model() {
+    client.onConnection = [this](bool connected) {
+      ++m_revision;
+      m_reading = false;
+      ready = connected && ready;
+      if (!connected)
+        error = "Display service unavailable. Install or start the shared hyprmoncfgd.service.";
+      else {
+        error.clear();
+        client.request("subscribe", Json::object(), [this](const Json& result, const std::string& message) {
+          if (message.empty())
+            receiveStatus(result);
+          else {
+            error = message;
+            changed();
+          }
+        });
+        refresh();
+      }
+      changed();
+    };
+    client.onStatus = [this](const Json& value) { receiveStatus(value); };
+  }
+  void Model::changed() {
+    if (onChanged)
+      onChanged();
+  }
+  void Model::open() {
+    readNicknames();
+    client.start();
+    if (client.connected())
+      refresh();
+  }
+
+  bool Model::stale() const {
+    return ready && status.value("monitor_set_hash", "") != document.value("monitor_set_hash", "");
+  }
+  bool Model::editable() const {
+    return client.connected()
+        && ready
+        && !pending
+        && transaction.empty()
+        && !foreignPreview
+        && !stale()
+        && !status.value("daemon", Json::object()).value("unmanaged", false);
+  }
+  void Model::receiveStatus(const Json& value) {
+    if (!value.is_object())
+      return;
+    ++m_revision;
+    status = value;
+    const auto daemon = status.value("daemon", Json::object());
+    const auto preview = daemon.value("preview", Json());
+    foreignPreview = preview.is_object() && preview.value("transaction_id", "") != transaction;
+    if (!transaction.empty() && (!preview.is_object() || preview.value("transaction_id", "") != transaction)) {
+      transaction.clear();
+      deadline.clear();
+      dirty = false;
+      refresh(true);
+    } else {
+      refresh();
+    }
+    changed();
+  }
+  void Model::refresh(bool reset) {
+    if (reset) {
+      dirty = false;
+      m_preserveDraft = false;
+      ++m_revision;
+    }
+    if (!client.connected())
+      return;
+    if (m_reading || pending || !transaction.empty() || foreignPreview) {
+      m_refreshQueued = true;
+      return;
+    }
+    m_reading = true;
+    m_refreshQueued = false;
+    const auto revision = m_revision;
+    client.request("editor_state", Json::object(), [this, revision](const Json& result, const std::string& message) {
+      m_reading = false;
+      if (!message.empty()) {
+        error = message;
+        changed();
+        return;
+      }
+      if (revision != m_revision || pending || !transaction.empty() || foreignPreview) {
+        refresh();
+        return;
+      }
+      if (!result.is_object() || !result.value("profile", Json()).is_object()) {
+        error = "Invalid display editor state.";
+        changed();
+        return;
+      }
+      if (dirty || m_preserveDraft) {
+        document["profiles"] = result.value("profiles", Json::array());
+        document["profile_workspace_plans"] = result.value("profile_workspace_plans", Json::object());
+      } else {
+        document = result;
+        draft = result["profile"];
+        defaults = draft;
+        workspacePlan = result.value("workspace_plan", Json::array());
+        if (output().empty() && draft.contains("outputs") && !draft["outputs"].empty())
+          selected = draft["outputs"][0].value("key", "");
+      }
+      ready = true;
+      changed();
+      if (m_refreshQueued)
+        refresh();
+    });
+  }
+  void Model::mutate(std::string method, Json params, Client::Reply success) {
+    if (pending || !client.connected())
+      return;
+    pending = true;
+    ++m_revision;
+    error.clear();
+    client.request(
+        std::move(method), std::move(params),
+        [this, success = std::move(success)](const Json& result, const std::string& message) {
+          pending = false;
+          if (!message.empty())
+            error = message;
+          else if (success)
+            success(result, message);
+          changed();
+          if (m_refreshQueued)
+            refresh();
+        }
+    );
+    changed();
+  }
+  void Model::edit(Json fields, bool perOutput) {
+    if (!editable())
+      return;
+    if (perOutput)
+      fields["output_key"] = selected;
+    mutate("edit_profile", {{"profile", draft}, {"edit", fields}}, [this](const Json& result, const std::string&) {
+      draft = result.at("profile");
+      workspacePlan = result.value("workspace_plan", Json::array());
+      dirty = draft != defaults;
+    });
+  }
+  void Model::load(const Json& profile) {
+    if (!editable())
+      return;
+    ++m_revision;
+    draft = profile;
+    defaults = draft;
+    m_preserveDraft = true;
+    dirty = false;
+    const auto plans = document.value("profile_workspace_plans", Json::object());
+    workspacePlan = plans.value(profile.value("name", ""), Json::array());
+    changed();
+  }
+  void Model::preview(bool save) {
+    if (!editable())
+      return;
+    saveOnCommit = save;
+    auto profile = draft;
+    if (profile.value("name", "").empty())
+      profile["name"] = "draft";
+    mutate(
+        "preview", {{"profile", profile}, {"timeout_seconds", 30}, {"save_on_commit", save}},
+        [this](const Json& result, const std::string&) {
+          transaction = result.value("id", "");
+          deadline = result.value("deadline", "");
+          foreignPreview = false;
+        }
+    );
+  }
+  void Model::previewProfile(const std::string& name) {
+    if (!editable())
+      return;
+    saveOnCommit = false;
+    mutate(
+        "preview", {{"profile_name", name}, {"timeout_seconds", 30}}, [this](const Json& result, const std::string&) {
+          transaction = result.value("id", "");
+          deadline = result.value("deadline", "");
+          foreignPreview = false;
+        }
+    );
+  }
+  void Model::finishPreview(bool keep) {
+    if (transaction.empty() || pending)
+      return;
+    Json params{{"transaction_id", transaction}};
+    if (keep)
+      params["save"] = saveOnCommit;
+    mutate(keep ? "commit" : "revert", params, [this](const Json&, const std::string&) {
+      transaction.clear();
+      deadline.clear();
+      dirty = false;
+      refresh(true);
+    });
+  }
+  void Model::save(const std::string& name) {
+    if (!editable() || name.empty())
+      return;
+    auto profile = draft;
+    profile["name"] = name;
+    mutate("save", {{"profile", profile}}, [this, profile](const Json&, const std::string&) {
+      draft = profile;
+      defaults = draft;
+      dirty = false;
+      m_preserveDraft = true;
+      refresh();
+    });
+  }
+  void Model::remove(const std::string& name) {
+    if (!editable())
+      return;
+    mutate("delete", {{"name", name}}, [this](const Json&, const std::string&) { refresh(); });
+  }
+  void Model::setAutomatic(bool enabled) {
+    if (!editable())
+      return;
+    mutate("set_profile_auto", {{"enabled", enabled}}, [this](const Json&, const std::string&) { refresh(); });
+  }
+  void Model::setManaged(bool enabled) {
+    if (!client.connected() || pending || !transaction.empty() || foreignPreview)
+      return;
+    mutate(enabled ? "manage" : "unmanage", Json::object(), [this](const Json&, const std::string&) { refresh(true); });
+  }
+  Json Model::output() const {
+    for (const auto& value : draft.value("outputs", Json::array()))
+      if (value.value("key", "") == selected)
+        return value;
+    return Json::object();
+  }
+  Json Model::hardware() const {
+    for (const auto& value : document.value("displays", Json::array()))
+      if (value.value("key", "") == selected)
+        return value;
+    return Json::object();
+  }
+  std::filesystem::path Model::settingsPath() const {
+    return std::filesystem::path(environment(
+               "HYPRMONCFG_CONFIG_DIR", environment("XDG_CONFIG_HOME", environment("HOME") + "/.config") + "/hyprmoncfg"
+           ))
+        / "display-settings.json";
+  }
+  void Model::readNicknames() {
+    std::ifstream stream(settingsPath());
+    const auto value = Json::parse(stream, nullptr, false);
+    m_nicknames = value.is_object() ? value.value("nicknames", Json::object()) : Json::object();
+  }
+  std::string Model::label(const std::string& connector) const {
+    const auto value = m_nicknames.find(connector);
+    return value != m_nicknames.end() && value->is_string() && !value->get<std::string>().empty()
+        ? value->get<std::string>()
+        : connector;
+  }
+} // namespace display
diff --git a/src/shell/display/display_model.h b/src/shell/display/display_model.h
new file mode 100644
index 0000000..addfac3
--- /dev/null
+++ b/src/shell/display/display_model.h
@@ -0,0 +1,55 @@
+#pragma once
+#include "shell/display/display_client.h"
+
+#include <filesystem>
+
+namespace display {
+  class Model {
+  public:
+    Model();
+    Client client;
+    Json document = Json::object();
+    Json status = Json::object();
+    Json draft = Json::object();
+    Json defaults = Json::object();
+    Json workspacePlan = Json::array();
+    std::string selected;
+    std::string error;
+    std::string transaction;
+    std::string deadline;
+    bool dirty = false;
+    bool pending = false;
+    bool ready = false;
+    bool foreignPreview = false;
+    bool saveOnCommit = false;
+    std::function<void()> onChanged;
+    void open();
+    void refresh(bool reset = false);
+    void edit(Json fields, bool output = true);
+    void load(const Json& profile);
+    void preview(bool save);
+    void previewProfile(const std::string& name);
+    void finishPreview(bool keep);
+    void save(const std::string& name);
+    void remove(const std::string& name);
+    void setAutomatic(bool enabled);
+    void setManaged(bool enabled);
+    bool editable() const;
+    bool stale() const;
+    Json output() const;
+    Json hardware() const;
+    std::string label(const std::string& connector) const;
+    void readNicknames();
+    std::filesystem::path settingsPath() const;
+
+  private:
+    void changed();
+    void receiveStatus(const Json& value);
+    void mutate(std::string method, Json params, Client::Reply success);
+    Json m_nicknames = Json::object();
+    std::uint64_t m_revision = 0;
+    bool m_reading = false;
+    bool m_preserveDraft = false;
+    bool m_refreshQueued = false;
+  };
+} // namespace display
diff --git a/src/shell/display/display_scene.cpp b/src/shell/display/display_scene.cpp
new file mode 100644
index 0000000..c09366a
--- /dev/null
+++ b/src/shell/display/display_scene.cpp
@@ -0,0 +1,309 @@
+#include "config/config_service.h"
+#include "render/render_context.h"
+#include "shell/display/display_window.h"
+#include "shell/tooltip/tooltip_manager.h"
+#include "ui/builders.h"
+#include "ui/controls/select_dropdown_popup.h"
+#include "wayland/wayland_connection.h"
+
+#include <algorithm>
+#include <cmath>
+#include <ctime>
+#include <format>
+
+using display::Json;
+namespace {
+  auto text(std::string value, ColorRole role = ColorRole::OnSurface, float size = Style::fontSizeBody) {
+    return ui::label({.text = std::move(value), .fontSize = size, .color = colorSpecFromRole(role)});
+  }
+  auto button(std::string label, std::function<void()> callback, bool enabled = true, bool primary = false) {
+    return ui::button(
+        {.text = std::move(label),
+         .enabled = enabled,
+         .variant = primary ? ButtonVariant::Primary : ButtonVariant::Outline,
+         .onClick = std::move(callback)}
+    );
+  }
+  std::string number(double value) { return std::format("{:g}", value); }
+} // namespace
+void DisplayWindow::buildScene() {
+  const float contentWidth = static_cast<float>(m_surface->width()) / scale();
+  const float contentHeight = static_cast<float>(m_surface->height()) / scale();
+  m_rebuildingScene = true;
+  m_brightnessSlider = nullptr;
+  const auto focus = m_input.captureTabFocus();
+  m_input.setSceneRoot(nullptr);
+  m_surface->setSceneRoot(nullptr);
+  if (m_popup)
+    m_popup->closeSelectDropdown();
+  m_scene = ui::node({.width = contentWidth, .height = contentHeight, .animationManager = &m_animations});
+  m_scene->setTransformOrigin(0, 0);
+  m_scene->setScale(scale());
+  m_scene->addChild(
+      ui::box({.fill = colorSpecFromRole(ColorRole::Surface), .width = contentWidth, .height = contentHeight})
+  );
+  m_popup->setParent(
+      m_surface->xdgSurface(), m_surface->wlSurface(), m_wayland->outputForSurface(m_surface->wlSurface())
+  );
+  m_scene->setPopupContext(m_popup.get());
+  auto main = ui::column(
+      {.out = &m_main,
+       .align = FlexAlign::Stretch,
+       .gap = 12,
+       .padding = 18,
+       .width = contentWidth,
+       .height = contentHeight}
+  );
+  main->addChild(
+      ui::row(
+          {.align = FlexAlign::Center, .gap = 12},
+          text(m_confirmationOnly ? "Keep display changes?" : "Display", ColorRole::OnSurface, Style::fontSizeHeader),
+          ui::spacer(), button("Close", [this]() { close(); })
+      )
+  );
+  if (!m_model.transaction.empty()) {
+    auto preview =
+        ui::column({.gap = 8, .padding = 12, .fill = colorSpecFromRole(ColorRole::SurfaceVariant), .radius = 9});
+    preview->addChild(text("Unconfirmed changes automatically roll back after 30 seconds."));
+    std::tm end{};
+    if (::strptime(m_model.deadline.c_str(), "%Y-%m-%dT%H:%M:%S", &end)) {
+      const auto seconds = std::max<std::time_t>(0, ::timegm(&end) - std::time(nullptr));
+      preview->addChild(
+          text(std::to_string(seconds) + " seconds remaining", ColorRole::OnSurfaceVariant, Style::fontSizeCaption)
+      );
+    }
+    preview->addChild(
+        ui::row(
+            {.gap = 12},
+            button(
+                "Revert", [this]() { m_model.finishPreview(false); }, !m_model.pending
+            ),
+            button("Keep changes", [this]() { m_model.finishPreview(true); }, !m_model.pending, true)
+        )
+    );
+    main->addChild(std::move(preview));
+  }
+  if (!m_confirmationOnly) {
+    auto nav = ui::row({.gap = 8});
+    for (const std::string page : {"layout", "workspaces", "profiles"})
+      nav->addChild(
+          ui::button(
+              {.text = page == "layout"   ? "Layout"
+                   : page == "workspaces" ? "Workspaces"
+                                          : "Profiles",
+               .selected = m_page == page,
+               .variant = m_page == page ? ButtonVariant::Primary : ButtonVariant::Outline,
+               .onClick = [this, page]() {
+                 m_page = page;
+                 m_scroll = {};
+                 rebuild();
+               }}
+          )
+      );
+    nav->addChild(ui::spacer());
+    nav->addChild(
+        button("Identify", [this]() { m_identify.show(*m_wayland, *m_render, m_model); }, m_model.editable())
+    );
+    nav->addChild(button("TUI", [this]() { openTui(); }));
+    nav->addChild(button(
+        "Reset",
+        [this]() {
+          m_textBuffers.clear();
+          m_model.refresh(true);
+        },
+        !m_model.pending && m_model.transaction.empty() && !m_model.foreignPreview
+    ));
+    main->addChild(std::move(nav));
+    if (m_model.stale())
+      main->addChild(
+          text("Connected displays changed. Reset to read the current layout before applying.", ColorRole::Error)
+      );
+    if (m_model.foreignPreview)
+      main->addChild(
+          text("Another editor is previewing a display layout. Wait for it to finish.", ColorRole::OnSurfaceVariant)
+      );
+    if (m_model.ready) {
+      if (m_saveName.empty())
+        m_saveName = m_model.draft.value("name", "Current Layout");
+      auto body = ui::column({.align = FlexAlign::Stretch, .gap = 12});
+      if (m_page == "layout") {
+        auto canvasRow = ui::row({.align = FlexAlign::Stretch, .gap = 14});
+        const bool narrow = contentWidth < 1000;
+        if (narrow)
+          canvasRow->setDirection(FlexDirection::Vertical);
+        const float canvasWidth = std::max(280.0F, narrow ? contentWidth - 70 : contentWidth * 0.59F - 45);
+        auto left = ui::column({.align = FlexAlign::Stretch, .gap = 10, .width = canvasWidth});
+        left->addChild(text(
+            "Drag displays to arrange them. Positions snap to neighboring edges.", ColorRole::OnSurfaceVariant,
+            Style::fontSizeCaption
+        ));
+        left->addChild(buildCanvas(canvasWidth, std::max(230.0F, contentHeight * 0.4F)));
+        for (const auto& output : m_model.draft.value("outputs", Json::array())) {
+          const auto key = output.value("key", "");
+          left->addChild(
+              ui::button(
+                  {.text =
+                       m_model.label(output.value("name", "")) + (output.value("enabled", true) ? "" : " · Disabled"),
+                   .selected = key == m_model.selected,
+                   .onClick = [this, key]() {
+                     m_model.selected = key;
+                     m_textBuffers.clear();
+                     rebuild();
+                   }}
+              )
+          );
+        }
+        canvasRow->addChild(std::move(left));
+        auto inspector = buildInspector();
+        if (!narrow)
+          inspector->setFlexGrow(1);
+        canvasRow->addChild(std::move(inspector));
+        body->addChild(std::move(canvasRow));
+      } else
+        body->addChild(m_page == "workspaces" ? buildWorkspaces() : buildProfiles());
+      auto scroll = ui::scrollView({.state = &m_scroll, .flexGrow = 1});
+      scroll->content()->setAlign(FlexAlign::Stretch);
+      scroll->content()->addChild(std::move(body));
+      main->addChild(std::move(scroll));
+      main->addChild(
+          ui::row(
+              {.align = FlexAlign::Center, .gap = 8},
+              text(
+                  m_model.pending     ? "Checking…"
+                      : m_model.dirty ? "Unsaved draft"
+                                      : "Current layout",
+                  ColorRole::OnSurfaceVariant
+              ),
+              ui::spacer(), button("Apply", [this]() { m_model.preview(false); }, m_model.editable(), true)
+          )
+      );
+    } else {
+      main->addChild(text("Connecting to the shared display service…", ColorRole::OnSurfaceVariant));
+      main->addChild(text(
+          "~/.config/quickshell/scripts/install-hyprmoncfg --enable-service", ColorRole::OnSurfaceVariant,
+          Style::fontSizeCaption
+      ));
+    }
+  }
+  if (!m_model.error.empty())
+    main->addChild(text(m_model.error, ColorRole::Error, Style::fontSizeCaption));
+  m_scene->addChild(std::move(main));
+  m_input.setTextInputContext(m_surface->wlSurface(), m_wayland->textInputService());
+  m_input.setCursorShapeCallback([this](std::uint32_t serial, std::uint32_t shape) {
+    m_wayland->setCursorShape(serial, shape);
+  });
+  m_input.setHoverChangeCallback([this](InputArea*, InputArea* next) {
+    TooltipManager::instance().onHoverChange(
+        next, m_surface->xdgSurface(), m_wayland->outputForSurface(m_surface->wlSurface())
+    );
+  });
+  m_input.setSceneRoot(m_scene.get());
+  m_surface->setSceneRoot(m_scene.get());
+  m_scene->layout(m_surface->renderTarget().renderer());
+  m_input.restoreTabFocus(focus);
+  m_rebuild = false;
+  m_rebuildingScene = false;
+}
+std::unique_ptr<Node> DisplayWindow::buildCanvas(float width, float height) {
+  auto canvas = ui::node({.width = width, .height = height, .clipChildren = true});
+  canvas->addChild(
+      ui::box({.fill = colorSpecFromRole(ColorRole::SurfaceVariant), .radius = 9, .width = width, .height = height})
+  );
+  auto outputs = m_model.draft.value("outputs", Json::array());
+  double minX = 0, minY = 0, maxX = 1, maxY = 1;
+  bool first = true;
+  for (const auto& output : outputs) {
+    if (!output.value("enabled", true) || !output.value("mirror_of", "").empty())
+      continue;
+    const auto transform = output.value("transform", 0);
+    const double factor = std::max(0.1, output.value("scale", 1.0));
+    const double w = output.value(transform % 2 ? "height" : "width", 1920) / factor;
+    const double h = output.value(transform % 2 ? "width" : "height", 1080) / factor;
+    const double x = output.value("x", 0), y = output.value("y", 0);
+    if (first) {
+      minX = x;
+      minY = y;
+      maxX = x + w;
+      maxY = y + h;
+      first = false;
+    } else {
+      minX = std::min(minX, x);
+      minY = std::min(minY, y);
+      maxX = std::max(maxX, x + w);
+      maxY = std::max(maxY, y + h);
+    }
+  }
+  const double zoom = std::min((width - 32) / std::max(1.0, maxX - minX), (height - 32) / std::max(1.0, maxY - minY));
+  const double offsetX = (width - (maxX - minX) * zoom) / 2, offsetY = (height - (maxY - minY) * zoom) / 2;
+  for (const auto& output : outputs) {
+    if (!output.value("enabled", true) || !output.value("mirror_of", "").empty())
+      continue;
+    const auto key = output.value("key", "");
+    const auto transform = output.value("transform", 0);
+    const double factor = std::max(0.1, output.value("scale", 1.0));
+    const float w = static_cast<float>(output.value(transform % 2 ? "height" : "width", 1920) / factor * zoom);
+    const float h = static_cast<float>(output.value(transform % 2 ? "width" : "height", 1080) / factor * zoom);
+    const float x = static_cast<float>(offsetX + (output.value("x", 0) - minX) * zoom);
+    const float y = static_cast<float>(offsetY + (output.value("y", 0) - minY) * zoom);
+    auto card = ui::inputArea({.focusable = true, .x = x, .y = y, .width = w, .height = h});
+    auto* cardPtr = card.get();
+    card->addChild(
+        ui::box(
+            {.fill = colorSpecFromRole(key == m_model.selected ? ColorRole::Primary : ColorRole::Surface),
+             .border = colorSpecFromRole(ColorRole::Outline),
+             .borderWidth = 2,
+             .radius = 6,
+             .width = w,
+             .height = h}
+        )
+    );
+    auto contents = ui::column(
+        {.align = FlexAlign::Center, .justify = FlexJustify::Center, .gap = 4, .padding = 6, .width = w, .height = h}
+    );
+    const auto role = key == m_model.selected ? ColorRole::OnPrimary : ColorRole::OnSurface;
+    contents->addChild(text(m_model.label(output.value("name", "")), role, Style::fontSizeTitle));
+    contents->addChild(text(output.value("mode", ""), role, Style::fontSizeMini));
+    contents->addChild(text(
+        number(factor) + "× · " + std::to_string(output.value("x", 0)) + ", " + std::to_string(output.value("y", 0)),
+        role, Style::fontSizeMini
+    ));
+    card->addChild(std::move(contents));
+    struct Drag {
+      bool active = false;
+      float startX = 0, startY = 0;
+    };
+    auto drag = std::make_shared<Drag>();
+    card->setOnPress([this, key, drag, zoom, output](const InputArea::PointerData& data) {
+      if (data.button != BTN_LEFT)
+        return;
+      if (data.pressed) {
+        drag->active = true;
+        drag->startX = data.sceneX;
+        drag->startY = data.sceneY;
+      } else if (drag->active) {
+        drag->active = false;
+        m_model.selected = key;
+        const auto dx = data.sceneX - drag->startX, dy = data.sceneY - drag->startY;
+        if (m_model.editable() && (std::abs(dx) > 3 || std::abs(dy) > 3))
+          m_model.edit(
+              {{"x", output.value("x", 0) + static_cast<int>(std::round(dx / (zoom * scale())))},
+               {"y", output.value("y", 0) + static_cast<int>(std::round(dy / (zoom * scale())))},
+               {"snap_distance", 24}}
+          );
+        else
+          rebuild();
+      }
+    });
+    card->setOnMotion([this, cardPtr, drag, x, y](const InputArea::PointerData& data) {
+      if (drag->active && m_model.editable()) {
+        float pointerX = 0, pointerY = 0;
+        Node::mapToScene(cardPtr, data.localX, data.localY, pointerX, pointerY);
+        cardPtr->setPosition(x + (pointerX - drag->startX) / scale(), y + (pointerY - drag->startY) / scale());
+        m_surface->requestRedraw();
+      }
+    });
+    card->setOnCancel([drag]() { drag->active = false; });
+    canvas->addChild(std::move(card));
+  }
+  return canvas;
+}
diff --git a/src/shell/display/display_window.cpp b/src/shell/display/display_window.cpp
new file mode 100644
index 0000000..939a554
--- /dev/null
+++ b/src/shell/display/display_window.cpp
@@ -0,0 +1,303 @@
+#include "shell/display/display_window.h"
+
+#include "config/config_service.h"
+#include "core/deferred_call.h"
+#include "core/input/keybind_matcher.h"
+#include "core/process/process.h"
+#include "render/render_context.h"
+#include "shell/tooltip/tooltip_manager.h"
+#include "system/brightness_service.h"
+#include "ui/builders.h"
+#include "ui/controls/select_dropdown_popup.h"
+#include "wayland/wayland_connection.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <xkbcommon/xkbcommon-keysyms.h>
+
+DisplayWindow::DisplayWindow() {
+  m_model.onChanged = [this]() {
+    if (!m_model.transaction.empty()) {
+      m_identify.clear();
+      if (!m_previewClock.active())
+        m_previewClock.startRepeating(std::chrono::seconds(1), [this]() { rebuild(); });
+      m_wasPreview = true;
+      if (!isOpen()) {
+        m_confirmationOnly = true;
+        auto alive = m_alive;
+        DeferredCall::callLater([this, alive]() {
+          if (*alive && !m_model.transaction.empty())
+            open();
+        });
+      }
+    }
+    if (m_wasPreview && m_model.transaction.empty() && !m_model.pending) {
+      m_previewClock.stop();
+      m_wasPreview = false;
+      m_textBuffers.clear();
+      if (m_confirmationOnly) {
+        auto alive = m_alive;
+        DeferredCall::callLater([this, alive]() {
+          if (*alive)
+            close();
+        });
+      }
+    }
+    rebuild();
+  };
+}
+DisplayWindow::~DisplayWindow() {
+  *m_alive = false;
+  m_identify.clear();
+  m_previewClock.stop();
+  if (m_watcher && m_nicknameWatch != 0)
+    m_watcher->unwatch(m_nicknameWatch);
+  m_model.onChanged = nullptr;
+  m_model.client.stop();
+  destroyWindow();
+}
+void DisplayWindow::initialize(
+    WaylandConnection& wayland, ConfigService& config, RenderContext& render, FileWatcher& watcher
+) {
+  m_wayland = &wayland;
+  m_config = &config;
+  m_render = &render;
+  m_watcher = &watcher;
+}
+float DisplayWindow::scale() const {
+  return m_config ? std::max(0.1F, m_config->config().accessibility.uiScale) : 1.0F;
+}
+bool DisplayWindow::isOpen() const { return m_surface && m_surface->isRunning(); }
+bool DisplayWindow::ownsKeyboardSurface(wl_surface* surface) const {
+  return surface && ((m_surface && surface == m_surface->wlSurface()) || (m_popup && surface == m_popup->wlSurface()));
+}
+void DisplayWindow::open() {
+  if (!m_wayland || !m_render || !m_wayland->hasXdgShell())
+    return;
+  if (isOpen()) {
+    m_wayland->activateSurface(m_surface->wlSurface());
+    for (const auto& window : m_wayland->windowsForApp("dev.noctalia.noctalia", "dev.noctalia.noctalia")) {
+      if (window.title == (m_confirmationOnly ? "Keep display changes? — Noctalia" : "Display — Noctalia")
+          && window.handle) {
+        m_wayland->activateToplevel(window.handle);
+        break;
+      }
+    }
+    return;
+  }
+  if (m_nicknameWatch == 0 && m_watcher) {
+    m_nicknameWatch = m_watcher->watch(m_model.settingsPath(), [this]() {
+      m_model.readNicknames();
+      rebuild();
+    });
+  }
+  m_model.open();
+  m_surface = std::make_unique<ToplevelSurface>(*m_wayland);
+  m_surface->setRenderContext(m_render);
+  m_surface->setAnimationManager(&m_animations);
+  m_surface->setClosedCallback([this]() {
+    if (!m_model.transaction.empty()) {
+      if (m_confirmationOnly) {
+        m_model.finishPreview(false);
+        return;
+      }
+      destroyWindow();
+      m_confirmationOnly = true;
+      auto alive = m_alive;
+      DeferredCall::callLater([this, alive]() {
+        if (*alive)
+          open();
+      });
+    } else
+      close();
+  });
+  m_surface->setConfigureCallback([this](std::uint32_t, std::uint32_t) { rebuild(); });
+  m_surface->setOutputChangedCallback([this](wl_output*) {
+    if (m_popup)
+      m_popup->closeSelectDropdown();
+    rebuild();
+  });
+  m_surface->setPrepareFrameCallback([this](bool update, bool layout) { prepareFrame(update, layout); });
+  auto output = m_wayland->lastPointerOutput();
+  if (!output && !m_wayland->outputs().empty())
+    output = m_wayland->outputs().front().output;
+  std::uint32_t width = static_cast<std::uint32_t>((m_confirmationOnly ? 580 : 1200) * scale());
+  std::uint32_t height = static_cast<std::uint32_t>((m_confirmationOnly ? 230 : 800) * scale());
+  if (const auto* info = m_wayland->findOutputByWl(output); info && info->hasUsableGeometry()) {
+    width = std::min(width, static_cast<std::uint32_t>(info->effectiveLogicalWidth()));
+    height = std::min(height, static_cast<std::uint32_t>(info->effectiveLogicalHeight()));
+  }
+  if (!m_surface->initialize(
+          output,
+          {.width = width,
+           .height = height,
+           .minWidth = std::min(width, 580U),
+           .minHeight = std::min(height, 230U),
+           .title = m_confirmationOnly ? "Keep display changes? — Noctalia" : "Display — Noctalia",
+           .appId = "dev.noctalia.Noctalia"}
+      )) {
+    m_surface.reset();
+    return;
+  }
+  m_popup = std::make_unique<SelectDropdownPopup>(*m_wayland, *m_render);
+  m_rebuild = true;
+}
+void DisplayWindow::close() {
+  if (!m_model.transaction.empty()) {
+    if (m_confirmationOnly) {
+      m_model.finishPreview(false);
+      return;
+    }
+    destroyWindow();
+    m_confirmationOnly = true;
+    open();
+    return;
+  }
+  destroyWindow();
+  m_confirmationOnly = false;
+}
+void DisplayWindow::destroyWindow() {
+  m_rebuildingScene = true;
+  TooltipManager::instance().forceDestroy();
+  m_input.pointerLeave();
+  m_input.setSceneRoot(nullptr);
+  m_popup.reset();
+  if (m_surface)
+    m_surface->setSceneRoot(nullptr);
+  m_scene.reset();
+  m_main = nullptr;
+  m_brightnessSlider = nullptr;
+  m_surface.reset();
+  m_pointerInside = false;
+  m_rebuildingScene = false;
+}
+void DisplayWindow::rebuild() {
+  m_rebuild = true;
+  if (m_surface)
+    m_surface->requestLayout();
+}
+void DisplayWindow::onAppearanceChanged() { rebuild(); }
+void DisplayWindow::onBrightnessChanged() {
+  if (!m_brightness || !m_brightnessSlider || m_brightnessSlider->dragging())
+    return;
+  if (const auto* display = m_brightness->findDisplay(m_brightnessConnector)) {
+    m_syncBrightness = true;
+    m_brightnessSlider->setValue(static_cast<double>(display->brightness) * 100);
+    m_syncBrightness = false;
+    if (m_surface)
+      m_surface->requestRedraw();
+  }
+}
+void DisplayWindow::prepareFrame(bool, bool layout) {
+  if (!m_surface || !m_render || m_surface->width() == 0 || m_surface->height() == 0)
+    return;
+  m_render->makeCurrent(m_surface->renderTarget());
+  const bool typing = m_input.focusedArea() && m_input.focusedArea()->textInputClient();
+  if (m_scene
+      && m_rebuild
+      && (typing || m_input.pointerCaptured())
+      && !m_model.pending
+      && !m_model.stale()
+      && m_model.transaction.empty()
+      && !m_model.foreignPreview) {
+    if (layout || m_scene->layoutDirty())
+      m_scene->layout(m_surface->renderTarget().renderer());
+    return;
+  }
+  if (!m_scene || m_rebuild)
+    buildScene();
+  else if (layout || m_scene->layoutDirty())
+    m_scene->layout(m_surface->renderTarget().renderer());
+}
+bool DisplayWindow::onPointerEvent(const PointerEvent& event) {
+  if (!isOpen())
+    return false;
+  if (m_popup && m_popup->isSelectDropdownOpen()) {
+    if (m_popup->onPointerEvent(event))
+      return true;
+    if (event.type == PointerEvent::Type::Button && event.pressed) {
+      m_popup->closeSelectDropdown();
+      return true;
+    }
+  }
+  const bool here = event.surface == m_surface->wlSurface();
+  if (!here && !m_pointerInside)
+    return false;
+  const auto x = static_cast<float>(event.sx), y = static_cast<float>(event.sy);
+  switch (event.type) {
+  case PointerEvent::Type::Enter:
+    m_pointerInside = here;
+    if (here)
+      m_input.pointerEnter(x, y, event.serial);
+    break;
+  case PointerEvent::Type::Leave:
+    if (here) {
+      m_pointerInside = false;
+      m_input.pointerLeave();
+    }
+    break;
+  case PointerEvent::Type::Motion:
+    m_input.pointerMotion(x, y, m_wayland->lastInputSerial());
+    break;
+  case PointerEvent::Type::Button:
+    m_input.pointerMotion(x, y, event.serial);
+    if (event.pressed && event.button == BTN_LEFT && y < 65 * scale() && !m_input.hoveredArea())
+      m_surface->beginMove(event.serial);
+    else
+      m_input.pointerButton(x, y, event.button, event.pressed, event.serial, event.time, event.touch);
+    break;
+  case PointerEvent::Type::Axis:
+    m_input.pointerAxis(
+        x, y, event.axis, event.axisSource, event.axisValue, event.axisDiscrete, event.axisValue120, event.axisLines
+    );
+    break;
+  }
+  if (m_scene && m_scene->layoutDirty())
+    m_surface->requestLayout();
+  else if (m_scene && m_scene->paintDirty())
+    m_surface->requestRedraw();
+  return here || m_pointerInside;
+}
+void DisplayWindow::onKeyboardEvent(const KeyboardEvent& event) {
+  if (m_popup && m_popup->isSelectDropdownOpen()) {
+    m_popup->onKeyboardEvent(event);
+    return;
+  }
+  if (event.pressed && KeybindMatcher::matches(KeybindAction::Cancel, event.sym, event.modifiers)) {
+    close();
+    return;
+  }
+  if (event.pressed && !event.preedit && (event.modifiers & KeyMod::Ctrl) != 0) {
+    if (event.sym == XKB_KEY_s) {
+      m_model.save(m_saveName);
+      return;
+    }
+    if (event.sym == XKB_KEY_Return) {
+      m_model.preview(false);
+      return;
+    }
+  }
+  m_input.keyEvent(event.sym, event.utf32, event.modifiers, event.pressed, event.preedit);
+  if (m_surface)
+    m_surface->requestLayout();
+}
+
+void DisplayWindow::openTui() {
+  const auto environment = [](const char* key, std::string fallback) {
+    const char* value = std::getenv(key);
+    return value && *value ? std::string(value) : std::move(fallback);
+  };
+  const auto home = environment("HOME", "");
+  const auto backend = environment(
+      "NOCTALIA_DISPLAY_BACKEND",
+      environment("XDG_CONFIG_HOME", home + "/.config") + "/quickshell/shared/display/backend"
+  );
+  const auto terminal = environment("NOCTALIA_DISPLAY_TERMINAL", home + "/bin/launch-terminal");
+  if (!std::filesystem::path(backend).is_absolute()
+      || !std::filesystem::path(terminal).is_absolute()
+      || !process::runAsync(std::vector<std::string>{terminal, backend, "tui"})) {
+    m_model.error = "Could not open the display TUI.";
+    rebuild();
+  }
+}
