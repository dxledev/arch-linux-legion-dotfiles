diff --git a/tests/display_editor_test.cpp b/tests/display_editor_test.cpp
new file mode 100644
index 0000000..d7392f9
--- /dev/null
+++ b/tests/display_editor_test.cpp
@@ -0,0 +1,229 @@
+#include "shell/display/display_model.h"
+#include "test_check.h"
+
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+using display::Json;
+namespace {
+  class Daemon {
+  public:
+    Daemon() {
+      std::array<char, 64> path{};
+      std::strcpy(path.data(), "/tmp/noctalia-display-test.XXXXXX");
+      TEST_CHECK(::mkdtemp(path.data()) != nullptr);
+      directory = path.data();
+      ::setenv("XDG_RUNTIME_DIR", directory.c_str(), 1);
+      ::setenv("HYPRMONCFG_CONFIG_DIR", directory.c_str(), 1);
+      server = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+      TEST_CHECK(server >= 0);
+      sockaddr_un address{};
+      address.sun_family = AF_UNIX;
+      const auto socket = directory + "/hyprmoncfgd.sock";
+      std::memcpy(address.sun_path, socket.c_str(), socket.size() + 1);
+      TEST_CHECK(::bind(server, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0);
+      TEST_CHECK(::listen(server, 1) == 0);
+    }
+    ~Daemon() {
+      if (peer >= 0)
+        ::close(peer);
+      ::close(server);
+      ::unlink((directory + "/hyprmoncfgd.sock").c_str());
+      ::unlink((directory + "/display-settings.json").c_str());
+      ::rmdir(directory.c_str());
+    }
+    void accept() {
+      peer = ::accept4(server, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+      TEST_CHECK(peer >= 0);
+    }
+    Json next() {
+      for (int count = 0; count < 100; ++count) {
+        const auto end = buffer.find('\n');
+        if (end != std::string::npos) {
+          const auto line = buffer.substr(0, end);
+          buffer.erase(0, end + 1);
+          return Json::parse(line);
+        }
+        pollfd ready{.fd = peer, .events = POLLIN, .revents = 0};
+        TEST_CHECK(::poll(&ready, 1, 50) > 0);
+        char chunk[8192];
+        const auto size = ::recv(peer, chunk, sizeof(chunk), 0);
+        TEST_CHECK(size > 0);
+        buffer.append(chunk, static_cast<std::size_t>(size));
+      }
+      TEST_CHECK(false);
+      return {};
+    }
+    void send(const Json& value) {
+      const auto text = value.dump() + "\n";
+      TEST_CHECK(::send(peer, text.data(), text.size(), MSG_NOSIGNAL) == static_cast<ssize_t>(text.size()));
+    }
+    void reply(const Json& request, Json result) {
+      send({{"type", "response"}, {"protocol_version", 1}, {"id", request.at("id")}, {"result", std::move(result)}});
+    }
+    void status(Json value) {
+      send({{"type", "event"}, {"protocol_version", 1}, {"event", "status"}, {"data", std::move(value)}});
+    }
+    void pump(display::Client& client) {
+      std::vector<pollfd> fds;
+      const auto start = client.addPollFds(fds);
+      TEST_CHECK(!fds.empty());
+      TEST_CHECK(::poll(fds.data(), static_cast<nfds_t>(fds.size()), 100) > 0);
+      client.dispatch(fds, start);
+    }
+    std::string directory;
+    int peer = -1;
+
+  private:
+    int server = -1;
+    std::string buffer;
+  };
+  Json profile(int x = 0) {
+    return {
+        {"name", "Desk"},
+        {"outputs", Json::array({{{"key", "panel"}, {"name", "DP-1"}, {"enabled", true}, {"x", x}, {"y", 0}}})},
+        {"workspaces", {{"enabled", false}}}
+    };
+  }
+  Json status(const std::string& hash = "one") { return {{"monitor_set_hash", hash}, {"daemon", {{"running", true}}}}; }
+  Json editor(int x = 0, const std::string& hash = "one") {
+    return {
+        {"monitor_set_hash", hash},
+        {"profile", profile(x)},
+        {"profiles", Json::array({profile()})},
+        {"workspace_plan", Json::array()}
+    };
+  }
+  void initial(Daemon& daemon, display::Model& model) {
+    model.open();
+    daemon.accept();
+    auto subscribe = daemon.next();
+    TEST_CHECK(subscribe.at("method") == "subscribe");
+    auto read = daemon.next();
+    TEST_CHECK(read.at("method") == "editor_state");
+    daemon.reply(subscribe, status());
+    daemon.reply(read, editor());
+    daemon.pump(model.client);
+    read = daemon.next();
+    daemon.reply(read, editor());
+    daemon.pump(model.client);
+    TEST_CHECK(model.ready);
+    TEST_CHECK(model.editable());
+  }
+} // namespace
+int main() {
+  Daemon daemon;
+  display::Model model;
+  initial(daemon, model);
+  TEST_CHECK(model.selected == "panel");
+  std::ofstream(daemon.directory + "/display-settings.json") << R"({"nicknames":{"DP-1":"Desk display"},"unknown":42})";
+  model.readNicknames();
+  TEST_CHECK(model.label("DP-1") == "Desk display");
+  TEST_CHECK(model.label("eDP-1") == "eDP-1");
+  model.edit({{"x", 100}});
+  auto request = daemon.next();
+  TEST_CHECK(request.at("method") == "edit_profile");
+  TEST_CHECK(request.at("params").at("edit").at("output_key") == "panel");
+  TEST_CHECK(model.pending);
+  TEST_CHECK(!model.editable());
+  daemon.reply(request, {{"profile", profile(100)}, {"workspace_plan", Json::array()}});
+  daemon.pump(model.client);
+  TEST_CHECK(model.dirty);
+  TEST_CHECK(model.output().at("x") == 100);
+  daemon.status(status());
+  daemon.pump(model.client);
+  request = daemon.next();
+  daemon.reply(request, editor());
+  daemon.pump(model.client);
+  TEST_CHECK(model.output().at("x") == 100);
+  model.save("Saved desk");
+  request = daemon.next();
+  TEST_CHECK(request.at("method") == "save");
+  TEST_CHECK(request.at("params").at("profile").at("name") == "Saved desk");
+  daemon.reply(request, Json::object());
+  daemon.pump(model.client);
+  request = daemon.next();
+  daemon.reply(request, editor());
+  daemon.pump(model.client);
+  TEST_CHECK(model.output().at("x") == 100);
+  TEST_CHECK(!model.dirty);
+  model.draft["name"] = "";
+  model.preview(false);
+  request = daemon.next();
+  TEST_CHECK(request.at("method") == "preview");
+  TEST_CHECK(request.at("params").at("timeout_seconds") == 30);
+  TEST_CHECK(request.at("params").at("profile").at("name") == "draft");
+  auto active = status();
+  active["daemon"]["preview"] = {{"transaction_id", "preview-one"}};
+  daemon.status(active);
+  daemon.reply(request, {{"id", "preview-one"}, {"deadline", "soon"}});
+  daemon.pump(model.client);
+  TEST_CHECK(model.transaction == "preview-one");
+  TEST_CHECK(!model.foreignPreview);
+  model.finishPreview(true);
+  request = daemon.next();
+  TEST_CHECK(request.at("method") == "commit");
+  TEST_CHECK(request.at("params").at("transaction_id") == "preview-one");
+  daemon.reply(request, Json::object());
+  daemon.status(status());
+  daemon.pump(model.client);
+  request = daemon.next();
+  daemon.reply(request, editor());
+  daemon.pump(model.client);
+  request = daemon.next();
+  daemon.reply(request, editor());
+  daemon.pump(model.client);
+  TEST_CHECK(model.transaction.empty());
+  daemon.status(active);
+  daemon.pump(model.client);
+  TEST_CHECK(model.foreignPreview);
+  TEST_CHECK(!model.editable());
+  daemon.status(status());
+  daemon.pump(model.client);
+  request = daemon.next();
+  daemon.reply(request, editor());
+  daemon.pump(model.client);
+  model.edit({{"x", 200}});
+  request = daemon.next();
+  daemon.reply(request, {{"profile", profile(200)}});
+  daemon.pump(model.client);
+  daemon.status(status("two"));
+  daemon.pump(model.client);
+  request = daemon.next();
+  daemon.reply(request, editor(0, "two"));
+  daemon.pump(model.client);
+  TEST_CHECK(model.stale());
+  TEST_CHECK(!model.editable());
+  TEST_CHECK(model.output().at("x") == 200);
+  model.refresh(true);
+  request = daemon.next();
+  daemon.reply(request, editor(0, "two"));
+  daemon.pump(model.client);
+  TEST_CHECK(!model.stale());
+  TEST_CHECK(model.editable());
+  TEST_CHECK(!model.dirty);
+  model.edit({{"enabled", false}});
+  request = daemon.next();
+  daemon.send(
+      {{"type", "response"},
+       {"protocol_version", 1},
+       {"id", request.at("id")},
+       {"error", {{"message", "At least one display must stay enabled."}}}}
+  );
+  daemon.pump(model.client);
+  TEST_CHECK(!model.pending);
+  TEST_CHECK(model.output().at("enabled") == true);
+  TEST_CHECK(!model.error.empty());
+  ::close(daemon.peer);
+  daemon.peer = -1;
+  daemon.pump(model.client);
+  TEST_CHECK(!model.client.connected());
+  TEST_CHECK(!model.editable());
+  std::cout << "Native display editor IPC, drafts, previews, topology, and nickname checks passed\n";
+}
