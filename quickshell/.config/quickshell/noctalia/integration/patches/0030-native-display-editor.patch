diff --git a/src/shell/display/display_client.cpp b/src/shell/display/display_client.cpp
new file mode 100644
index 0000000..ce36e73
--- /dev/null
+++ b/src/shell/display/display_client.cpp
@@ -0,0 +1,207 @@
+#include "shell/display/display_client.h"
+
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <utility>
+
+namespace display {
+  Client::~Client() { stop(); }
+
+  void Client::start() {
+    if (m_running)
+      return;
+    m_running = true;
+    connect();
+    m_retry.startRepeating(std::chrono::seconds(2), [this]() {
+      if (m_fd < 0)
+        connect();
+      for (const auto& [id, pending] : m_pending) {
+        (void)id;
+        if (std::chrono::steady_clock::now() >= pending.deadline) {
+          disconnect();
+          return;
+        }
+      }
+    });
+  }
+
+  void Client::stop() {
+    m_running = false;
+    m_retry.stop();
+    onConnection = nullptr;
+    onStatus = nullptr;
+    m_pending.clear();
+    if (m_fd >= 0)
+      ::close(m_fd);
+    m_fd = -1;
+  }
+
+  void Client::connect() {
+    const char* runtime = std::getenv("XDG_RUNTIME_DIR");
+    if (runtime == nullptr || runtime[0] != '/') {
+      if (onConnection)
+        onConnection(false);
+      return;
+    }
+    const std::string path = std::string(runtime) + "/hyprmoncfgd.sock";
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    if (path.size() >= sizeof(address.sun_path))
+      return;
+    std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+    m_fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+    if (m_fd < 0)
+      return;
+    if (::connect(m_fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0) {
+      if (errno == EINPROGRESS) {
+        m_connecting = true;
+        return;
+      }
+      disconnect();
+      return;
+    }
+    m_connecting = false;
+    if (onConnection)
+      onConnection(true);
+  }
+
+  void Client::disconnect() {
+    if (m_fd >= 0)
+      ::close(m_fd);
+    m_fd = -1;
+    m_connecting = false;
+    m_input.clear();
+    m_output.clear();
+    auto pending = std::exchange(m_pending, {});
+    if (onConnection)
+      onConnection(false);
+    for (auto& [id, entry] : pending) {
+      (void)id;
+      if (entry.reply)
+        entry.reply({}, "Display service disconnected; unconfirmed previews roll back.");
+    }
+  }
+
+  bool Client::request(std::string method, Json params, Reply reply) {
+    if (!connected())
+      return false;
+    const auto id = std::to_string(++m_sequence);
+    m_pending.emplace(id, Pending{std::move(reply), std::chrono::steady_clock::now() + std::chrono::seconds(15)});
+    m_output +=
+        Json{
+            {"type", "request"},
+            {"protocol_version", 1},
+            {"id", id},
+            {"method", std::move(method)},
+            {"params", std::move(params)}
+        }.dump()
+        + "\n";
+    flush();
+    return true;
+  }
+
+  void Client::doAddPollFds(std::vector<pollfd>& fds) {
+    if (m_fd >= 0)
+      fds.push_back(
+          {.fd = m_fd,
+           .events = static_cast<short>(POLLIN | ((m_connecting || !m_output.empty()) ? POLLOUT : 0)),
+           .revents = 0}
+      );
+  }
+
+  void Client::dispatch(const std::vector<pollfd>& fds, std::size_t index) {
+    if (m_fd < 0 || index >= fds.size() || fds[index].fd != m_fd)
+      return;
+    const auto flags = fds[index].revents;
+    if ((flags & (POLLERR | POLLHUP | POLLNVAL)) != 0) {
+      disconnect();
+      return;
+    }
+    if (m_connecting && (flags & POLLOUT) != 0) {
+      int error = 0;
+      socklen_t length = sizeof(error);
+      if (::getsockopt(m_fd, SOL_SOCKET, SO_ERROR, &error, &length) < 0 || error != 0) {
+        disconnect();
+        return;
+      }
+      m_connecting = false;
+      if (onConnection)
+        onConnection(true);
+    }
+    if ((flags & POLLOUT) != 0)
+      flush();
+    if ((flags & POLLIN) != 0 && m_fd >= 0)
+      receive();
+  }
+
+  void Client::flush() {
+    while (connected() && !m_output.empty()) {
+      const auto written = ::send(m_fd, m_output.data(), m_output.size(), MSG_NOSIGNAL);
+      if (written > 0)
+        m_output.erase(0, static_cast<std::size_t>(written));
+      else if (written < 0 && errno == EINTR)
+        continue;
+      else if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+        return;
+      else {
+        disconnect();
+        return;
+      }
+    }
+  }
+
+  void Client::receive() {
+    char buffer[8192];
+    while (m_fd >= 0) {
+      const auto count = ::recv(m_fd, buffer, sizeof(buffer), 0);
+      if (count > 0) {
+        m_input.append(buffer, static_cast<std::size_t>(count));
+        if (m_input.size() > 4 * 1024 * 1024) {
+          disconnect();
+          return;
+        }
+        std::size_t end;
+        while ((end = m_input.find('\n')) != std::string::npos) {
+          const auto line = m_input.substr(0, end);
+          m_input.erase(0, end + 1);
+          message(line);
+        }
+      } else if (count < 0 && errno == EINTR)
+        continue;
+      else if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+        return;
+      else {
+        disconnect();
+        return;
+      }
+    }
+  }
+
+  void Client::message(const std::string& line) {
+    const auto value = Json::parse(line, nullptr, false);
+    if (!value.is_object() || value.value("protocol_version", 0) != 1) {
+      disconnect();
+      return;
+    }
+    if (value.value("type", "") == "event" && value.value("event", "") == "status") {
+      if (onStatus)
+        onStatus(value.value("data", Json::object()));
+      return;
+    }
+    const auto entry = m_pending.find(value.value("id", ""));
+    if (entry == m_pending.end())
+      return;
+    auto reply = std::move(entry->second.reply);
+    m_pending.erase(entry);
+    const auto error = value.find("error");
+    if (reply)
+      reply(
+          value.value("result", Json::object()),
+          error != value.end() && error->is_object() ? error->value("message", "Display request failed.") : ""
+      );
+  }
+} // namespace display
diff --git a/src/shell/display/display_client.h b/src/shell/display/display_client.h
new file mode 100644
index 0000000..2dd6a50
--- /dev/null
+++ b/src/shell/display/display_client.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include "app/poll_source.h"
+#include "core/timer_manager.h"
+
+#include <functional>
+#include <map>
+#include <nlohmann/json.hpp>
+#include <string>
+
+namespace display {
+  using Json = nlohmann::json;
+
+  class Client final : public PollSource {
+  public:
+    using Reply = std::function<void(const Json&, const std::string&)>;
+    ~Client() override;
+    void start();
+    void stop();
+    bool request(std::string method, Json params, Reply reply);
+    bool connected() const { return m_fd >= 0 && !m_connecting; }
+    std::function<void(bool)> onConnection;
+    std::function<void(const Json&)> onStatus;
+    void dispatch(const std::vector<pollfd>& fds, std::size_t index) override;
+
+  protected:
+    void doAddPollFds(std::vector<pollfd>& fds) override;
+
+  private:
+    struct Pending {
+      Reply reply;
+      std::chrono::steady_clock::time_point deadline;
+    };
+    void connect();
+    void disconnect();
+    void flush();
+    void receive();
+    void message(const std::string& line);
+    int m_fd = -1;
+    bool m_connecting = false;
+    bool m_running = false;
+    unsigned long m_sequence = 0;
+    std::string m_input;
+    std::string m_output;
+    std::map<std::string, Pending> m_pending;
+    Timer m_retry;
+  };
+} // namespace display
