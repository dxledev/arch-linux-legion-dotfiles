+
+namespace {
+
+  using namespace std::chrono;
+  using namespace calendar::local;
+
+  bool expect(bool condition, const char* message) {
+    if (!condition) {
+      std::println(stderr, "local_calendar_test: {}", message);
+    }
+    return condition;
+  }
+
+  system_clock::time_point localMidnight(int y, int m, int d) {
+    std::tm value{};
+    value.tm_year = y - 1900;
+    value.tm_mon = m - 1;
+    value.tm_mday = d;
+    value.tm_isdst = -1;
+    return system_clock::from_time_t(std::mktime(&value));
+  }
+
+  bool onDay(const CalendarEvent& event, int y, int m, int d) {
+    const std::time_t raw = system_clock::to_time_t(event.start);
+    std::tm value{};
+    localtime_r(&raw, &value);
+    return value.tm_year + 1900 == y && value.tm_mon + 1 == m && value.tm_mday == d;
+  }
+
+  bool hasEvent(const std::vector<CalendarEvent>& events, const char* title, int y, int m, int d) {
+    return std::ranges::any_of(events, [&](const CalendarEvent& event) {
+      return event.title == title && onDay(event, y, m, d);
+    });
+  }
+
+} // namespace
