+    constexpr std::string_view kHolidayColor = "#FBBF24";
+    constexpr std::string_view kObservanceColor = "#F472B6";
+    constexpr std::string_view kGlobalColor = "#38BDF8";
+    constexpr std::string_view kAstroColor = "#A78BFA";
+    constexpr std::string_view kTaskColor = "#4ADE80";
+
+    constexpr std::array<std::string_view, 7> kWeekdayNames = {"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"};
+    constexpr std::array<std::string_view, 4> kMoonNames = {
+        "New Moon", "First Quarter Moon", "Full Moon", "Last Quarter Moon"
+    };
+
+    using TimePoint = chrono::system_clock::time_point;
+
+    struct Entry {
+      CalendarEvent event;
+      Kind kind;
+    };
+
+    std::string_view kindColor(Kind kind) {
+      switch (kind) {
+      case Kind::Holiday:
+        return kHolidayColor;
+      case Kind::Observance:
+        return kObservanceColor;
+      case Kind::Global:
+        return kGlobalColor;
+      case Kind::Astro:
+        return kAstroColor;
+      }
+      return kGlobalColor;
+    }
+
+    std::string_view kindLabel(Kind kind) {
+      switch (kind) {
+      case Kind::Holiday:
+        return "Holiday";
+      case Kind::Observance:
+        return "Observance";
+      case Kind::Global:
+        return "Global event";
+      case Kind::Astro:
+        return "Sky event";
+      }
+      return {};
+    }
+
+    TimePoint localMidnight(int year, int month0, int day) {
+      std::tm value{};
+      value.tm_year = year - 1900;
+      value.tm_mon = month0;
+      value.tm_mday = day;
+      value.tm_isdst = -1;
+      return chrono::system_clock::from_time_t(std::mktime(&value));
+    }
+
+    std::tm localTm(TimePoint time) {
+      const std::time_t raw = chrono::system_clock::to_time_t(time);
+      std::tm value{};
+      localtime_r(&raw, &value);
+      return value;
+    }
+
+    chrono::sys_days civil(int year, int month0, int day) {
+      return chrono::sys_days{chrono::year{year} / chrono::month{static_cast<unsigned>(month0 + 1)} / chrono::day{static_cast<unsigned>(day)}};
+    }
+
+    // Weekday (0 = Sunday) of a civil date.
+    int weekdayOf(int year, int month0, int day) {
+      return static_cast<int>(chrono::weekday{civil(year, month0, day)}.c_encoding());
+    }
+
+    int daysInMonth(int year, int month0) {
+      const auto last = chrono::year{year} / chrono::month{static_cast<unsigned>(month0 + 1)} / chrono::last;
+      return static_cast<int>(static_cast<unsigned>(last.day()));
+    }
+
+    // The nth (1-based) weekday (0 = Sunday) of a month.
+    int nthWeekday(int year, int month0, int weekday, int n) {
+      const int first = weekdayOf(year, month0, 1);
+      return 1 + ((weekday - first + 7) % 7) + (n - 1) * 7;
+    }
+
+    int lastWeekday(int year, int month0, int weekday) {
+      const int last = daysInMonth(year, month0);
+      return last - ((weekdayOf(year, month0, last) - weekday + 7) % 7);
+    }
+
+    // Anonymous Gregorian algorithm: {month0, day}.
+    std::pair<int, int> easter(int year) {
+      const int a = year % 19;
+      const int b = year / 100;
+      const int c = year % 100;
+      const int d = b / 4;
+      const int e = b % 4;
+      const int f = (b + 8) / 25;
+      const int g = (b - f + 1) / 3;
+      const int h = (19 * a + b - d - g + 15) % 30;
+      const int i = c / 4;
+      const int k = c % 4;
+      const int l = (32 + 2 * e + 2 * i - h - k) % 7;
+      const int m = (a + 11 * h + 22 * l) / 451;
+      const int month = (h + l - 7 * m + 114) / 31;
+      const int day = ((h + l - 7 * m + 114) % 31) + 1;
+      return {month - 1, day};
+    }
+
+    // Moon phases after Meeus, Astronomical Algorithms ch. 49 (main periodic terms). `k` counts
+    // lunations from 2000-01-06: whole numbers are new moons, then quarters at +0.25 steps.
+    // Returns Unix milliseconds.
+    double moonPhaseMillis(double k) {
+      constexpr double rad = std::numbers::pi / 180.0;
+      const double t = k / 1236.85;
+      const double t2 = t * t;
+      const double t3 = t2 * t;
+      const double t4 = t3 * t;
+      const double jde =
+          2451550.09766 + 29.530588861 * k + 0.00015437 * t2 - 0.00000015 * t3 + 0.00000000073 * t4;
+      const double e = 1 - 0.002516 * t - 0.0000074 * t2;
+      const double m = (2.5534 + 29.10535670 * k - 0.0000014 * t2 - 0.00000011 * t3) * rad;
+      const double mp = (201.5643 + 385.81693528 * k + 0.0107582 * t2 + 0.00001238 * t3 - 0.000000058 * t4) * rad;
+      const double f = (160.7108 + 390.67050284 * k - 0.0016118 * t2 - 0.00000227 * t3 + 0.000000011 * t4) * rad;
+      const double o = (124.7746 - 1.56375588 * k + 0.0020672 * t2 + 0.00000215 * t3) * rad;
+      const int phase = static_cast<int>(std::floor((k - std::floor(k)) * 4 + 0.5)) % 4;
+      const auto s = [](double x) { return std::sin(x); };
+      const auto c = [](double x) { return std::cos(x); };
+      double corr = 0.0;
+      if (phase == 0) {
+        corr = -0.40720 * s(mp) + 0.17241 * e * s(m) + 0.01608 * s(2 * mp) + 0.01039 * s(2 * f)
+            + 0.00739 * e * s(mp - m) - 0.00514 * e * s(mp + m) + 0.00208 * e * e * s(2 * m)
+            - 0.00111 * s(mp - 2 * f) - 0.00057 * s(mp + 2 * f) + 0.00056 * e * s(2 * mp + m)
+            - 0.00042 * s(3 * mp) + 0.00042 * e * s(m + 2 * f) + 0.00038 * e * s(m - 2 * f)
+            - 0.00024 * e * s(2 * mp - m) - 0.00017 * s(o);
+      } else if (phase == 2) {
+        corr = -0.40614 * s(mp) + 0.17302 * e * s(m) + 0.01614 * s(2 * mp) + 0.01043 * s(2 * f)
+            + 0.00734 * e * s(mp - m) - 0.00515 * e * s(mp + m) + 0.00209 * e * e * s(2 * m)
+            - 0.00111 * s(mp - 2 * f) - 0.00057 * s(mp + 2 * f) + 0.00056 * e * s(2 * mp + m)
+            - 0.00042 * s(3 * mp) + 0.00042 * e * s(m + 2 * f) + 0.00038 * e * s(m - 2 * f)
+            - 0.00024 * e * s(2 * mp - m) - 0.00017 * s(o);
+      } else {
+        corr = -0.62801 * s(mp) + 0.17172 * e * s(m) - 0.01183 * e * s(mp + m) + 0.00862 * s(2 * mp)
+            + 0.00804 * s(2 * f) + 0.00454 * e * s(mp - m) + 0.00204 * e * e * s(2 * m)
+            - 0.00180 * s(mp - 2 * f) - 0.00070 * s(mp + 2 * f) - 0.00040 * s(3 * mp)
+            - 0.00034 * e * s(2 * mp - m) + 0.00032 * e * s(m + 2 * f) + 0.00032 * e * s(m - 2 * f)
+            - 0.00028 * e * e * s(mp + 2 * m) + 0.00027 * e * s(2 * mp + m) - 0.00017 * s(o);
+        const double w = 0.00306 - 0.00038 * e * c(m) + 0.00026 * c(mp) - 0.00002 * c(mp - m)
+            + 0.00002 * c(mp + m) + 0.00002 * c(2 * f);
+        corr += phase == 1 ? w : -w;
+      }
+      return (jde + corr - 2440587.5) * 86400000.0;
+    }
+
+    TimePoint fromMillis(double millis) {
+      return TimePoint{chrono::duration_cast<chrono::system_clock::duration>(chrono::duration<double, std::milli>(millis))};
+    }
+
+    // "yyyy-mm-ddThh:mm:ssZ".
+    std::optional<TimePoint> parseInstant(std::string_view text) {
+      int y = 0;
+      int mo = 0;
+      int d = 0;
+      int h = 0;
+      int mi = 0;
+      int s = 0;
+      const std::string owned(text);
+      if (std::sscanf(owned.c_str(), "%d-%d-%dT%d:%d:%dZ", &y, &mo, &d, &h, &mi, &s) != 6) {
+        return std::nullopt;
+      }
+      return chrono::sys_days{chrono::year{y} / chrono::month{static_cast<unsigned>(mo)} / chrono::day{static_cast<unsigned>(d)}}
+          + chrono::hours{h} + chrono::minutes{mi} + chrono::seconds{s};
+    }
+
+    Entry allDayEntry(TimePoint start, std::string_view title, Kind kind) {
+      Entry entry;
+      entry.kind = kind;
+      entry.event.title = std::string(title);
+      entry.event.calendarName = std::string(kindLabel(kind));
+      entry.event.kindLabel = std::string(kindLabel(kind));
+      entry.event.colorHex = std::string(kindColor(kind));
+      entry.event.start = start;
+      entry.event.end = start + chrono::hours{24};
+      entry.event.allDay = true;
+      return entry;
+    }
+
+    Entry instantEntry(TimePoint when, std::string_view title, Kind kind) {
+      Entry entry = allDayEntry(when, title, kind);
+      entry.event.end = when;
+      entry.event.allDay = false;
+      return entry;
+    }
+
+    void buildYear(int year, std::vector<Entry>& out) {
+      const auto add = [&](int month0, int day, std::string_view title, Kind kind) {
+        out.push_back(allDayEntry(localMidnight(year, month0, day), title, kind));
+      };
+      const auto addInstant = [&](TimePoint when, std::string_view title, Kind kind) {
+        out.push_back(instantEntry(when, title, kind));
+      };
+
+      // US federal holidays.
+      add(0, 1, "New Year's Day", Kind::Holiday);
+      add(0, nthWeekday(year, 0, 1, 3), "Martin Luther King Jr. Day", Kind::Holiday);
+      add(1, nthWeekday(year, 1, 1, 3), "Presidents' Day", Kind::Holiday);
+      add(4, lastWeekday(year, 4, 1), "Memorial Day", Kind::Holiday);
+      if (year >= 2021) {
+        add(5, 19, "Juneteenth", Kind::Holiday);
+      }
+      add(6, 4, "Independence Day", Kind::Holiday);
+      add(8, nthWeekday(year, 8, 1, 1), "Labor Day", Kind::Holiday);
+      add(9, nthWeekday(year, 9, 1, 2), "Indigenous Peoples' Day / Columbus Day", Kind::Holiday);
+      add(10, 11, "Veterans Day", Kind::Holiday);
+      add(10, nthWeekday(year, 10, 4, 4), "Thanksgiving", Kind::Holiday);
+      add(11, 25, "Christmas Day", Kind::Holiday);
+
+      // Widely observed days.
+      const auto [easterMonth, easterDay] = easter(year);
+      const chrono::sys_days easterDate = civil(year, easterMonth, easterDay);
+      const auto addEaster = [&](int offset, std::string_view title) {
+        const chrono::year_month_day ymd{easterDate + chrono::days{offset}};
+        add(static_cast<int>(static_cast<unsigned>(ymd.month())) - 1, static_cast<int>(static_cast<unsigned>(ymd.day())), title, Kind::Observance);
+      };
+      addEaster(-2, "Good Friday");
+      addEaster(0, "Easter Sunday");
+      add(1, 2, "Groundhog Day", Kind::Observance);
+      add(1, 14, "Valentine's Day", Kind::Observance);
+      add(2, 17, "St. Patrick's Day", Kind::Observance);
+      add(3, 1, "April Fools' Day", Kind::Observance);
+      add(3, 15, "Tax Day (US)", Kind::Observance);
+      add(4, 5, "Cinco de Mayo", Kind::Observance);
+      add(4, nthWeekday(year, 4, 0, 2), "Mother's Day", Kind::Observance);
+      add(5, nthWeekday(year, 5, 0, 3), "Father's Day", Kind::Observance);
+      add(9, 31, "Halloween", Kind::Observance);
+      add(10, nthWeekday(year, 10, 4, 4) + 1, "Black Friday", Kind::Observance);
+      if (year % 2 == 0) {
+        add(10, nthWeekday(year, 10, 1, 1) + 1, "Election Day (US)", Kind::Observance);
+      }
+      add(11, 24, "Christmas Eve", Kind::Observance);
+      add(11, 31, "New Year's Eve", Kind::Observance);
+
+      // International days and civil changes.
+      add(2, nthWeekday(year, 2, 0, 2), "Daylight Saving Time begins (US)", Kind::Global);
+      add(10, nthWeekday(year, 10, 0, 1), "Daylight Saving Time ends (US)", Kind::Global);
+      add(2, 8, "International Women's Day", Kind::Global);
+      add(2, 14, "Pi Day", Kind::Global);
+      add(3, 7, "World Health Day", Kind::Global);
+      add(3, 22, "Earth Day", Kind::Global);
+      add(4, 1, "International Workers' Day", Kind::Global);
+      add(5, 5, "World Environment Day", Kind::Global);
+      add(5, 8, "World Oceans Day", Kind::Global);
+      add(8, 21, "International Day of Peace", Kind::Global);
+      add(9, 24, "United Nations Day", Kind::Global);
+      add(11, 10, "Human Rights Day", Kind::Global);
+
+      // Lunar, religious and one-off events from the tables.
+      const std::string prefix = std::to_string(year) + "-";
+      for (const TableEvent& item : kMovableEvents) {
+        if (!item.when.starts_with(prefix)) {
+          continue;
+        }
+        if (item.when.size() > 10) {
+          if (const auto instant = parseInstant(item.when)) {
+            addInstant(*instant, item.title, item.kind);
+          }
+          continue;
+        }
+        add(std::atoi(std::string(item.when.substr(5, 2)).c_str()) - 1, std::atoi(std::string(item.when.substr(8, 2)).c_str()), item.title, item.kind);
+      }
+
+      // Moon phases that land on a local day of the year.
+      const int k0 = static_cast<int>(std::floor((year - 2000) * 12.3685)) - 2;
+      for (int step = 0; step < 4 * 16; ++step) {
+        const TimePoint when = fromMillis(moonPhaseMillis(k0 + step / 4.0));
+        if (localTm(when).tm_year + 1900 == year) {
+          addInstant(when, kMoonNames[static_cast<std::size_t>(step % 4)], Kind::Astro);
+        }
+      }
+
+      // Solstices and equinoxes, meteor showers.
+      for (const TableEvent& item : kSeasonTimes) {
+        if (!item.when.starts_with(prefix)) {
+          continue;
+        }
+        if (const auto instant = parseInstant(item.when)) {
+          addInstant(*instant, item.title, item.kind);
+        }
+      }
+      for (const Meteor& shower : kMeteorShowers) {
+        add(shower.month - 1, shower.day, std::string(shower.name) + " meteor shower peak", Kind::Astro);
+      }
+    }
+
+    std::string trimmed(const std::string& text) {
+      const auto first = text.find_first_not_of(" \t\r\n");
+      if (first == std::string::npos) {
+        return {};
+      }
+      return text.substr(first, text.find_last_not_of(" \t\r\n") - first + 1);
+    }
+
+    std::string stringField(const nlohmann::json& object, const char* key) {
+      const auto it = object.find(key);
+      return it != object.end() && it->is_string() ? it->get<std::string>() : std::string{};
+    }
+
+    bool matches(const TaskRule& rule, int year, int month0, int day) {
+      if (rule.type == "daily") {
+        return true;
+      }
+      if (rule.type == "date") {
+        return rule.value == std::format("{:04d}-{:02d}-{:02d}", year, month0 + 1, day);
+      }
+      if (rule.type == "weekly") {
+        const std::string_view name = kWeekdayNames[static_cast<std::size_t>(weekdayOf(year, month0, day))];
+        return std::ranges::find(rule.days, name) != rule.days.end();
+      }
+      return false;
+    }
+
+  } // namespace
+
+  std::filesystem::path dashboardTasksPath() {
+    if (const char* override = std::getenv("NOCTALIA_DASHBOARD_TASKS_FILE"); override != nullptr && *override != '\0') {
+      return override;
+    }
+    const char* home = std::getenv("HOME");
+    return std::filesystem::path(home != nullptr ? home : "") / ".config" / "dashboard" / "tasks.json";
+  }
+
+  std::vector<TaskRule> readTaskRules(const std::filesystem::path& path) {
+    std::vector<TaskRule> rules;
+    std::ifstream stream(path);
+    if (!stream) {
+      return rules;
+    }
+    const nlohmann::json data = nlohmann::json::parse(stream, nullptr, false);
+    if (!data.is_array()) {
+      return rules;
+    }
+    for (const nlohmann::json& item : data) {
+      if (!item.is_object()) {
+        continue;
+      }
+      TaskRule rule;
+      rule.task = trimmed(stringField(item, "task"));
+      if (rule.task.empty()) {
+        continue;
+      }
+      rule.type = stringField(item, "recurrence_type");
+      rule.value = stringField(item, "recurrence_value");
+      rule.createdAt = stringField(item, "created_at");
+      if (rule.type == "weekly") {
+        std::size_t start = 0;
+        while (start <= rule.value.size()) {
+          const auto comma = rule.value.find(',', start);
+          const std::string day = trimmed(rule.value.substr(start, comma == std::string::npos ? std::string::npos : comma - start));
+          if (!day.empty()) {
+            rule.days.push_back(day);
+          }
+          if (comma == std::string::npos) {
+            break;
+          }
+          start = comma + 1;
+        }
+      }
+      rules.push_back(std::move(rule));
+    }
+    return rules;
+  }
+
+  std::vector<CalendarEvent> taskEvents(const std::vector<TaskRule>& rules, TimePoint first, TimePoint last) {
+    std::vector<CalendarEvent> out;
+    if (rules.empty()) {
+      return out;
+    }
+    const std::tm firstDay = localTm(first);
+    const std::tm lastDay = localTm(last);
+    const chrono::sys_days end = civil(lastDay.tm_year + 1900, lastDay.tm_mon, lastDay.tm_mday);
+    for (chrono::sys_days day = civil(firstDay.tm_year + 1900, firstDay.tm_mon, firstDay.tm_mday); day <= end; day += chrono::days{1}) {
+      const chrono::year_month_day ymd{day};
+      const int year = static_cast<int>(ymd.year());
+      const int month0 = static_cast<int>(static_cast<unsigned>(ymd.month())) - 1;
+      const int date = static_cast<int>(static_cast<unsigned>(ymd.day()));
+      TimePoint start{};
+      bool haveStart = false;
+      for (const TaskRule& rule : rules) {
+        if (!matches(rule, year, month0, date)) {
+          continue;
+        }
+        if (!haveStart) {
+          start = localMidnight(year, month0, date);
+          haveStart = true;
+        }
+        CalendarEvent event;
+        event.id = "dashboard-task:" + rule.createdAt + "|" + rule.task + ":" + std::format("{:04d}-{:02d}-{:02d}", year, month0 + 1, date);
+        event.title = rule.task;
+        event.calendarName = "Dashboard";
+        event.colorHex = std::string(kTaskColor);
+        event.kindLabel = rule.type == "daily" ? "Daily task" : rule.type == "weekly" ? "Weekly task" : "Task";
+        event.start = start;
+        event.end = start + chrono::hours{24};
+        event.allDay = true;
+        event.showMarker = rule.type == "date";
+        out.push_back(std::move(event));
+      }
+    }
+    return out;
+  }
+
+  std::vector<CalendarEvent> holidayEvents(int firstYear, int lastYear) {
+    std::vector<Entry> entries;
+    for (int year = firstYear; year <= lastYear; ++year) {
+      buildYear(year, entries);
+    }
+    std::ranges::stable_sort(entries, [](const Entry& a, const Entry& b) {
+      if (a.event.start != b.event.start) {
+        return a.event.start < b.event.start;
+      }
+      return a.kind < b.kind;
+    });
+    std::vector<CalendarEvent> out;
+    out.reserve(entries.size());
+    for (Entry& entry : entries) {
+      out.push_back(std::move(entry.event));
+    }
+    return out;
+  }
+
+} // namespace calendar::local
diff --git a/src/calendar/local_events.h b/src/calendar/local_events.h
new file mode 100644
index 000000000..5e8912a2c
--- /dev/null
+++ b/src/calendar/local_events.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "calendar/calendar_types.h"
+
+#include <chrono>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+// Calendar entries that need no account: holidays and global events computed offline, and the
+// Dashboard app's task list (~/.config/dashboard/tasks.json). Both are folded into the calendar
+// snapshot next to the online events.
+namespace calendar::local {
+
+  // One recurrence rule from the Dashboard's tasks.json: "daily", "weekly" (value is a comma list
+  // of English weekday abbreviations) or "date" (value is yyyy-mm-dd).
+  struct TaskRule {
+    std::string task;
+    std::string type;
+    std::string value;
+    std::string createdAt;
+    std::vector<std::string> days;
+  };
+
+  // NOCTALIA_DASHBOARD_TASKS_FILE, else $HOME/.config/dashboard/tasks.json.
+  [[nodiscard]] std::filesystem::path dashboardTasksPath();
+
+  // A missing or malformed file reads as an empty list.
+  [[nodiscard]] std::vector<TaskRule> readTaskRules(const std::filesystem::path& path);
+
+  // Every rule's occurrences on the local days from `first` to `last`, as all-day events. Only
+  // one-off ("date") tasks carry a marker dot, because daily and weekly rules would dot most days.
+  [[nodiscard]] std::vector<CalendarEvent> taskEvents(
+      const std::vector<TaskRule>& rules, std::chrono::system_clock::time_point first,
+      std::chrono::system_clock::time_point last
+  );
+
+  // US federal holidays, common observances, international days, DST changes, moon phases,
+  // eclipses, equinoxes/solstices and meteor showers for the years firstYear..lastYear, most
+  // prominent first within a day. Lunar, religious and eclipse dates come from tables covering
+  // 2025-2032.
+  [[nodiscard]] std::vector<CalendarEvent> holidayEvents(int firstYear, int lastYear);
+
+} // namespace calendar::local
