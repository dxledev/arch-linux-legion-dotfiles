+  ok = expect(hasEvent(holidays, "Daylight Saving Time ends (US)", 2026, 11, 1), "DST end 2026") && ok;
+  ok = expect(hasEvent(holidays, "Lunar New Year", 2026, 2, 17), "table event 2026") && ok;
+  ok = expect(!hasEvent(holidays, "Election Day (US)", 2027, 11, 2), "only the requested years") && ok;
+  ok = expect(std::ranges::is_sorted(holidays, {}, &CalendarEvent::start), "holidays sorted by start") && ok;
+  ok = expect(
