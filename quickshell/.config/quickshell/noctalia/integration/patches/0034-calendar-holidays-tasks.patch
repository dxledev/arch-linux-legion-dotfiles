+void CalendarService::scheduleLocalRollover() {
+  const std::tm today = [] {
+    const std::time_t raw = std::time(nullptr);
+    std::tm value{};
+    localtime_r(&raw, &value);
+    return value;
+  }();
+  const int secondsIntoDay = today.tm_hour * 3600 + today.tm_min * 60 + today.tm_sec;
+  m_nextLocalRollover = std::chrono::steady_clock::now() + std::chrono::seconds{std::max(60, 86400 - secondsIntoDay + 1)};
+}
+
+void CalendarService::reloadHolidays() {
+  const std::time_t raw = std::time(nullptr);
+  std::tm today{};
+  localtime_r(&raw, &today);
