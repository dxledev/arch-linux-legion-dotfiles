+  std::string m_qrSvgPath;
+  double m_leftValue = 0.0;
+  double m_rightValue = 0.0;
+  double m_fullScale = 100.0;
+  bool m_leftEngaged = false;
+  bool m_rightEngaged = false;
+
+  Flex* m_root = nullptr;
+  Flex* m_readings = nullptr;
+  Flex* m_qrContent = nullptr;
+  Label* m_title = nullptr;
+  Label* m_contextLabel = nullptr;
+  Label* m_status = nullptr;
+  Label* m_errorLabel = nullptr;
+  SpeedDial* m_leftDial = nullptr;
+  SpeedDial* m_rightDial = nullptr;
+  Spinner* m_spinner = nullptr;
+  Button* m_runAgainButton = nullptr;
+  Button* m_closeButton = nullptr;
+  Label* m_qrSsidLabel = nullptr;
+  Label* m_qrHint = nullptr;
+  Image* m_qrImage = nullptr;
+};
