+namespace {
+
+  constexpr float kDesignDiameter = 190.0F;
+  constexpr float kArcStart = 135.0F;
+  constexpr float kArcSweep = 270.0F;
+  constexpr int kTickCount = 46;
+
+  void setSource(cairo_t* context, const Color& color, float alpha = 1.0F) {
+    cairo_set_source_rgba(context, color.r, color.g, color.b, color.a * alpha);
+  }
+
+  void drawSpacedText(cairo_t* context, std::string_view text, double centerX, double baseline, double spacing) {
+    double width = 0.0;
+    for (const char character : text) {
+      char value[2] = {character, '\0'};
+      cairo_text_extents_t extents{};
+      cairo_text_extents(context, value, &extents);
+      width += extents.x_advance + spacing;
+    }
+    if (!text.empty()) {
+      width -= spacing;
+    }
+
+    double x = centerX - width * 0.5;
+    for (const char character : text) {
+      char value[2] = {character, '\0'};
+      cairo_move_to(context, x, baseline);
+      cairo_show_text(context, value);
+      cairo_text_extents_t extents{};
+      cairo_text_extents(context, value, &extents);
+      x += extents.x_advance + spacing;
+    }
+  }
+
+  std::string readingText(double value) {
+    return value < 10.0 ? std::format("{:.1f}", value) : std::format("{:.0f}", value);
+  }
+
+  std::uint8_t unpremultiply(std::uint8_t component, std::uint8_t alpha) {
+    if (alpha == 0) {
+      return 0;
+    }
+    return static_cast<std::uint8_t>(
+        std::min(255U, (static_cast<unsigned int>(component) * 255U + alpha / 2U) / alpha)
+    );
+  }
+
+} // namespace
+
+SpeedDial::SpeedDial(std::string label, std::string unit, float scale)
+    : m_label(std::move(label)), m_unit(std::move(unit)), m_diameter(kDesignDiameter * scale) {
+  setFit(ImageFit::Contain);
+  setSize(m_diameter, m_diameter);
+  setHitTestVisible(false);
+  m_paletteConn = paletteChanged().connect([this] { m_dirty = true; });
+}
+
+void SpeedDial::setLabels(std::string label, std::string unit) {
+  if (m_label == label && m_unit == unit) {
+    return;
+  }
+  m_label = std::move(label);
+  m_unit = std::move(unit);
+  m_dirty = true;
+}
+
+void SpeedDial::setReading(double value, double fullScale, bool engaged) {
+  if (m_value == value && m_fullScale == fullScale && m_engaged == engaged) {
+    return;
+  }
+  m_value = std::max(0.0, value);
+  m_fullScale = std::max(1.0, fullScale);
+  m_engaged = engaged;
+  setOpacity(m_engaged ? 1.0F : 0.5F);
+  m_dirty = true;
+}
+
+void SpeedDial::update(Renderer& renderer) {
+  if (m_dirty) {
+    redraw(renderer);
+  }
+}
+
+void SpeedDial::redraw(Renderer& renderer) {
+  const float renderScale = std::max(1.0F, renderer.renderScale());
+  const int rasterSize = std::max(1, static_cast<int>(std::round(m_diameter * renderScale)));
+  cairo_surface_t* surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, rasterSize, rasterSize);
+  cairo_t* context = cairo_create(surface);
+  const double pixelsPerUnit = static_cast<double>(rasterSize) / m_diameter;
+  cairo_scale(context, pixelsPerUnit, pixelsPerUnit);
+  cairo_set_operator(context, CAIRO_OPERATOR_CLEAR);
+  cairo_paint(context);
+  cairo_set_operator(context, CAIRO_OPERATOR_OVER);
+
+  const double diameter = m_diameter;
+  const double scale = diameter / kDesignDiameter;
+  const double centerX = diameter * 0.5;
+  const double centerY = diameter * 0.48;
+  const double radius = diameter * 0.5 - 7.0 * scale;
+  const double start = std::numbers::pi * kArcStart / 180.0;
+  const double sweep = std::numbers::pi * kArcSweep / 180.0;
+  const double fraction = std::clamp(m_value / m_fullScale, 0.0, 1.0);
+  const float dim = m_engaged ? 1.0F : 0.5F;
+  const Color primary = resolveColorSpec(colorSpecFromRole(ColorRole::Primary));
+  const Color onSurface = resolveColorSpec(colorSpecFromRole(ColorRole::OnSurface));
+  const Color onSurfaceVariant = resolveColorSpec(colorSpecFromRole(ColorRole::OnSurfaceVariant));
+
+  cairo_set_line_cap(context, CAIRO_LINE_CAP_ROUND);
+  cairo_set_line_width(context, 4.0 * scale);
+  setSource(context, onSurfaceVariant, 0.24F * dim);
+  cairo_arc(context, centerX, centerY, radius, start, start + sweep);
+  cairo_stroke(context);
+
+  if (fraction > 0.004) {
+    cairo_set_line_width(context, 12.0 * scale);
+    setSource(context, primary, 0.18F * dim);
+    cairo_arc(context, centerX, centerY, radius, start, start + sweep * fraction);
+    cairo_stroke(context);
+
+    cairo_set_line_width(context, 4.0 * scale);
+    setSource(context, primary, dim);
+    cairo_arc(context, centerX, centerY, radius, start, start + sweep * fraction);
+    cairo_stroke(context);
+  }
+
+  for (int index = 0; index < kTickCount; ++index) {
+    const bool major = index % 5 == 0;
+    const double angle = start + sweep * static_cast<double>(index) / (kTickCount - 1);
+    const double outerRadius = radius - 5.0 * scale;
+    const double innerRadius = outerRadius - (major ? 10.0 : 6.0) * scale;
+    cairo_move_to(context, centerX + std::cos(angle) * innerRadius, centerY + std::sin(angle) * innerRadius);
+    cairo_line_to(context, centerX + std::cos(angle) * outerRadius, centerY + std::sin(angle) * outerRadius);
+    cairo_set_line_width(context, (major ? 2.0 : 1.0) * scale);
+    setSource(context, onSurfaceVariant, (major ? 0.4F : 0.2F) * dim);
+    cairo_stroke(context);
+  }
+
+  const double needleAngle = start + sweep * fraction;
+  const double needleLength = diameter * 0.32;
+  const double needleX = centerX + std::cos(needleAngle) * needleLength;
+  const double needleY = centerY + std::sin(needleAngle) * needleLength;
+  cairo_pattern_t* needleGradient = cairo_pattern_create_linear(needleX, needleY, centerX, centerY);
+  cairo_pattern_add_color_stop_rgba(needleGradient, 0.0, primary.r, primary.g, primary.b, primary.a * dim);
+  cairo_pattern_add_color_stop_rgba(needleGradient, 1.0, primary.r, primary.g, primary.b, 0.0);
+  cairo_set_source(context, needleGradient);
+  cairo_set_line_width(context, 3.0 * scale);
+  cairo_move_to(context, centerX, centerY);
+  cairo_line_to(context, needleX, needleY);
+  cairo_stroke(context);
+  cairo_pattern_destroy(needleGradient);
+
+  cairo_select_font_face(context, "monospace", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD);
+  cairo_set_font_size(context, 24.0 * scale);
+  setSource(context, onSurface, dim);
+  const std::string value = readingText(m_value);
+  cairo_text_extents_t valueExtents{};
+  cairo_text_extents(context, value.c_str(), &valueExtents);
+  cairo_move_to(context, centerX - valueExtents.width * 0.5 - valueExtents.x_bearing, centerY + 22.0 * scale);
+  cairo_show_text(context, value.c_str());
+
+  cairo_set_font_size(context, 10.0 * scale);
+  setSource(context, onSurfaceVariant, 0.9F * dim);
+  cairo_text_extents_t unitExtents{};
+  cairo_text_extents(context, m_unit.c_str(), &unitExtents);
+  cairo_move_to(context, centerX - unitExtents.width * 0.5 - unitExtents.x_bearing, centerY + 38.0 * scale);
+  cairo_show_text(context, m_unit.c_str());
+
+  cairo_set_font_size(context, 10.0 * scale);
+  cairo_select_font_face(context, "monospace", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD);
+  setSource(context, onSurfaceVariant, 0.75F * dim);
+  drawSpacedText(context, m_label, centerX, diameter - 3.0 * scale, 1.5 * scale);
+
+  cairo_destroy(context);
+  cairo_surface_flush(surface);
+  const std::uint8_t* source = cairo_image_surface_get_data(surface);
+  const int stride = cairo_image_surface_get_stride(surface);
+  std::vector<std::uint8_t> rgba(static_cast<std::size_t>(rasterSize) * rasterSize * 4U);
+  for (int y = 0; y < rasterSize; ++y) {
+    for (int x = 0; x < rasterSize; ++x) {
+      const std::uint8_t* pixel = source + static_cast<std::size_t>(y) * stride + static_cast<std::size_t>(x) * 4U;
+      std::uint8_t blue = 0;
+      std::uint8_t green = 0;
+      std::uint8_t red = 0;
+      std::uint8_t alpha = 0;
+      if constexpr (std::endian::native == std::endian::little) {
+        blue = pixel[0];
+        green = pixel[1];
+        red = pixel[2];
+        alpha = pixel[3];
+      } else {
+        alpha = pixel[0];
+        red = pixel[1];
+        green = pixel[2];
+        blue = pixel[3];
+      }
+      const std::size_t offset = (static_cast<std::size_t>(y) * rasterSize + x) * 4U;
+      rgba[offset] = unpremultiply(red, alpha);
+      rgba[offset + 1] = unpremultiply(green, alpha);
+      rgba[offset + 2] = unpremultiply(blue, alpha);
+      rgba[offset + 3] = alpha;
+    }
+  }
+
+  cairo_surface_destroy(surface);
+  if (setSourceRaw(
+          renderer, rgba.data(), rgba.size(), rasterSize, rasterSize, rasterSize * 4, PixmapFormat::RGBA, false
+      )) {
+    m_dirty = false;
+  }
+}
