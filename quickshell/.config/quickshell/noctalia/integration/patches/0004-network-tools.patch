+
+  auto header = ui::row({
+      .align = FlexAlign::Center,
+      .gap = Style::spaceSm * scale,
+  });
+  header->addChild(
+      ui::label({
+          .out = &m_title,
+          .fontSize = Style::fontSizeTitle * scale,
+          .fontWeight = FontWeight::Bold,
+          .color = colorSpecFromRole(ColorRole::OnSurface),
+          .textAlign = TextAlign::Center,
+          .flexGrow = 1.0F,
+      })
+  );
+  root->addChild(std::move(header));
+
+  root->addChild(
+      ui::label({
+          .out = &m_contextLabel,
+          .fontSize = Style::fontSizeCaption * scale,
+          .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+          .maxLines = 1,
+          .textAlign = TextAlign::Center,
+          .visible = false,
+          .participatesInLayout = false,
+      })
+  );
+
+  auto readings = ui::row({
+      .out = &m_readings,
+      .align = FlexAlign::Center,
+      .justify = FlexJustify::Center,
+      .wrap = true,
+      .gap = Style::spaceMd * scale,
+      .fillWidth = true,
+  });
+  auto leftDial = std::make_unique<SpeedDial>("DOWNLOAD", "Mbps", scale);
+  m_leftDial = leftDial.get();
+  readings->addChild(std::move(leftDial));
+  auto rightDial = std::make_unique<SpeedDial>("UPLOAD", "Mbps", scale);
+  m_rightDial = rightDial.get();
+  readings->addChild(std::move(rightDial));
+  root->addChild(std::move(readings));
+
+  auto qrContent = ui::column({
+      .out = &m_qrContent,
+      .align = FlexAlign::Center,
+      .gap = Style::spaceSm * scale,
+      .fillWidth = true,
+      .visible = false,
+      .participatesInLayout = false,
+  });
+  qrContent->addChild(
+      ui::label({
+          .out = &m_qrSsidLabel,
+          .fontSize = Style::fontSizeBody * scale,
+          .fontWeight = FontWeight::Bold,
+          .color = colorSpecFromRole(ColorRole::OnSurface),
+          .textAlign = TextAlign::Center,
+          .visible = false,
+      })
+  );
+  qrContent->addChild(
+      ui::image({
+          .out = &m_qrImage,
+          .fit = ImageFit::Contain,
+          .width = 240.0F * scale,
+          .height = 240.0F * scale,
+      })
+  );
+  qrContent->addChild(
+      ui::label({
+          .out = &m_qrHint,
+          .text = "Scan to join this network",
+          .fontSize = Style::fontSizeBody * scale,
+          .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+          .textAlign = TextAlign::Center,
+      })
+  );
+  root->addChild(std::move(qrContent));
+
+  auto statusRow = ui::row({
+      .align = FlexAlign::Center,
+      .justify = FlexJustify::Center,
+      .gap = Style::spaceSm * scale,
+      .fillWidth = true,
+  });
+  statusRow->addChild(
+      ui::spinner({
+          .out = &m_spinner,
+          .color = colorSpecFromRole(ColorRole::Primary),
+          .spinnerSize = Style::baseGlyphSize * scale,
+      })
+  );
+  statusRow->addChild(
+      ui::label({
+          .out = &m_status,
+          .fontSize = Style::fontSizeCaption * scale,
+          .color = colorSpecFromRole(ColorRole::OnSurfaceVariant),
+      })
+  );
+  root->addChild(std::move(statusRow));
+
+  root->addChild(
+      ui::label({
+          .out = &m_errorLabel,
+          .fontSize = Style::fontSizeCaption * scale,
+          .color = colorSpecFromRole(ColorRole::Error),
+          .maxLines = 3,
+          .textAlign = TextAlign::Center,
+          .visible = false,
+      })
+  );
+
+  auto actions = ui::row({
+      .align = FlexAlign::Center,
+      .justify = FlexJustify::Center,
+      .gap = Style::spaceSm * scale,
+      .fillWidth = true,
+  });
+  actions->addChild(
+      ui::button({
+          .out = &m_runAgainButton,
+          .variant = ButtonVariant::Primary,
+          .tooltip = "Run this tool again",
+          .onClick = [this]() { startTest(); },
+      })
+  );
+  actions->addChild(
+      ui::button({
+          .out = &m_closeButton,
+          .text = "Close",
+          .variant = ButtonVariant::Ghost,
+          .onClick = [this]() { close(); },
+      })
+  );
+  root->addChild(std::move(actions));
+
+  m_layoutDirty = true;
+  return root;
+}
+
+void NetworkToolsPopup::open(Kind kind, std::string context) {
+  if (m_root == nullptr) {
+    return;
+  }
+  close();
+  m_kind = kind;
+  m_context = std::move(context);
+  m_open = true;
+  m_root->setVisible(true);
+  m_root->setParticipatesInLayout(true);
+  startTest();
+}
+
+void NetworkToolsPopup::close() {
+  ++m_runId;
+  if (m_cancel != nullptr) {
+    m_cancel->store(true);
+  }
+  m_running = false;
+  m_open = false;
+  m_phase.clear();
+  m_error.clear();
+  clearQrFile();
+  if (m_root != nullptr) {
+    m_root->setVisible(false);
+    m_root->setParticipatesInLayout(false);
+    m_layoutDirty = true;
+    PanelManager::instance().refresh();
+  }
+}
+
+void NetworkToolsPopup::update(Renderer& renderer) {
+  if (!m_open) {
+    return;
+  }
+  syncContent(&renderer);
+  if (m_kind != Kind::WifiQr) {
+    if (m_leftDial != nullptr) {
+      m_leftDial->update(renderer);
+    }
+    if (m_rightDial != nullptr) {
+      m_rightDial->update(renderer);
+    }
+  }
+}
+
+void NetworkToolsPopup::setPanelCardOpacity(float opacity) {
+  m_cardOpacity = opacity;
+  if (m_root != nullptr) {
+    m_root->setCardStyle(m_scale, m_cardOpacity);
+  }
+}
+
+void NetworkToolsPopup::onClose() {
+  close();
+  m_root = nullptr;
+  m_readings = nullptr;
+  m_qrContent = nullptr;
+  m_title = nullptr;
+  m_contextLabel = nullptr;
+  m_status = nullptr;
+  m_errorLabel = nullptr;
+  m_leftDial = nullptr;
+  m_rightDial = nullptr;
+  m_spinner = nullptr;
+  m_runAgainButton = nullptr;
+  m_closeButton = nullptr;
+  m_qrSsidLabel = nullptr;
+  m_qrHint = nullptr;
+  m_qrImage = nullptr;
+}
+
+void NetworkToolsPopup::startTest() {
+  if (!m_open) {
+    return;
+  }
+  ++m_runId;
+  if (m_cancel != nullptr) {
+    m_cancel->store(true);
+  }
+  m_cancel = std::make_shared<std::atomic<bool>>(false);
+  m_running = true;
+  m_phase = m_kind == Kind::WifiQr ? "qr" : m_kind == Kind::NetworkSpeed ? "download" : "read";
+  m_error.clear();
+  m_qrSsid.clear();
+  m_leftValue = 0.0;
+  m_rightValue = 0.0;
+  m_fullScale = m_kind == Kind::DiskSpeed ? 500.0 : 100.0;
+  m_leftEngaged = m_kind != Kind::WifiQr;
+  m_rightEngaged = false;
+  if (m_kind == Kind::DiskSpeed) {
+    m_context.clear();
+  }
+  clearQrFile();
+  m_layoutDirty = true;
+  syncContent(nullptr);
+  PanelManager::instance().refresh();
+
+  switch (m_kind) {
+  case Kind::NetworkSpeed:
+    startNetworkPhase("down", m_runId);
+    break;
+  case Kind::DiskSpeed:
+    startDiskTest(m_runId);
+    break;
+  case Kind::WifiQr:
+    startWifiQr(m_runId);
+    break;
+  }
+}
+
+void NetworkToolsPopup::startNetworkPhase(std::string phase, std::uint64_t runId) {
+  const auto script = integrationScript("network-speedtest");
+  const std::string commandPhase = phase;
+  const auto weak = std::weak_ptr<std::uint8_t>(m_lifetime);
+  const auto cancel = m_cancel;
+  auto pending = std::make_shared<std::string>();
+  const bool started = process::runAsync(
+      std::vector<std::string>{"/usr/bin/bash", script.string(), commandPhase},
+      process::RunCallbacks{
+          .stdOut =
+              [this, weak, runId, phase, pending](std::string_view chunk) {
+                consumeLines(*pending, chunk, [this, weak, runId, phase](std::string line) {
+                  const auto value = numericLine(line);
+                  if (!value.has_value()) {
+                    return;
+                  }
+                  const std::string expectedPhase = phase == "down" ? "download" : "upload";
+                  DeferredCall::callLater([this, weak, runId, expectedPhase, phase, value = *value]() {
+                    if (weak.expired() || !m_open || runId != m_runId) {
+                      return;
+                    }
+                    if (m_phase != expectedPhase) {
+                      return;
+                    }
+                    updateReading(phase == "down", value);
+                    PanelManager::instance().refresh();
+                  });
+                });
+              },
+          .onExit =
+              [this, weak, runId, phase = std::move(phase)](process::RunResult result) mutable {
+                DeferredCall::callLater([this, weak, runId, phase = std::move(phase),
+                                         result = std::move(result)]() mutable {
+                  if (weak.expired() || !m_open || runId != m_runId) {
+                    return;
+                  }
+                  const auto value = lastNumericLine(result.out);
+                  const bool expectedTimeout = phase == "down" || phase == "up";
+                  if ((!result && !(expectedTimeout && result.timedOut)) || !value.has_value()) {
+                    setFailure(firstErrorLine(result.err, "Network speed test failed"));
+                    return;
+                  }
+                  if (phase == "down") {
+                    updateReading(true, *value);
+                    m_phase = "upload";
+                    m_rightEngaged = true;
+                    updateReading(false, m_rightValue);
+                    m_layoutDirty = true;
+                    PanelManager::instance().refresh();
+                    startNetworkPhase("up", runId);
+                    return;
+                  }
+                  updateReading(false, *value);
+                  m_leftEngaged = true;
+                  m_rightEngaged = true;
+                  m_phase.clear();
+                  m_running = false;
+                  m_layoutDirty = true;
+                  PanelManager::instance().refresh();
+                });
+              },
+      },
+      process::RunOptions{
+          .timeout = std::chrono::seconds(15),
+          .cancel = cancel,
+      }
+  );
+  if (!started) {
+    setFailure("Could not start network speed test");
+  }
+}
+
+void NetworkToolsPopup::startDiskTest(std::uint64_t runId) {
+  const auto script = integrationScript("disk-speedtest");
+  const auto weak = std::weak_ptr<std::uint8_t>(m_lifetime);
+  const auto cancel = m_cancel;
+  auto pending = std::make_shared<std::string>();
+  const bool started = process::runAsync(
+      std::vector<std::string>{"/usr/bin/bash", script.string()},
+      process::RunCallbacks{
+          .stdOut =
+              [this, weak, runId, pending](std::string_view chunk) {
+                consumeLines(*pending, chunk, [this, weak, runId](std::string line) {
+                  std::istringstream parsed(line);
+                  std::string key;
+                  parsed >> key;
+                  if (key == "disk") {
+                    std::string model;
+                    std::getline(parsed >> std::ws, model);
+                    DeferredCall::callLater([this, weak, runId, model = std::move(model)]() mutable {
+                      if (weak.expired() || !m_open || runId != m_runId) {
+                        return;
+                      }
+                      setContext(std::move(model));
+                      PanelManager::instance().refresh();
+                    });
+                    return;
+                  }
+                  double value = 0.0;
+                  std::string trailing;
+                  if ((key != "read" && key != "write")
+                      || !(parsed >> value)
+                      || (parsed >> trailing)
+                      || !std::isfinite(value)
+                      || value < 0.0) {
+                    return;
+                  }
+                  const bool left = key == "read";
+                  DeferredCall::callLater([this, weak, runId, left, value]() {
+                    if (weak.expired() || !m_open || runId != m_runId) {
+                      return;
+                    }
+                    if (m_phase != (left ? "read" : "write")) {
+                      return;
+                    }
+                    if (!left) {
+                      m_phase = "write";
+                      m_rightEngaged = true;
+                    }
+                    updateReading(left, value);
+                    PanelManager::instance().refresh();
+                  });
+                });
+              },
+          .onExit =
+              [this, weak, runId](process::RunResult result) mutable {
+                DeferredCall::callLater([this, weak, runId, result = std::move(result)]() mutable {
+                  if (weak.expired() || !m_open || runId != m_runId) {
+                    return;
+                  }
+                  const auto [read, write] = diskValues(result.out);
+                  if (!result || !read.has_value() || !write.has_value()) {
+                    setFailure(firstErrorLine(result.err, "Disk speed test failed"));
+                    return;
+                  }
+                  updateReading(true, *read);
+                  updateReading(false, *write);
+                  m_leftEngaged = true;
+                  m_rightEngaged = true;
+                  m_phase.clear();
+                  m_running = false;
+                  m_layoutDirty = true;
+                  PanelManager::instance().refresh();
+                });
+              },
+      },
+      process::RunOptions{
+          .timeout = std::chrono::seconds(60),
+          .cancel = cancel,
+      }
+  );
+  if (!started) {
+    setFailure("Could not start disk speed test");
+  }
+}
+
+void NetworkToolsPopup::startWifiQr(std::uint64_t runId) {
+  const auto script = integrationScript("wifi-qr");
+  const auto weak = std::weak_ptr<std::uint8_t>(m_lifetime);
+  const auto cancel = m_cancel;
+  const bool started = process::runAsync(
+      std::vector<std::string>{"/usr/bin/bash", script.string(), "--meta"},
+      process::RunCallbacks{
+          .onExit =
+              [this, weak, runId](process::RunResult result) mutable {
+                DeferredCall::callLater([this, weak, runId, result = std::move(result)]() mutable {
+                  if (weak.expired() || !m_open || runId != m_runId) {
+                    return;
+                  }
+                  if (!result) {
+                    setFailure(firstErrorLine(result.err, "Could not generate Wi-Fi QR code"));
+                    return;
+                  }
+                  const auto parsed = parseQrOutput(result.out);
+                  if (!parsed.has_value()) {
+                    setFailure("Could not read the Wi-Fi QR code");
+                    return;
+                  }
+                  const auto [ssid, rows] = *parsed;
+                  m_qrSsid = ssid;
+                  m_qrSvgPath =
+                      (std::filesystem::temp_directory_path()
+                       / ("noctalia-wifi-qr-" + std::to_string(::getpid()) + "-" + std::to_string(runId) + ".svg"))
+                          .string();
+                  if (!writeQrSvg(m_qrSvgPath, rows)) {
+                    setFailure("Could not render the Wi-Fi QR code");
+                    return;
+                  }
+                  m_phase.clear();
+                  m_running = false;
+                  m_layoutDirty = true;
+                  PanelManager::instance().refresh();
+                });
+              },
+      },
+      process::RunOptions{
+          .timeout = std::chrono::seconds(10),
+          .cancel = cancel,
+      }
+  );
+  if (!started) {
+    setFailure("Could not start Wi-Fi QR code generation");
+  }
+}
+
+void NetworkToolsPopup::setFailure(std::string message) {
+  m_error = std::move(message);
+  m_phase.clear();
+  m_running = false;
+  m_layoutDirty = true;
+  PanelManager::instance().refresh();
+}
+
+void NetworkToolsPopup::setContext(std::string context) {
+  if (m_context == context) {
+    return;
+  }
+  m_context = std::move(context);
+  m_layoutDirty = true;
+  if (m_contextLabel != nullptr) {
+    m_contextLabel->setText(m_context);
+    const bool visible = !m_context.empty() && m_kind != Kind::WifiQr;
+    m_contextLabel->setVisible(visible);
+    m_contextLabel->setParticipatesInLayout(visible);
+  }
+}
+
+void NetworkToolsPopup::updateReading(bool left, double value) {
+  m_fullScale = expandScale(m_kind, m_fullScale, value);
+  if (left) {
+    m_leftValue = value;
+  } else {
+    m_rightValue = value;
+  }
+  if (m_leftDial != nullptr) {
+    m_leftDial->setReading(m_leftValue, m_fullScale, m_leftEngaged);
+  }
+  if (m_rightDial != nullptr) {
+    m_rightDial->setReading(m_rightValue, m_fullScale, m_rightEngaged);
+  }
+}
+
+void NetworkToolsPopup::syncContent(Renderer* renderer) {
+  if (m_root == nullptr) {
+    return;
+  }
+  const bool qr = m_kind == Kind::WifiQr;
+  if (m_title != nullptr) {
+    m_title->setText(qr ? "Wi-Fi QR Code" : m_kind == Kind::NetworkSpeed ? "Network Speed Test" : "Disk Speed Test");
+  }
+  if (m_contextLabel != nullptr) {
+    m_contextLabel->setText(m_context);
+    const bool visible = !qr && !m_context.empty();
+    m_contextLabel->setVisible(visible);
+    m_contextLabel->setParticipatesInLayout(visible);
+  }
+  if (m_runAgainButton != nullptr) {
+    m_runAgainButton->setText(qr ? "Refresh QR" : "Run Again");
+    m_runAgainButton->setTooltip(qr ? "Generate a new Wi-Fi QR code" : "Run this tool again");
+    m_runAgainButton->setEnabled(!m_running);
+  }
+  if (m_readings != nullptr) {
+    m_readings->setVisible(!qr);
+    m_readings->setParticipatesInLayout(!qr);
+  }
+  if (m_qrContent != nullptr) {
+    m_qrContent->setVisible(qr);
+    m_qrContent->setParticipatesInLayout(qr);
+  }
+  if (m_spinner != nullptr) {
+    m_spinner->setVisible(m_running);
+    if (m_running && !m_spinner->spinning()) {
+      m_spinner->start();
+    } else if (!m_running && m_spinner->spinning()) {
+      m_spinner->stop();
+    }
+  }
+  if (m_errorLabel != nullptr) {
+    m_errorLabel->setText(m_error);
+    m_errorLabel->setVisible(!m_error.empty());
+    m_errorLabel->setParticipatesInLayout(!m_error.empty());
+  }
+  if (m_status != nullptr) {
+    if (!m_error.empty()) {
+      m_status->setText("Test failed");
+    } else if (m_running) {
+      if (m_kind == Kind::NetworkSpeed) {
+        m_status->setText(m_phase == "upload" ? "Running upload..." : "Running download...");
+      } else if (m_kind == Kind::DiskSpeed) {
+        m_status->setText(m_phase == "write" ? "Running write test..." : "Running read test...");
+      } else {
+        m_status->setText("Generating QR code...");
+      }
+    } else {
+      m_status->setText(qr ? "QR code ready" : "Test complete");
+    }
+  }
+
+  if (!qr) {
+    const std::string unit = m_kind == Kind::NetworkSpeed ? "Mbps" : "MB/s";
+    if (m_leftDial != nullptr) {
+      m_leftDial->setLabels(m_kind == Kind::NetworkSpeed ? "DOWNLOAD" : "READ", unit);
+      m_leftDial->setReading(m_leftValue, m_fullScale, m_leftEngaged);
+    }
+    if (m_rightDial != nullptr) {
+      m_rightDial->setLabels(m_kind == Kind::NetworkSpeed ? "UPLOAD" : "WRITE", unit);
+      m_rightDial->setReading(m_rightValue, m_fullScale, m_rightEngaged);
+    }
+  } else {
+    if (m_qrSsidLabel != nullptr) {
+      const bool hasSsid = !m_qrSsid.empty();
+      m_qrSsidLabel->setText(hasSsid ? "SSID: " + m_qrSsid : std::string{});
+      m_qrSsidLabel->setVisible(hasSsid);
+      m_qrSsidLabel->setParticipatesInLayout(hasSsid);
+    }
+    if (renderer != nullptr && m_qrImage != nullptr && !m_qrSvgPath.empty() && m_qrImage->sourcePath() != m_qrSvgPath) {
+      if (!m_qrImage->setSourceFile(*renderer, m_qrSvgPath, static_cast<int>(std::round(240.0F * m_scale)), false)) {
+        setFailure("Could not load the Wi-Fi QR code");
+      }
+    }
+  }
+}
+
+void NetworkToolsPopup::clearQrFile() {
+  if (m_qrSvgPath.empty()) {
+    return;
+  }
+  std::error_code error;
+  std::filesystem::remove(m_qrSvgPath, error);
+  m_qrSvgPath.clear();
+}
