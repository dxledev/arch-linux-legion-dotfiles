+#include <string>
+
+class Renderer;
+
+class SpeedDial final : public Image {
+public:
+  SpeedDial(std::string label, std::string unit, float scale);
+
+  void setLabels(std::string label, std::string unit);
+  void setReading(double value, double fullScale, bool engaged);
+  void update(Renderer& renderer);
+
+private:
+  void redraw(Renderer& renderer);
+
+  std::string m_label;
+  std::string m_unit;
+  float m_diameter = 0.0F;
+  double m_value = 0.0;
+  double m_fullScale = 100.0;
+  bool m_engaged = false;
+  bool m_dirty = true;
+  Signal<>::ScopedConnection m_paletteConn;
+};
