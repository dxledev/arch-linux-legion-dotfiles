+namespace {
+
+  std::filesystem::path integrationScript(std::string_view name) {
+    const char* xdgConfigHome = std::getenv("XDG_CONFIG_HOME");
+    const char* home = std::getenv("HOME");
+    const std::filesystem::path configHome = xdgConfigHome != nullptr && xdgConfigHome[0] != '\0'
+        ? std::filesystem::path(xdgConfigHome)
+        : home != nullptr && home[0] != '\0' ? std::filesystem::path(home) / ".config"
+                                             : std::filesystem::path{};
+    return configHome / "noctalia" / "integration" / name;
+  }
+
+  std::string firstErrorLine(const std::string& error, std::string fallback) {
+    std::istringstream lines(error);
+    std::string line;
+    if (std::getline(lines, line) && !line.empty()) {
+      return line;
+    }
+    return fallback;
+  }
+
+  std::optional<double> lastNumericLine(const std::string& output) {
+    std::istringstream lines(output);
+    std::string line;
+    std::optional<double> value;
+    while (std::getline(lines, line)) {
+      std::istringstream parsed(line);
+      double candidate = 0.0;
+      std::string trailing;
+      if (parsed >> candidate && !(parsed >> trailing) && std::isfinite(candidate) && candidate >= 0.0) {
+        value = candidate;
+      }
+    }
+    return value;
+  }
+
+  std::optional<double> numericLine(std::string_view line) {
+    std::istringstream parsed{std::string(line)};
+    double value = 0.0;
+    std::string trailing;
+    if (!(parsed >> value) || (parsed >> trailing) || !std::isfinite(value) || value < 0.0) {
+      return std::nullopt;
+    }
+    return value;
+  }
+
+  template <typename Callback> void consumeLines(std::string& pending, std::string_view chunk, Callback callback) {
+    pending.append(chunk);
+    std::size_t newline = 0;
+    while ((newline = pending.find('\n')) != std::string::npos) {
+      std::string line = pending.substr(0, newline);
+      if (!line.empty() && line.back() == '\r') {
+        line.pop_back();
+      }
+      pending.erase(0, newline + 1);
+      callback(std::move(line));
+    }
+  }
+
+  std::pair<std::optional<double>, std::optional<double>> diskValues(const std::string& output) {
+    std::istringstream lines(output);
+    std::string line;
+    std::optional<double> read;
+    std::optional<double> write;
+    while (std::getline(lines, line)) {
+      std::istringstream parsed(line);
+      std::string phase;
+      double candidate = 0.0;
+      if (!(parsed >> phase >> candidate) || !std::isfinite(candidate) || candidate < 0.0) {
+        continue;
+      }
+      if (phase == "read") {
+        read = candidate;
+      } else if (phase == "write") {
+        write = candidate;
+      }
+    }
+    return {read, write};
+  }
+
+  double expandScale(NetworkToolsPopup::Kind kind, double current, double value) {
+    constexpr std::array networkStops{100.0, 250.0, 500.0, 1000.0, 2500.0, 5000.0, 10000.0};
+    constexpr std::array diskStops{500.0, 1000.0, 2500.0, 5000.0, 10000.0, 15000.0};
+    if (value <= current * 0.92) {
+      return current;
+    }
+    if (kind == NetworkToolsPopup::Kind::DiskSpeed) {
+      for (const double stop : diskStops) {
+        if (stop > current && value <= stop * 0.92) {
+          return stop;
+        }
+      }
+      return std::max(current, value / 0.92);
+    }
+    for (const double stop : networkStops) {
+      if (stop > current && value <= stop * 0.92) {
+        return stop;
+      }
+    }
+    return std::max(current, value / 0.92);
+  }
+
+  std::optional<std::pair<std::string, std::vector<std::string>>> parseQrOutput(const std::string& output) {
+    std::istringstream lines(output);
+    std::string line;
+    std::string ssid;
+    std::vector<std::string> rows;
+    while (std::getline(lines, line)) {
+      if (line.starts_with("meta\t")) {
+        const std::size_t securityEnd = line.find('\t', 5);
+        const std::size_t ssidStart = securityEnd == std::string::npos ? std::string::npos : securityEnd + 1;
+        if (ssidStart != std::string::npos) {
+          ssid = line.substr(ssidStart);
+        }
+        continue;
+      }
+      if (line.empty() || !std::ranges::all_of(line, [](char value) { return value == '0' || value == '1'; })) {
+        continue;
+      }
+      rows.push_back(std::move(line));
+    }
+    if (rows.empty()) {
+      return std::nullopt;
+    }
+    const std::size_t width = rows.front().size();
+    if (width == 0 || !std::ranges::all_of(rows, [width](const std::string& row) { return row.size() == width; })) {
+      return std::nullopt;
+    }
+    return std::pair{std::move(ssid), std::move(rows)};
+  }
+
+  bool writeQrSvg(const std::filesystem::path& path, const std::vector<std::string>& rows) {
+    if (rows.empty() || rows.front().empty()) {
+      return false;
+    }
+    const std::size_t width = rows.front().size();
+    if (!std::ranges::all_of(rows, [width](const std::string& row) { return row.size() == width; })) {
+      return false;
+    }
+
+    constexpr std::size_t quietZone = 4;
+    const std::size_t size = width + quietZone * 2;
+    std::error_code error;
+    std::filesystem::create_directories(path.parent_path(), error);
+    if (error) {
+      return false;
+    }
+    std::ofstream svg(path, std::ios::trunc);
+    if (!svg) {
+      return false;
+    }
+
+    // QR modules stay fixed black and white for scanner contrast; surrounding copy uses role colors.
+    svg
+        << "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\""
+        << size
+        << "\" height=\""
+        << size
+        << "\" viewBox=\"0 0 "
+        << size
+        << ' '
+        << size
+        << "\" shape-rendering=\"crispEdges\">"
+        << "<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>";
+    for (std::size_t y = 0; y < rows.size(); ++y) {
+      for (std::size_t x = 0; x < width; ++x) {
+        if (rows[y][x] == '1') {
+          svg
+              << "<rect x=\""
+              << x + quietZone
+              << "\" y=\""
+              << y + quietZone
+              << "\" width=\"1\" height=\"1\" fill=\"#111111\"/>";
+        }
+      }
+    }
+    svg << "</svg>\n";
+    return static_cast<bool>(svg);
+  }
+
+} // namespace
