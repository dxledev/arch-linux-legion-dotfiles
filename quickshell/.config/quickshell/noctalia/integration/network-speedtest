#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == --help || ${1:-} == --dry-run ]]; then
    printf '%s\n' 'Network speed test: fast.com; pass down or up.'
    exit 0
fi

direction=${1:-}
case "$direction" in
    down|up) ;;
    *)
        printf 'Usage: network-speedtest [down|up]\n' >&2
        exit 2
        ;;
esac

probe=1.1.1.1
parallel=8
iface=$(/usr/bin/ip route get "$probe" 2>/dev/null | /usr/bin/awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
if [[ -z "$iface" || ! -r "/sys/class/net/$iface/statistics/rx_bytes" || ! -r "/sys/class/net/$iface/statistics/tx_bytes" ]]; then
    printf '%s\n' 'No active network interface' >&2
    exit 1
fi

fast_token=YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm
fast_api_url="https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=3"
fast_urls=$(/usr/bin/curl -fsS "$fast_api_url" 2>/dev/null | /usr/bin/jq -r '.targets[]?.url // empty')
if [[ -z "$fast_urls" ]]; then
    printf '%s\n' 'Failed to fetch speed test endpoints' >&2
    exit 1
fi

traffic_pids=()
cleanup() {
    local pid
    for pid in "${traffic_pids[@]}"; do
        [[ -n "$pid" ]] || continue
        /usr/bin/pkill -TERM -P "$pid" 2>/dev/null || true
        /usr/bin/kill "$pid" 2>/dev/null || true
    done
    for pid in "${traffic_pids[@]}"; do
        [[ -n "$pid" ]] || continue
        wait "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT
trap 'exit 143' TERM INT

traffic_worker() {
    local -a urls=( $fast_urls )
    local url_count=${#urls[@]}
    local index=$RANDOM
    local url
    if [[ "$direction" == down ]]; then
        while /usr/bin/kill -0 $$ 2>/dev/null; do
            url=${urls[$((index % url_count))]}
            /usr/bin/curl -fsS -o /dev/null "$url" 2>/dev/null || return
            index=$((index + 1))
        done
    else
        while /usr/bin/kill -0 $$ 2>/dev/null; do
            url=${urls[$((index % url_count))]}
            /usr/bin/dd if=/dev/zero bs=1M count=64 2>/dev/null | /usr/bin/curl -fsS -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || return
            index=$((index + 1))
        done
    fi
}

format_mbps() {
    /usr/bin/awk -v value="$1" 'BEGIN { if (value <= 0) print "0.0"; else if (value < 10) printf "%.1f\n", value; else printf "%.0f\n", value }'
}

for ((index = 0; index < parallel; index++)); do
    traffic_worker &
    traffic_pids+=("$!")
done

rx_before=$(/usr/bin/cat "/sys/class/net/$iface/statistics/rx_bytes")
tx_before=$(/usr/bin/cat "/sys/class/net/$iface/statistics/tx_bytes")

any_alive() {
    local pid
    for pid in "${traffic_pids[@]}"; do
        if /usr/bin/kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

while any_alive; do
    /usr/bin/sleep 1
    rx_after=$(/usr/bin/cat "/sys/class/net/$iface/statistics/rx_bytes")
    tx_after=$(/usr/bin/cat "/sys/class/net/$iface/statistics/tx_bytes")
    if [[ "$direction" == down ]]; then
        rate=$(/usr/bin/awk -v before="$rx_before" -v after="$rx_after" 'BEGIN { if (after < before) print 0; else print (after - before) * 8 / 1000000 }')
    else
        rate=$(/usr/bin/awk -v before="$tx_before" -v after="$tx_after" 'BEGIN { if (after < before) print 0; else print (after - before) * 8 / 1000000 }')
    fi
    format_mbps "$rate"
    rx_before=$rx_after
    tx_before=$tx_after
done
