#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
shell_root="$(/usr/bin/readlink -f -- "$script_dir/../..")"
shell_entry="$config_home/quickshell/shell.qml"
aether_bin="${AETHER_BIN:-$shell_root/.runtime/aether/bin/aether}"
aether_theme_file="${AETHER_THEME_FILE:-$config_home/aether/theme/colors.toml}"
aether_wallpapers_dir="${AETHER_WALLPAPERS_DIR:-$config_home/aether/theme/backgrounds}"
aether_themes_dir="${AETHER_THEMES_DIR:-$config_home/aether/themes}"
aether_library_dir="${AETHER_LIBRARY_DIR:-$HOME/files/pictures/Aether}"
dynamic_wallpapers_dir="${CAELESTIA_DYNAMIC_WALLPAPERS_DIR:-$HOME/files/pictures/wallpapers/dynamic}"
quickshell_wrapper="${AETHER_QUICKSHELL_WRAPPER:-$shell_root/scripts/quickshell}"
system_action="${AETHER_SYSTEM_ACTION_BIN:-$script_dir/system-action}"
hyprctl_bin="${HYPRCTL_BIN:-/usr/bin/hyprctl}"
jq_bin="${JQ_BIN:-/usr/bin/jq}"
notify_send_bin="${NOTIFY_SEND_BIN:-$HOME/bin/notify-send}"
workspace="special:aether"
state_dir="$state_home/caelestia"
launch_lock="$state_dir/aether-launch-v2.lock"
apply_lock="$state_dir/aether-apply-v2.lock"
log_file="$state_dir/aether.log"
dry_run=0
temporary_palette_file=""

usage() {
    printf 'Usage: aether [--dry-run] launch|quit|apply|sync|status\n'
}

fail() {
    printf 'aether: %s\n' "$*" >&2
    exit 1
}

cleanup_temporary_palette() {
    [[ -z "$temporary_palette_file" || ! -e "$temporary_palette_file" ]] || /usr/bin/rm -f -- "$temporary_palette_file"
}

trap cleanup_temporary_palette EXIT

notify_failure() {
    local message="$1"
    if [[ -x "$notify_send_bin" ]]; then
        "$notify_send_bin" -t 6000 "Aether" "$message" >/dev/null 2>&1 || true
    fi
    fail "$message"
}

run() {
    if (( dry_run )); then
        printf '%q ' "$@"
        printf '\n'
    else
        "$@"
    fi
}

find_binary() {
    local candidate
    for candidate in "$aether_bin"; do
        if [[ -x "$candidate" ]]; then
            /usr/bin/readlink -f -- "$candidate"
            return
        fi
    done
    return 1
}

configure_library() {
    local settings_dir settings_file temporary
    settings_dir="$config_home/aether"
    settings_file="$settings_dir/settings.json"
    [[ "$aether_library_dir" == /* ]] || fail 'AETHER_LIBRARY_DIR must be an absolute path.'

    if [[ -e "$settings_file" ]]; then
        "$jq_bin" -e 'type == "object"' "$settings_file" >/dev/null 2>&1 || \
            fail "Aether settings are malformed: $settings_file"
    fi

    if (( dry_run )); then
        printf 'Create Aether wallpaper library: %s\n' "$aether_library_dir"
        printf 'Set Aether wallpaperFolder in %s: %s\n' "$settings_file" "$aether_library_dir"
        return
    fi

    /usr/bin/mkdir -p -- "$aether_library_dir" "$settings_dir"
    temporary="$(/usr/bin/mktemp "$settings_dir/.settings.json.XXXXXX")"
    if [[ -e "$settings_file" ]]; then
        "$jq_bin" --arg folder "$aether_library_dir" '.wallpaperFolder = $folder' "$settings_file" > "$temporary"
    else
        "$jq_bin" -n --arg folder "$aether_library_dir" '{wallpaperFolder: $folder}' > "$temporary"
    fi
    /usr/bin/mv -f -- "$temporary" "$settings_file"
}

resolve_binary() {
    local binary
    binary="$(find_binary)" || notify_failure "Aether is unavailable. Expected an executable at $aether_bin"
    printf '%s\n' "$binary"
}

missing_libraries() {
    local binary="$1" output
    output="$(/usr/bin/ldd "$binary" 2>&1 || true)"
    /usr/bin/awk '/=> not found/ { print $1 }' <<< "$output"
}

validate_runtime() {
    local binary="$1" missing
    missing="$(missing_libraries "$binary")"
    [[ -z "$missing" ]] || notify_failure "Aether cannot start because runtime libraries are missing: ${missing//$'\n'/, }. Install webkit2gtk-4.1."
}

client_info() {
    local clients
    clients="$("$hyprctl_bin" clients -j 2>/dev/null)" || return 0
    "$jq_bin" -c '
        first(.[] | select(
            ((.class // "") | ascii_downcase) == "aether" or
            ((.initialClass // "") | ascii_downcase) == "aether"
        )) // empty
    ' <<< "$clients" 2>/dev/null || true
}

workspace_visible() {
    local monitors
    monitors="$("$hyprctl_bin" monitors -j 2>/dev/null)" || return 1
    "$jq_bin" -e --arg workspace "$workspace" \
        'any(.[]; .specialWorkspace.name == $workspace)' <<< "$monitors" >/dev/null 2>&1
}

place_client() {
    local address="$1"
    run "$hyprctl_bin" dispatch "hl.dsp.window.float({ action = \"on\", window = \"address:$address\" })"
    run "$hyprctl_bin" dispatch "hl.dsp.window.resize({ x = 1320, y = 880, window = \"address:$address\" })"
    run "$hyprctl_bin" dispatch "hl.dsp.window.center({ window = \"address:$address\" })"
}

focus_client() {
    local address="$1"
    local client_workspace="${2:-}"
    if [[ "$client_workspace" != "$workspace" ]]; then
        run "$hyprctl_bin" dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$workspace\", follow = false })"
    fi
    if ! workspace_visible; then
        run "$hyprctl_bin" dispatch 'hl.dsp.focus({ monitor = "HDMI-A-1" })'
        run "$hyprctl_bin" dispatch 'hl.dsp.workspace.toggle_special("aether")'
    fi
    place_client "$address"
    run "$hyprctl_bin" dispatch "hl.dsp.focus({ window = \"address:$address\" })"
}

install_apply_hook() {
    local source="$script_dir/aether-custom" destination="$config_home/aether/custom/caelestia"
    local source_path destination_path file
    local -a managed_files=(config.json shell-integration.txt post-apply.sh)
    [[ -r "$source/config.json" && -r "$source/shell-integration.txt" && -x "$source/post-apply.sh" ]] || \
        fail "Managed Aether integration is incomplete: $source"
    source_path="$(/usr/bin/readlink -f -- "$source")"

    if [[ -L "$destination" ]]; then
        destination_path="$(/usr/bin/readlink -f -- "$destination")"
        [[ "$destination_path" == "$source_path" ]] || fail "Refusing to replace unmanaged Aether integration: $destination"
        run /usr/bin/unlink -- "$destination"
    elif [[ -e "$destination" && ! -d "$destination" ]]; then
        fail "Refusing to replace unmanaged Aether integration: $destination"
    fi

    run /usr/bin/mkdir -p -- "$destination"
    for file in "${managed_files[@]}"; do
        if [[ -e "$destination/$file" || -L "$destination/$file" ]]; then
            [[ -L "$destination/$file" ]] || fail "Refusing to replace unmanaged Aether integration file: $destination/$file"
            destination_path="$(/usr/bin/readlink -f -- "$destination/$file")"
            [[ "$destination_path" == "$source_path/$file" ]] || fail "Refusing to replace unmanaged Aether integration file: $destination/$file"
        fi
        run /usr/bin/ln -sfnT -- "$source_path/$file" "$destination/$file"
    done
}

read_aether_apply_status() {
    local binary="$1" attempt status wallpaper
    # Aether briefly clears the wallpaper while Apply rebuilds its outputs.
    for (( attempt=0; attempt<10; attempt++ )); do
        status="$("$binary" status --json 2>/dev/null || true)"
        if "$jq_bin" -e '.ok == true' <<< "$status" >/dev/null 2>&1; then
            wallpaper="$("$jq_bin" -r '.wallpaper // empty' <<< "$status")"
            if [[ "$wallpaper" == /* ]] && aether_wallpaper_source_available "$wallpaper"; then
                printf '%s\n' "$status"
                return
            fi
        fi
        /usr/bin/sleep 0.2
    done
    fail 'Aether did not finish writing an existing wallpaper.'
}

aether_wallpaper_source_available() {
    local reported="$1" name candidate
    name="${reported##*/}"
    [[ -f "$reported" || -f "$aether_wallpapers_dir/$name" ]] && return 0
    [[ -d "$aether_themes_dir" ]] || return 1
    while IFS= read -r -d '' candidate; do
        [[ "${candidate##*/}" == "$name" ]] && return 0
    done < <(/usr/bin/find -L "$aether_themes_dir" -mindepth 3 -maxdepth 3 -type f -path '*/backgrounds/*' -print0 2>/dev/null)
    return 1
}

resolve_aether_wallpaper() {
    local status="$1" reported wallpaper candidate candidate_hash expected_hash
    local -a candidates=()
    reported="$("$jq_bin" -r '.wallpaper // empty' <<< "$status")"
    [[ "$reported" == /* ]] || fail 'Aether did not report an absolute wallpaper path.'
    [[ ! -f "$reported" ]] || candidates+=("$reported")
    candidate="$aether_wallpapers_dir/${reported##*/}"
    [[ ! -f "$candidate" ]] || candidates+=("$candidate")
    if [[ -d "$aether_themes_dir" ]]; then
        while IFS= read -r -d '' candidate; do
            [[ "${candidate##*/}" == "${reported##*/}" ]] && candidates+=("$candidate")
        done < <(/usr/bin/find -L "$aether_themes_dir" -mindepth 3 -maxdepth 3 -type f -path '*/backgrounds/*' -print0 2>/dev/null)
    fi

    (( ${#candidates[@]} )) || fail 'Aether output and reported wallpaper are both missing.'
    wallpaper="${candidates[0]}"
    expected_hash="$(hash_file "$wallpaper")"
    for candidate in "${candidates[@]:1}"; do
        candidate_hash="$(hash_file "$candidate")"
        [[ "$candidate_hash" == "$expected_hash" ]] || fail 'Aether wallpaper paths with the same name contain different content.'
    done
    /usr/bin/readlink -f -- "$wallpaper"
}

aether_output_value() {
    local file="$1" name="$2"
    /usr/bin/awk -F= -v name="$name" '
        $1 ~ "^[[:space:]]*" name "[[:space:]]*$" {
            value=$2
            sub(/^[[:space:]]*/, "", value)
            sub(/[[:space:]]*$/, "", value)
            gsub(/"/, "", value)
            print value
            exit
        }
    ' "$file"
}

validate_aether_apply_output() {
    local status="$1" output="$2" style light_mode mode palette_mode name colour
    "$jq_bin" -e '
        .ok == true and (.mode | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
        (.light_mode | type == "boolean") and (.palette | type == "array" and length == 16) and
        all(.palette[]; type == "string" and test("^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$")) and
        (.wallpaper | type == "string" and startswith("/"))
    ' <<< "$status" >/dev/null || fail 'Aether status is missing a valid style, mode, palette, or wallpaper.'
    style="$("$jq_bin" -r '.mode' <<< "$status")"
    light_mode="$("$jq_bin" -r '.light_mode' <<< "$status")"
    if [[ "$light_mode" == true ]]; then mode=light; else mode=dark; fi
    palette_mode="$(aether_output_value "$output" mode)"
    [[ "$palette_mode" == "$mode" ]] || fail 'Aether colors.toml mode does not match the current Aether editor state.'

    for name in background foreground accent muted red green yellow blue magenta cyan; do
        colour="$(aether_output_value "$output" "$name")"
        [[ "$colour" =~ ^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$ ]] || fail "Aether colors.toml has an invalid $name value."
    done
    printf '%s\n%s\n' "$style" "$mode"
}

write_complete_aether_palette() {
    local status="$1" semantic_file="$2" mode="$3" output="$4" name colour index
    printf 'mode = "%s"\n' "$mode" > "$output"
    for name in background foreground accent muted red green yellow blue magenta cyan; do
        colour="$(aether_output_value "$semantic_file" "$name")"
        printf '%s = "%s"\n' "$name" "$colour" >> "$output"
    done
    for (( index=0; index<16; index++ )); do
        colour="$("$jq_bin" -r --argjson index "$index" '.palette[$index]' <<< "$status")"
        printf 'color%d = "%s"\n' "$index" "$colour" >> "$output"
    done
}

hash_file() {
    /usr/bin/sha256sum -- "$1" | /usr/bin/cut -d' ' -f1
}

find_identical_dynamic_wallpaper() {
    local wanted_hash="$1" candidate candidate_hash
    [[ -d "$dynamic_wallpapers_dir" ]] || return 1
    while IFS= read -r -d '' candidate; do
        candidate_hash="$(hash_file "$candidate" 2>/dev/null || true)"
        if [[ -n "$candidate_hash" && "$candidate_hash" == "$wanted_hash" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done < <(/usr/bin/find -L "$dynamic_wallpapers_dir" -maxdepth 1 -type f -print0 2>/dev/null)
    return 1
}

dynamic_wallpaper_destination() {
    local source="$1" name hash base stem extension candidate candidate_hash
    hash="$(hash_file "$source")"
    if candidate="$(find_identical_dynamic_wallpaper "$hash")"; then
        printf '%s\n' "$candidate"
        return
    fi

    name="${source##*/}"
    base="$dynamic_wallpapers_dir/$name"
    if [[ ! -e "$base" && ! -L "$base" ]]; then
        printf '%s\n' "$base"
        return
    fi

    if [[ "$name" == *.* && "$name" != .* ]]; then
        stem="${name%.*}"
        extension=".${name##*.}"
    else
        stem="$name"
        extension=""
    fi
    candidate="$dynamic_wallpapers_dir/$stem-${hash:0:12}$extension"
    if [[ -e "$candidate" || -L "$candidate" ]]; then
        candidate_hash="$(hash_file "$candidate" 2>/dev/null || true)"
        if [[ "$candidate_hash" == "$hash" ]]; then
            printf '%s\n' "$candidate"
            return
        fi
        candidate="$dynamic_wallpapers_dir/$stem-$hash$extension"
    fi
    if [[ -e "$candidate" || -L "$candidate" ]]; then
        candidate_hash="$(hash_file "$candidate" 2>/dev/null || true)"
        [[ "$candidate_hash" == "$hash" ]] || fail "A hash-suffixed Dynamic wallpaper path is already occupied: $candidate"
    fi
    printf '%s\n' "$candidate"
}

save_aether_wallpaper() {
    local source="$1" destination temporary source_hash
    [[ "$dynamic_wallpapers_dir" == /* ]] || fail 'CAELESTIA_DYNAMIC_WALLPAPERS_DIR must be an absolute path.'
    destination="$(dynamic_wallpaper_destination "$source")"
    saved_wallpaper="$destination"
    source_hash="$(hash_file "$source")"
    if [[ -f "$destination" ]] && [[ "$(hash_file "$destination")" == "$source_hash" ]]; then return; fi
    if (( dry_run )); then
        run /usr/bin/mkdir -p -- "$dynamic_wallpapers_dir"
        run /usr/bin/cp -- "$source" "$destination"
        return
    fi

    /usr/bin/mkdir -p -- "$dynamic_wallpapers_dir"
    temporary="$(/usr/bin/mktemp "$dynamic_wallpapers_dir/.${destination##*/}.XXXXXX")"
    /usr/bin/cp -- "$source" "$temporary" || { /usr/bin/rm -f -- "$temporary"; fail 'Could not copy the Aether wallpaper.'; }
    [[ "$(hash_file "$temporary")" == "$source_hash" ]] || { /usr/bin/rm -f -- "$temporary"; fail 'Copied Aether wallpaper content did not match its source.'; }
    /usr/bin/mv -nT -- "$temporary" "$destination" || { /usr/bin/rm -f -- "$temporary"; fail 'Could not save the Aether wallpaper.'; }
    if [[ -e "$temporary" ]]; then
        /usr/bin/rm -f -- "$temporary"
        [[ -f "$destination" && "$(hash_file "$destination")" == "$source_hash" ]] || fail "Dynamic wallpaper path was taken by different content: $destination"
    fi
}

write_shell_palette() {
    local palette_json="$1" output="$aether_theme_file" temporary
    [[ "$output" == /* ]] || fail 'AETHER_THEME_FILE must be an absolute path.'
    run /usr/bin/mkdir -p -- "${output%/*}"
    (( dry_run )) && { printf 'Generate Aether chrome palette: %s\n' "$output"; return; }
    temporary="$(/usr/bin/mktemp "${output%/*}/.colors.toml.XXXXXX")"
    "$jq_bin" -r '
        def line($name; $value): $name + " = \"" + $value + "\"";
        [line("mode"; .mode),
         line("accent"; .accent), line("cursor"; .foreground),
         line("foreground"; .foreground), line("background"; .background),
         line("selection_foreground"; .background), line("selection_background"; .accent),
         line("bg"; .background), line("lighter_bg"; .terminal[8]),
         line("dark_bg"; .background), line("darker_bg"; .terminal[0]),
         line("fg"; .muted), line("light_fg"; .foreground),
         line("bright_fg"; .terminal[15]), line("dark_fg"; .terminal[8]),
         line("muted"; .muted), line("selection"; .accent),
         line("red"; .red), line("green"; .green), line("yellow"; .yellow),
         line("blue"; .blue), line("magenta"; .magenta), line("cyan"; .cyan),
         line("orange"; .yellow), line("brown"; .muted),
         line("bright_red"; .terminal[9]), line("bright_green"; .terminal[10]),
         line("bright_yellow"; .terminal[11]), line("bright_blue"; .terminal[12]),
         line("bright_magenta"; .terminal[13]), line("bright_cyan"; .terminal[14]),
         line("black"; .terminal[0]), line("white"; .terminal[7]),
         line("bright_black"; .terminal[8]), line("bright_white"; .terminal[15])] +
        [range(0; 16) as $i | line("color" + ($i | tostring); .terminal[$i])]
        | .[]
    ' <<< "$palette_json" > "$temporary"
    /usr/bin/mv -f -- "$temporary" "$output"
}

sync_shell_palette_contents() {
    local palette
    [[ "$quickshell_wrapper" == /* && -x "$quickshell_wrapper" ]] || fail "Quickshell wrapper must be an executable absolute path: $quickshell_wrapper"
    if ! palette="$("$quickshell_wrapper" -p "$shell_entry" ipc call theme aetherPalette 2>&1)"; then
        fail "Could not read Caelestia's palette. Restart the shell and try again."
    fi
    "$jq_bin" -e '
        (.mode == "light" or .mode == "dark") and
        ([.background, .foreground, .accent, .muted, .red, .green, .yellow, .blue, .magenta, .cyan] | all(test("^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"))) and
        (.terminal | type == "array" and length == 16 and all(.[]; type == "string" and test("^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$")))
    ' <<< "$palette" >/dev/null || fail "Caelestia returned an invalid Aether palette. Restart the shell and try again."
    write_shell_palette "$palette"
}

sync_shell_palette() {
    if (( dry_run )); then
        sync_shell_palette_contents
        return
    fi
    /usr/bin/mkdir -p -- "$state_dir"
    (
        exec 8>"$apply_lock"
        /usr/bin/flock 8
        sync_shell_palette_contents
    )
}

sync() {
    sync_shell_palette
}

wait_for_client() {
    local attempt info
    for (( attempt=0; attempt<100; attempt++ )); do
        info="$(client_info)"
        if [[ -n "$info" ]]; then
            printf '%s\n' "$info"
            return
        fi
        /usr/bin/sleep 0.1
    done
    return 1
}

focus_info() {
    local info="$1" address client_workspace
    address="$("$jq_bin" -r '.address // empty' <<< "$info")"
    client_workspace="$("$jq_bin" -r '.workspace.name // empty' <<< "$info")"
    [[ -n "$address" ]] || return 1
    focus_client "$address" "$client_workspace"
}

ipc_running() {
    local binary="$1" output
    output="$("$binary" status --json 2>/dev/null)" || return 1
    "$jq_bin" -e '.ok == true' <<< "$output" >/dev/null 2>&1
}

running_pids() {
    local user_id
    user_id="$(/usr/bin/id -u)"
    /usr/bin/pgrep -u "$user_id" -x aether 2>/dev/null || true
}

launch() {
    local binary info launched_pid
    configure_library
    install_apply_hook
    info="$(client_info)"
    if [[ -n "$info" ]]; then
        focus_info "$info"
        return
    fi
    binary="$(resolve_binary)"
    validate_runtime "$binary"

    if ipc_running "$binary"; then
        info="$(wait_for_client)" || notify_failure "Aether is running, but its window could not be found."
        focus_info "$info"
        return
    fi

    if (( dry_run )); then
        sync_shell_palette
        printf 'Launch native Wayland Theme Editor on %s: GDK_BACKEND=wayland %q --tab editor\n' "$workspace" "$binary"
        return
    fi

    /usr/bin/mkdir -p -- "$state_dir"
    exec 9>"$launch_lock"
    if ! /usr/bin/flock -n 9; then
        info="$(wait_for_client)" || notify_failure "Another Aether launch is in progress, but no window appeared."
        focus_info "$info"
        return
    fi

    info="$(client_info)"
    if [[ -n "$info" ]]; then
        focus_info "$info"
        return
    fi
    if ipc_running "$binary"; then
        info="$(wait_for_client)" || notify_failure "Aether is running, but its window could not be found."
        focus_info "$info"
        return
    fi

    sync_shell_palette
    GDK_BACKEND=wayland "$binary" --tab editor 8>&- 9>&- >>"$log_file" 2>&1 &
    launched_pid=$!
    if info="$(wait_for_client)"; then
        focus_info "$info"
        return
    fi
    if /usr/bin/kill -0 "$launched_pid" 2>/dev/null; then
        notify_failure "Aether started, but no window appeared. See $log_file"
    fi
    wait "$launched_pid" 2>/dev/null || true
    notify_failure "Aether could not start. See $log_file"
}

quit() {
    local attempt pid
    local -a pids=()
    mapfile -t pids < <(running_pids)
    (( ${#pids[@]} )) || return 0

    if (( dry_run )); then
        for pid in "${pids[@]}"; do
            run /usr/bin/kill -TERM -- "$pid"
        done
        return
    fi

    /usr/bin/kill -TERM -- "${pids[@]}"
    for (( attempt=0; attempt<50; attempt++ )); do
        mapfile -t pids < <(running_pids)
        (( ${#pids[@]} )) || return 0
        /usr/bin/sleep 0.1
    done
    notify_failure 'Aether did not exit after SIGTERM.'
}

apply_to_shell() {
    local binary colors status wallpaper capture style mode
    binary="$(resolve_binary)" || return
    validate_runtime "$binary"
    colors="$aether_theme_file"
    [[ -r "$colors" ]] || fail "Aether palette not found: $colors"
    [[ "$system_action" == /* && -x "$system_action" ]] || fail "System action must be an executable absolute path: $system_action"
    if (( ! dry_run )); then
        /usr/bin/mkdir -p -- "$state_dir"
        exec 8>"$apply_lock"
        /usr/bin/flock 8
    fi
    status="$(read_aether_apply_status "$binary")" || return
    wallpaper="$(resolve_aether_wallpaper "$status")" || return
    capture="$(validate_aether_apply_output "$status" "$colors")" || return
    style="${capture%%$'\n'*}"
    mode="${capture#*$'\n'}"
    temporary_palette_file="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/caelestia-aether-palette.XXXXXX")" || fail 'Could not create a temporary Aether palette.'
    write_complete_aether_palette "$status" "$colors" "$mode" "$temporary_palette_file" || fail 'Could not build the complete Aether palette.'
    SHELL_DYNAMIC_WALLPAPER="$wallpaper" "$script_dir/shell-theme" --dry-run set-aether --style "$style" "$temporary_palette_file" >/dev/null

    if (( dry_run )); then
        printf 'Source wallpaper: %s\nStyle: %s\nMode: %s\n' "$wallpaper" "$style" "$mode"
        save_aether_wallpaper "$wallpaper"
        printf 'Saved wallpaper: %s\n' "$saved_wallpaper"
        "$system_action" --dry-run dynamic-wallpaper "$saved_wallpaper"
        return
    fi

    save_aether_wallpaper "$wallpaper"
    "$system_action" dynamic-wallpaper "$saved_wallpaper" 8>&- || fail 'Could not select the saved Dynamic wallpaper.'
    SHELL_DYNAMIC_WALLPAPER="$saved_wallpaper" "$script_dir/shell-theme" set-aether --style "$style" "$temporary_palette_file" 8>&-
}

apply() {
    local output_file status details message notifier
    if (( dry_run )); then
        apply_to_shell
        return
    fi

    /usr/bin/mkdir -p -- "$state_dir"
    output_file="$(/usr/bin/mktemp "$state_dir/.aether-apply.XXXXXX")"
    if AETHER_APPLY_WORKER=1 "$script_dir/aether" apply-worker > "$output_file" 2>&1; then
        if [[ -s "$output_file" ]]; then /usr/bin/cat -- "$output_file" >> "$log_file"; fi
        /usr/bin/rm -f -- "$output_file"
        return 0
    else
        status="$?"
    fi

    /usr/bin/cat -- "$output_file" >> "$log_file"
    details="$(/usr/bin/tail -n 2 -- "$output_file" | /usr/bin/tr '\n' ' ' | /usr/bin/sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//' | /usr/bin/cut -c1-180)"
    [[ -n "$details" ]] || details='The import command failed without an error message.'
    printf '[%s] Aether Apply import failed (exit %s): %s\n' "$(/usr/bin/date -Is)" "$status" "$details" >> "$log_file"
    message="Aether palette import failed: $details See $log_file."
    /usr/bin/rm -f -- "$output_file"
    notifier="$notify_send_bin"
    [[ -x "$notifier" ]] || notifier=/usr/bin/notify-send
    if [[ -x "$notifier" ]]; then
        "$notifier" -t 8000 'Aether Apply failed' "$message" >/dev/null 2>&1 || true
    fi
    printf 'aether: %s\n' "$message" >&2
    return "$status"
}

status() {
    local binary="" info="" missing="" source="system" address="" client_workspace="" pid="0"
    local -a pids=()
    local ipc=false process=false visible=false
    binary="$(find_binary || true)"
    info="$(client_info)"
    mapfile -t pids < <(running_pids)
    if (( ${#pids[@]} )); then
        process=true
        pid="${pids[0]}"
    fi
    source="$($script_dir/shell-theme status 2>/dev/null | "$jq_bin" -r '.source // "system"' 2>/dev/null || printf system)"
    if [[ -n "$binary" ]]; then
        missing="$(missing_libraries "$binary")"
        if [[ -z "$missing" ]] && ipc_running "$binary"; then ipc=true; fi
    fi
    if [[ -n "$info" ]]; then
        address="$("$jq_bin" -r '.address // empty' <<< "$info")"
        client_workspace="$("$jq_bin" -r '.workspace.name // empty' <<< "$info")"
        [[ "$process" == true ]] || pid="$("$jq_bin" -r '.pid // 0' <<< "$info")"
    fi
    if workspace_visible; then visible=true; fi
    "$jq_bin" -cn \
        --arg binary "$binary" --arg missing "$missing" --arg address "$address" \
        --arg workspace "$workspace" --arg clientWorkspace "$client_workspace" \
        --arg source "$source" --argjson pid "$pid" --argjson process "$process" --argjson ipc "$ipc" --argjson visible "$visible" \
        '{available: ($binary != ""), binary: $binary,
          runtimeReady: ($binary != "" and $missing == ""),
          missingLibraries: ($missing | split("\n") | map(select(length > 0))),
          running: ($process or $ipc or $address != ""), process: $process, ipc: $ipc, pid: $pid, address: $address,
          workspace: $workspace, clientWorkspace: $clientWorkspace,
          onWorkspace: ($clientWorkspace == $workspace), workspaceVisible: $visible,
          shellSource: $source}'
}

[[ "${1:-}" != --dry-run ]] || { dry_run=1; shift; }
command_name="${1:-launch}"
(( $# == 0 )) || shift
(( $# == 0 )) || { usage >&2; exit 2; }

case "$command_name" in
    launch) launch ;;
    quit) quit ;;
    apply) apply ;;
    apply-worker)
        [[ "${AETHER_APPLY_WORKER:-}" == 1 ]] || fail 'Apply worker cannot be called directly.'
        apply_to_shell
        ;;
    sync) sync ;;
    status) status ;;
    --help|-h) usage ;;
    *) usage >&2; exit 2 ;;
esac
