INTEGRATION = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(INTEGRATION))

from neovim_palette import build_palette
from palette_colour import contrast_ratio, lab, oklab_chroma, oklab_distance, parse_colour


TERMINAL = [
    "#171a1f",
    "#d96a67",
    "#8dae72",
    "#d6ae65",
    "#6f9fce",
    "#b088c7",
    "#6eb8b5",
    "#c8d0dc",
    "#303640",
    "#ed8179",
    "#a7c982",
    "#ecc376",
    "#86b3e0",
    "#c39ad6",
    "#83cfca",
    "#e5e9f0",
]
TERMINAL_NAMES = ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white")
PROVIDERS = (("caelestia", "variant", "tonalspot"),
             ("noctalia", "variant", "m3-content"),
             ("island", "style", "wh-pastel"))
SURFACE_NAMES = ("base", "mantle", "surface0", "surface1", "surface2")
PROBED_GROUPS = (
    "Normal", "NormalNC", "NormalFloat", "Comment", "Delimiter", "SpecialChar", "Tag",
    "@comment.documentation", "@punctuation", "@punctuation.delimiter", "@punctuation.bracket",
    "@punctuation.special", "@tag.delimiter", "@custom.template_argument.cpp", "@custom.array_bracket.cpp",
)


def make_palette(mode="dark", variant="tonalspot", terminal=None, background=None, **options):
    terminal = list(TERMINAL if terminal is None else terminal)
    background = background or (terminal[0] if mode == "dark" else "#f5f4f1")
    return build_palette(terminal, background, mode, variant, **options)


def make_renderer_palette(mode, variant_key, variant, terminal):
    background = terminal[0] if mode == "dark" else "#f5f4f1"
    foreground = terminal[15] if mode == "dark" else "#343941"
    colours = {
        "background": background,
        "onBackground": foreground,
        "foreground": foreground,
        "accent": terminal[4],
        "muted": terminal[8],
        "red": terminal[1],
        "green": terminal[2],
        "yellow": terminal[3],
        "blue": terminal[4],
        "magenta": terminal[5],
        "cyan": terminal[6],
    }
    colours.update({f"term{index}": colour for index, colour in enumerate(terminal)})
    return {"mode": mode, variant_key: variant, "colours": colours}


def run_renderer(renderer, provider, palette_file, wallpaper, environment, *options):
    return subprocess.run(
        [str(renderer), "--provider", provider, *options, str(palette_file), str(wallpaper)],
        env=environment,
        capture_output=True,
        text=True,
        timeout=20,
    )


def terminal_configs(output_dir):
    with (output_dir / "alacritty.toml").open("rb") as stream:
        alacritty = tomllib.load(stream)["colors"]
    ansi = [
        *(alacritty["normal"][name] for name in TERMINAL_NAMES),
        *(alacritty["bright"][name] for name in TERMINAL_NAMES),
    ]
    kitty = sorted(
        (int(index), "#" + value)
        for index, value in re.findall(
            r"^color(\d+)\s+#([0-9a-fA-F]{6})$", (output_dir / "kitty.conf").read_text(), re.M
        )
    )
    ghostty = sorted(
        (int(index), "#" + value)
        for index, value in re.findall(
            r"^palette\s*=\s*(\d+)=#([0-9a-fA-F]{6})$", (output_dir / "ghostty.ghostty").read_text(), re.M
        )
    )
    return ansi, [value for _, value in kitty], [value for _, value in ghostty]


def write_nvim_probe(path):
    path.write_text(
        """local theme = vim.env.DYNAMIC_NVIM_THEME
dofile(theme)
local function foreground(group)
  local highlight = vim.api.nvim_get_hl(0, { name = group, link = false })
  return highlight.fg and string.format('#%06x', highlight.fg) or ''
end
local output = {
  name = vim.g.colors_name,
  variant = vim.g.desktop_dynamic_variant,
  terminal = {},
  groups = {},
}
for index = 0, 15 do
  output.terminal[index + 1] = vim.g['terminal_color_' .. index]
end
for _, group in ipairs(vim.split(vim.env.DYNAMIC_NVIM_GROUPS, ',')) do
  output.groups[group] = foreground(group)
end
vim.fn.writefile({ vim.json.encode(output) }, vim.env.DYNAMIC_NVIM_RESULT)
"""
    )


def run_nvim_probe(generated_lua, probe_file, result_file, root, groups):
    environment = dict(os.environ)
    environment.update({
        "HOME": str(root / "home"),
        "XDG_CONFIG_HOME": str(root / "config"),
        "XDG_DATA_HOME": str(root / "data"),
        "XDG_STATE_HOME": str(root / "state"),
        "XDG_CACHE_HOME": str(root / "cache"),
        "NVIM_LOG_FILE": str(root / "nvim.log"),
        "DYNAMIC_NVIM_THEME": str(generated_lua),
        "DYNAMIC_NVIM_RESULT": str(result_file),
        "DYNAMIC_NVIM_GROUPS": ",".join(groups),
    })
    for name in ("home", "config", "data", "state", "cache"):
        (root / name).mkdir(parents=True, exist_ok=True)
    result = subprocess.run(
        ["/usr/bin/nvim", "--clean", "--headless", "-u", "NONE", "-i", "NONE", "-n",
         "-c", f"luafile {probe_file}", "-c", "qa!"],
        env=environment,
        capture_output=True,
        text=True,
        timeout=20,
    )
    return result, json.loads(result_file.read_text()) if result.returncode == 0 else {}


def snapshot_directory(directory):
    snapshot = {}
    for path in sorted(directory.rglob("*")):
        relative = str(path.relative_to(directory))
        if path.is_symlink():
            snapshot[relative] = ("link", os.readlink(path))
        elif path.is_file():
            snapshot[relative] = ("file", path.read_bytes())
        elif path.is_dir():
            snapshot[relative] = ("directory",)
    return snapshot


def make_render_fixture(root, source_template):
    config_home = root / "config"
    themes = config_home / "themes"
    template = themes / "fixture-theme"
    shutil.copytree(source_template.resolve(), template, ignore=shutil.ignore_patterns("wallpapers"))
    wallpaper = root / "wallpaper.png"
    wallpaper.write_bytes(b"isolated dynamic wallpaper fixture\n")
    palette_file = root / "palette.json"
    probe_file = root / "probe.lua"
    result_file = root / "probe.json"
    write_nvim_probe(probe_file)
    return config_home, themes, template, wallpaper, palette_file, probe_file, result_file


def renderer_environment(root, config_home, themes, template):
    environment = dict(os.environ)
    environment.update({
        "HOME": str(root / "home"),
        "XDG_CONFIG_HOME": str(config_home),
        "XDG_CACHE_HOME": str(root / "cache"),
        "XDG_STATE_HOME": str(root / "state"),
        "THEMES_DIR": str(themes),
        "THEME_TEMPLATE_DIR": str(template),
    })
    return environment


def assert_render_lifecycle(test, renderer, provider, palette_file, wallpaper, environment, output_dir, dynamic_root):
    test.assertFalse(output_dir.exists())
    before_dry_run = snapshot_directory(dynamic_root) if dynamic_root.exists() else None
    preview = run_renderer(renderer, provider, palette_file, wallpaper, environment, "--dry-run")
    test.assertEqual(preview.returncode, 0, preview.stderr)
    test.assertFalse(output_dir.exists())
    after_dry_run = snapshot_directory(dynamic_root) if dynamic_root.exists() else None
    test.assertEqual(after_dry_run, before_dry_run)

    render = run_renderer(renderer, provider, palette_file, wallpaper, environment)
    test.assertEqual(render.returncode, 0, render.stderr)
    test.assertEqual(render.stdout, "changed\n")
    repeated = run_renderer(renderer, provider, palette_file, wallpaper, environment)
    test.assertEqual(repeated.returncode, 0, repeated.stderr)
    test.assertEqual(repeated.stdout, "unchanged\n")


def assert_loaded_theme(test, loaded, terminal, mode, variant):
    expected = build_palette(terminal, terminal[0] if mode == "dark" else "#f5f4f1", mode, variant)
    colours = {key: "#" + value for key, value in expected["colours"].items()}
    test.assertEqual(loaded["name"], "desktop-dynamic")
    test.assertEqual(loaded["variant"], variant)
    test.assertEqual(loaded["terminal"], terminal)
    for group in ("Normal", "NormalNC", "NormalFloat"):
        test.assertEqual(loaded["groups"][group], colours["text"])
    for group in ("Comment", "@comment.documentation"):
        test.assertEqual(loaded["groups"][group], colours["muted"])
    for group in (
        "Delimiter", "@punctuation", "@punctuation.delimiter", "@punctuation.bracket",
        "@punctuation.special", "@tag.delimiter", "@custom.array_bracket.cpp",
    ):
        test.assertEqual(loaded["groups"][group], colours["punctuation"])
    for group in ("SpecialChar", "Tag"):
        test.assertEqual(loaded["groups"][group], colours["sky"])
    test.assertEqual(loaded["groups"]["@custom.template_argument.cpp"], colours["text"])


class NeovimPaletteTests(unittest.TestCase):
    def test_dark_light_and_monochrome_keep_terminal_and_readable_text(self):
        monochrome = ["#171717", "#555555", "#666666", "#777777", "#888888", "#999999", "#aaaaaa", "#bbbbbb",
                      "#303030", "#646464", "#757575", "#868686", "#979797", "#a8a8a8", "#b9b9b9", "#e5e5e5"]
        cases = (("dark", "tonalspot", TERMINAL), ("light", "tonalspot", TERMINAL), ("dark", "monochrome", monochrome))
        for mode, variant, terminal in cases:
            with self.subTest(mode=mode, variant=variant):
                result = make_palette(mode, variant, terminal=terminal)
                colours = result["colours"]
                self.assertEqual(result["mode"], mode)
                self.assertEqual(result["variant"], variant)
                self.assertEqual(result["terminal"], [parse_colour(colour) for colour in terminal])
                expected_base = terminal[0] if mode == "dark" else "#f5f4f1"
                self.assertEqual(colours["base"], parse_colour(expected_base))
                self.assertGreaterEqual(contrast_ratio(colours["text"], colours["base"]), 4.5)
                self.assertTrue(result["report"])
                if variant == "monochrome":
                    self.assertLess(max(oklab_chroma(colour) for colour in colours.values()), 0.002)

    def test_passing_syntax_seeds_stay_on_their_ansi_slots(self):
        result = make_palette()
        colours = result["colours"]
        surfaces = [colours[name] for name in SURFACE_NAMES]
        for role, index in (("red", 1), ("green", 2), ("yellow", 3), ("peach", 3), ("blue", 4),
                            ("primary", 4), ("mauve", 5), ("teal", 6), ("secondary", 6),
                            ("pink", 13), ("sky", 14), ("lavender", 12)):
            with self.subTest(role=role):
                seed = parse_colour(TERMINAL[index])
                if min(contrast_ratio(seed, surface) for surface in surfaces) >= 4.5:
                    self.assertEqual(colours[role], seed)

    def test_low_contrast_correction_preserves_the_seed_hue(self):
        terminal = list(TERMINAL)
        terminal[1] = "#512020"
        result = make_palette(terminal=terminal)
        corrected = result["colours"]["red"]
        self.assertNotEqual(corrected, terminal[1])
        surfaces = [result["colours"][name] for name in SURFACE_NAMES]
        self.assertGreaterEqual(min(contrast_ratio(corrected, surface) for surface in surfaces), 4.5)
        source_lab, corrected_lab = lab(terminal[1]), lab(corrected)
        source_hue = math.degrees(math.atan2(source_lab[2], source_lab[1]))
        corrected_hue = math.degrees(math.atan2(corrected_lab[2], corrected_lab[1]))
        hue_delta = abs((source_hue - corrected_hue + 180) % 360 - 180)
        self.assertLessEqual(hue_delta, 12)

    def test_punctuation_is_neutral_and_comments_are_darker_in_both_modes(self):
        for mode in ("dark", "light"):
            with self.subTest(mode=mode):
                result = make_palette(mode)
                colours = result["colours"]
                punctuation = colours["punctuation"]
                comments = colours["muted"]
                surfaces = SURFACE_NAMES
                self.assertLessEqual(oklab_chroma(punctuation), 0.035)
                for surface in surfaces:
                    self.assertGreaterEqual(contrast_ratio(punctuation, colours[surface]), 3.0)
                    self.assertGreaterEqual(contrast_ratio(comments, colours[surface]), 1.5)
                gap = lab(punctuation)[0] - lab(comments)[0]
                self.assertGreater(gap, 0)
                if mode == "dark":
                    self.assertAlmostEqual(gap, 0.200, delta=0.006)
                self.assertFalse(any("comment shade clamped" in line for line in result["report"]))

    def test_neutrals_are_darkened_by_the_requested_extra_shades(self):
        for mode in ("dark", "light"):
            with self.subTest(mode=mode):
                baseline = make_palette(mode, punctuation_darken=0, comment_darken=0)["colours"]
                darker = make_palette(mode)["colours"]
                for role, amount in (("punctuation", 0.10), ("muted", 0.225)):
                    actual = lab(baseline[role])[0] - lab(darker[role])[0]
                    self.assertAlmostEqual(actual, min(amount, lab(baseline[role])[0]), delta=0.006)
                for role in ("text", "red", "green", "yellow", "blue", "mauve", "teal"):
                    self.assertEqual(darker[role], baseline[role])

    def test_neutral_whites_keep_a_terminal_tint(self):
        tinted = list(TERMINAL)
        tinted[7] = "#c8d0dc"
        tinted[15] = "#e5e9f0"
        result = make_palette(terminal=tinted)
        text = result["colours"]["text"]
        self.assertGreater(oklab_chroma(text), 0.005)
        self.assertLessEqual(min(oklab_distance(text, tinted[index]) for index in (7, 15)), 0.08)

    def test_selection_foreground_contrasts_with_its_background(self):
        colours = make_palette()["colours"]
        self.assertEqual(colours["selection_text"], colours["base"])
        self.assertGreaterEqual(contrast_ratio(colours["text"], colours["surface1"]), 4.5)
        for role in ("primary", "yellow", "green", "mauve", "red"):
            with self.subTest(background=role):
                self.assertGreaterEqual(contrast_ratio(colours["selection_text"], colours[role]), 4.5)

    def test_rendered_lua_and_terminal_palettes_match_for_all_providers(self):
        source_template = Path.home() / ".config/themes/current"
        self.assertTrue(source_template.is_dir(), "current static theme is required as a render template")
        renderer = INTEGRATION / "theme-render"
        ansi = [parse_colour(colour) for colour in TERMINAL]

        with tempfile.TemporaryDirectory(prefix="neovim-render-test-") as temporary:
            root = Path(temporary)
            config_home, themes, template, wallpaper, palette_file, probe_file, result_file = make_render_fixture(
                root, source_template
            )

            for provider, variant_key, variant in PROVIDERS:
                output_dir = themes / ".dynamic" / provider
                for mode in ("dark", "light"):
                    with self.subTest(provider=provider, mode=mode):
                        palette_file.write_text(json.dumps(make_renderer_palette(mode, variant_key, variant, ansi)))
                        environment = renderer_environment(root, config_home, themes, template)
                        if mode == "dark":
                            assert_render_lifecycle(
                                self, renderer, provider, palette_file, wallpaper, environment, output_dir,
                                themes / ".dynamic",
                            )
                        else:
                            render = run_renderer(renderer, provider, palette_file, wallpaper, environment)
                            self.assertEqual(render.returncode, 0, render.stderr)

                        self.assertTrue((output_dir / "neovim.lua").is_file())
                        self.assertTrue((output_dir / f".{provider}-generated").is_file())
                        terminal, kitty, ghostty = terminal_configs(output_dir)
                        self.assertEqual(terminal, kitty)
                        self.assertEqual(terminal, ghostty)

                        nvim, loaded = run_nvim_probe(
                            output_dir / "neovim.lua", probe_file, result_file, root, PROBED_GROUPS
                        )
                        self.assertEqual(nvim.returncode, 0, nvim.stderr)
                        assert_loaded_theme(self, loaded, terminal, mode, variant)


if __name__ == "__main__":
    unittest.main()
