#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    scheme)
        shift
        [[ "${1:-}" == set ]] || exit 2
        shift
        mode="" variant=""
        while (( $# )); do
            case "$1" in
                -m) mode="$2"; shift 2 ;;
                -v) variant="$2"; shift 2 ;;
                *) shift ;;
            esac
        done
        printf '%s %s\n' "$mode" "$variant" > "$XDG_STATE_HOME/fake-scheme"
        ;;
    wallpaper)
        read -r mode variant < "$XDG_STATE_HOME/fake-scheme"
        printf 'wallpaper %s %s\n' "$mode" "$variant" >> "$FAKE_CAELESTIA_LOG"
        /usr/bin/sleep 0.1
        /usr/bin/jq -cn --arg mode "$mode" --arg variant "$variant" '
            {mode: $mode, variant: $variant,
             colours: {background: "101318", onBackground: "eaeff5", surface: "20242a", onSurface: "eaeff5",
                       primary: "81a1c1", onPrimary: "101318", secondary: "88c0d0", tertiary: "ebcb8b", error: "bf616a"}}
        '
        ;;
    *) exit 2 ;;
esac
