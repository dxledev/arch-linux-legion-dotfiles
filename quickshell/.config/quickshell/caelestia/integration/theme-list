#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: theme-list [--list | --dry-run]\n'
}

load_menu_parser() {
    local menu_script="${MENU_THEME_SCRIPT:-${DESKTOP_SCRIPTS_DIR:-$HOME/bin}/menu-theme}"
    local parser

    [[ -r "$menu_script" ]] || { printf 'Cannot read %s\n' "$menu_script" >&2; return 1; }
    # Import the existing palette functions without starting the Rofi menu.
    parser="$(/usr/bin/awk '
        /^require_command "\$ROFI_BIN"/ { found = 1; exit }
        { print }
        END { if (!found) exit 1 }
    ' "$menu_script")" || { printf 'Unsupported menu-theme parser\n' >&2; return 1; }
    source /dev/stdin <<< "$parser"
    THEME_DIR_RESOLVED="$(/usr/bin/readlink -f -- "${SHELL_THEMES_DIR:-$THEME_DIR}")"
    [[ -d "$THEME_DIR_RESOLVED" ]] || { printf 'Themes directory not found\n' >&2; return 1; }
    validate_icon_base_size
}

list_themes() {
    local dry_run="$1"
    local theme_path theme name icon current_path state_file source applied current

    load_menu_parser
    current_path="$(/usr/bin/readlink -f -- "$THEME_DIR_RESOLVED/current" || true)"
    state_file="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/shell-theme.json"
    source="$([ -r "$state_file" ] && /usr/bin/jq -r 'if .source == "dynamic" or .source == "aether" then "dynamic" else "system" end' "$state_file" 2>/dev/null || printf system)"
    {
        /usr/bin/jq -cn --argjson current "$([[ "$source" == dynamic ]] && printf true || printf false)" \
            '{id: "dynamic", name: "Dynamic", icon: "auto_awesome", iconType: "material", current: $current, applied: false, dynamic: true}'
        while IFS= read -r theme_path; do
            theme="${theme_path##*/}"
            name="$(format_theme_display "$theme")"
            if (( dry_run )); then
                icon="$(cached_palette_icon_path "$theme")"
            else
                require_command "$MAGICK_BIN" ImageMagick
                require_command "$MKDIR_BIN" mkdir
                icon="$(palette_icon "$theme" "$theme_path")"
            fi
            applied="$([[ "$(/usr/bin/readlink -f -- "$theme_path")" == "$current_path" ]] && printf true || printf false)"
            current="$([[ "$source" == system && "$applied" == true ]] && printf true || printf false)"
            /usr/bin/jq -cn --arg id "$theme" --arg name "$name" --arg icon "$icon" \
                --argjson current "$current" --argjson applied "$applied" \
                '{id: $id, name: $name, icon: $icon, iconType: "image", current: $current, applied: $applied, dynamic: false}'
        done < <(list_named_theme_paths)
    } | /usr/bin/jq -s .
}

[[ $# -le 1 ]] || { usage >&2; exit 2; }
case "${1:---list}" in
    --list) list_themes 0 ;;
    --dry-run) list_themes 1 ;;
    --help|-h) usage ;;
    *) usage >&2; exit 2 ;;
esac
