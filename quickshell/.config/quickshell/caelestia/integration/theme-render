write_hyprlock() {
    local directory="$1" index colour role
    local -a first=("$mantle" "$surface0" "$surface1" "$surface2" "$overlay0" "$overlay1" "$overlay2" "$subtext1" "$text_colour")
    local -a second=("$sapphire" "$sky" "$teal" "$green" "$yellow" "$peach" "$red" "$pink" "$lavender")
    local -a third=("$pink" "$flamingo" "$rosewater" "$red" "$peach" "$yellow" "$green" "$teal" "$sky")
    local -a fourth=("$mauve" "$lavender" "$blue" "$sapphire" "$sky" "$teal" "$green" "$yellow" "$peach")
    : > "$directory/hyprlock.conf"
    for role in 1 2 3 4; do
        case "$role" in
            1) colour="$base"; accent=("${first[@]}") ;;
            2) colour="$blue"; accent=("${second[@]}") ;;
            3) colour="$primary"; accent=("${third[@]}") ;;
            4) colour="$pink"; accent=("${fourth[@]}") ;;
        esac
        printf '$primary_%d   = %s\n$text_%d      = %s\n' "$role" "${colour^^}" "$role" "${text_colour^^}" >> "$directory/hyprlock.conf"
        for index in {1..9}; do printf '$p%d_accent_%d = %s\n' "$role" "$index" "${accent[index - 1]^^}"; done >> "$directory/hyprlock.conf"
        printf '\n$primary_%d_rgba   = rgba(%s,0.9)\n$text_%d_rgba      = rgba(%s,0.9)\n' "$role" "$(rgb "$colour" | tr -d ' ')" "$role" "$(rgb "$text_colour" | tr -d ' ')" >> "$directory/hyprlock.conf"
        for index in {1..9}; do printf '$p%d_accent_%d_rgba = rgba(%s,0.9)\n' "$role" "$index" "$(rgb "${accent[index - 1]}" | tr -d ' ')"; done >> "$directory/hyprlock.conf"
        printf '\n' >> "$directory/hyprlock.conf"
    done
    printf '$primary_5_rgba = rgba(%s,0.5)\n$primary_6_rgba = rgba(%s,0.5)\n$primary_7_rgba = rgba(%s,0.5)\n$primary_8_rgba = rgba(%s,0.5)\n\n$accent1_2   = %sCC\n$accent1_2ff = %sFF\n' "$(rgb "$base" | tr -d ' ')" "$(rgb "$blue" | tr -d ' ')" "$(rgb "$primary" | tr -d ' ')" "$(rgb "$pink" | tr -d ' ')" "${blue^^}" "${blue^^}" >> "$directory/hyprlock.conf"
}

write_spicetify() {
    local directory="$1"
    /usr/bin/mkdir -p -- "$directory/spicetify"
    if [[ -r "$spicetify_template/user.css" ]]; then
        /usr/bin/cp -- "$spicetify_template/user.css" "$directory/spicetify/user.css"
    else
        : > "$directory/spicetify/user.css"
    fi
    printf '[Dynamic]\naccent             = %s\naccent-active      = %s\naccent-inactive    = %s\nbanner             = %s\nborder-active      = %s\nborder-inactive    = %s\nheader             = %s\nhighlight          = %s\nmain               = %s\nnotification       = %s\nnotification-error = %s\nsubtext            = %s\ntext               = %s\n' "$primary" "$secondary" "$base" "$primary" "$primary" "$surface1" "$surface0" "$surface1" "$base" "$blue" "$red" "$subtext1" "$text_colour" > "$directory/spicetify/color.ini"
}

build_output() {
    local normalised="$1" wallpaper="$2" fingerprint="$3"
    local wallpaper_resolved wallpaper_directory
    wallpaper_resolved="$(/usr/bin/readlink -f -- "$wallpaper")"
    wallpaper_directory="${wallpaper_resolved%/*}"
    staging_dir="$(/usr/bin/mktemp -d "$themes_dir/.dynamic/.caelestia.render.XXXXXX")"
    /usr/bin/cp -a -- "$template_dir/." "$staging_dir/"
    write_terminals "$staging_dir"
    write_shared_formats "$staging_dir"
    write_shell_formats "$staging_dir"
    write_neovim "$staging_dir"
    write_btop "$staging_dir"
    write_template_preserving_formats "$staging_dir"
    write_application_css "$staging_dir"
    write_hyprlock "$staging_dir"
    write_spicetify "$staging_dir"
    /usr/bin/ln -sfnT -- "$wallpaper_resolved" "$staging_dir/wallpaper.png"
    /usr/bin/ln -sfnT -- "$wallpaper_directory" "$staging_dir/wallpapers"
    printf '%s\n' "$fingerprint" > "$staging_dir/.${provider}-generated"
    if [[ "$provider" == caelestia ]]; then
        printf '%s\n' "$fingerprint" > "$staging_dir/.caelestia-generated"
    fi
    /usr/bin/cp -- "$normalised" "$staging_dir/palette.json"
}

install_output() {
    /usr/bin/mkdir -p -- "${output_dir%/*}"
    if [[ -e "$output_dir" ]]; then
        backup_dir="${output_dir%/*}/.${provider}.previous.$$"
        /usr/bin/mv -- "$output_dir" "$backup_dir"
    fi
    if ! /usr/bin/mv -- "$staging_dir" "$output_dir"; then
        [[ -z "$backup_dir" || ! -e "$backup_dir" ]] || /usr/bin/mv -- "$backup_dir" "$output_dir"
        fail 'Could not activate rendered output.'
    fi
    staging_dir=""
    [[ -z "$backup_dir" || ! -e "$backup_dir" ]] || /usr/bin/rm -rf -- "$backup_dir"
    backup_dir=""
}

main() {
    local palette_file wallpaper fingerprint current_fingerprint="" template_fingerprint renderer_fingerprint
    while (( $# )); do
        case "$1" in
            --dry-run) dry_run=1 ;;
            --force) force=1 ;;
            --provider)
                shift
                (( $# )) || { usage >&2; exit 2; }
                provider="$1"
                ;;
            --help|-h) usage; return ;;
            --*) usage >&2; exit 2 ;;
            *) break ;;
        esac
        shift
    done
    (( $# == 2 )) || { usage >&2; exit 2; }
    palette_file="$1" wallpaper="$2"
    configure_provider
    validate_paths "$palette_file" "$wallpaper"
    temporary_palette="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/caelestia-palette.XXXXXX")"
    trap 'status=$?; cleanup; exit "$status"' EXIT
    normalise_palette "$palette_file" "$temporary_palette"
    load_palette "$temporary_palette"
    template_fingerprint="$(/usr/bin/find -L "$template_dir" -maxdepth 1 -type f ! -name wallpaper.png -print0 | /usr/bin/sort -z | /usr/bin/xargs -0 -r /usr/bin/sha256sum | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1)"
    renderer_fingerprint="$(/usr/bin/sha256sum "${BASH_SOURCE[0]}" | /usr/bin/cut -d' ' -f1)"
    fingerprint="$( { printf '%s\n' "$provider"; /usr/bin/sha256sum "$temporary_palette" | /usr/bin/cut -d' ' -f1; /usr/bin/readlink -f -- "$wallpaper"; /usr/bin/readlink -f -- "$template_dir"; printf '%s\n%s\n' "$template_fingerprint" "$renderer_fingerprint"; } | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1 )"
    [[ ! -r "$output_dir/.$provider-generated" ]] || current_fingerprint="$(<"$output_dir/.$provider-generated")"
    if (( ! force )) && [[ "$fingerprint" == "$current_fingerprint" ]]; then
        printf 'unchanged\n'
        return
    fi
    if (( dry_run )); then
        printf 'Provider: %s\nRender: %s\nTemplate: %s\nWallpaper: %s\nFingerprint: %s\n' "$provider" "$output_dir" "$(/usr/bin/readlink -f -- "$template_dir")" "$(/usr/bin/readlink -f -- "$wallpaper")" "$fingerprint"
        return
    fi
    /usr/bin/mkdir -p -- "$themes_dir/.dynamic"
    build_output "$temporary_palette" "$wallpaper" "$fingerprint"
    install_output
    printf 'changed\n'
}

terminal_names=(black red green yellow blue magenta cyan white)
main "$@"
