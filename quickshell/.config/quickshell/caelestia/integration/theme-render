#!/usr/bin/env bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
themes_dir="${THEMES_DIR:-$config_home/themes}"
provider="caelestia"
output_dir=""
template_dir="${THEME_TEMPLATE_DIR:-$themes_dir/current}"
spicetify_template="${SPICETIFY_TEMPLATE_DIR:-$config_home/spicetify/Themes/text}"
dry_run=0
force=0
staging_dir=""
backup_dir=""
temporary_palette=""

usage() {
    printf 'Usage: theme-render [--dry-run] [--force] [--provider caelestia|noctalia] PALETTE_JSON ABSOLUTE_WALLPAPER\n'
}

fail() {
    printf 'theme-render: %s\n' "$*" >&2
    exit 1
}

cleanup() {
    [[ -z "$staging_dir" || ! -e "$staging_dir" ]] || /usr/bin/rm -rf -- "$staging_dir"
    [[ -z "$backup_dir" || ! -e "$backup_dir" ]] || /usr/bin/rm -rf -- "$backup_dir"
    [[ -z "$temporary_palette" || ! -e "$temporary_palette" ]] || /usr/bin/rm -f -- "$temporary_palette"
}

require_absolute() {
    [[ "$2" == /* ]] || fail "$1 must be an absolute path: $2"
}

configure_provider() {
    case "$provider" in
        caelestia) output_dir="${DYNAMIC_THEME_DIR:-$themes_dir/.dynamic/caelestia}" ;;
        noctalia) output_dir="${NOCTALIA_DYNAMIC_THEME_DIR:-$themes_dir/.dynamic/noctalia}" ;;
        *) fail "Unknown provider: $provider" ;;
    esac
}

validate_paths() {
    local palette_file="$1" wallpaper="$2" themes_resolved template_resolved
    require_absolute THEMES_DIR "$themes_dir"
    require_absolute DYNAMIC_THEME_DIR "$output_dir"
    require_absolute THEME_TEMPLATE_DIR "$template_dir"
    require_absolute SPICETIFY_TEMPLATE_DIR "$spicetify_template"
    require_absolute PALETTE_JSON "$palette_file"
    require_absolute WALLPAPER "$wallpaper"
    [[ "$provider" == caelestia && "$output_dir" == "$themes_dir/.dynamic/caelestia" ||
       "$provider" == noctalia && "$output_dir" == "$themes_dir/.dynamic/noctalia" ]] ||
        fail "Dynamic output is not managed: $output_dir"
    [[ -r "$palette_file" && -f "$palette_file" ]] || fail "Palette not found: $palette_file"
    [[ -f "$wallpaper" ]] || fail "Wallpaper not found: $wallpaper"
    themes_resolved="$(/usr/bin/readlink -f -- "$themes_dir")"
    template_resolved="$(/usr/bin/readlink -f -- "$template_dir")"
    [[ -d "$themes_resolved" && -d "$template_resolved" ]] || fail 'Theme directories are unavailable.'
    [[ "${template_resolved%/*}" == "$themes_resolved" && "${template_resolved##*/}" != .* && "${template_resolved##*/}" != current ]] ||
        fail "Template must resolve to an immediate named theme: $template_dir"
    for required_file in alacritty.toml btop.theme cava chromium-flags.conf discord.css hellpaper.conf obsidian.css; do
        [[ -r "$template_dir/$required_file" ]] || fail "Template is missing $required_file: $template_dir"
    done
    if [[ -e "$output_dir" || -L "$output_dir" ]]; then
        [[ -d "$output_dir" && ! -L "$output_dir" &&
           ( -f "$output_dir/.caelestia-generated" || -f "$output_dir/.noctalia-generated" ) ]] ||
            fail "Refusing to replace unmanaged output: $output_dir"
    fi
}

normalise_palette() {
    local palette_file="$1" output="$2"
    /usr/bin/jq -e '
        def colour:
            if type != "string" then error("colour must be a string")
            else sub("^#"; "") | ascii_downcase | if test("^[0-9a-f]{6}([0-9a-f]{2})?$") then .[0:6] else error("invalid colour") end
            end;
        def pick($names): first($names[] as $name | .colours[$name] // empty) | colour;
        if (.mode != "dark" and .mode != "light") or (.colours | type != "object") then error("invalid palette") else . end |
        {
          mode,
          base: pick(["base", "background"]),
          mantle: pick(["mantle", "surfaceContainerLow", "surface", "background"]),
          crust: pick(["crust", "surfaceContainerLowest", "term0", "background"]),
          surface0: pick(["surface0", "surfaceContainer", "term0", "outlineVariant"]),
          surface1: pick(["surface1", "surfaceContainerHigh", "term8", "outlineVariant"]),
          surface2: pick(["surface2", "surfaceContainerHighest", "outlineVariant", "term8"]),
          overlay0: pick(["overlay0", "outlineVariant", "term8", "muted"]),
          overlay1: pick(["overlay1", "outline", "term8", "muted"]),
          overlay2: pick(["overlay2", "outline", "muted", "term8"]),
          text: pick(["text", "onBackground", "foreground", "term15", "term7"]),
          subtext1: pick(["subtext1", "onSurfaceVariant", "foreground", "muted", "term7"]),
          subtext0: pick(["subtext0", "outline", "muted", "term8"]),
          primary: pick(["primary", "accent", "blue", "term4"]),
          secondary: pick(["secondary", "cyan", "magenta", "term6"]),
          tertiary: pick(["tertiary", "yellow", "term3"]),
          red: pick(["red", "error", "term1"]),
          green: pick(["green", "success", "term2"]),
          yellow: pick(["yellow", "tertiary", "term3"]),
          peach: pick(["peach", "yellow", "term3"]),
          pink: pick(["pink", "magenta", "secondary", "term5"]),
          mauve: pick(["mauve", "primary", "accent", "term5"]),
          blue: pick(["blue", "primary", "term4"]),
          sapphire: pick(["sapphire", "blue", "primary", "term4"]),
          sky: pick(["sky", "cyan", "secondary", "term6"]),
          teal: pick(["teal", "cyan", "secondary", "term6"]),
          lavender: pick(["lavender", "primaryFixed", "primary", "term12"]),
          rosewater: pick(["rosewater", "onPrimaryContainer", "text", "term15"]),
          flamingo: pick(["flamingo", "pink", "secondary", "term13"]),
          terminal: [range(0; 16) as $i | pick(["term" + ($i | tostring)])]
        }
    ' "$palette_file" > "$output" || fail 'Palette is malformed or incomplete.'
}

load_palette() {
    local palette_file="$1"
    mapfile -t values < <(/usr/bin/jq -r '[.mode, .base, .mantle, .crust, .surface0, .surface1, .surface2, .overlay0, .overlay1, .overlay2, .text, .subtext1, .subtext0, .primary, .secondary, .tertiary, .red, .green, .yellow, .peach, .pink, .mauve, .blue, .sapphire, .sky, .teal, .lavender, .rosewater, .flamingo] + .terminal | .[]' "$palette_file")
    (( ${#values[@]} == 45 )) || fail 'Normalised palette is incomplete.'
    mode="${values[0]}" base="${values[1]}" mantle="${values[2]}" crust="${values[3]}"
    surface0="${values[4]}" surface1="${values[5]}" surface2="${values[6]}"
    overlay0="${values[7]}" overlay1="${values[8]}" overlay2="${values[9]}"
    text_colour="${values[10]}" subtext1="${values[11]}" subtext0="${values[12]}"
    primary="${values[13]}" secondary="${values[14]}" tertiary="${values[15]}"
    red="${values[16]}" green="${values[17]}" yellow="${values[18]}" peach="${values[19]}"
    pink="${values[20]}" mauve="${values[21]}" blue="${values[22]}" sapphire="${values[23]}"
    sky="${values[24]}" teal="${values[25]}" lavender="${values[26]}" rosewater="${values[27]}" flamingo="${values[28]}"
    terminal=("${values[@]:29:16}")
}

rgb() {
    local value="$1"
    printf '%d, %d, %d' "$((16#${value:0:2}))" "$((16#${value:2:2}))" "$((16#${value:4:2}))"
}

write_terminals() {
    local directory="$1" index
    {
        printf '[colors.primary]\nbackground = "#%s"\nforeground = "#%s"\n\n' "$base" "$text_colour"
        printf '[colors.normal]\n'
        for index in {0..7}; do printf '%-7s = "#%s"\n' "${terminal_names[index]}" "${terminal[index]}"; done
        printf '\n[colors.bright]\n'
        for index in {8..15}; do printf '%-7s = "#%s"\n' "${terminal_names[index - 8]}" "${terminal[index]}"; done
    } > "$directory/alacritty.toml"
    {
        printf 'foreground #%s\nbackground #%s\n\n' "$text_colour" "$base"
        for index in {0..15}; do printf 'color%-2d #%s\n' "$index" "${terminal[index]}"; done
    } > "$directory/kitty.conf"
    {
        printf 'background = #%s\nforeground = #%s\n\n' "$base" "$text_colour"
        for index in {0..15}; do printf 'palette = %d=#%s\n' "$index" "${terminal[index]}"; done
    } > "$directory/ghostty.ghostty"
}

write_shared_formats() {
    local directory="$1" user_rgb
    user_rgb="$(rgb "$base")"
    printf 'Simp1e-Dark\n' > "$directory/cursor"
    printf '{ "BrowserThemeColor": "#%s" }\n' "$base" > "$directory/brave.json"
    /usr/bin/awk -v rgb="${user_rgb// /}" -v scheme="$mode" '
        /^--set-user-color=/ { print "--set-user-color=" rgb; next }
        /^--set-color-variant=/ { print "--set-color-variant=standard"; next }
        /^--set-color-scheme=/ { print "--set-color-scheme=" scheme; next }
        { print }
    ' "$template_dir/chromium-flags.conf" > "$directory/chromium-flags.conf"
    printf 'hl.config({\n  general = {\n    col = {\n      active_border = { colors = { "rgba(%sff)", "rgba(%sff)" }, angle = 45 },\n      inactive_border = "rgba(%sff)",\n    },\n  },\n})\n' "$primary" "$text_colour" "$surface0" > "$directory/borders.lua"
    printf 'general {\n    col.active_border = rgba(%sff) rgba(%sff) 45deg\n    col.inactive_border = rgba(%sff)\n}\n' "$primary" "$text_colour" "$surface0" > "$directory/borders.conf"
    printf 'hl.config({\n    plugin = {\n        hymission = {\n            niri_mode_wallpaper_zoom_background_color = "#%sff"\n        }\n    }\n})\n' "$mantle" > "$directory/hymission-background.lua"
    printf '* {\n    bg:        #%sEB;\n    bg-2:      #%s;\n    fg:        #%s;\n    accent:    #%s;\n    border:    #%s;\n    muted:     #%s;\n}\n' "$base" "$base" "$text_colour" "$primary" "$primary" "$subtext0" > "$directory/rofi.rasi"
    printf '@define-color base #%s;\n@define-color mantle #%s;\n@define-color crust #%s;\n@define-color surface0 #%s;\n@define-color surface1 #%s;\n@define-color surface2 #%s;\n@define-color text #%s;\n@define-color subtext #%s;\n@define-color accent #%s;\n@define-color blue #%s;\n@define-color green #%s;\n@define-color red #%s;\n@define-color orange #%s;\n' "$base" "$mantle" "$crust" "$surface0" "$surface1" "$surface2" "$text_colour" "$subtext1" "$primary" "$blue" "$green" "$red" "$peach" > "$directory/gtk.css"
}

write_shell_formats() {
    local directory="$1"
    printf 'pragma Singleton\n\nimport Quickshell\nimport QtQuick\n\nSingleton {\n    readonly property color background: "#%s"\n    readonly property color backgroundAlt: "#%s"\n    readonly property color backgroundAlpha: Qt.rgba(%s, 0.87)\n    readonly property color backgroundGray: "#%s"\n    readonly property color foreground: "#%s"\n    readonly property color foregroundInactive: "#%s"\n    readonly property color primary: "#%s"\n    readonly property color muted: "#%s"\n    readonly property color border: "#%s"\n    readonly property color secondary: "#%s"\n    readonly property color success: "#%s"\n    readonly property color warning: "#%s"\n    readonly property color danger: "#%s"\n}\n' "$base" "$mantle" "$(rgb "$surface0" | /usr/bin/sed 's/, / \/ 255, /g; s/$/ \/ 255/')" "$surface0" "$text_colour" "$subtext0" "$primary" "$overlay1" "$primary" "$secondary" "$green" "$yellow" "$red" > "$directory/Colors.qml"
    printf 'pragma Singleton\nimport QtQuick\n\nQtObject {\n    property color bg:        "#%s"\n    property color fg:        "#%s"\n    property color muted:     "#%s"\n    property color accent:    "#%s"\n    property color secondary: "#%s"\n    property color green:     "#%s"\n    property color border:    "#%s"\n\n    property real opacity: 1.0\n}\n' "$base" "$text_colour" "$subtext0" "$primary" "$secondary" "$green" "$primary" > "$directory/dashboard.qml"
    printf ':root {\n    --color-primary: #%s;\n    --color-secondary: #%s;\n    --color-accent: #%s;\n    --color-surface: #%s;\n    --color-surface-alt: #%s;\n    --color-panel-backdrop: var(--color-surface);\n    --color-picker-backdrop: var(--color-surface);\n    --color-content-backdrop: var(--color-surface-alt);\n    --color-border: #%s;\n    --color-text: #%s;\n    --color-muted: #%s;\n    --color-success: #%s;\n    --color-warning: #%s;\n    --color-danger: #%s;\n    --panel-bg: var(--color-surface);\n    --header-bg: var(--color-surface-alt);\n    --content-bg: var(--color-surface);\n    --border-color: var(--color-border);\n    --text-color: var(--color-text);\n    --text-muted-color: var(--color-muted);\n    --button-primary-bg: var(--color-primary);\n    --button-primary-fg: var(--color-surface);\n    --input-bg: #%s;\n    --slider-track-bg: #%s;\n    --slider-fill-bg: var(--color-primary);\n    --swatch-selected-border-color: var(--color-secondary);\n}\n' "$primary" "$secondary" "$tertiary" "$base" "$surface0" "$subtext0" "$text_colour" "$subtext1" "$green" "$yellow" "$red" "$surface1" "$surface0" > "$directory/chromack.css"
    printf ':root { --background: #%sD9; --text-color: #%s; --primary-color: #%s; --secondary-color: #%s; --border-color: #%s; }\n' "$base" "$text_colour" "$primary" "$secondary" "$primary" > "$directory/ward.css"
    printf '@define-color foreground #%s;\n@define-color background #%s;\n@define-color primary #%s;\n@define-color muted #%s;\n@define-color border #%s;\n@define-color background-alpha rgba(%s, 0.87);\n@define-color background-alt #%s;\n@define-color foreground-inactive #%s;\n' "$text_colour" "$base" "$primary" "$overlay1" "$primary" "$(rgb "$surface0")" "$mantle" "$subtext0" > "$directory/waybar.css"
    for index in {0..7}; do printf '@define-color %s #%s;\n' "${terminal_names[index]}" "${terminal[index]}"; done >> "$directory/waybar.css"
    for index in {8..15}; do printf '@define-color bright-%s #%s;\n' "${terminal_names[index - 8]}" "${terminal[index]}"; done >> "$directory/waybar.css"
    printf '@define-color background-gray #%s;\n' "$surface0" >> "$directory/waybar.css"
    printf '@define-color background-color #%sD9;\n@define-color border-color #%s;\n@define-color progress #%s;\n@define-color label #%s;\n@define-color image #%s;\n' "$base" "$primary" "$primary" "$text_colour" "$secondary" > "$directory/swayosd.css"
    printf '@define-color window-background rgba(%s, 0);\n@define-color app-background rgba(%s, 0.6);\n@define-color button-background rgba(%s, 0.25);\n@define-color indicator-point #%s;\n@define-color preview-item-background rgba(%s, 0.47);\n@define-color preview-item-border rgba(%s, 0.12);\n@define-color preview-item-hover-background rgba(%s, 0.30);\n' "$(rgb "$base")" "$(rgb "$base")" "$(rgb "$overlay1")" "$primary" "$(rgb "$overlay1")" "$(rgb "$primary")" "$(rgb "$overlay1")" > "$directory/dock.css"
    printf ':root {\n  --panel-bg: #%s; --panel-border: #%s; --list-bg: #%s; --header-bg: #%s; --header-color: #%s; --footer-bg: #%s; --footer-color: #%s;\n  --card-bg: #%s; --card-border: #%s; --summary-color: #%s; --body-color: #%s; --app-name-color: #%s; --timestamp-color: #%s;\n  --badge-bg: #%s; --badge-color: #%s; --clear-bg: #%s; --clear-hover-bg: #%s; --clear-color: #%s;\n  --dismiss-color: #%s; --dismiss-hover-bg: #%s; --action-bg: #%s; --action-hover-bg: #%s; --action-color: #%s;\n  --icon-bg: #%s; --handle-bg: #%s; --scrollbar-track-bg: #%s; --scrollbar-thumb-bg: #%s; --scrollbar-thumb-hover-bg: #%s;\n}\n' "$base" "$subtext0" "$base" "$surface0" "$text_colour" "$surface0" "$subtext0" "$surface1" "$subtext0" "$text_colour" "$subtext1" "$primary" "$subtext0" "$surface1" "$primary" "$primary" "$secondary" "$crust" "$subtext1" "$surface1" "$surface0" "$surface2" "$text_colour" "$surface0" "$primary" "$surface0" "$primary" "$secondary" > "$directory/wardnc.css"
}

write_btop() {
    local directory="$1"
    /usr/bin/awk -v main_bg="#$base" -v main_fg="#$text_colour" -v title="#$text_colour" -v hi_fg="#$primary" \
        -v selected_bg="#$surface1" -v selected_fg="#$primary" -v inactive_fg="#$subtext0" -v graph_text="#$rosewater" \
        -v meter_bg="#$surface1" -v proc_misc="#$rosewater" -v cpu_box="#$mauve" -v mem_box="#$green" \
        -v net_box="#$flamingo" -v proc_box="#$blue" -v div_line="#$overlay2" -v temp_start="#$green" \
        -v temp_mid="#$yellow" -v temp_end="#$red" -v cpu_start="#$teal" -v cpu_mid="#$sky" -v cpu_end="#$lavender" \
        -v free_start="#$mauve" -v free_mid="#$lavender" -v free_end="#$blue" -v cached_start="#$sky" \
        -v cached_mid="#$blue" -v cached_end="#$lavender" -v available_start="#$peach" -v available_mid="#$flamingo" \
        -v available_end="#$red" -v used_start="#$green" -v used_mid="#$teal" -v used_end="#$sky" \
        -v download_start="#$peach" -v download_mid="#$flamingo" -v download_end="#$red" \
        -v upload_start="#$green" -v upload_mid="#$teal" -v upload_end="#$sky" -v process_start="#$sky" \
        -v process_mid="#$lavender" -v process_end="#$mauve" '
        BEGIN { split("main_bg main_fg title hi_fg selected_bg selected_fg inactive_fg graph_text meter_bg proc_misc cpu_box mem_box net_box proc_box div_line temp_start temp_mid temp_end cpu_start cpu_mid cpu_end free_start free_mid free_end cached_start cached_mid cached_end available_start available_mid available_end used_start used_mid used_end download_start download_mid download_end upload_start upload_mid upload_end process_start process_mid process_end", names) }
        { for (i in names) if ($0 ~ "^theme\\[" names[i] "\\]=") { value = SYMTAB[names[i]]; sub(/"#[0-9A-Fa-f]+"/, "\"" value "\"") } print }
    ' "$template_dir/btop.theme" > "$directory/btop.theme"
}

write_template_preserving_formats() {
    local directory="$1"
    /usr/bin/awk -v c1="#$primary" -v c2="#$red" -v c3="#$pink" -v c4="#$flamingo" -v c5="#$rosewater" -v c6="#$peach" -v c7="#$lavender" -v c8="#$blue" '
        /^gradient_color_[1-8][[:space:]]*=/ { split($0, parts, "_"); gradient_index=parts[3]+0; value=SYMTAB["c" gradient_index]; sub(/=.*/, "= '\''" value "'\''"); print; next }
        { print }
    ' "$template_dir/cava" > "$directory/cava"
    /usr/bin/awk -v bg="$(rgb "$base"), 255" -v idle="$(rgb "$mantle"), 255" -v hover="$(rgb "$surface0"), 255" \
        -v border="$(rgb "$primary"), 255" -v ripple="$(rgb "$secondary"), 255" -v overlay="$(rgb "$base"), 200" -v text="$(rgb "$text_colour"), 255" '
        /^\[Theme\]/ { in_theme=1; print; next }
        /^\[/ { in_theme=0 }
        in_theme && /^[[:space:]]*(bg|idle|hover|border|ripple|overlay|text)[[:space:]]*=/ {
            key=$1; value=SYMTAB[key]; sub(/=.*/, "= " value); print; next
        }
        { print }
    ' "$template_dir/hellpaper.conf" > "$directory/hellpaper.conf"
}

write_application_css() {
    local directory="$1"
    /usr/bin/cp -- "$template_dir/discord.css" "$directory/discord.css"
    printf '\nbody {\n  --bg-4: #%s; --bg-3: #%s; --bg-2: #%s; --bg-1: #%s;\n  --text-0: #%s; --text-1: #%s; --text-2: #%s; --text-3: #%s; --text-4: #%s; --text-5: #%s;\n  --accent-1: #%s; --accent-2: #%s; --accent-3: #%s; --accent-4: #%s; --accent-5: #%s; --accent-new: #%s;\n  --online: #%s; --idle: #%s; --dnd: #%s; --streaming: #%s; --offline: #%s;\n  --border-light: #%s; --border: #%s; --border-hover: #%s;\n}\n' "$base" "$mantle" "$crust" "$crust" "$crust" "$text_colour" "$pink" "$subtext1" "$subtext0" "$overlay1" "$blue" "$primary" "$pink" "$lavender" "$sapphire" "$red" "$green" "$yellow" "$red" "$mauve" "$overlay1" "$surface1" "$primary" "$primary" >> "$directory/discord.css"
    /usr/bin/cp -- "$template_dir/obsidian.css" "$directory/obsidian.css"
    printf '\n.theme-dark, .theme-light {\n  --background-primary: #%s; --background-primary-alt: #%s; --background-secondary: #%s; --background-secondary-alt: #%s;\n  --text-normal: #%s; --text-selection: #%s; --background-modifier-border: #%s;\n  --text-title-h1: #%s; --text-title-h2: #%s; --text-title-h3: #%s; --text-title-h4: #%s; --text-title-h5: #%s; --text-title-h6: #%s;\n  --text-link: #%s; --text-accent: #%s; --text-accent-hover: #%s; --interactive-accent: #%s; --interactive-accent-hover: #%s;\n  --text-muted: #%s; --text-faint: #%s; --code-normal: #%s; --text-error: #%s; --text-error-hover: #%s; --text-success: #%s;\n  --tag-color: #%s; --tag-background: #%s; --graph-line: #%s; --graph-node: #%s; --graph-node-focused: #%s; --graph-node-tag: #%s; --graph-node-attachment: #%s;\n}\n' "$base" "$base" "$mantle" "$mantle" "$text_colour" "$surface1" "$surface1" "$red" "$green" "$yellow" "$blue" "$primary" "$secondary" "$blue" "$primary" "$primary" "$primary" "$secondary" "$subtext1" "$surface2" "$primary" "$red" "$red" "$green" "$primary" "$surface1" "$surface1" "$primary" "$blue" "$primary" "$green" >> "$directory/obsidian.css"
}

write_neovim() {
    local directory="$1"
    if [[ -e "$directory/neovim.lua" || -L "$directory/neovim.lua" ]]; then
        /usr/bin/rm -f -- "$directory/neovim.lua"
    fi
    {
        printf 'local palette = {\n'
        printf '  base = "#%s", mantle = "#%s", surface0 = "#%s", surface1 = "#%s", surface2 = "#%s",\n' "$base" "$mantle" "$surface0" "$surface1" "$surface2"
        printf '  overlay0 = "#%s", overlay1 = "#%s", text = "#%s", subtext0 = "#%s", subtext1 = "#%s",\n' "$overlay0" "$overlay1" "$text_colour" "$subtext0" "$subtext1"
        printf '  primary = "#%s", secondary = "#%s", peach = "#%s", red = "#%s", green = "#%s", yellow = "#%s",\n' "$primary" "$secondary" "$peach" "$red" "$green" "$yellow"
        printf '  blue = "#%s", mauve = "#%s", pink = "#%s", teal = "#%s", sky = "#%s", lavender = "#%s"\n' "$blue" "$mauve" "$pink" "$teal" "$sky" "$lavender"
        printf '}\n\n'
        printf 'vim.cmd("highlight clear")\n'
        printf 'if vim.fn.exists("syntax_on") == 1 then vim.cmd("syntax reset") end\n'
        printf 'vim.o.background = "%s"\n' "$mode"
        printf 'vim.o.termguicolors = true\n'
        printf 'vim.g.colors_name = "desktop-dynamic"\n\n'
        printf 'local function set(names, value)\n'
        printf '  for _, name in ipairs(names) do vim.api.nvim_set_hl(0, name, value) end\n'
        printf 'end\n\n'
        printf 'set({ "Normal", "NormalNC" }, { fg = palette.text, bg = "NONE" })\n'
