{
    "appearance": {
        "font": {
            "body": {
                "family": "CaskaydiaMono Nerd Font"
            },
            "clock": "CaskaydiaMono Nerd Font",
            "headline": {
                "family": "CaskaydiaMono Nerd Font"
            },
            "label": {
                "family": "CaskaydiaMono Nerd Font"
            },
            "mono": {
                "family": "CaskaydiaMono Nerd Font"
            },
            "title": {
                "family": "CaskaydiaMono Nerd Font"
            },
            "workspaces": "CaskaydiaMono Nerd Font"
        }
    },
    "background": {
        "enabled": false
    },
    "bar": {
        "clock": {
            "showDate": true
        },
        "statusIcons": [
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            }
        ],
        "tray": {
            "iconSubs": [
                {
                    "icon": "discord-tray",
                    "id": "vesktop_status_icon_1"
                }
            ]
        },
        "workspaces": {
            "perMonitorWorkspaces": true,
            "shown": 5,
            "specialWorkspaceIcons": [
                {
                    "icon": "music_note",
                    "name": "mediaspace"
                },
                {
                    "icon": "forum",
                    "name": "discordspace"
                },
                {
                    "icon": "terminal",
                    "name": "scratchpad"
                },
                {
                    "icon": "chat",
                    "name": "socialspace"
                }
            ]
        }
    },
    "general": {
        "apps": {
            "audio": [
                "/usr/bin/pavucontrol"
            ],
            "explorer": [
                "/usr/bin/nemo"
            ],
            "playback": [
                "/usr/bin/celluloid"
            ],
            "terminal": [
                "/home/dxle/bin/launch-terminal"
            ]
        },
        "idle": {
            "lockBeforeSleep": false,
            "timeouts": [
            ]
        }
    },
    "launcher": {
        "actions": [
            {
                "command": [
                    "apps"
                ],
                "description": "Open the app menu",
                "icon": "apps",
                "name": "Apps"
            },
            {
                "command": [
                    "autocomplete",
                    "calc"
                ],
                "description": "Calculate with Qalc",
                "icon": "calculate",
                "name": "Calculator"
            },
            {
                "command": [
                    "chromack"
                ],
                "description": "Pick colors and generate palettes",
                "icon": "palette",
                "name": "Chromack"
            },
            {
                "command": [
                    "autocomplete",
                    "theme"
                ],
                "description": "Choose a system theme",
                "icon": "palette",
                "name": "Theme"
            },
            {
                "command": [
                    "autocomplete",
                    "wallpaper"
                ],
                "description": "Choose a wallpaper from the current theme",
                "icon": "image",
                "name": "Wallpaper"
            },
            {
                "command": [
                    "autocomplete",
                    "fonts"
                ],
                "description": "Choose a font",
                "icon": "font_download",
                "name": "Fonts"
            },
            {
                "command": [
                    "autocomplete",
                    "terminal-prompt"
