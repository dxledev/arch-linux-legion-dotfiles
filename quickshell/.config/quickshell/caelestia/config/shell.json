                "name": "System Update"
            },
            {
                "command": [
                    "panel",
                    "bluetooth"
                ],
                "description": "Manage Bluetooth devices",
                "icon": "bluetooth",
                "name": "Bluetooth"
            },
            {
                "command": [
                    "panel",
