                "icon": "lock",
                "name": "Lock"
            },
            {
                "command": [
                    "autocomplete",
                    "learn"
                ],
                "description": "Keybindings and documentation",
                "icon": "school",
                "name": "Learn"
            },
            {
                "command": [
                    "autocomplete",
                    "capture"
                ],
                "description": "Screenshot and recording tools",
                "icon": "screenshot_monitor",
                "name": "Capture"
            },
            {
                "command": [
                    "/home/dxle/.config/quickshell/scripts/quickshell",
