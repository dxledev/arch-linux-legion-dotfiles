    "osd": {
        "enabled": true
    },
    "paths": {
        "wallpaperDir": "/home/dxle/.config/themes/current/wallpapers"
    },
    "services": {
        "gpuType": "Nvidia",
        "sensorUnits": "Fahrenheit",
        "smartScheme": false,
        "useTwelveHourClock": false,
        "weatherUnits": "Fahrenheit"
    },
    "session": {
        "commands": {
            "hibernate": [
                "/home/dxle/bin/system-toggle-nightlight"
            ],
            "logout": [
                "/home/dxle/.config/hyprlock/scripts/launch-lock-screen.sh"
            ]
        },
        "icons": {
            "hibernate": "nightlight",
            "logout": "lock"
        }
    },
