                "icon": "battery_full",
                "name": "Battery & Power Profile"
            },
            {
                "command": [
                    "idle-lock"
                ],
                "description": "Toggle automatic screen locking",
                "icon": "lock",
                "name": "Idle Lock"
            },
            {
                "command": [
                    "nightlight"
                ],
                "description": "Toggle nightlight",
                "icon": "nightlight",
                "name": "Nightlight"
            },
            {
                "command": [
                    "/usr/bin/bash",
                    "/home/dxle/.config/quickshell/scripts/restart-shell",
