+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/crmne/hyprmoncfg/internal/hypr"
+	"github.com/crmne/hyprmoncfg/internal/profile"
+)
+
+func TestManualProfileDoesNotEnablePanelDuringExternalRecovery(t *testing.T) {
+	restored := wakeMonitors()
+	restored[0].Disabled = true
+	chosen := profile.FromMonitors("External Only", restored)
+	for _, panelEnabled := range []bool{false, true} {
+		name := "panel stays disabled"
+		if panelEnabled {
+			name = "panel disabled after config drift"
+		}
+		t.Run(name, func(t *testing.T) {
+			before := append([]hypr.Monitor(nil), restored...)
+			before[0].Disabled = !panelEnabled
+			for i := 1; i < len(before); i++ {
+				before[i].Width, before[i].Height = 0, 0
+			}
+			beforeJSON, _ := json.Marshal(before)
+			afterJSON, _ := json.Marshal(restored)
+			env := newApplyBestTestEnvWithMonitors(t, string(beforeJSON), string(afterJSON))
+			svc := New(env.client, env.store, Config{MonitorsConf: env.monitorsConfPath, HyprConfig: env.hyprlandConfigPath})
+			svc.setManualOverride(profile.MonitorSetHash(restored), chosen)
+			if err := svc.applyBest(context.Background()); err != nil {
+				t.Fatalf("manual profile recovery: %v", err)
+			}
+			if !strings.Contains(readMonitorsConf(t, env), "output = eDP-1\n  disabled = 1") {
+				t.Fatal("recovery enabled the deliberately disabled panel")
+			}
+		})
+	}
+}
+
+func TestManualProfileSurvivesDaemonRestart(t *testing.T) {
+	configDir := t.TempDir()
+	monitors := wakeMonitors()
+	monitors[0].Disabled = true
+	chosen := profile.FromMonitors("External Only", monitors)
+	monitorSet := profile.MonitorSetHash(monitors)
+	svc := New(nil, nil, Config{ConfigDir: configDir})
+	svc.setManualOverride(monitorSet, chosen)
+
+	restarted := New(nil, nil, Config{ConfigDir: configDir})
+	got, held := restarted.manualOverride(monitorSet)
+	panel, found := got.OutputByKey(monitors[0].HardwareKey())
+	if !held || got.Name != chosen.Name || !found || panel.Enabled {
+		t.Fatalf("restart discarded manual layout: %+v, held=%t", got, held)
+	}
+	restarted.clearManualOverride()
+	if _, held := New(nil, nil, Config{ConfigDir: configDir}).manualOverride(monitorSet); held {
+		t.Fatal("explicit automatic selection was lost on restart")
+	}
+}
+
+func TestManualProfileDoesNotReturnAfterHardwareChangeAndRestart(t *testing.T) {
+	configDir := t.TempDir()
+	monitors := wakeMonitors()
+	svc := New(nil, nil, Config{ConfigDir: configDir})
+	svc.setManualOverride(profile.MonitorSetHash(monitors), profile.FromMonitors("Desk", monitors))
+	svc.releaseManualOverrideForMonitorSet("different hardware")
+	if _, held := svc.manualOverride("different hardware"); held {
+		t.Fatal("manual layout held for unrelated hardware")
+	}
+	if _, held := New(nil, nil, Config{ConfigDir: configDir}).manualOverride(profile.MonitorSetHash(monitors)); held {
+		t.Fatal("released manual layout returned after restart")
+	}
+}
+
+func TestMonitorStatusReadDoesNotReleaseManualProfile(t *testing.T) {
+	configDir := t.TempDir()
+	monitors := wakeMonitors()
+	monitorSet := profile.MonitorSetHash(monitors)
+	svc := New(nil, nil, Config{ConfigDir: configDir})
+	svc.setManualOverride(monitorSet, profile.FromMonitors("Desk", monitors))
+	if _, held := svc.manualOverride("incomplete status snapshot"); held {
+		t.Fatal("manual layout reported for unrelated hardware")
+	}
+	for _, current := range []*Service{svc, New(nil, nil, Config{ConfigDir: configDir})} {
+		if got, held := current.manualOverride(monitorSet); !held || got.Name != "Desk" {
+			t.Fatal("a status read discarded the manual choice")
+		}
+	}
+}
+
+func TestManualProfileRejectsInvalidPersistedState(t *testing.T) {
+	configDir := t.TempDir()
+	if err := os.WriteFile(configDir+"/manual-profile.json", []byte(`{"monitor_set":"desk","profile":{"name":"Broken"}}`), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, held := New(nil, nil, Config{ConfigDir: configDir}).manualOverride("desk"); held {
+		t.Fatal("invalid persisted layout became authoritative")
+	}
+}
