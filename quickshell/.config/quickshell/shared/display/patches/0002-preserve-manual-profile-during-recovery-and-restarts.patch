+package daemon
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+
+	"github.com/crmne/hyprmoncfg/internal/config"
+	"github.com/crmne/hyprmoncfg/internal/profile"
+)
+
+type manualProfileState struct {
+	MonitorSet string          `json:"monitor_set"`
+	Profile    profile.Profile `json:"profile"`
+}
+
+func (s *Service) releaseManualOverrideForMonitorSet(monitorSet string) {
+	s.manualMu.Lock()
+	defer s.manualMu.Unlock()
+	if s.manualSet == "" || s.manualSet == monitorSet {
+		return
+	}
+	// Status reads can see an incomplete topology during a config reload.
+	// Only the daemon's reconciliation may release a choice for new hardware.
+	s.manualSet, s.manualProfile = "", profile.Profile{}
+	s.persistManualOverride()
+}
+
+func (s *Service) manualStatePath() string {
+	return filepath.Join(s.cfg.ConfigDir, "manual-profile.json")
+}
+
+func (s *Service) persistManualOverride() {
+	if s.cfg.ConfigDir == "" {
+		return
+	}
+	data, err := json.Marshal(manualProfileState{MonitorSet: s.manualSet, Profile: s.manualProfile})
+	if err == nil {
+		err = config.WriteFileAtomic(s.manualStatePath(), append(data, '\n'), 0o600)
+	}
+	if err != nil {
+		s.cfg.Logf("could not persist manual profile selection: %v", err)
+	}
+}
+
+func (s *Service) restoreManualOverride() {
+	if s.cfg.ConfigDir == "" {
+		return
+	}
+	data, err := os.ReadFile(s.manualStatePath())
+	if errors.Is(err, os.ErrNotExist) {
+		return
+	}
+	var saved manualProfileState
+	if err == nil {
+		err = json.Unmarshal(data, &saved)
+	}
+	if err != nil {
+		s.cfg.Logf("could not restore manual profile selection: %v", err)
+		return
+	}
+	if saved.MonitorSet == "" || saved.Profile.Name == "" {
+		return
+	}
+	if err := saved.Profile.Validate(); err != nil {
+		s.cfg.Logf("invalid persisted manual profile selection: %v", err)
+		return
+	}
+	s.manualSet, s.manualProfile = saved.MonitorSet, saved.Profile
+}
