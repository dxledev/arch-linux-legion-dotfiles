+package daemon
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/crmne/hyprmoncfg/internal/hypr"
+	"github.com/crmne/hyprmoncfg/internal/lid"
+	"github.com/crmne/hyprmoncfg/internal/profile"
+)
+
+func TestRefreshLidStatePreservesManualProfile(t *testing.T) {
+	for _, state := range []lid.State{lid.Closed, lid.Open} {
+		t.Run(string(state), func(t *testing.T) {
+			svc := New(nil, nil, Config{})
+			svc.lidSupported = true
+			svc.setLidState(lid.Open)
+			if state == lid.Open {
+				svc.setLidState(lid.Closed)
+			}
+			svc.readLid = func(context.Context) (lid.State, error) { return state, nil }
+			svc.setManualOverride("desk", profile.Profile{Name: "External Only"})
+			svc.refreshLidState(context.Background())
+			if svc.lidState != state {
+				t.Fatalf("lid state = %q, want %q", svc.lidState, state)
+			}
+			chosen, held := svc.manualOverride("desk")
+			if !held || chosen.Name != "External Only" {
+				t.Fatalf("fresh lid read discarded manual profile: %+v, held=%t", chosen, held)
+			}
+		})
+	}
+}
+
+func TestRunManualProfileSurvivesLidChanges(t *testing.T) {
+	monitors := []hypr.Monitor{
+		{Name: "eDP-2", Make: "Laptop", Model: "Panel", Serial: "internal", Width: 1920, Height: 1080, RefreshRate: 60, Scale: 1, Disabled: true},
+		{Name: "HDMI-A-1", Make: "External", Model: "Panel", Serial: "desk", Width: 1920, Height: 1080, RefreshRate: 60, Scale: 1, DPMSStatus: true},
+	}
+	chosen := profile.FromMonitors("Home", monitors)
+	env := newRunTestEnv(t, monitors, func(svc *Service) {
+		svc.setManualOverride(profile.MonitorSetHash(monitors), chosen)
+		automatic := append([]hypr.Monitor(nil), monitors...)
+		automatic[0].Disabled = false
+		if err := svc.store.Save(profile.FromMonitors("Current Layout", automatic)); err != nil {
+			t.Fatal(err)
+		}
+	})
+	defer env.stop()
+	waitFor(t, time.Second, func() bool {
+		return env.logs.contains("automatic reconciliation completed")
+	}, "startup reconciliation")
+
+	for _, state := range []lid.State{lid.Closed, lid.Open} {
+		baseline := strings.Count(env.logs.all(), "automatic reconciliation completed")
+		env.setLid(state)
+		env.lidStates <- state
+		waitFor(t, 2*time.Second, func() bool {
+			return strings.Count(env.logs.all(), "automatic reconciliation completed") > baseline
+		}, "lid reconciliation")
+		got, held := env.svc.manualOverride(profile.MonitorSetHash(monitors))
+		if !held || got.Name != chosen.Name {
+			t.Fatalf("lid %s discarded manual choice: %+v, held=%t\n%s", state, got, held, env.logs.all())
+		}
+		content, err := os.ReadFile(env.monitorsConfPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(content), "output = eDP-2\n  disabled = 1") {
+			t.Fatalf("lid %s enabled the deliberately disabled laptop panel:\n%s", state, content)
+		}
+	}
+}
