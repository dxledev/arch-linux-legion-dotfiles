@@ -0,0 +1,146 @@
+package wallpaperfusion
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+)
+
+func fixture(t *testing.T, name string) string {
+	t.Helper()
+	body, err := os.ReadFile("testdata/" + name + ".txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(body)
+}
+
+func TestSearchPages(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.URL.Path != "/Ajax/BuildSearchResultsHTML/" {
+			t.Errorf("unexpected search request: %s %s", r.Method, r.URL.Path)
+		}
+		if err := r.ParseForm(); err != nil {
+			t.Error(err)
+		}
+		if r.Form.Get("Text") != "nature & lakes" || r.Form.Get("Sort") != "4" || r.Form.Get("Mon") != "2" {
+			t.Errorf("filters were not encoded correctly: %v", r.Form)
+		}
+		io.WriteString(w, fixture(t, "page"+r.Form.Get("Page")))
+	}))
+	defer server.Close()
+	client := &Client{http: server.Client(), baseURL: server.URL}
+	seen := make(map[string]bool)
+	for page := 0; page < 2; page++ {
+		result, err := client.Search(SearchParams{Query: " nature & lakes ", Page: page, Sort: 4, Monitors: 2})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(result.Data) != 2 || result.Page != page || !result.HasMore {
+			t.Fatalf("unexpected page: %+v", result)
+		}
+		for _, wallpaper := range result.Data {
+			if seen[wallpaper.ID] || !IsDownloadURL(wallpaper.Path) || wallpaper.Source != "wallpaperfusion" || wallpaper.CreditURL != wallpaper.URL || !imageURLAllowed(wallpaper.Thumbs["small"]) {
+				t.Fatalf("invalid or repeated wallpaper: %+v", wallpaper)
+			}
+			seen[wallpaper.ID] = true
+		}
+	}
+}
+
+func TestSearchResponseValidation(t *testing.T) {
+	body := fixture(t, "page0")
+	for name, response := range map[string]string{
+		"unexpected layout":   "<html>Service unavailable</html>",
+		"wrong request":       strings.Replace(body, "2:::", "3:::", 1),
+		"untrusted thumbnail": strings.ReplaceAll(body, "binaryfortressdownloads.com", "example.com"),
+		"untrusted page":      strings.ReplaceAll(body, "www.wallpaperfusion.com/Image/", "example.com/Image/"),
+	} {
+		t.Run(name, func(t *testing.T) {
+			if _, err := parseResponse(response, 0); err == nil {
+				t.Fatal("expected a clear error instead of silently empty results")
+			}
+		})
+	}
+	parts := strings.SplitN(body, ":::", 13)
+	parts[7], parts[11] = "<p>No matches</p>", "True"
+	result, err := parseResponse(strings.Join(parts, ":::"), 0)
+	if err != nil || len(result.Data) != 0 || result.HasMore || result.Data == nil {
+		t.Fatalf("no matches was not handled: %+v, %v", result, err)
+	}
+	parts[7] = `<a class="ImageThumbBorder" href="https://www.wallpaperfusion.com/Image/lakes/12/"><span class="ImageThumb" style="background-image:url('https://binaryfortressdownloads.com/Download/WPF/Images/12/thumb.jpg');"></span><span class="ImageThumbHoverTitle">Lakes &amp; <b>Mountains</b></span></a>`
+	parts[7] += parts[7]
+	result, err = parseResponse(strings.Join(parts, ":::"), 0)
+	if err != nil || len(result.Data) != 1 || result.Data[0].Title != "Lakes & Mountains" {
+		t.Fatalf("HTML decoding or deduplication failed: %+v, %v", result, err)
+	}
+}
+
+func TestSearchFailure(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusTooManyRequests)
+	}))
+	defer server.Close()
+	client := &Client{http: server.Client(), baseURL: server.URL}
+	if _, err := client.Search(SearchParams{}); err == nil || !strings.Contains(err.Error(), "rate limit") {
+		t.Fatalf("expected rate-limit feedback: %v", err)
+	}
+	if _, err := client.Search(SearchParams{Page: -1}); err == nil {
+		t.Fatal("negative page accepted")
+	}
+}
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestResolveDownloadRedirect(t *testing.T) {
+	for _, target := range []string{"https://binaryfortressdownloads.com/Download/WPF/Images/12/original.jpg", "https://example.com/original.jpg"} {
+		client := NewClient()
+		client.http.Transport = roundTripFunc(func(r *http.Request) (*http.Response, error) {
+			if r.Method != http.MethodHead {
+				t.Errorf("download resolution fetched the image body: %s", r.Method)
+			}
+			response := &http.Response{StatusCode: http.StatusOK, Header: make(http.Header), Body: io.NopCloser(strings.NewReader("")), Request: r}
+			if IsDownloadURL(r.URL.String()) {
+				response.StatusCode = http.StatusFound
+				response.Header.Set("Location", target)
+			}
+			return response, nil
+		})
+		resolved, err := client.ResolveImageURL(baseURL + "/Download/12/?W=-1&H=-1")
+		if imageURLAllowed(target) && (err != nil || resolved != target) {
+			t.Fatalf("redirect did not resolve: %s, %v", resolved, err)
+		}
+		if !imageURLAllowed(target) && err == nil {
+			t.Fatal("untrusted download origin accepted")
+		}
+	}
+}
+
+func TestLiveSearchPagination(t *testing.T) {
+	if os.Getenv("AETHER_WALLPAPERFUSION_LIVE_TEST") != "1" {
+		t.Skip("set AETHER_WALLPAPERFUSION_LIVE_TEST=1 to test the public source")
+	}
+	client := NewClient()
+	seen := make(map[string]bool)
+	for page := 0; page < 2; page++ {
+		result, err := client.Search(SearchParams{Query: "nature", Page: page})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(result.Data) == 0 || !result.HasMore {
+			t.Fatalf("missing live results on page %d: %+v", page, result)
+		}
+		for _, wallpaper := range result.Data {
+			if seen[wallpaper.ID] {
+				t.Fatalf("pagination repeated wallpaper %s", wallpaper.ID)
+			}
+			seen[wallpaper.ID] = true
+		}
+		t.Logf("page %d: %d wallpapers", page, len(result.Data))
+	}
+}
diff --git a/internal/wallpaperfusion/parser.go b/internal/wallpaperfusion/parser.go
new file mode 100644
index 0000000..f28cd82
--- /dev/null
+++ b/internal/wallpaperfusion/parser.go
@@ -0,0 +1,104 @@
+package wallpaperfusion
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+
+	"golang.org/x/net/html"
+)
+
+var imagePage = regexp.MustCompile(`^https://www\.wallpaperfusion\.com/Image/[^/?#]+/([1-9][0-9]*)/$`)
+var backgroundImage = regexp.MustCompile(`background-image\s*:\s*url\(\s*["']?([^\s"')]+)["']?\s*\)`)
+
+func parseResponse(body string, page int) (*SearchResult, error) {
+	parts := strings.SplitN(body, ":::", 13)
+	if len(parts) != 13 || parts[0] != "2" || (strings.ToLower(parts[11]) != "true" && strings.ToLower(parts[11]) != "false") {
+		return nil, fmt.Errorf("WallpaperFusion returned an invalid search response")
+	}
+	root, err := html.Parse(strings.NewReader(parts[7]))
+	if err != nil {
+		return nil, fmt.Errorf("could not parse WallpaperFusion results")
+	}
+	result := &SearchResult{Data: []Wallpaper{}, Page: page, HasMore: strings.ToLower(parts[11]) == "false"}
+	seen := make(map[string]bool)
+	cardCount := 0
+	walk(root, func(node *html.Node) {
+		if node.Type != html.ElementNode || node.Data != "a" || !hasClass(node, "ImageThumbBorder") {
+			return
+		}
+		cardCount++
+		wallpaper, ok := parseCard(node)
+		if ok && !seen[wallpaper.ID] {
+			result.Data = append(result.Data, wallpaper)
+			seen[wallpaper.ID] = true
+		}
+	})
+	if len(result.Data) == 0 && (cardCount > 0 || result.HasMore) {
+		return nil, fmt.Errorf("WallpaperFusion's result format has changed; try again later")
+	}
+	return result, nil
+}
+
+func parseCard(node *html.Node) (Wallpaper, bool) {
+	pageURL := attribute(node, "href")
+	match := imagePage.FindStringSubmatch(pageURL)
+	if len(match) != 2 {
+		return Wallpaper{}, false
+	}
+	var title, thumb string
+	walk(node, func(child *html.Node) {
+		if hasClass(child, "ImageThumbHoverTitle") {
+			title = strings.TrimSpace(nodeText(child))
+		}
+		if hasClass(child, "ImageThumb") {
+			if image := backgroundImage.FindStringSubmatch(attribute(child, "style")); len(image) == 2 {
+				thumb = image[1]
+			}
+		}
+	})
+	if title == "" || !imageURLAllowed(thumb) {
+		return Wallpaper{}, false
+	}
+	return Wallpaper{
+		ID: "wallpaperfusion-" + match[1], URL: pageURL,
+		Path:   baseURL + "/Download/" + match[1] + "/?W=-1&H=-1",
+		Thumbs: map[string]string{"small": thumb, "large": thumb, "original": thumb},
+		Title:  title, Alt: title, Source: "wallpaperfusion", CreditURL: pageURL, CreditText: "WallpaperFusion",
+	}, true
+}
+
+func walk(node *html.Node, visit func(*html.Node)) {
+	visit(node)
+	for child := node.FirstChild; child != nil; child = child.NextSibling {
+		walk(child, visit)
+	}
+}
+
+func attribute(node *html.Node, key string) string {
+	for _, attr := range node.Attr {
+		if attr.Key == key {
+			return attr.Val
+		}
+	}
+	return ""
+}
+
+func hasClass(node *html.Node, class string) bool {
+	for _, value := range strings.Fields(attribute(node, "class")) {
+		if value == class {
+			return true
+		}
+	}
+	return false
+}
+
+func nodeText(node *html.Node) string {
+	var text strings.Builder
+	walk(node, func(child *html.Node) {
+		if child.Type == html.TextNode {
+			text.WriteString(child.Data)
+		}
+	})
+	return text.String()
+}
