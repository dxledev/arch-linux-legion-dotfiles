+<script lang="ts">
+    import {onMount} from 'svelte';
+    import WallpaperFusionFilters from './WallpaperFusionFilters.svelte';
+    import WallpaperGrid from '$lib/components/wallhaven/WallpaperGrid.svelte';
+    import EmptyState from '$lib/components/shared/EmptyState.svelte';
+    import LoadingState from '$lib/components/shared/LoadingState.svelte';
+    import {
+        getResults,
+        getIsSearching,
+        getError,
+        getHasMore,
+        initialize,
+        loadMore,
+        retry,
+    } from '$lib/stores/wallpaperfusion.svelte';
+
+    onMount(() => {
+        initialize();
+    });
+</script>
+
+<div class="flex h-full flex-col">
+    <WallpaperFusionFilters />
+    {#if getError() && getResults().length > 0}
+        <div
+            class="border-border text-warning flex items-center gap-3 border-b px-3 py-2 text-[11px]"
+            role="status"
+        >
+            <span>{getError()} Showing previous results.</span>
+            <button
+                class="hover:text-fg-primary ml-auto shrink-0"
+                onclick={retry}
+                disabled={getIsSearching()}>Retry</button
+            >
+        </div>
+    {/if}
+    <div class="flex-1 overflow-y-auto p-3">
+        {#if getIsSearching() && getResults().length === 0}
+            <LoadingState message="Searching WallpaperFusion…" />
+        {:else if getResults().length === 0}
+            <EmptyState
+                title={getError()
+                    ? 'Could not load WallpaperFusion'
+                    : 'No wallpapers found'}
+                body={getError() ||
+                    'Try another keyword, or clear the search to browse all wallpapers.'}
+                actionLabel="Retry"
+                onaction={retry}
+            />
+        {:else}
+            <WallpaperGrid wallpapers={getResults()} />
+            <div
+                class="text-fg-dimmed flex flex-col items-center justify-center gap-3 py-5 text-[11px]"
+                role="status"
+            >
+                <span
+                    >{getIsSearching()
+                        ? 'Searching WallpaperFusion…'
+                        : `Showing ${getResults().length} wallpapers`}</span
+                >
+                {#if getHasMore()}
+                    <button
+                        class="border-border text-fg-secondary hover:bg-bg-hover border px-4 py-1.5 disabled:opacity-50"
+                        onclick={loadMore}
+                        disabled={getIsSearching()}
+                        >{getIsSearching() ? 'Loading…' : 'Load more'}</button
+                    >
+                {:else if !getError() && !getIsSearching()}
+                    <span>End of results</span>
+                {/if}
+            </div>
+        {/if}
+    </div>
+</div>
