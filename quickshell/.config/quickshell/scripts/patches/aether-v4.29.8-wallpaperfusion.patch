+package favorites
+
+import "testing"
+
+func TestWallpaperFusionFavoriteRoundTrip(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	path := "https://www.wallpaperfusion.com/Download/29100/?W=-1&H=-1"
+	data := map[string]interface{}{
+		"name": "Peaceful Mountain Lake Sunset", "thumbUrl": "https://binaryfortressdownloads.com/Download/WPF/Images/29100/thumb.jpg",
+		"url":        "https://www.wallpaperfusion.com/Image/peaceful-mountain-lake-sunset/29100/",
+		"credit_url": "https://www.wallpaperfusion.com/Image/peaceful-mountain-lake-sunset/29100/", "credit_text": "WallpaperFusion",
+	}
+	service := NewService()
+	service.Toggle(path, "wallpaperfusion", data)
+	reloaded := NewService()
+	favorites := reloaded.GetAll()
+	if len(favorites) != 1 || favorites[0].Type != "wallpaperfusion" || favorites[0].Data["thumbUrl"] != data["thumbUrl"] || favorites[0].Data["credit_url"] != data["credit_url"] {
+		t.Fatalf("favorite source or metadata lost on reload: %+v", favorites)
+	}
+	if reloaded.Toggle(path, "wallpaperfusion", nil) || len(NewService().GetAll()) != 0 {
+		t.Fatal("favorite removal did not persist")
+	}
+}
diff --git a/internal/wallpaperfusion/client.go b/internal/wallpaperfusion/client.go
new file mode 100644
index 0000000..911adbf
--- /dev/null
+++ b/internal/wallpaperfusion/client.go
@@ -0,0 +1,110 @@
+package wallpaperfusion
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const baseURL = "https://www.wallpaperfusion.com"
+const responseLimit = 4 << 20
+
+var downloadPath = regexp.MustCompile(`^/Download/[1-9][0-9]*/$`)
+
+type Client struct {
+	http    *http.Client
+	baseURL string
+}
+
+func NewClient() *Client {
+	return &Client{http: &http.Client{Timeout: 30 * time.Second}, baseURL: baseURL}
+}
+
+func searchValues(params SearchParams) (url.Values, error) {
+	if params.Page < 0 || params.Sort < 0 || params.Sort > 9 || (params.Monitors < 0 || params.Monitors > 4) && params.Monitors != 99 {
+		return nil, fmt.Errorf("invalid WallpaperFusion search filters")
+	}
+	return url.Values{
+		"ReqID": {"2"}, "Page": {strconv.Itoa(params.Page)},
+		"Text": {strings.TrimSpace(params.Query)}, "Sort": {strconv.Itoa(params.Sort)},
+		"Mon": {strconv.Itoa(params.Monitors)}, "TagShow": {""}, "TagHide": {""},
+		"RateAll": {"0"}, "RateUser": {""}, "SearchWidth": {"0"}, "SearchWidthMod": {"0"},
+		"SearchHeight": {"0"}, "SearchHeightMod": {"0"}, "SubmittersMode": {""},
+		"ArtistsMode": {""}, "ShowFavs": {"0"}, "TagSearchMode": {"0"},
+	}, nil
+}
+
+func (c *Client) Search(params SearchParams) (*SearchResult, error) {
+	values, err := searchValues(params)
+	if err != nil {
+		return nil, err
+	}
+	req, err := http.NewRequest(http.MethodPost, c.baseURL+"/Ajax/BuildSearchResultsHTML/", strings.NewReader(values.Encode()))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Accept", "text/html")
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("could not reach WallpaperFusion: %w", err)
+	}
+	defer resp.Body.Close()
+	if err := responseStatus(resp); err != nil {
+		return nil, err
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, responseLimit+1))
+	if err != nil || len(body) > responseLimit {
+		return nil, fmt.Errorf("could not read WallpaperFusion search results")
+	}
+	return parseResponse(string(body), params.Page)
+}
+
+func responseStatus(resp *http.Response) error {
+	if resp.StatusCode == http.StatusTooManyRequests {
+		return fmt.Errorf("WallpaperFusion rate limit reached; wait before retrying")
+	}
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("WallpaperFusion returned HTTP %d", resp.StatusCode)
+	}
+	return nil
+}
+
+func IsDownloadURL(raw string) bool {
+	parsed, err := url.Parse(raw)
+	return err == nil && parsed.Scheme == "https" && parsed.Host == "www.wallpaperfusion.com" && parsed.User == nil && downloadPath.MatchString(parsed.Path)
+}
+
+func (c *Client) ResolveImageURL(raw string) (string, error) {
+	if !IsDownloadURL(raw) {
+		return "", fmt.Errorf("invalid WallpaperFusion download URL")
+	}
+	// Resolve the site's redirect before the shared downloader chooses a filename.
+	req, err := http.NewRequest(http.MethodHead, raw, nil)
+	if err != nil {
+		return "", err
+	}
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("could not resolve WallpaperFusion download: %w", err)
+	}
+	defer resp.Body.Close()
+	if err := responseStatus(resp); err != nil {
+		return "", err
+	}
+	imageURL := resp.Request.URL.String()
+	if !imageURLAllowed(imageURL) {
+		return "", fmt.Errorf("WallpaperFusion returned an invalid image URL")
+	}
+	return imageURL, nil
+}
+
+func imageURLAllowed(raw string) bool {
+	parsed, err := url.Parse(raw)
+	return err == nil && parsed.Scheme == "https" && parsed.Host == "binaryfortressdownloads.com" && parsed.User == nil && strings.HasPrefix(parsed.Path, "/Download/WPF/Images/")
+}
