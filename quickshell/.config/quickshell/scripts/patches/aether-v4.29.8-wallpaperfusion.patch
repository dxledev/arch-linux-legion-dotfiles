--- /dev/null
+++ b/app_wallpaperfusion_test.go
@@ -0,0 +1,37 @@
+package main
+
+import (
+	"image"
+	_ "image/jpeg"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"aether/internal/wallhaven"
+	"aether/internal/wallpaperfusion"
+)
+
+func TestLiveWallpaperFusionDownload(t *testing.T) {
+	if os.Getenv("AETHER_WALLPAPERFUSION_LIVE_TEST") != "1" {
+		t.Skip("set AETHER_WALLPAPERFUSION_LIVE_TEST=1 to test downloads")
+	}
+	t.Setenv("XDG_DATA_HOME", t.TempDir())
+	app := &App{wallhaven: wallhaven.NewClient(), wallpaperFusion: wallpaperfusion.NewClient()}
+	path, err := app.DownloadWallpaper("https://www.wallpaperfusion.com/Download/29100/?W=-1&H=-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if filepath.Ext(path) != ".jpg" {
+		t.Fatalf("download has no image extension: %s", path)
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	config, format, err := image.DecodeConfig(file)
+	if err != nil || format != "jpeg" || config.Width < 1920 || config.Height < 1080 {
+		t.Fatalf("invalid downloaded image: %+v %s %v", config, format, err)
+	}
+	t.Logf("downloaded %s: %dx%d %s", filepath.Base(path), config.Width, config.Height, format)
+}
