@@ -0,0 +1,106 @@
+import type {wallpaperfusion} from '../../../wailsjs/go/models';
+
+let query = $state('nature');
+let sort = $state(0);
+let monitors = $state(0);
+let results = $state<wallpaperfusion.Wallpaper[]>([]);
+let searching = $state(false);
+let initialized = false;
+let error = $state('');
+let hasMore = $state(false);
+let nextPage = 0;
+let activeSearch: wallpaperfusion.SearchParams | null = null;
+let failedSearch: wallpaperfusion.SearchParams | null = null;
+let initialization: Promise<void> | null = null;
+
+export const getQuery = () => query;
+export const getSort = () => sort;
+export const getMonitors = () => monitors;
+export const getResults = () => results;
+export const getIsSearching = () => searching;
+export const getError = () => error;
+export const getHasMore = () => hasMore && !error;
+export const setQuery = (value: string) => {
+    query = value;
+};
+export const setSort = (value: number) => {
+    sort = value;
+};
+export const setMonitors = (value: number) => {
+    monitors = value;
+};
+
+export async function initialize(): Promise<void> {
+    if (!initialization) initialization = loadConfig();
+    await initialization;
+    if (!initialized && !searching) await search();
+}
+
+async function loadConfig(): Promise<void> {
+    try {
+        const {GetWallpaperFusionConfig} = await import(
+            '../../../wailsjs/go/main/App'
+        );
+        const config = await GetWallpaperFusionConfig();
+        if (typeof config?.query === 'string') query = config.query;
+        if (
+            Number.isInteger(config?.sort) &&
+            config.sort >= 0 &&
+            config.sort <= 9
+        )
+            sort = config.sort;
+        if ([0, 1, 2, 3, 4, 99].includes(config?.monitors))
+            monitors = config.monitors;
+    } catch {}
+}
+
+async function fetchPage(params: wallpaperfusion.SearchParams): Promise<void> {
+    if (searching) return;
+    searching = true;
+    error = '';
+    try {
+        const {SearchWallpaperFusion, SaveWallpaperFusionConfig} = await import(
+            '../../../wailsjs/go/main/App'
+        );
+        const result = await SearchWallpaperFusion(params);
+        const previous = params.page === 0 ? [] : results;
+        const seen = new Set(previous.map(wallpaper => wallpaper.id));
+        results = [
+            ...previous,
+            ...(result.data || []).filter(wallpaper => {
+                if (seen.has(wallpaper.id)) return false;
+                seen.add(wallpaper.id);
+                return true;
+            }),
+        ];
+        activeSearch = params;
+        nextPage = params.page + 1;
+        hasMore = result.hasMore;
+        failedSearch = null;
+        SaveWallpaperFusionConfig({
+            query: params.q,
+            sort: params.sort,
+            monitors: params.monitors,
+        }).catch(() => {});
+    } catch (cause) {
+        error = String(cause);
+        failedSearch = params;
+    } finally {
+        initialized = true;
+        searching = false;
+    }
+}
+
+export async function search(): Promise<void> {
+    await fetchPage({q: query, sort, monitors, page: 0});
+}
+
+export async function loadMore(): Promise<void> {
+    if (!getHasMore() || !activeSearch) return;
+    await fetchPage({...activeSearch, page: nextPage});
+}
+
+export async function retry(): Promise<void> {
+    if (failedSearch) await fetchPage(failedSearch);
+    else await search();
+}
