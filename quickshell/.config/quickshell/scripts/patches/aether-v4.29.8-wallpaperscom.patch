+package favorites
+
+import "testing"
+
+func TestWallpapersComFavoriteRoundTrip(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	path := "https://wallpapers.com/images/high/mountains.jpg"
+	data := map[string]interface{}{
+		"name": "Mountains", "thumbUrl": "https://wallpapers.com/images/thumbnail/mountains.jpg",
+		"url":        "https://wallpapers.com/wallpapers/mountains.html",
+		"credit_url": "https://wallpapers.com/", "credit_text": "Wallpapers.com",
+	}
+	service := NewService()
+	if !service.Toggle(path, "wallpaperscom", data) {
+		t.Fatal("favorite was not added")
+	}
+	reloaded := NewService()
+	favorites := reloaded.GetAll()
+	if len(favorites) != 1 || favorites[0].Type != "wallpaperscom" || favorites[0].Data["thumbUrl"] != data["thumbUrl"] || favorites[0].Data["credit_url"] != data["credit_url"] {
+		t.Fatalf("favorite metadata did not survive reload: %+v", favorites)
+	}
+	if reloaded.Toggle(path, "wallpaperscom", nil) || len(NewService().GetAll()) != 0 {
+		t.Fatal("favorite was not removed")
+	}
+}
diff --git a/internal/wallpaperscom/client.go b/internal/wallpaperscom/client.go
new file mode 100644
index 0000000..04f36bc
--- /dev/null
+++ b/internal/wallpaperscom/client.go
@@ -0,0 +1,184 @@
+package wallpaperscom
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"path"
+	"regexp"
+	"strings"
+	"time"
+)
+
+const baseURL = "https://wallpapers.com/api/v1"
+
+var slugSeparators = regexp.MustCompile(`[^a-z0-9]+`)
+
+type Client struct {
+	http    *http.Client
+	baseURL string
+}
+
+type apiWallpaper struct {
+	ID         json.Number `json:"id"`
+	Title      string      `json:"title"`
+	Alt        string      `json:"alt"`
+	Thumb      string      `json:"thumb"`
+	High       string      `json:"high"`
+	URL        string      `json:"url"`
+	Credit     string      `json:"credit"`
+	CreditText string      `json:"credit_text"`
+	CreditURL  string      `json:"credit_url"`
+}
+
+type apiResponse struct {
+	apiWallpaper
+	Success   bool           `json:"success"`
+	Items     []apiWallpaper `json:"items"`
+	Wallpaper *apiWallpaper  `json:"wallpaper"`
+	Total     int            `json:"total"`
+}
+
+func NewClient() *Client {
+	return &Client{http: &http.Client{Timeout: 30 * time.Second}, baseURL: baseURL}
+}
+
+func searchEndpoint(params SearchParams) (string, error) {
+	query := strings.Trim(slugSeparators.ReplaceAllString(strings.ToLower(strings.TrimSpace(params.Query)), "-"), "-")
+	values := url.Values{}
+	switch params.Mode {
+	case "daily":
+		return "/daily-wallpaper", nil
+	case "random":
+		values.Set("type", "wallpaper")
+		if query != "" {
+			values.Set("q", query)
+		}
+		return "/random?" + values.Encode(), nil
+	case "", "keyword":
+		if query == "" {
+			return "", fmt.Errorf("enter a keyword to search Wallpapers.com")
+		}
+		limit := params.Limit
+		if limit <= 0 {
+			limit = 24
+		}
+		if limit > 60 {
+			limit = 60
+		}
+		values.Set("limit", fmt.Sprint(limit))
+		return "/keyword/" + query + "?" + values.Encode(), nil
+	default:
+		return "", fmt.Errorf("unknown Wallpapers.com search mode")
+	}
+}
+
+func (c *Client) Search(params SearchParams) (*SearchResult, error) {
+	endpoint, err := searchEndpoint(params)
+	if err != nil {
+		return nil, err
+	}
+	req, err := http.NewRequest(http.MethodGet, c.baseURL+endpoint, nil)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Accept", "application/json")
+	if key := strings.TrimSpace(params.APIKey); key != "" {
+		req.Header.Set("X-API-Key", key)
+	}
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("could not reach Wallpapers.com: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode == http.StatusNotFound && params.Mode != "daily" {
+		var missing struct {
+			Message string `json:"msg"`
+		}
+		if json.NewDecoder(io.LimitReader(resp.Body, 4<<20)).Decode(&missing) == nil && (missing.Message == "no matches" || missing.Message == "unknown keyword") {
+			return &SearchResult{Data: []Wallpaper{}}, nil
+		}
+	}
+	if resp.StatusCode == http.StatusTooManyRequests {
+		return nil, fmt.Errorf("Wallpapers.com rate limit reached; wait a minute before retrying")
+	}
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("Wallpapers.com returned HTTP %d", resp.StatusCode)
+	}
+	var response apiResponse
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 4<<20)).Decode(&response); err != nil {
+		return nil, fmt.Errorf("Wallpapers.com returned an invalid response")
+	}
+	if !response.Success {
+		return nil, fmt.Errorf("Wallpapers.com could not complete the request")
+	}
+	return normalizeResponse(response), nil
+}
+
+func siteURL(raw string) bool {
+	parsed, err := url.Parse(raw)
+	return err == nil && parsed.Scheme == "https" && parsed.Host == "wallpapers.com" && parsed.User == nil
+}
+
+func normalizeWallpaper(item apiWallpaper) (Wallpaper, bool) {
+	if !siteURL(item.High) || !strings.HasPrefix(item.High, "https://wallpapers.com/images/") {
+		return Wallpaper{}, false
+	}
+	id := item.ID.String()
+	if id == "" {
+		parsed, _ := url.Parse(item.High)
+		id = path.Base(parsed.Path)
+	}
+	thumb := item.Thumb
+	if !siteURL(thumb) {
+		thumb = item.High
+	}
+	pageURL := item.URL
+	if !siteURL(pageURL) {
+		pageURL = "https://wallpapers.com/"
+	}
+	creditURL := item.CreditURL
+	if !siteURL(creditURL) {
+		creditURL = "https://wallpapers.com/"
+	}
+	credit := item.CreditText
+	if credit == "" {
+		credit = item.Credit
+	}
+	if credit == "" {
+		credit = "Wallpapers.com"
+	}
+	title := item.Title
+	if title == "" {
+		title = item.Alt
+	}
+	return Wallpaper{
+		ID: "wallpaperscom-" + id, URL: pageURL, Path: item.High,
+		Thumbs: map[string]string{"small": thumb, "large": thumb, "original": thumb},
+		Title:  title, Alt: item.Alt, Source: "wallpaperscom", CreditURL: creditURL, CreditText: credit,
+	}, true
+}
+
+func normalizeResponse(response apiResponse) *SearchResult {
+	items := response.Items
+	if response.Wallpaper != nil {
+		items = []apiWallpaper{*response.Wallpaper}
+	} else if response.High != "" {
+		items = []apiWallpaper{response.apiWallpaper}
+	}
+	result := &SearchResult{Data: []Wallpaper{}, Total: response.Total}
+	seen := make(map[string]bool)
+	for _, item := range items {
+		wallpaper, ok := normalizeWallpaper(item)
+		if ok && !seen[wallpaper.ID] {
+			result.Data = append(result.Data, wallpaper)
+			seen[wallpaper.ID] = true
+		}
+	}
+	if result.Total < len(result.Data) {
+		result.Total = len(result.Data)
+	}
+	return result
+}
diff --git a/internal/wallpaperscom/client_test.go b/internal/wallpaperscom/client_test.go
