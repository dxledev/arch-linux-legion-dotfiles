@@ -0,0 +1,145 @@
+package wallpaperscom
+
+import (
+	"fmt"
+	"image"
+	_ "image/jpeg"
+	_ "image/png"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"aether/internal/wallhaven"
+)
+
+const testWallpaper = `{"id":123,"title":"Mountains","alt":"Snowy mountains","high":"https://wallpapers.com/images/high/mountains.jpg","thumb":"https://wallpapers.com/images/thumbnail/mountains.jpg","url":"https://wallpapers.com/wallpapers/mountains.html","credit":"Wallpapers.com","credit_url":"https://wallpapers.com/"}`
+
+func TestSearchResponseFormats(t *testing.T) {
+	tests := []struct {
+		name, mode, response, endpoint string
+	}{
+		{"keyword", "keyword", `{"success":true,"total":9,"items":[` + testWallpaper + `]}`, "/keyword/doctor-doom"},
+		{"random", "random", `{"success":true,"wallpaper":` + testWallpaper + `}`, "/random"},
+		{"daily", "daily", `{"success":true,` + strings.TrimPrefix(testWallpaper, "{"), "/daily-wallpaper"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != tc.endpoint || r.Header.Get("X-API-Key") != "test-key" {
+					t.Errorf("unexpected request: %s, key present=%v", r.URL.Path, r.Header.Get("X-API-Key") != "")
+				}
+				if tc.mode == "keyword" && r.URL.Query().Get("limit") != "60" {
+					t.Errorf("limit was not capped: %s", r.URL.RawQuery)
+				}
+				if tc.mode == "random" && (r.URL.Query().Get("q") != "doctor-doom" || r.URL.Query().Get("type") != "wallpaper") {
+					t.Errorf("unexpected random filters: %s", r.URL.RawQuery)
+				}
+				fmt.Fprint(w, tc.response)
+			}))
+			defer server.Close()
+			client := &Client{http: server.Client(), baseURL: server.URL}
+			result, err := client.Search(SearchParams{Query: " Doctor Doom! ", Mode: tc.mode, Limit: 90, APIKey: " test-key "})
+			if err != nil || len(result.Data) != 1 {
+				t.Fatalf("Search result=%v, err=%v", result, err)
+			}
+			wallpaper := result.Data[0]
+			if wallpaper.ID != "wallpaperscom-123" || wallpaper.Title != "Mountains" || wallpaper.Source != "wallpaperscom" || wallpaper.CreditURL != "https://wallpapers.com/" || wallpaper.Thumbs["small"] == "" {
+				t.Fatalf("lost wallpaper metadata: %+v", wallpaper)
+			}
+		})
+	}
+}
+
+func TestSearchFailures(t *testing.T) {
+	tests := []struct {
+		status        int
+		body, message string
+	}{
+		{429, "", "rate limit"},
+		{403, "<html>challenge</html>", "HTTP 403"},
+		{200, "<html>challenge</html>", "invalid response"},
+		{200, `{"success":false}`, "could not complete"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.message, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("X-API-Key") != "" {
+					t.Error("anonymous request included a key")
+				}
+				w.WriteHeader(tc.status)
+				fmt.Fprint(w, tc.body)
+			}))
+			defer server.Close()
+			client := &Client{http: server.Client(), baseURL: server.URL}
+			_, err := client.Search(SearchParams{Mode: "daily"})
+			if err == nil || !strings.Contains(err.Error(), tc.message) {
+				t.Fatalf("unexpected error: %v", err)
+			}
+		})
+	}
+}
+
+func TestNormalizeRejectsInvalidImagesAndDuplicates(t *testing.T) {
+	response := apiResponse{Items: []apiWallpaper{
+		{ID: "1", High: "https://wallpapers.com/images/high/one.jpg"},
+		{ID: "1", High: "https://wallpapers.com/images/high/one.jpg"},
+		{ID: "2", High: "https://example.com/two.jpg"},
+	}}
+	result := normalizeResponse(response)
+	if len(result.Data) != 1 || result.Total != 1 || result.Data[0].CreditText != "Wallpapers.com" {
+		t.Fatalf("unexpected normalized response: %+v", result)
+	}
+	if _, err := searchEndpoint(SearchParams{Query: "   "}); err == nil {
+		t.Error("empty keyword was accepted")
+	}
+}
+
+func TestSearchNoMatches(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNotFound)
+		fmt.Fprint(w, `{"success":false,"msg":"no matches"}`)
+	}))
+	defer server.Close()
+	client := &Client{http: server.Client(), baseURL: server.URL}
+	result, err := client.Search(SearchParams{Mode: "random", Query: "nature"})
+	if err != nil || result == nil || len(result.Data) != 0 {
+		t.Fatalf("no matches was not an empty result: result=%v, err=%v", result, err)
+	}
+}
+
+func TestLiveAPI(t *testing.T) {
+	if os.Getenv("AETHER_WALLPAPERSCOM_LIVE_TEST") != "1" {
+		t.Skip("set AETHER_WALLPAPERSCOM_LIVE_TEST=1 to check the public API")
+	}
+	client := NewClient()
+	t.Setenv("XDG_DATA_HOME", t.TempDir())
+	for _, mode := range []string{"keyword", "random", "daily"} {
+		t.Run(mode, func(t *testing.T) {
+			query := ""
+			if mode == "keyword" {
+				query = "nature"
+			}
+			result, err := client.Search(SearchParams{Query: query, Mode: mode, Limit: 2})
+			if err != nil || result == nil || len(result.Data) == 0 {
+				t.Fatalf("live Search result=%v, err=%v", result, err)
+			}
+			if mode == "daily" {
+				localPath, err := wallhaven.NewClient().Download(result.Data[0].Path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				file, err := os.Open(localPath)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer file.Close()
+				config, _, err := image.DecodeConfig(file)
+				if err != nil || config.Width <= 0 || config.Height <= 0 {
+					t.Fatalf("download was not an image: config=%+v, err=%v", config, err)
+				}
+			}
+		})
+	}
+}
