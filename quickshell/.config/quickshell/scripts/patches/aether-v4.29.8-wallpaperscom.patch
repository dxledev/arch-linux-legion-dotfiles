new file mode 100644
index 0000000..d1298e0
--- /dev/null
+++ b/frontend/src/lib/stores/wallpaperscom.svelte.ts
@@ -0,0 +1,83 @@
+import type {wallpaperscom} from '../../../wailsjs/go/models';
+
+export type BrowseMode = 'keyword' | 'random' | 'daily';
+
+let query = $state('desktop');
+let limit = $state(24);
+let apiKey = $state('');
+let mode = $state<BrowseMode>('keyword');
+let results = $state<wallpaperscom.Wallpaper[]>([]);
+let total = $state(0);
+let searching = $state(false);
+let initialized = $state(false);
+let error = $state('');
+let initialization: Promise<void> | null = null;
+
+export const getQuery = () => query;
+export const getLimit = () => limit;
+export const getApiKey = () => apiKey;
+export const getMode = () => mode;
+export const getResults = () => results;
+export const getTotal = () => total;
+export const getIsSearching = () => searching;
+export const getError = () => error;
+export const setQuery = (value: string) => {
+    query = value;
+};
+export const setLimit = (value: number) => {
+    limit = value;
+};
+export const setApiKey = (value: string) => {
+    apiKey = value;
+};
+
+export async function initialize(): Promise<void> {
+    if (!initialization) initialization = loadConfig();
+    await initialization;
+    if (!initialized && !searching) await search();
+}
+
+async function loadConfig(): Promise<void> {
+    try {
+        const {GetWallpapersComConfig} = await import(
+            '../../../wailsjs/go/main/App'
+        );
+        const config = await GetWallpapersComConfig();
+        if (typeof config?.query === 'string') query = config.query;
+        if ([24, 48, 60].includes(config?.limit)) limit = config.limit;
+        if (typeof config?.apiKey === 'string') apiKey = config.apiKey;
+    } catch {}
+}
+
+export async function saveConfig(): Promise<void> {
+    const {SaveWallpapersComConfig} = await import(
+        '../../../wailsjs/go/main/App'
+    );
+    await SaveWallpapersComConfig({query, limit, apiKey});
+}
+
+export async function search(nextMode: BrowseMode = mode): Promise<void> {
+    if (searching) return;
+    mode = nextMode;
+    searching = true;
+    error = '';
+    try {
+        const {SearchWallpapersCom} = await import(
+            '../../../wailsjs/go/main/App'
+        );
+        const result = await SearchWallpapersCom({
+            q: query,
+            limit,
+            apiKey,
+            mode,
+        });
+        results = result.data || [];
+        total = result.total || 0;
+        saveConfig().catch(() => {});
+    } catch (cause) {
+        error = String(cause);
+    } finally {
+        initialized = true;
+        searching = false;
+    }
+}
