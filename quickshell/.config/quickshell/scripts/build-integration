#!/usr/bin/env bash
set -euo pipefail

root="${QUICKSHELL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell}"
runtime="${QUICKSHELL_RUNTIME:-$root/.runtime}"
build_dir="${SHELL_BUILD_DIR:-${TMPDIR:-/tmp}/caelestia-build}/integration"
dry_run=0
case "${1:-}" in
    --dry-run) dry_run=1 ;;
    --help|-h) printf 'Usage: build-integration [--dry-run]\nBuild the local notification markup module.\n'; exit ;;
    '') ;;
    *) exit 2 ;;
esac
run() { if (( dry_run )); then printf '%q ' "$@"; printf '\n'; else "$@"; fi; }
run /usr/bin/cmake -S "$root/caelestia/integration/markup" -B "$build_dir" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$runtime"
run /usr/bin/cmake --build "$build_dir" -j 2
run /usr/bin/cmake --install "$build_dir"
