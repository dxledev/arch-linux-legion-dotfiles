#!/usr/bin/env bash
set -euo pipefail

root="${QUICKSHELL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell}"
dry_run=0
fail() { printf 'select-shell: %s\n' "$*" >&2; exit 1; }
usage() { printf 'Usage: select-shell [--dry-run] NAME | --list | --status\n'; }

[[ "${1:-}" != --dry-run ]] || { dry_run=1; shift; }
case "${1:---help}" in
    --help|-h) usage; exit ;;
    --status) /usr/bin/readlink "$root/active"; exit ;;
    --list)
        for manifest in "$root"/*/exports; do
            [[ -f "$manifest" ]] || continue
            [[ "$manifest" != "$root/active/exports" ]] || continue
            name="${manifest%/exports}"; printf '%s\n' "${name##*/}"
        done
        exit
        ;;
esac
[[ $# == 1 && "$1" =~ ^[a-zA-Z0-9_-]+$ ]] || { usage >&2; exit 2; }
name="$1"
[[ -f "$root/$name/shell.qml" && -f "$root/$name/exports" ]] || fail 'Shell must contain shell.qml and exports.'
mapfile -t exports < "$root/$name/exports"
for entry in "${exports[@]}"; do
    [[ "$entry" =~ ^[a-zA-Z0-9_.-]+$ && "$entry" != .* && "$entry" != active && "$entry" != scripts ]] || fail "Invalid export: $entry"
    [[ -e "$root/$name/$entry" ]] || fail "Missing export: $entry"
    [[ ! -e "$root/$entry" && ! -L "$root/$entry" ]] ||
        [[ -L "$root/$entry" && "$(/usr/bin/readlink "$root/$entry")" == "active/$entry" ]] || fail "Unmanaged path: $root/$entry"
done
if (( dry_run )); then
    printf 'Select %s -> %s\n' "$root/active" "$name"
    printf 'Export: %s\n' "${exports[@]}"
    printf 'Restart the root shell if running; reload Hyprland keybindings.\n'
    exit
fi
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/quickshell-select-$UID.lock"
/usr/bin/flock -n 9 || fail 'Another shell switch is running.'
instances="$("$root/scripts/quickshell" list -p "$root/shell.qml" --json)"
pids=()
if [[ "$instances" == \[* ]]; then
    mapfile -t pids < <(/usr/bin/jq -r '.[].pid' <<< "$instances")
fi
for pid in "${pids[@]}"; do /usr/bin/kill -TERM "$pid"; done
for pid in "${pids[@]}"; do
    for (( attempt=0; attempt<50; attempt++ )); do
        /usr/bin/kill -0 "$pid" 2>/dev/null || break
        /usr/bin/sleep 0.1
    done
    /usr/bin/kill -0 "$pid" 2>/dev/null && fail "Shell PID $pid did not stop."
done
if [[ -f "$root/active/exports" ]]; then
    while IFS= read -r entry; do
        [[ "$entry" =~ ^[a-zA-Z0-9_.-]+$ && "$entry" != .* ]] || continue
        [[ -L "$root/$entry" && "$(/usr/bin/readlink "$root/$entry")" == "active/$entry" ]] || continue
        if ! printf '%s\n' "${exports[@]}" | /usr/bin/grep -Fxq -- "$entry"; then
            /usr/bin/unlink "$root/$entry"
        fi
    done < "$root/active/exports"
fi
for entry in "${exports[@]}"; do /usr/bin/ln -sfn "active/$entry" "$root/$entry"; done
/usr/bin/ln -s "$name" "$root/.active-next-$$"
/usr/bin/mv -Tf "$root/.active-next-$$" "$root/active"
if (( ${#pids[@]} )); then
    "$root/scripts/quickshell" -p "$root/shell.qml" -n -d 9>&-
fi
if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then /usr/bin/hyprctl reload >/dev/null; fi
