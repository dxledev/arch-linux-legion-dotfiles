#!/usr/bin/env bash
set -euo pipefail

mode_script="${SHELL_MODE_SCRIPT:-$HOME/bin/toggle-shell-mode}"
dry_run=0
delay=0

usage() {
    printf 'Usage: restart-shell [--delay SECONDS] [--dry-run]\n'
}

fail() {
    printf 'restart-shell: %s\n' "$*" >&2
    exit 1
}

parse_args() {
    while (( $# )); do
        case "$1" in
            --delay)
                (( $# >= 2 )) || fail '--delay requires a value.'
                delay="$2"
                shift 2
                ;;
            --dry-run)
                dry_run=1
                shift
                ;;
            --help|-h)
                usage
                return 0
                ;;
            *)
                usage >&2
                exit 2
                ;;
        esac
    done
    [[ "$delay" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]] || fail 'Delay must be a non-negative number.'
}

main() {
    parse_args "$@"
    [[ "$mode_script" == /* && -x "$mode_script" ]] || fail "Invalid shell mode controller: $mode_script"
    if (( dry_run )); then
        [[ "$delay" == 0 ]] || printf 'Delay: %s seconds\n' "$delay"
        exec "$mode_script" --dry-run --apply
    fi
    [[ "$delay" == 0 ]] || /usr/bin/sleep "$delay"
    exec "$mode_script" --apply
}

main "$@"
