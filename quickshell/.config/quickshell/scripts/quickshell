#!/usr/bin/env bash
set -euo pipefail

config_root="${QUICKSHELL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell}"
runtime="${QUICKSHELL_RUNTIME:-$config_root/.runtime}"
export QML_IMPORT_PATH="$runtime/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
export CAELESTIA_LIB_DIR="$runtime/lib/caelestia"
export QS_ICON_THEME="${QS_ICON_THEME:-Papirus}"
export PATH="$config_root/scripts:$runtime/cli/bin:$PATH"
exec /usr/bin/quickshell "$@"
