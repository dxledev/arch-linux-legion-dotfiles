#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: wifi-password <interface>\n'
}

case "${1:-}" in
    --help)
        usage
        exit 0
        ;;
esac

[[ $# -eq 1 ]] || {
    usage >&2
    exit 2
}

interface=$1
[[ "$interface" =~ ^[[:alnum:]_.:-]+$ ]] || {
    printf 'Invalid network interface\n' >&2
    exit 2
}

uuid=$(/usr/bin/nmcli --get-values GENERAL.CON-UUID device show "$interface" | /usr/bin/head -n 1)
[[ -n "$uuid" && "$uuid" != '--' ]] || {
    printf 'No active Wi-Fi connection\n' >&2
    exit 1
}

mapfile -t fields < <(/usr/bin/nmcli --show-secrets --escape no --get-values \
    802-11-wireless-security.key-mgmt,802-11-wireless-security.psk,802-11-wireless-security.wep-key0 \
    connection show uuid "$uuid")

key_management=${fields[0]:-}
password=${fields[1]:-}
wep_key=${fields[2]:-}

[[ "$key_management" != *eap* && "$key_management" != *ieee8021x* ]] || {
    printf 'Enterprise Wi-Fi has no shareable password\n' >&2
    exit 1
}

if [[ -z "$key_management" || "$key_management" == 'none' ]]; then
    password=$wep_key
    [[ -n "$password" ]] || {
        printf 'This network has no password\n' >&2
        exit 1
    }
fi

[[ -n "$password" ]] || {
    printf 'Could not read the Wi-Fi password\n' >&2
    exit 1
}

printf '%s\n' "$password"
