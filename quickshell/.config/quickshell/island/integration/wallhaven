# ---------------------------------------------------------------- images

def find_existing(wallpaper_id):
    installed = installed_paths().get(wallpaper_id, "")
    if installed:
        return installed
    if os.path.isdir(IMAGE_DIR):
        for ext in ("jpg", "jpeg", "png", "webp"):
            candidate = os.path.join(IMAGE_DIR, "wallhaven-%s.%s" % (wallpaper_id, ext))
            if os.path.isfile(candidate):
                return candidate
    return ""


def clean_stem(value, extension=""):
    """A wallpaper name without surrounding space, a repeated extension, or characters unsafe in a file name."""
    try:
        stem = str(value).strip()
        if extension and stem.lower().endswith(extension.lower()) and len(stem) > len(extension):
            stem = stem[:-len(extension)].strip()
        if not stem:
            fail("Enter a name for the wallpaper.")
        if "/" in stem or stem.startswith("."):
            fail("Names cannot contain / or start with a dot.")
        if re.search(r"[\x00-\x1f\x7f-\x9f]", stem):
            fail("Names cannot contain control characters.")
        if len(stem.encode("utf-8")) > 200:
            fail("Names must be 200 bytes or fewer.")
    except UnicodeEncodeError:
        fail("Names must be valid UTF-8 text.")
    return stem


def move_without_clobber(source, destination):
    """Gives source the name destination without replacing anything there; source is gone afterwards."""
    try:
        os.link(source, destination, follow_symlinks=False)
    except FileExistsError:
        fail("A wallpaper named %s already exists." % os.path.basename(destination))
    except OSError:
        if os.path.lexists(destination):
            fail("A wallpaper named %s already exists." % os.path.basename(destination))
        os.replace(source, destination)
        return
    os.unlink(source)


def download(url, destination_dir, wallpaper_id):
    parsed = urllib.parse.urlparse(url)
    allowed = {urllib.parse.urlparse(API).hostname, "w.wallhaven.cc", "wallhaven.cc"}
    if parsed.scheme not in ("https", "http") or parsed.hostname not in allowed:
        fail("Refusing to download from an unexpected host.")
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    os.makedirs(destination_dir, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix=".wallhaven-", dir=destination_dir)
    try:
        with os.fdopen(handle, "wb") as out, urllib.request.urlopen(request, timeout=60) as response:
            ext = IMAGE_TYPES.get(response.headers.get_content_type())
            if not ext:
                fail("Wallhaven did not return an image.")
            total = 0
            while True:
                block = response.read(1 << 16)
                if not block:
                    break
                total += len(block)
                if total > MAX_IMAGE_BYTES:
                    fail("The image is larger than 256 MB.")
                out.write(block)
        final = os.path.join(destination_dir, "wallhaven-%s.%s" % (wallpaper_id, ext))
        os.replace(temporary, final)
        return final
    except HelperError:
        raise
    except (urllib.error.URLError, OSError, TimeoutError) as error:
        fail("Download failed: %s" % getattr(error, "reason", error), "network")
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def image_url(wallpaper_id, hint):
    """The full-size URL: the search result's own `path` when given, else one API lookup."""
    if hint and re.fullmatch(r"https?://[^\s]+/wallhaven-%s\.(?:jpe?g|png|webp)" % re.escape(wallpaper_id), hint):
        return hint
    config = load_config()
    item = api_get("/w/" + wallpaper_id, {}, config["apiKey"]).get("data") or {}
    if not item.get("path"):
        fail("Wallhaven returned no image for this wallpaper.")
    return item["path"]


def command_prepare(args):
    if not 1 <= len(args) <= 2 or not re.fullmatch(r"[A-Za-z0-9]{4,12}", args[0]):
        fail("prepare requires a wallpaper id.")
