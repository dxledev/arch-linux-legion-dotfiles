    if existing:
        emit({"id": args[0], "path": existing, "installed": existing.startswith(os.path.realpath(DYNAMIC_DIR) + os.sep)
              or existing.startswith(DYNAMIC_DIR + os.sep)})
        return
    path = download(image_url(args[0], args[1] if len(args) > 1 else ""), IMAGE_DIR, args[0])
    emit({"id": args[0], "path": path, "installed": False})


def command_install(args):
    if not 1 <= len(args) <= 3 or not re.fullmatch(r"[A-Za-z0-9]{4,12}", args[0]):
        fail("install requires a wallpaper id.")
    existing = find_existing(args[0])
    if existing and not existing.startswith(IMAGE_DIR + os.sep):
        emit({"id": args[0], "path": existing, "installed": True})
        return
    source = existing
    if not source:
        source = download(image_url(args[0], args[1] if len(args) > 1 else ""), IMAGE_DIR, args[0])
    extension = os.path.splitext(source)[1]
    name = args[2] if len(args) > 2 else ""
    stem = clean_stem(name, extension) if name else os.path.splitext(os.path.basename(source))[0]
    os.makedirs(DYNAMIC_DIR, exist_ok=True)
    destination = os.path.join(DYNAMIC_DIR, stem + extension)
    # Copy next to the destination first so the final link is atomic and never exposes a partial file.
    handle, temporary = tempfile.mkstemp(prefix=".wallhaven-", dir=DYNAMIC_DIR)
    os.close(handle)
    try:
        shutil.copyfile(source, temporary)
        os.chmod(temporary, 0o644)
        move_without_clobber(temporary, destination)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    tag_id(destination, args[0])
    os.unlink(source)
    emit({"id": args[0], "path": destination, "installed": True})


def command_rename_file(args):
    if len(args) != 2 or not os.path.isabs(args[0]) or not os.path.isfile(args[0]):
        fail("rename-file requires an existing wallpaper path and a new name.")
    path = args[0]
    directory, name = os.path.split(path)
    extension = os.path.splitext(name)[1]
    destination = os.path.join(directory, clean_stem(args[1], extension) + extension)
    if destination == path:
        emit({"path": path, "unchanged": True})
        return
    # Tag first so the id survives the rename even on a file that was only known by its name.
    wallpaper_id = file_id(path)
    if wallpaper_id:
        tag_id(path, wallpaper_id)
    move_without_clobber(path, destination)
    if in_library(path):
        old_name, new_name = os.path.basename(path), os.path.basename(destination)

        def follow_rename(index):
            # The destination did not exist before the move, so any entry already naming it is stale.
            for key, value in list(index.items()):
                if value == new_name:
                    del index[key]
            for key, value in list(index.items()):
                if value == old_name:
                    index[key] = new_name
            if wallpaper_id:
                index.setdefault(wallpaper_id, new_name)
        index_update(follow_rename)
    emit({"path": destination})


LIBRARY_EXTENSIONS = (".jpg", ".jpeg", ".png", ".webp", ".gif")


def library_sort_key(path):
    return [int(t) if t.isdecimal() else t.lower() for t in re.split(r"(\d+)", path)]


def command_library(args):
    if args:
        fail("library accepts no arguments.")
    root = os.path.realpath(DYNAMIC_DIR)
    if not os.path.isdir(root):
        emit({"data": [], "directory": root})
        return
    paths = []
    for directory, dirnames, filenames in os.walk(root, followlinks=True):
        for name in filenames:
            path = os.path.join(directory, name)
            if name.startswith(".") or os.path.splitext(name)[1].lower() not in LIBRARY_EXTENSIONS:
                continue
            if os.path.isfile(path):
                paths.append(path)
    items = []
    for path in sorted(paths, key=library_sort_key):
        width = height = 0
        try:
            from PIL import Image
            with Image.open(path) as image:
                width, height = image.size
        except Exception:
            width = height = 0
        items.append({
            "id": path, "path": path, "name": os.path.basename(path),
            "resolution": "%dx%d" % (width, height) if width and height else "",
            "width": width, "height": height, "fileSize": os.path.getsize(path),
            "fileType": os.path.splitext(path)[1][1:].lower(),
        })
    emit({"data": items, "directory": root})


def prune_cache():
    """Drops cached full-size previews older than a week and thumbnails unused for two; installed wallpapers are never touched.
    Runs at most once an hour."""
    try:
        if time.time() - os.path.getmtime(PRUNE_STAMP) < 3600:
            return
    except OSError:
        pass
    for directory, ttl in ((IMAGE_DIR, 7 * 86400), (THUMB_DIR, THUMB_TTL)):
        if not os.path.isdir(directory):
            continue
        cutoff = time.time() - ttl
        for name in os.listdir(directory):
            path = os.path.join(directory, name)
            try:
                if os.path.isfile(path) and os.path.getmtime(path) < cutoff:
                    os.unlink(path)
            except OSError:
                pass
    try:
        os.makedirs(CACHE_ROOT, exist_ok=True)
        with open(PRUNE_STAMP, "a"):
            os.utime(PRUNE_STAMP)
    except OSError:
        pass


# ---------------------------------------------------------------- colour maths

def srgb_to_linear(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def linear_to_srgb(c):
    return 12.92 * c if c <= 0.0031308 else 1.055 * (c ** (1 / 2.4)) - 0.055


def hex_to_oklch(value):
    r, g, b = (srgb_to_linear(int(value[i:i + 2], 16) / 255) for i in (1, 3, 5))
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    lightness = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return lightness, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def oklch_to_rgb(lightness, chroma, hue):
    a, b = chroma * math.cos(math.radians(hue)), chroma * math.sin(math.radians(hue))
    l = (lightness + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (lightness - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (lightness - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s)


def oklch_to_hex(lightness, chroma, hue):
    """Converts to sRGB, shrinking chroma until the colour is inside the gamut."""
    lightness = min(1.0, max(0.0, lightness))
    low, high = 0.0, max(0.0, chroma)
    rgb = oklch_to_rgb(lightness, high, hue)
    if not all(-1e-4 <= c <= 1 + 1e-4 for c in rgb):
        for _ in range(24):
            mid = (low + high) / 2
            if all(-1e-4 <= c <= 1 + 1e-4 for c in oklch_to_rgb(lightness, mid, hue)):
                low = mid
            else:
                high = mid
        rgb = oklch_to_rgb(lightness, low, hue)
    return "#%02x%02x%02x" % tuple(round(min(1.0, max(0.0, linear_to_srgb(max(0.0, c)))) * 255) for c in rgb)


def luminance(value):
    r, g, b = (srgb_to_linear(int(value[i:i + 2], 16) / 255) for i in (1, 3, 5))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def hue_pull(hue, target, strength):
    diff = (target - hue + 540) % 360 - 180
    return (hue + diff * strength) % 360


def mix_oklch(a, b, amount):
    la, ca, ha = hex_to_oklch(a)
    lb, cb, hb = hex_to_oklch(b)
    return oklch_to_hex(la + (lb - la) * amount, ca + (cb - ca) * amount, hue_pull(ha, hb, amount))


def dominant_colors(path, count=8):
    """Returns [(hex, share)] from a downsampled copy of the full image."""
    try:
        from PIL import Image
    except ImportError:
        fail("Python Pillow is required for Island's own palette schemes.")
    try:
        with Image.open(path) as image:
            image = image.convert("RGB")
            image.thumbnail((192, 192))
            quantized = image.quantize(colors=count, method=Image.Quantize.MEDIANCUT)
            palette = quantized.getpalette()[:count * 3]
            counts = sorted(quantized.getcolors() or [], reverse=True)
    except (OSError, ValueError) as error:
        fail("Could not read the image: %s" % error)
    total = float(sum(n for n, _ in counts)) or 1.0
    return [("#%02x%02x%02x" % tuple(palette[i * 3:i * 3 + 3]), n / total) for n, i in counts if i * 3 + 2 < len(palette)]


def custom_palette(path, scheme, mode):
    label, _desc, target, strength, lights, chroma, bg_lights, bg_chroma, fg_chroma = CUSTOM_SCHEMES[scheme]
    dark = mode == "dark"
    colours = dominant_colors(path)
    best_hue, best = 260.0, -1.0
    for value, share in colours:
        _l, c, h = hex_to_oklch(value)
        weight = c * (0.4 + share)
        if c > 0.02 and weight > best:
            best_hue, best = h, weight
    # Schemes with an anchor hue pull the image's hues toward it; the rest follow the image.
    anchor = best_hue if target is None else target
    tint = best_hue if target is None else hue_pull(best_hue, target, 0.7)
    ansi_hues = [hue_pull(base, anchor, strength) for base in ANSI_ANCHORS]
    lightness = lights[0] if dark else lights[1]
    background = oklch_to_hex(bg_lights[0] if dark else bg_lights[1], bg_chroma, tint)
    foreground = oklch_to_hex(0.86 if dark else 0.28, fg_chroma, tint)
    ansi = []
    for hue, offset in zip(ansi_hues, STAGGER):
        colour = oklch_to_hex(lightness + offset, chroma, hue)
        step = 0.0
        while contrast(background, colour) < 4.5 and step < 0.5:
            step += 0.02
            colour = oklch_to_hex(lightness + offset + (step if dark else -step), chroma, hue)
        ansi.append(colour)
    bright = []
    for colour in ansi:
        l, c, h = hex_to_oklch(colour)
        bright.append(oklch_to_hex(l + (0.07 if dark else -0.06), c + 0.015, h))
    comment = mix_oklch(background, foreground, 0.38)
    bright_fg = oklch_to_hex(0.94 if dark else 0.18, fg_chroma, tint)
    # The accent is the ANSI colour whose hue sits closest to the image's dominant hue.
    accent = min(ansi, key=lambda c: abs((hex_to_oklch(c)[2] - best_hue + 180) % 360 - 180))
    terminal = [background] + ansi + [foreground, comment] + bright + [bright_fg]
    return {"mode": mode, "terminal": terminal, "colors": {
        "background": background, "foreground": foreground, "accent": accent, "muted": comment,
        "red": ansi[0], "green": ansi[1], "yellow": ansi[2], "blue": ansi[3], "magenta": ansi[4], "cyan": ansi[5]}}


def parse_toml_colors(text):
    values = {}
    for line in text.splitlines():
        match = re.match(r'^\s*([A-Za-z0-9_]+)\s*=\s*"(#[0-9a-fA-F]{6,8})"\s*$', line)
        if match:
            values[match.group(1)] = match.group(2).lower()
        else:
            match = re.match(r'^\s*mode\s*=\s*"(light|dark)"\s*$', line)
            if match:
                values["mode"] = match.group(1)
    return values


def aether_binary():
    candidates = [os.environ.get("AETHER_BIN"),
                  os.path.realpath(os.path.join(SCRIPT_DIR, "..", "..", ".runtime", "aether", "bin", "aether")),
                  shutil.which("aether")]
    for candidate in candidates:
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return ""


def aether_palette(path, scheme, mode):
    binary = aether_binary()
    if not binary:
        fail("The Aether binary is unavailable; build it with the Caelestia runtime scripts.")
    with tempfile.TemporaryDirectory(prefix="island-wallhaven-") as output:
        command = [binary, "--generate", path, "--no-apply", "--extract-mode", scheme, "--output", output,
                   "--no-zed", "--no-vscode", "--no-neovim"]
        if mode == "light":
            command.append("--light-mode")
        try:
            subprocess.run(command, check=True, capture_output=True, timeout=60, stdin=subprocess.DEVNULL)
            with open(os.path.join(output, "colors.toml")) as stream:
                parsed = parse_toml_colors(stream.read())
        except (subprocess.SubprocessError, OSError) as error:
            fail("Aether could not generate the %s palette: %s" % (scheme, getattr(error, "stderr", None) or error))
    needed = list(COLOR_KEYS) + ["color%d" % i for i in range(16)]
    if parsed.get("mode") != mode or any(k not in parsed for k in needed):
        fail("Aether produced an incomplete %s palette." % scheme)
    return {"mode": mode, "colors": {k: parsed[k] for k in COLOR_KEYS}, "terminal": [parsed["color%d" % i] for i in range(16)]}


def build_palette(path, scheme, mode):
    if mode not in ("dark", "light"):
        fail("Mode must be dark or light.")
    if not os.path.isfile(path):
        fail("Image not found: %s" % path)
    if scheme in CUSTOM_SCHEMES:
        palette = custom_palette(path, scheme, mode)
    elif scheme in [s[0] for s in AETHER_SCHEMES]:
        palette = aether_palette(path, scheme, mode)
    else:
        fail("Unknown palette scheme: %s" % scheme)
    palette["scheme"] = scheme
    palette["style"] = "wh-" + scheme
    return palette


def palette_toml(palette):
    lines = ["# Generated by Island's Wallhaven browser.", 'mode = "%s"' % palette["mode"]]
    lines += ['%s = "%s"' % (k, palette["colors"][k]) for k in COLOR_KEYS]
    lines += ['color%d = "%s"' % (i, c) for i, c in enumerate(palette["terminal"])]
    return "\n".join(lines) + "\n"


