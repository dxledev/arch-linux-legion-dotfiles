class HelperError(Exception):
    def __init__(self, message, code="error"):
        super().__init__(message)
        self.code = code


def fail(message, code="error"):
    raise HelperError(message, code)


def emit(value):
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()


# ---------------------------------------------------------------- config

def private_write(path, data):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    handle, temporary = tempfile.mkstemp(prefix="." + os.path.basename(path) + ".", dir=directory)
    try:
        with os.fdopen(handle, "w") as stream:
            json.dump(data, stream, separators=(",", ":"))
            stream.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    except BaseException:
        if os.path.exists(temporary):
            os.unlink(temporary)
        raise


def read_json(path):
    try:
        with open(path) as stream:
            value = json.load(stream)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def sanitize_filters(raw):
    """Returns a filter dict with every field validated against wallhaven's API."""
    raw = raw if isinstance(raw, dict) else {}
    out = dict(DEFAULT_FILTERS)

    def bits(value, default):
        value = str(value if value is not None else default)
        return value if re.fullmatch(r"[01]{3}", value) and value != "000" else default

    out["q"] = str(raw.get("q", ""))[:200]
    out["categories"] = bits(raw.get("categories"), "111")
    out["purity"] = bits(raw.get("purity"), "100")
    sorting = raw.get("sorting", "date_added")
    out["sorting"] = sorting if sorting in SORTINGS else "date_added"
    out["order"] = "asc" if raw.get("order") == "asc" else "desc"
    top = raw.get("topRange", "1M")
    out["topRange"] = top if top in TOP_RANGES else "1M"
    atleast = str(raw.get("atleast", "") or "")
    out["atleast"] = atleast if re.fullmatch(r"\d{3,5}x\d{3,5}", atleast) else ""
    for key, pattern in (("resolutions", r"\d{3,5}x\d{3,5}"), ("ratios", r"(landscape|portrait|\d{1,2}x\d{1,2})")):
        values = raw.get(key, [])
        if isinstance(values, str):
            values = [part for part in values.split(",") if part]
        out[key] = [str(v) for v in values if re.fullmatch(pattern, str(v))][:24]
    colors = str(raw.get("colors", "") or "").lower().lstrip("#")
    out["colors"] = colors if colors in WALLHAVEN_COLORS else ""
    seed = str(raw.get("seed", "") or "")
    out["seed"] = seed if re.fullmatch(r"[A-Za-z0-9]{6}", seed) else ""
    return out


def sanitize_page_size(value):
    """Results shown per page; wallhaven fixes the API page size, so smaller pages are sliced client-side.
    0 (the default) shows the whole API page."""
    try:
        size = int(value)
    except (TypeError, ValueError):
        return 0
    return size if size in PAGE_SIZES else 0


def load_config():
    saved = read_json(CONFIG_FILE)
    seeded = not saved
    aether = read_json(AETHER_CONFIG) if seeded else {}
    api_key = str(saved.get("apiKey") or aether.get("apiKey") or "")
    filters = saved.get("filters")
    if filters is None:
        filters = {"categories": aether.get("categories"), "purity": aether.get("purity"),
                   "sorting": aether.get("sorting"), "order": aether.get("order"),
                   "atleast": aether.get("resolutions", "")}
        # Aether defaults to "favorites"; Island starts from the same preference when it exists.
    return {"apiKey": api_key, "filters": sanitize_filters(filters), "username": str(saved.get("username", ""))[:64],
            "pageSize": sanitize_page_size(saved.get("pageSize"))}


def store_config(config):
    private_write(CONFIG_FILE, {"apiKey": config["apiKey"], "filters": config["filters"],
                                "username": config.get("username", ""), "pageSize": config.get("pageSize", 24)})


def command_config(_args):
    config = load_config()
    emit({"filters": config["filters"], "hasKey": bool(config["apiKey"]), "username": config["username"],
          "pageSize": config["pageSize"], "colors": list(WALLHAVEN_COLORS), "sortings": list(SORTINGS), "topRanges": list(TOP_RANGES)})


def command_save_config(args):
    if len(args) != 1:
        fail("save-config requires one JSON object.")
    try:
        payload = json.loads(args[0])
    except ValueError:
        fail("save-config received invalid JSON.")
    config = load_config()
    if isinstance(payload, dict):
        if "filters" in payload:
            config["filters"] = sanitize_filters(payload["filters"])
        if "username" in payload:
            config["username"] = re.sub(r"[^A-Za-z0-9_.-]", "", str(payload["username"]))[:64]
        if "pageSize" in payload:
            config["pageSize"] = sanitize_page_size(payload["pageSize"])
    store_config(config)
    emit({"ok": True})


def command_set_key(_args):
    key = os.environ.get("ISLAND_WALLHAVEN_NEW_KEY", "").strip()
    if key and not re.fullmatch(r"[A-Za-z0-9]{16,64}", key):
        fail("That does not look like a wallhaven API key (letters and digits only).")
    config = load_config()
    config["apiKey"] = key
    if not key:
        config["filters"]["purity"] = config["filters"]["purity"][:2] + "0"
    store_config(config)
    emit({"ok": True, "hasKey": bool(key)})


# ---------------------------------------------------------------- HTTP

def throttle():
    """Blocks until a call fits in wallhaven's 45 requests/minute allowance."""
    os.makedirs(CACHE_ROOT, exist_ok=True)
    with open(RATE_FILE + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        deadline = time.time() + 25
        while True:
            now = time.time()
            stamps = [t for t in read_json(RATE_FILE).get("calls", []) if now - t < RATE_WINDOW]
            if len(stamps) < RATE_LIMIT:
                stamps.append(now)
                private_write(RATE_FILE, {"calls": stamps})
                return
            wait = RATE_WINDOW - (now - stamps[0]) + 0.05
            if now + wait > deadline:
                fail("Wallhaven rate limit reached (45 requests per minute). Try again shortly.", "rate_limited")
            time.sleep(wait)


def api_get(path, params=None, api_key=""):
    query = urllib.parse.urlencode([(k, v) for k, v in (params or {}).items() if v not in ("", None)])
    url = API + path + ("?" + query if query else "")
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
    if api_key:
        request.add_header("X-API-Key", api_key)
    throttle()
    try:
        with urllib.request.urlopen(request, timeout=25) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        if error.code == 401:
            fail("Wallhaven rejected the API key.", "unauthorized")
        if error.code == 429:
            fail("Wallhaven rate limit reached. Try again shortly.", "rate_limited")
        if error.code == 404:
            fail("Wallhaven could not find that item.", "not_found")
        fail("Wallhaven returned HTTP %d." % error.code)
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        fail("Could not reach wallhaven.cc: %s" % getattr(error, "reason", error), "network")
    except ValueError:
        fail("Wallhaven returned an unreadable response.")


