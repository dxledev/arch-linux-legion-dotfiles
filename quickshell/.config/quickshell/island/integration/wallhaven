    thumbs = item.get("thumbs") or {}
    return {
        "id": str(item.get("id", "")),
        "url": item.get("url", ""),
        "path": item.get("path", ""),
        "thumb": thumbs.get("large") or thumbs.get("small") or thumbs.get("original") or "",
        "thumbSmall": thumbs.get("small") or thumbs.get("large") or "",
        "resolution": item.get("resolution", ""),
        "width": int(item.get("dimension_x") or 0),
        "height": int(item.get("dimension_y") or 0),
        "ratio": str(item.get("ratio", "")),
        "fileSize": int(item.get("file_size") or 0),
        "fileType": item.get("file_type", ""),
        "category": item.get("category", ""),
        "purity": item.get("purity", ""),
        "views": int(item.get("views") or 0),
        "favorites": int(item.get("favorites") or 0),
        "colors": [c for c in item.get("colors", []) if isinstance(c, str) and HEX_RE.match(c)],
