    "collection": command_collection, "thumbs": command_thumbs, "prepare": command_prepare, "install": command_install,
    "rename-file": command_rename_file, "library": command_library,
    "previews": command_previews, "preview": command_preview, "palette-file": command_palette_file,
    "schemes": command_schemes,
}


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help") or argv[1] not in COMMANDS:
        sys.stderr.write(__doc__)
        return 0 if len(argv) > 1 and argv[1] in ("-h", "--help") else 2
    try:
        if argv[1] == "search":
            prune_cache()
        COMMANDS[argv[1]](argv[2:])
    except HelperError as error:
        emit({"error": str(error), "code": error.code})
        return 1
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
