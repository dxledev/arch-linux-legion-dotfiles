def normalize_meta(meta):
    query = meta.get("query")
    if isinstance(query, dict):
        query = "id:%s" % query.get("id", "")
    return {"page": int(meta.get("current_page") or 1), "lastPage": int(meta.get("last_page") or 1),
            "perPage": int(str(meta.get("per_page") or 24)), "total": int(meta.get("total") or 0),
            "seed": meta.get("seed") or "", "query": query or ""}


WALLPAPER_ID_RE = r"[A-Za-z0-9]{4,12}"
ID_XATTR = "user.wallhaven.id"
IDS_FILE = os.path.join(STATE_DIR, "wallhaven-ids.json")   # sidecar index: id -> library file name
IDS_LOCK = os.path.join(STATE_DIR, "wallhaven-ids.lock")


def name_id(name):
    """The id from a `wallhaven-<id>.<ext>` file name, or ""."""
    match = re.fullmatch(r"wallhaven-(%s)\.(?:jpe?g|png|webp)" % WALLPAPER_ID_RE, name)
    return match.group(1) if match else ""


def xattr_id(path):
    """The id recorded on the file by tag_id, or "" (also when the filesystem has no user xattrs)."""
    try:
        value = os.getxattr(path, ID_XATTR, follow_symlinks=False).decode("ascii")
    except (OSError, AttributeError, UnicodeDecodeError):
        return ""
    return value if re.fullmatch(WALLPAPER_ID_RE, value) else ""


def in_library(path):
    """Whether path sits directly in the Dynamic library (not in a subfolder, nor outside it)."""
    return os.path.dirname(os.path.normpath(path)) == os.path.normpath(DYNAMIC_DIR)


def index_load():
    """The sidecar id index as {id: library file name}. Read-only; anything unreadable or malformed counts as empty."""
    ids = read_json(IDS_FILE).get("ids")
    if not isinstance(ids, dict):
        return {}
    return {k: v for k, v in ids.items()
            if isinstance(k, str) and re.fullmatch(WALLPAPER_ID_RE, k) and isinstance(v, str)
            and v == os.path.basename(v) and not v.startswith(".")}


def index_update(mutator):
    """Edits the sidecar id index under a lock, then drops entries whose file is gone. Best effort: returns False instead of raising."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(IDS_LOCK, "a") as lock:
            deadline = time.time() + 1.5
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.time() > deadline:
                        return False
                    time.sleep(0.05)
            index = index_load()
            mutator(index)
            for wallpaper_id, name in list(index.items()):
                if not os.path.isfile(os.path.join(DYNAMIC_DIR, name)):
                    del index[wallpaper_id]
            private_write(IDS_FILE, {"version": 1, "ids": index})
        return True
    except Exception:  # best effort: the index must never fail an install or a rename
        return False


def tag_id(path, wallpaper_id):
    """Records the wallpaper id on the file (xattr) and in the sidecar index so a rename keeps it recognised.
    Best effort: returns False if neither could be written."""
    if not re.fullmatch(WALLPAPER_ID_RE, wallpaper_id or ""):
        return False
    tagged = False
    try:
        os.setxattr(path, ID_XATTR, wallpaper_id.encode("ascii"), follow_symlinks=False)
        tagged = True
    except (OSError, AttributeError):
        pass
    if in_library(path):
        name = os.path.basename(path)

        def record(index):
            for other in [k for k, v in index.items() if v == name and k != wallpaper_id]:
                del index[other]
            index[wallpaper_id] = name
        tagged = index_update(record) or tagged
    return tagged


def file_id(path):
    """The wallpaper id of a library file: its xattr first, then its `wallhaven-<id>` name, then the sidecar index, else ""."""
    name = os.path.basename(path)
    indexed = ""
    if in_library(path):
        indexed = next((k for k, v in index_load().items() if v == name), "")
    return xattr_id(path) or name_id(name) or indexed


def installed_paths():
    """Dynamic library files by wallpaper id (top level only), found by name, by their xattr tag, then by the sidecar index."""
    found = {}
    try:
        names = sorted(os.listdir(DYNAMIC_DIR))
    except OSError:
        return found
    for name in names:
        path = os.path.join(DYNAMIC_DIR, name)
        if name.startswith(".") or not os.path.isfile(path):
            continue
        for wallpaper_id in (name_id(name), xattr_id(path)):
            if wallpaper_id:
                found.setdefault(wallpaper_id, path)
    for wallpaper_id, name in index_load().items():
        path = os.path.join(DYNAMIC_DIR, name)
        if os.path.isfile(path):
            found.setdefault(wallpaper_id, path)
    return found


def installed_ids():
    """Wallpaper ids already in the Dynamic library, so results can show an "In library" badge."""
    return set(installed_paths())


def mark_installed(items):
    have = installed_ids()
    for item in items:
        item["installed"] = item["id"] in have
    return items


# ---------------------------------------------------------------- thumbnail cache

def thumb_file(wallpaper_id, url):
    extension = os.path.splitext(urllib.parse.urlparse(url).path)[1].lower()
    return os.path.join(THUMB_DIR, wallpaper_id + (extension if extension in (".jpg", ".jpeg", ".png", ".webp") else ".jpg"))


def cached_thumb(wallpaper_id, url):
    """The on-disk copy of a thumbnail, or "". Using one refreshes its age so it survives pruning."""
    path = thumb_file(wallpaper_id, url)
    try:
        if os.path.getsize(path) > 0:
            os.utime(path)
            return path
    except OSError:
        pass
    return ""


def fetch_thumb(wallpaper_id, url):
    """Downloads one thumbnail into the cache (atomically; runs may be killed midway). Returns its path or ""."""
    if not re.fullmatch(r"[A-Za-z0-9]{4,12}", wallpaper_id or "") or urllib.parse.urlparse(url).scheme not in ("http", "https"):
        return ""
    path = cached_thumb(wallpaper_id, url)
    if path:
        return path
    temporary = ""
    try:
        os.makedirs(THUMB_DIR, exist_ok=True)
        handle, temporary = tempfile.mkstemp(prefix="." + wallpaper_id + ".", dir=THUMB_DIR)
        request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
        with os.fdopen(handle, "wb") as out, urllib.request.urlopen(request, timeout=15) as response:
            if not response.headers.get_content_type().startswith("image/"):
                raise ValueError("not an image")
            data = response.read(MAX_THUMB_BYTES + 1)
            if not data or len(data) > MAX_THUMB_BYTES:
                raise ValueError("bad thumbnail size")
            out.write(data)
        path = thumb_file(wallpaper_id, url)
        os.replace(temporary, path)
        return path
    except Exception:  # best effort: a flaky CDN connection must not take the page down with it
        if temporary and os.path.exists(temporary):
            try:
                os.unlink(temporary)
            except OSError:
                pass
        return ""


def cache_thumbs(items, download):
    """Points each wallpaper's `thumb` at its cached file; with `download`, fetches the missing ones first."""
    missing = []
    for item in items:
        local = cached_thumb(item["id"], item["thumb"])
        if local:
            item["thumb"] = pathlib.Path(local).as_uri()
        elif download and item["thumb"]:
            missing.append(item)
    if missing:
        with concurrent.futures.ThreadPoolExecutor(THUMB_WORKERS) as pool:
            for item, local in zip(missing, pool.map(lambda i: fetch_thumb(i["id"], i["thumb"]), missing)):
                if local:
                    item["thumb"] = pathlib.Path(local).as_uri()
    return items


def command_thumbs(args):
    try:
        wanted = json.loads(args[0]) if len(args) == 1 else None
    except ValueError:
        wanted = None
    if not isinstance(wanted, list):
        fail("thumbs requires a JSON list of {id, url}.")
    wanted = [w for w in wanted[:128] if isinstance(w, dict) and isinstance(w.get("id"), str) and isinstance(w.get("url"), str)]
    with concurrent.futures.ThreadPoolExecutor(THUMB_WORKERS) as pool:
        futures = {pool.submit(fetch_thumb, w["id"], w["url"]): w["id"] for w in wanted}
        for future in concurrent.futures.as_completed(futures):
            path = future.result()
            if path:
                emit({"id": futures[future], "path": pathlib.Path(path).as_uri()})


def command_search(args):
    if len(args) != 1:
