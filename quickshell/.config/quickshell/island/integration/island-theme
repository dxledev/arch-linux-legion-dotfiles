#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")" && pwd)"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
state_dir="${ISLAND_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/island}"
themes_dir="${THEMES_DIR:-$config_home/themes}"
dynamic_directory="${ISLAND_DYNAMIC_WALLPAPERS_DIR:-$HOME/files/pictures/wallpapers/dynamic}"
settings_file="$state_dir/settings.json"
wallpapers_file="$state_dir/wallpapers.json"
shell_theme="${ISLAND_SHELL_THEME_ENGINE:-$script_dir/../../caelestia/integration/shell-theme}"
theme_apply="${THEME_APPLY:-${DESKTOP_SCRIPTS_DIR:-$HOME/bin}/theme-apply}"
awww_bin="${ISLAND_AWWW_BIN:-/usr/bin/awww}"
awww_daemon="${ISLAND_AWWW_DAEMON:-/usr/bin/awww-daemon}"
pgrep_bin="${ISLAND_PGREP_BIN:-/usr/bin/pgrep}"
wallhaven_helper="${ISLAND_WALLHAVEN_HELPER:-$script_dir/wallhaven}"
wallpaper_relink="${ISLAND_WALLPAPER_RELINK:-$script_dir/../../shared/wallpapers/relink}"
dry_run=0

source "$script_dir/theme-functions"

usage() {
    printf 'Usage: island-theme [--dry-run] status|ui|themes|wallpapers|wallpaper-directory|restore|theme NAME|wallpaper PATH|delete-wallpapers PATH...|rename-wallpaper PATH STEM|next|previous|mode light|dark|variant NAME|aether-list [PATH]|aether-select wh-SCHEME light|dark|wallpaper-palette PATH aether|material SCHEME light|dark|setting KEY VALUE\n'
}

fail() {
    printf 'island-theme: %s\n' "$*" >&2
    exit 1
}

engine() {
    local args=()
    (( ! dry_run )) || args+=(--dry-run)
    SHELL_THEME_DESKTOP_PROVIDER=island SHELL_THEME_STATE_DIR="$state_dir" \
        SHELL_THEME_PREWARM="${ISLAND_THEME_PREWARM:-1}" \
        SHELL_THEME_CACHE_DIR="${ISLAND_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/island/theme}" \
        SHELL_THEME_SUPPRESS_NOTIFY=1 THEME_APPLY_SKIP_WAYBAR=1 THEME_APPLY_SUPPRESS_NOTIFY=1 THEME_APPLY_SKIP_WALLPAPER=1 \
        THEME_APPLY_FORCE_EXTERNAL_WALLPAPER=1 THEME_APPLY_ACTIVATE_ONLY=1 \
        "$shell_theme" "${args[@]}" "$@" 8>&-
}

reload_applications() {
    (( ! dry_run )) || return 0
    [[ "${THEME_APPLY_ACTIVATE_ONLY:-0}" != 1 ]] || return 0
    local args=("$source_name")
    [[ "$source_name" != dynamic ]] || args+=(island)
    THEME_APPLY_SKIP_WAYBAR=1 THEME_APPLY_SUPPRESS_NOTIFY=1 THEME_APPLY_SKIP_WALLPAPER=1 \
        THEME_APPLY_FORCE_EXTERNAL_WALLPAPER=1 THEME_APPLY_LOW_PRIORITY="${THEME_APPLY_LOW_PRIORITY:-1}" \
        THEME_APPLY_WAIT_FOR_RELOADS="${THEME_APPLY_WAIT_FOR_RELOADS:-0}" \
        "$theme_apply" "${args[@]}" 8>&-
}

load_state() {
    theme_state="$(engine status)"
    source_name="$(/usr/bin/jq -r .source <<< "$theme_state")"
    static_theme="$(/usr/bin/jq -r .staticTheme <<< "$theme_state")"
    [[ "$static_theme" =~ ^[a-z0-9][a-z0-9._-]*$ && -f "$themes_dir/$static_theme/Colors.qml" ]] || fail 'Saved static theme is unavailable.'
    theme_key="$static_theme"
    [[ "$source_name" != dynamic ]] || theme_key=dynamic
    wallpaper_directory="$themes_dir/$static_theme/wallpapers"
    [[ "$theme_key" != dynamic ]] || wallpaper_directory="$dynamic_directory"
    wallpaper_directory="$(/usr/bin/readlink -f -- "$wallpaper_directory")"
}

selected_wallpaper() {
    local saved=""
    if [[ -r "$wallpapers_file" ]]; then
        saved="$(/usr/bin/jq -r --arg key "$theme_key" '.[$key] // empty' "$wallpapers_file")"
    fi
    if [[ -f "$saved" && "$saved" == "$wallpaper_directory/"* ]]; then
        printf '%s\n' "$saved"
    elif [[ "$theme_key" == dynamic ]]; then
        first_wallpaper
    else
        /usr/bin/readlink -f -- "$themes_dir/$static_theme/wallpaper.png"
    fi
}

first_wallpaper() {
    local -a entries=()
    mapfile -d '' -t entries < <(scan_wallpapers)
    (( ${#entries[@]} )) || fail "No wallpapers in $wallpaper_directory"
    printf '%s\n' "${entries[0]}"
}

save_wallpaper() {
    local path="$1" data='{}'
    [[ ! -r "$wallpapers_file" ]] || data="$(/usr/bin/cat -- "$wallpapers_file")"
    write_json "$wallpapers_file" "$(/usr/bin/jq -c --arg key "$theme_key" --arg path "$path" '.[$key]=$path' <<< "$data")"
    if [[ "$theme_key" == dynamic ]]; then
        /usr/bin/ln -sfn -- "$path" "$state_dir/dynamic-wallpaper"
    fi
}

apply_selection() {
    local path="$1"
    [[ "$path" == /* && -f "$path" ]] || fail "Wallpaper unavailable: $path"
    path="$(/usr/bin/readlink -f -- "$path")"
    [[ "$path" == "$wallpaper_directory/"* ]] || fail 'Wallpaper must belong to the active theme directory.'
    if (( dry_run )); then
        printf 'Island %s wallpaper: %s\n' "$theme_key" "$path"
        return
    fi
    save_wallpaper "$path"
    if [[ "$theme_key" == dynamic ]]; then engine refresh-wallpaper; fi
    apply_awww "$path" 0
    if [[ "$theme_key" == dynamic ]]; then reload_applications; fi
}

restore() {
    local wallpaper
    load_state
    wallpaper="$(selected_wallpaper)"
    [[ -f "$wallpaper" ]] || fail "Saved wallpaper unavailable: $wallpaper"
    if (( ! dry_run )); then save_wallpaper "$wallpaper"; fi
    SHELL_DYNAMIC_WALLPAPER="$wallpaper" engine restore
    apply_awww "$wallpaper" 1
    reload_applications
}

step_wallpaper() {
    local direction="$1" current index=0 selected=0 path
    local -a entries=()
    mapfile -d '' -t entries < <(scan_wallpapers)
    (( ${#entries[@]} )) || fail 'No wallpapers available.'
    current="$(selected_wallpaper)"
    for path in "${entries[@]}"; do
        if [[ "$path" == "$current" ]]; then selected="$index"; break; fi
        index=$((index + 1))
    done
    selected=$(((selected + direction + ${#entries[@]}) % ${#entries[@]}))
    apply_selection "${entries[selected]}"
}

valid_scheme() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

# Switches to the Dynamic theme's wallpaper directory so palette commands can run from any theme.
use_dynamic_library() {
    theme_key=dynamic
    wallpaper_directory="$(/usr/bin/readlink -f -- "$dynamic_directory")"
}

# Writes a colors.toml for the scheme and prints its path; the caller removes it.
generate_palette_file() {
    local palette_file
    palette_file="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/island-palette.XXXXXX")"
    if ! "$wallhaven_helper" palette-file "$1" "$2" "$3" "$palette_file" >/dev/null; then
        /usr/bin/rm -f -- "$palette_file"
        fail "Could not generate the $2 palette."
    fi
    printf '%s\n' "$palette_file"
}

# Palettes generated by the Wallhaven browser are stored per wallpaper as "wh-SCHEME" Aether snapshots.
generated_palette_exists() {
    engine list-aether | /usr/bin/jq -e --arg style "$1" --arg mode "$2" \
        'any(.[]; .style == $style and .mode == $mode)' >/dev/null
}

aether_select() {
    local style="$1" mode="$2" wallpaper palette_file
    [[ "$style" =~ ^wh-[a-z0-9][a-z0-9-]*$ && ( "$mode" == light || "$mode" == dark ) ]] || fail 'aether-select requires wh-SCHEME and light or dark.'
    [[ "$theme_key" == dynamic ]] || fail 'Generated palettes apply to Dynamic themes.'
    if (( dry_run )); then printf 'Select generated palette %s (%s)\n' "$style" "$mode"; return; fi
    if generated_palette_exists "$style" "$mode"; then
        engine set-aether-variant "$style" "$mode"
    else
        # The other light/dark pair is generated from the wallpaper on first use, then stored beside the first.
        wallpaper="$(selected_wallpaper)"
        palette_file="$(generate_palette_file "$wallpaper" "${style#wh-}" "$mode")"
        engine set-aether --style "$style" "$palette_file" || { /usr/bin/rm -f -- "$palette_file"; fail "Could not apply the $style palette."; }
        /usr/bin/rm -f -- "$palette_file"
    fi
    reload_applications
}

# Applies a wallpaper from the Dynamic library together with a generated Aether palette or a Material variant.
wallpaper_palette() {
    local path="$1" kind="$2" scheme="$3" mode="$4" palette_file
    [[ "$kind" == aether || "$kind" == material ]] || fail 'Palette kind must be aether or material.'
    [[ "$mode" == light || "$mode" == dark ]] || fail 'Palette mode must be light or dark.'
    use_dynamic_library
    [[ "$path" == /* && -f "$path" ]] || fail "Wallpaper unavailable: $path"
    path="$(/usr/bin/readlink -f -- "$path")"
    [[ "$path" == "$wallpaper_directory/"* ]] || fail 'Wallpaper must belong to the Dynamic wallpaper library.'
    if [[ "$kind" == aether ]]; then
        valid_scheme "$scheme" || fail 'Invalid palette scheme.'
    else
        [[ "$scheme" =~ ^(tonalspot|vibrant|expressive|fidelity|fruitsalad|monochrome|neutral|rainbow|content)$ ]] || fail 'Invalid Material variant.'
    fi
    if (( dry_run )); then
        printf 'Island dynamic wallpaper: %s\nPalette: %s %s (%s)\n' "$path" "$kind" "$scheme" "$mode"
        return
    fi
    save_wallpaper "$path"
    if [[ "$kind" == aether ]]; then
        palette_file="$(generate_palette_file "$path" "$scheme" "$mode")"
        engine set-aether --style "wh-$scheme" "$palette_file" || { /usr/bin/rm -f -- "$palette_file"; fail "Could not apply the $scheme palette."; }
        /usr/bin/rm -f -- "$palette_file"
    else
        # set-mode and set-variant each render; only switch source and mode when they differ.
        [[ "$source_name" == dynamic ]] || engine set-source dynamic
        if [[ "$(/usr/bin/jq -r .mode <<< "$(engine status)")" != "$mode" ]]; then engine set-mode "$mode"; fi
        engine set-variant "$scheme"
    fi
    apply_awww "$path" 0
    # The engine may have just switched from a static theme; reload applications for Dynamic, not the old source.
    source_name=dynamic
    reload_applications
}

# Caelestia and Noctalia keep their own references to Dynamic wallpapers; when a file is renamed or replaced they
# are repointed in the state directories next to Island's own. The file operation has already happened, so
# problems here are warnings and never fail the command.
relink_wallpaper() {
    local old="$1" new="$2" mode="${3:-}" root="${state_dir%/*}"
    local -a flags=()
    [[ "$mode" != replaced ]] || flags=(--replaced)
    # A running Noctalia only adopts the edited settings.toml when asked, so give relink its binary (never a default there).
    local noctalia="${NOCTALIA_BIN:-$config_home/noctalia/.runtime/bin/noctalia}"
    [[ ! -x "$noctalia" ]] || flags+=(--noctalia-bin "$noctalia")
    [[ "$theme_key" == dynamic && "$old" != "$new" ]] || return 0
    if (( dry_run )); then
        printf 'Island dynamic relink: %s -> %s\n' "$old" "$new"
        return 0
    fi
    [[ -x "$wallpaper_relink" ]] || return 0
    "$wallpaper_relink" "${flags[@]}" --state-root "$root" "$old" "$new" >/dev/null || printf 'island-theme: could not update other shells for %s\n' "${old##*/}" >&2
}

# Removes wallpapers from the active theme directory. When the applied wallpaper is among them, a random
# survivor is applied first (palette included for Dynamic) so the shell never points at a deleted file.
delete_wallpapers() {
    local -a entries=() remaining=()
    local -A doomed=() doomed_real=()
    local path entry current replacement="" survivor
    (( $# )) || fail 'delete-wallpapers requires at least one path.'
    mapfile -d '' -t entries < <(scan_wallpapers)
    for path in "$@"; do
        for entry in "${entries[@]}"; do
            [[ "$entry" != "$path" ]] || { doomed["$entry"]=1; doomed_real["$(/usr/bin/readlink -f -- "$entry")"]=1; }
        done
    done
    (( ${#doomed[@]} )) || fail 'No matching wallpapers to delete.'
    # Other shells and the lock screen read the theme's shared wallpaper.png link, which Island never rewrites.
    if [[ "$theme_key" != dynamic && -L "$themes_dir/$static_theme/wallpaper.png" ]]; then
        local shared
        shared="$(/usr/bin/readlink -f -- "$themes_dir/$static_theme/wallpaper.png")"
        [[ -z "${doomed_real[$shared]:-}" ]] || fail "${shared##*/} is the $static_theme theme's default wallpaper and is shared with other shells."
    fi
    for entry in "${entries[@]}"; do
        [[ -z "${doomed[$entry]:-}" ]] || continue
        remaining+=("$entry")
    done
    (( ${#remaining[@]} )) || fail 'Keep at least one wallpaper in the directory.'
    current="$(selected_wallpaper)"
    if [[ -n "${doomed[$current]:-}" || -n "${doomed_real[$(/usr/bin/readlink -f -- "$current")]:-}" ]]; then
        replacement="${remaining[RANDOM % ${#remaining[@]}]}"
    fi
    if (( dry_run )); then
        printf 'Island %s delete: %s\n' "$theme_key" "${!doomed[*]}"
        [[ -z "$replacement" ]] || printf 'Island %s wallpaper: %s\n' "$theme_key" "$(/usr/bin/readlink -f -- "$replacement")"
        survivor="${replacement:-$current}"
        for entry in "${!doomed[@]}"; do relink_wallpaper "$entry" "$survivor" replaced; done
        return
    fi
    [[ -z "$replacement" ]] || apply_selection "$replacement"
    # Other shells that remembered a deleted wallpaper move to the one Island now shows.
    survivor="$(selected_wallpaper)"
    for entry in "${!doomed[@]}"; do relink_wallpaper "$entry" "$survivor" replaced; done
    for entry in "${!doomed[@]}"; do update_favorites "$entry" ""; /usr/bin/rm -f -- "$entry"; done
}

# Renames a wallpaper in the active theme directory, keeping its extension. The helper validates the name and
# performs the rename; the applied wallpaper and every theme's remembered wallpaper follow the new path.
rename_wallpaper() {
    (( $# == 2 )) || fail 'rename-wallpaper requires a path and a name.'
    local path="$1" stem="$2" entry base extension directory new output status=0 message was_selected=0 current matched=0
    local -a entries=()
    mapfile -d '' -t entries < <(scan_wallpapers)
    for entry in "${entries[@]}"; do
        if [[ "$entry" == "$path" ]]; then matched=1; break; fi
    done
    (( matched )) || fail 'No matching wallpaper to rename.'
    # Other shells and the lock screen read the theme's shared wallpaper.png link, which Island never rewrites.
    if [[ "$theme_key" != dynamic && -L "$themes_dir/$static_theme/wallpaper.png" ]]; then
        local shared
        shared="$(/usr/bin/readlink -f -- "$themes_dir/$static_theme/wallpaper.png")"
        [[ "$shared" != "$(/usr/bin/readlink -f -- "$path")" ]] || fail "${path##*/} is the $static_theme theme's default wallpaper and is shared with other shells."
    fi
    base="${path##*/}"
    directory="${path%/*}"
    extension=""
    [[ "$base" != *.* ]] || extension=".${base##*.}"
    new="$directory/$stem$extension"
    if (( dry_run )); then
        printf 'Island %s rename: %s -> %s\n' "$theme_key" "$path" "$new"
        relink_wallpaper "$path" "$new"
        return
    fi
    current="$(selected_wallpaper)"
    # Island stores the resolved file, so renaming a link to it changes nothing about the stored selection.
    if [[ -L "$path" ]]; then
        [[ "$current" != "$path" ]] || was_selected=1
    elif [[ "$current" == "$path" || "$(/usr/bin/readlink -f -- "$current")" == "$(/usr/bin/readlink -f -- "$path")" ]]; then
        was_selected=1
    fi
    output="$("$wallhaven_helper" rename-file "$path" "$stem")" || status=$?
    if (( status )); then
        message="$(/usr/bin/jq -r '.error // empty' <<< "$output" 2>/dev/null || true)"
        fail "${message:-Could not rename the wallpaper.}"
    fi
    new="$(/usr/bin/jq -r .path <<< "$output")"
    # Each theme remembers its own wallpaper, so any entry that names the old file moves to the new one.
    if [[ -r "$wallpapers_file" ]]; then
        write_json "$wallpapers_file" "$(/usr/bin/jq -c --arg old "$path" --arg new "$new" \
            'to_entries | map(if .value == $old then .value = $new else . end) | from_entries' "$wallpapers_file")"
    fi
    update_favorites "$path" "$new"
    if (( was_selected )); then save_wallpaper "$new"; fi
    relink_wallpaper "$path" "$new"
}

aether_list() {
    if (( $# == 0 )); then
        if [[ "$theme_key" == dynamic ]]; then engine list-aether; else printf '[]\n'; fi
        return
    fi
    (( $# == 1 )) || fail 'aether-list accepts at most a wallpaper path.'
    local path="$1" real
    [[ "$path" == /* && -f "$path" ]] || fail "Wallpaper unavailable: $path"
    real="$(/usr/bin/readlink -f -- "$path")"
    [[ "$real" == "$(/usr/bin/readlink -f -- "$dynamic_directory")/"* ]] || fail 'Wallpaper must belong to the Dynamic wallpaper library.'
    engine list-aether "$real"
}

main() {
    [[ "$state_dir" == /* && "$themes_dir" == /* && "$dynamic_directory" == /* && "$shell_theme" == /* && "$theme_apply" == /* && "$awww_bin" == /* && "$awww_daemon" == /* && "$pgrep_bin" == /* ]] || fail 'Paths must be absolute.'
    [[ "${1:-}" != --dry-run ]] || { dry_run=1; shift; }
    local action="${1:---help}"
    (( $# == 0 )) || shift
    if [[ "$action" == --help || "$action" == -h ]]; then usage; return; fi
    if [[ "$action" != status && "$action" != ui && "$action" != themes && "$action" != wallpapers && "$action" != wallpaper-directory && "$action" != aether-list ]] && (( ! dry_run )); then
        /usr/bin/mkdir -p -- "$state_dir"
        exec 8>"$state_dir/controller.lock"
        /usr/bin/flock 8
    fi
    load_state
    case "$action" in
        status) (( $# == 0 )) || fail 'status accepts no arguments.'; printf '%s\n' "$theme_state" ;;
        ui) (( $# == 0 )) || fail 'ui accepts no arguments.'; ui_state ;;
        themes) (( $# == 0 )) || fail 'themes accepts no arguments.'; list_themes ;;
        wallpapers) (( $# == 0 )) || fail 'wallpapers accepts no arguments.'; scan_wallpapers | /usr/bin/jq -Rs 'split("\u0000") | map(select(length > 0) | {path: .})' ;;
        wallpaper-directory) (( $# == 0 )) || fail 'wallpaper-directory accepts no arguments.'; printf '%s\n' "$wallpaper_directory" ;;
        initialize)
            (( $# == 0 )) || fail 'initialize accepts no arguments.'
            if (( dry_run )); then printf 'Initialize Island state at %s\n' "$state_dir"; return; fi
            [[ -f "$state_dir/shell-theme.json" ]] || write_json "$state_dir/shell-theme.json" "$theme_state"
            [[ -f "$settings_file" ]] || write_json "$settings_file" "$(read_settings)"
            save_wallpaper "$(selected_wallpaper)"
            local status_directory="${XDG_CACHE_HOME:-$HOME/.cache}/island/status"
            /usr/bin/mkdir -p -- "$status_directory"
            [[ -f "$status_directory/event" ]] || /usr/bin/touch "$status_directory/event"
            ;;
        restore) (( $# == 0 )) || fail 'restore accepts no arguments.'; restore ;;
        theme)
            (( $# == 1 )) || fail 'theme requires one name.'
            if [[ "$1" == dynamic ]]; then
                theme_key=dynamic; wallpaper_directory="$(/usr/bin/readlink -f -- "$dynamic_directory")"
                local wallpaper
                wallpaper="$(selected_wallpaper)"
                if (( ! dry_run )); then save_wallpaper "$wallpaper"; fi
                SHELL_DYNAMIC_WALLPAPER="$wallpaper" engine set-source dynamic
            else
                engine set-static-theme "$1"
            fi
            if (( ! dry_run )); then
                load_state
                apply_awww "$(selected_wallpaper)" 0
                reload_applications
            fi
            ;;
        delete-wallpapers) delete_wallpapers "$@" ;;
        rename-wallpaper) rename_wallpaper "$@" ;;
        wallpaper) (( $# == 1 )) || fail 'wallpaper requires one path.'; apply_selection "$1" ;;
        next|previous) (( $# == 0 )) || fail 'No arguments expected.'; if [[ "$action" == next ]]; then step_wallpaper 1; else step_wallpaper -1; fi ;;
        mode|variant)
            (( $# == 1 )) || fail 'One value required.'
            [[ "$theme_key" == dynamic ]] || fail 'Mode and variant apply to Dynamic themes.'
            engine "set-$action" "$1"
            reload_applications
            ;;
        aether-list) aether_list "$@" ;;
        aether-select) (( $# == 2 )) || fail 'aether-select requires a style and a mode.'; aether_select "$1" "$2" ;;
        wallpaper-palette) (( $# == 4 )) || fail 'wallpaper-palette requires a path, kind, scheme and mode.'; wallpaper_palette "$1" "$2" "$3" "$4" ;;
        setting) (( $# == 2 )) || fail 'setting requires a key and value.'; save_setting "$1" "$2" ;;
        *) usage >&2; return 2 ;;
    esac
}

main "$@"
