#!/usr/bin/env bash
set -euo pipefail

test_dir="$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")" && pwd)"
test_root="$(/usr/bin/mktemp -d /tmp/island-forecast.XXXXXX)"
fail() { printf '%s\n' "$*" >&2; exit 1; }

/usr/bin/node "$test_dir/weather-data.js" || fail "weather data checks failed"

/usr/bin/mkdir -p "$test_root/runtime" "$test_root/cache" "$test_root/state"
/usr/bin/chmod 700 "$test_root/runtime"
printf '[]\n' > "$test_root/tasks.json"
printf '{"services":{"weatherUnits":"Celsius"}}\n' > "$test_root/caelestia.json"

# Open-Meteo-shaped fixture for 15 days from today: day n peaks at 20+n C and dips to 10+n C.
/usr/bin/python3 - "$test_root/forecast.json" <<'PY'
import datetime, json, math, sys
today = datetime.date.today()
days = [today + datetime.timedelta(days=n) for n in range(15)]
codes = [0, 2, 3, 61, 63, 95, 71, 45, 55, 80, 1, 3, 2, 0, 61, 75]
hourly = {"time": [], "temperature_2m": [], "apparent_temperature": [], "precipitation_probability": [], "weather_code": []}
for n, day in enumerate(days):
    for hour in range(24):
        temp = 15 + n + 5 * math.sin((hour - 9) / 24 * 2 * math.pi)
        hourly["time"].append(f"{day.isoformat()}T{hour:02d}:00")
        hourly["temperature_2m"].append(round(temp, 1))
        hourly["apparent_temperature"].append(round(temp - 1.5, 1))
        hourly["precipitation_probability"].append((hour * 7 + n * 5) % 100)
        hourly["weather_code"].append(codes[n] if 8 <= hour <= 20 else 0)
daily = {
    "time": [d.isoformat() for d in days], "weather_code": codes,
    "temperature_2m_max": [20 + n for n in range(15)], "temperature_2m_min": [10 + n for n in range(15)],
    "sunrise": [f"{d.isoformat()}T07:12" for d in days], "sunset": [f"{d.isoformat()}T18:04" for d in days],
    "precipitation_probability_max": [(n * 13) % 100 for n in range(15)], "wind_speed_10m_max": [10 + n * 2 for n in range(15)],
}
json.dump({"utc_offset_seconds": 0, "hourly": hourly, "daily": daily}, open(sys.argv[1], "w"))
PY

cat > "$test_root/controller" <<'CONTROLLER'
#!/usr/bin/env bash
set -euo pipefail
config_home="$TEST_ROOT/config"
settings_file="$TEST_ROOT/state/settings.json"
dry_run=0
fail() { printf '%s\n' "$*" >&2; exit 1; }
source "$TEST_DIR/../theme-functions"
case "${1:-}" in
    ui) /usr/bin/jq -cn --argjson settings "$(read_settings)" '{theme:{source:"static",mode:"dark",variant:"tonalspot"},label:"test",settings:$settings,wallpaper:"",colors:{background:"#101010",backgroundAlt:"#181818",foreground:"#eeeeee",foregroundInactive:"#aaaaaa",muted:"#777777",primary:"#ffab91",danger:"#ee5555",warning:"#eebb55",success:"#66bb66"}}' ;;
    themes) printf '[]\n' ;;
    setting) save_setting "$2" "$3" ;;
    wallpaper-directory) exit 0 ;;
    *) exit 2 ;;
esac
CONTROLLER
/usr/bin/chmod +x "$test_root/controller"

log_file="$test_root/forecast-views.log"
/usr/bin/sed "s|\"../../|\"file://$test_dir/../../|g" "$test_dir/forecast-views.qml" > "$test_root/views.qml"
export ISLAND_DASHBOARD_TASKS_FILE="$test_root/tasks.json"
export ISLAND_QUOTES_URL="file://$test_root/missing-quotes.json"
export ISLAND_WEATHER_URL="file://$test_root/forecast.json"
export ISLAND_WEATHER_LOCATION="40.7,-74"
export ISLAND_CAELESTIA_CONFIG="$test_root/caelestia.json"
export ISLAND_WEATHER_UNITS="Fahrenheit"
export FORECAST_SHOT="${FORECAST_SHOT:-}"
if ! QT_QPA_PLATFORM=offscreen WAYLAND_DISPLAY= HYPRLAND_INSTANCE_SIGNATURE= \
    QML_IMPORT_PATH="$test_dir/../../../.runtime/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
    TEST_ROOT="$test_root" TEST_DIR="$test_dir" XDG_RUNTIME_DIR="$test_root/runtime" \
    XDG_CACHE_HOME="$test_root/cache" ISLAND_STATE_DIR="$test_root/state" SHELL_NOTIFICATION_HISTORY="$test_root/notification-history.jsonl" \
    ISLAND_THEME_SCRIPT="$test_root/controller" \
    /usr/bin/dbus-run-session -- /usr/bin/timeout 40s /usr/bin/quickshell -p "$test_root/views.qml" \
    > "$log_file" 2>&1; then
    /usr/bin/cat "$log_file" >&2
    fail "Could not run forecast-views.qml; fixture retained at $test_root"
fi
if ! /usr/bin/rg -q 'PASS: forecast panel, calendar round trip and cache' "$log_file" \
    || /usr/bin/rg -q 'FAIL:|ERROR|ReferenceError|TypeError|Binding loop' "$log_file"; then
    /usr/bin/cat "$log_file" >&2
    fail "forecast-views.qml failed; fixture retained at $test_root"
fi
/usr/bin/jq -e '.place.lat == 40.7 and (.forecast.days | length) == 15 and .placeKey == "40.7,-74"' "$test_root/state/weather.json" >/dev/null \
    || fail "forecast was not cached in weather.json; fixture retained at $test_root"
printf 'PASS: forecast-views.qml\n'
/usr/bin/rm -rf "$test_root"
