make_fixture() {
    /usr/bin/mkdir -p "$test_root/runtime" "$test_root/state" "$test_root/cache/island/status"
    /usr/bin/chmod 700 "$test_root/runtime"
    /usr/bin/cp -a "$test_dir/../.." "$test_root/island"
    make_audio_fixture
    /usr/bin/sed 's|"../../|"island/|g' "$test_dir/osd-settings-views.qml" > "$test_root/views.qml"
    /usr/bin/sed -i 's/readonly property var islandScreens: .*/property var islandScreens: [{name: "DP-1"}, {name: "HDMI-A-1"}]/' "$test_root/island/services/ThemeService.qml"
    /usr/bin/sed -i 's/readonly property var monitor: .*/readonly property var monitor: null/' "$test_root/island/services/WorkspaceService.qml" "$test_root/island/views/WorkspaceView.qml"
    /usr/bin/sed -i 's/model: Quickshell.screens/model: [{name: "DP-1"}, {name: "HDMI-A-1"}]/' "$test_root/island/services/StatusWatcher.qml"
    : > "$test_root/cache/island/status/event"
    cat > "$test_root/controller" <<'CONTROLLER'
#!/usr/bin/env bash
set -euo pipefail
config_home="$TEST_ROOT/config"
settings_file="$TEST_ROOT/state/settings.json"
dry_run=0
fail() { printf '%s\n' "$*" >&2; exit 1; }
source "$TEST_ROOT/island/integration/theme-functions"
case "$1" in
    ui) /usr/bin/jq -cn --argjson settings "$(read_settings)" '{theme:{source:"static",mode:"dark",variant:"tonalspot"},label:"test",settings:$settings,wallpaper:"",colors:{background:"#101010",foreground:"#eeeeee",foregroundInactive:"#aaaaaa",muted:"#777777",primary:"#ffab91",danger:"#ee5555",warning:"#eebb55",success:"#66bb66"}}' ;;
    themes) printf '[]\n' ;;
    setting) save_setting "$2" "$3" ;;
    wallpaper-directory) exit 0 ;;
    *) exit 2 ;;
esac
CONTROLLER
    /usr/bin/chmod +x "$test_root/controller"
}

ipc() { /usr/bin/quickshell -p "$test_root/views.qml" ipc call osdTest "$@" 2>/dev/null; }
expect() {
    local data
    data="$(ipc snapshot)"
    /usr/bin/jq -e "$1" <<< "$data" >/dev/null || fail "Failed: $1; $data"
}
wait_for() {
    local attempt
    for ((attempt=0; attempt<100; attempt++)); do
        if ipc snapshot | /usr/bin/jq -e "$1" >/dev/null 2>&1; then return; fi
        /usr/bin/sleep 0.05
    done
    expect "$1"
}
event() { printf '%s\n' "$1" > "$test_root/cache/island/status/event"; }

run_session() {
    /usr/bin/quickshell -p "$test_root/views.qml" > "$test_root/views.log" 2>&1 &
    fixture_pid=$!
    trap 'kill "$fixture_pid" 2>/dev/null || true' EXIT
    wait_for '.ready and .panel == "Clock" and .choices == 1'
    expect '.clock.font == "Noto Sans" and .clock.size == 24 and (.clock.bold | not) and .dp.height >= 36'
    check_font_inheritance
    ipc settingsPanel 'Dynamic palette'
    wait_for '.panel == "Dynamic palette" and (.progress.scrollable | not)'
    expect '(.progress.scrollable | not) and .progress.opacity == 0 and .progress.height == 2'
    ipc settingsPanel OSD
    wait_for '.panel == "OSD" and .choices == 1 and .modal'
    wait_for '.progress.scrollable and .progress.opacity == 1 and .progress.value > 0 and .progress.value < 1 and .progress.fillWidth < .progress.width'
    local title_geometry
    title_geometry="$(ipc snapshot | /usr/bin/jq -c '.progress | [.titleX, .titleY, .titleHeight, .headerHeight]')"
    ipc scrollTo 1
    wait_for '.progress.value == 1 and (.progress.fillWidth - .progress.width | fabs) < 0.1'
    ipc scrollTo 0
    wait_for '.progress.value < 1 and (.progress.fillWidth - .progress.width * .progress.value | fabs) < 0.1'
    ipc save scrollProgressAnimationDuration 1000
    wait_for '.settings.scrollProgressAnimationDuration == 1000 and (.busy | not)'
    ipc scrollTo 1
    expect '.progress.value == 1 and .progress.fillWidth < .progress.width - 1'
    wait_for '(.progress.fillWidth - .progress.width | fabs) < 0.1'
    ipc save scrollProgressAnimationDuration 180
    wait_for '.settings.scrollProgressAnimationDuration == 180 and (.busy | not)'
    ipc scrollTo 0
    wait_for '.scroll.position == 0'
    ipc save scrollAnimationDuration 500
    wait_for '.settings.scrollAnimationDuration == 500 and (.busy | not)'
    ipc wheel 64 false >/dev/null
    expect '.scroll.animating and .scroll.position >= 0 and .scroll.position < 64'
    expect '(.progress.fillWidth - .progress.width * .progress.value | fabs) < 0.1'
    ipc wheel 64 false >/dev/null
    expect '.scroll.destination == 128'
    ipc wheel -64 false >/dev/null
    expect '.scroll.destination == 64'
    wait_for '(.scroll.animating | not) and (.scroll.position - 64 | fabs) < 0.1'
    expect '(.progress.fillWidth - .progress.width * .progress.value | fabs) < 0.1'
    ipc wheel 25 true >/dev/null
    expect '(.scroll.animating | not) and (.scroll.position - 89 | fabs) < 0.1'
    ipc wheel 64 false >/dev/null
    expect '.scroll.animating'
    ipc scrollTo 0.75
    expect '(.scroll.animating | not) and (.scroll.position - .scroll.range * 0.75 | fabs) < 0.1'
    ipc wheel 10000 false >/dev/null
    wait_for '(.scroll.animating | not) and (.scroll.position - .scroll.range | fabs) < 0.1'
    expect '.progress.value == 1 and (.progress.fillWidth - .progress.width | fabs) < 0.1'
    [[ $(ipc wheel 64 false) == false ]] || fail 'Scrolled beyond the bottom.'
    ipc save scrollAnimationDuration 180
    wait_for '.settings.scrollAnimationDuration == 180 and (.busy | not)'
    ipc save scrollProgressVisibleDuration 500
    wait_for '.settings.scrollProgressVisibleDuration == 500 and (.busy | not)'
    ipc save scrollProgressAlwaysVisible false
    wait_for '(.settings.scrollProgressAlwaysVisible | not) and (.busy | not)'
    wait_for '.progress.opacity == 0'
    ipc scrollTo 0.5
    wait_for '.progress.opacity > 0 and .progress.value < 1'
    wait_for '.progress.opacity == 0'
    [[ "$title_geometry" == "$(ipc snapshot | /usr/bin/jq -c '.progress | [.titleX, .titleY, .titleHeight, .headerHeight]')" ]] || fail 'Scroll indicator moved the title.'
    ipc save scrollProgressAlwaysVisible true
    wait_for '.settings.scrollProgressAlwaysVisible and (.busy | not) and .progress.opacity == 1'
    ipc settingsPanel 'Dynamic palette'
    wait_for '.panel == "Dynamic palette" and (.progress.scrollable | not) and .progress.opacity == 0'
    ipc save scrollProgressShowOnNonScrollable true
    wait_for '.settings.scrollProgressShowOnNonScrollable and (.busy | not) and .progress.opacity == 1 and .progress.value == 1'
    ipc save scrollProgressShowOnNonScrollable false
    wait_for '(.settings.scrollProgressShowOnNonScrollable | not) and (.busy | not) and .progress.opacity == 0'
    ipc settingsPanel Settings
    wait_for '.panel == "Settings"'
    event 'volume|65'
    wait_for '.dp.showing and (.hdmi.showing | not) and .dp.percentages[0].text == "65%"'
    expect '.animation == 80 and .dp.percentages[0].size == 20 and (.dp.percentages[0].bold | not) and .dp.sliders[0].width == 240 and .dp.sliders[0].height == 10 and .dp.sliders[0].radius == 5'
    ipc save osdFontFamily 'Noto Sans'
    wait_for '.settings.osdFontFamily == "Noto Sans" and (.busy | not)'
    event 'brightness|25|DP-1'
    wait_for '.dp.showing and (.hdmi.showing | not) and .dp.percentages[0].text == "25%"'
    expect '.dp.percentages[0].font == "Noto Sans" and .dp.sliders[0].width == 240 and .dp.sliders[0].height == 10'
    event 'brightness|80|HDMI-A-1'
    wait_for '(.dp.showing | not) and .hdmi.showing and .hdmi.percentages[0].text == "80%"'
    ipc screens true
    wait_for '(.dp.showing | not) and .hdmi.showing and (.hdmi.sliders | length) == 1 and (.hdmi.labels | length) == 1'
    expect '.hdmi.labels == ["HDMI-A-1"] and .hdmi.percentages[0].text == "80%"'
    event 'brightness|35|DP-1'
    wait_for '(.dp.showing | not) and .hdmi.showing and (.hdmi.sliders | length) == 1 and .hdmi.labels == ["DP-1"] and .hdmi.percentages[0].text == "35%"'
    /usr/bin/sleep 0.3
    event 'brightness|90|HDMI-A-1'
    wait_for '.hdmi.showing and (.hdmi.sliders | length) == 1 and .hdmi.percentages[0].text == "90%"'
    wait_for '(.hdmi.showing | not)'
    /usr/bin/bash "$test_dir/../../scripts/publish-brightness-osd.sh" 45 DP-1 &
    local first_event=$!
    /usr/bin/bash "$test_dir/../../scripts/publish-brightness-osd.sh" 75 HDMI-A-1 &
    local second_event=$!
    wait "$first_event" "$second_event"
    wait_for '.hdmi.showing and (.hdmi.sliders | length) == 1 and (.hdmi.percentages[0].text == "45%" or .hdmi.percentages[0].text == "75%")'
    wait_for '(.hdmi.showing | not)'
    ipc save osdShowPercentage false
    wait_for '(.settings.osdShowPercentage | not) and (.busy | not)'
    event 'volume|30'
    wait_for '.hdmi.showing and (.hdmi.percentages[0].visible | not)'
    event 'volume|-1'
    wait_for '.hdmi.showing and .hdmi.percentages[0].visible and .hdmi.percentages[0].text == "Muted"'
    ipc keyboard
    wait_for '.mode == "keyboard" and .hdmi.showing'
    expect '.hdmi.text.font == "Noto Sans" and .hdmi.text.size == 20 and (.hdmi.text.bold | not) and .animation == 80'
    ipc save clockFontSize 40
    wait_for '.clock.size == 40 and (.busy | not)'
    wait_for '(.hdmi.showing | not) and .dp.height >= 52'
    expect '.error == ""'
}

check_font_inheritance() {
    ipc settingsPanel Appearance
    wait_for '.panel == "Appearance" and .ui.choices == 1'
    ipc save uiFontFamily 'DejaVu Sans'
    wait_for '.settings.uiFontFamily == "DejaVu Sans" and (.busy | not)'
    expect '.ui.titleFont == "DejaVu Sans" and .ui.searchFont == "DejaVu Sans" and .clock.font == "Noto Sans"'
    ipc settingsPanel Clock
    wait_for '.panel == "Clock" and (.ui.inherit | not) and .ui.fontChoiceEnabled'
    ipc toggleFontInheritance
    wait_for '.settings.clockInheritUiFont and (.busy | not)'
    expect '.ui.inherit and (.ui.fontChoiceEnabled | not) and .clock.font == "DejaVu Sans" and .ui.dateFont == "DejaVu Sans"'
    ipc settingsPanel OSD
    wait_for '.panel == "OSD" and (.ui.inherit | not) and .ui.fontChoiceEnabled'
    ipc toggleFontInheritance
    wait_for '.settings.osdInheritUiFont and (.busy | not)'
    event 'volume|65'
    wait_for '.dp.showing and .dp.percentages[0].font == "DejaVu Sans"'
    expect '.ui.inherit and (.ui.fontChoiceEnabled | not) and .dp.iconFont == "JetBrainsMono Nerd Font"'
    ipc keyboard
    wait_for '.mode == "keyboard" and .dp.text.font == "DejaVu Sans"'
    ipc save uiFontFamily 'Noto Sans'
    wait_for '.settings.uiFontFamily == "Noto Sans" and (.busy | not)'
    expect '.ui.titleFont == "Noto Sans" and .ui.searchFont == "Noto Sans" and .clock.font == "Noto Sans" and .dp.text.font == "Noto Sans"'
    ipc toggleFontInheritance
    wait_for '(.settings.osdInheritUiFont | not) and (.busy | not)'
    expect '.ui.fontChoiceEnabled and .settings.osdFontFamily == "JetBrainsMono Nerd Font" and .dp.text.font == "JetBrainsMono Nerd Font"'
    ipc settingsPanel Clock
    wait_for '.panel == "Clock"'
    ipc toggleFontInheritance
    wait_for '(.settings.clockInheritUiFont | not) and (.busy | not)'
    expect '.ui.fontChoiceEnabled and .settings.clockFontFamily == "Noto Sans" and .clock.font == "Noto Sans"'
    wait_for '(.dp.showing | not) and (.hdmi.showing | not)'
}

check_drawer_views() {
    /usr/bin/mkdir -p "$test_root/drawer-images"
    /usr/bin/sed "s|\"../../|\"file:$test_root/island/|g" "$test_dir/osd-drawer-views.qml" > "$test_root/drawer.qml"
    if ! QT_QPA_PLATFORM=offscreen WAYLAND_DISPLAY= HYPRLAND_INSTANCE_SIGNATURE= \
        OSD_DRAWER_IMAGE_DIR="$test_root/drawer-images" \
        /usr/bin/dbus-run-session -- /usr/bin/timeout 45s /usr/bin/quickshell -p "$test_root/drawer.qml" > "$test_root/drawer.log" 2>&1; then
        /usr/bin/cat "$test_root/drawer.log" >&2
        fail 'Could not run exclusive OSD drawer views.'
    fi
    if ! /usr/bin/rg -q 'PASS: all OSD types' "$test_root/drawer.log" \
        || /usr/bin/rg -q 'FAIL:|ERROR|ReferenceError|TypeError|Binding loop' "$test_root/drawer.log"; then
        /usr/bin/cat "$test_root/drawer.log" >&2
        fail 'Exclusive OSD drawer views failed.'
    fi
}

if [[ ${1:-} == --session ]]; then test_root=$2; run_session; exit; fi
test_root="$(/usr/bin/mktemp -d /tmp/island-osd-settings.XXXXXX)"
make_fixture
check_settings
check_publishers
export ISLAND_DDCUTIL_BIN=/usr/bin/true
export TEST_ROOT="$test_root" XDG_RUNTIME_DIR="$test_root/runtime" XDG_CACHE_HOME="$test_root/cache" ISLAND_STATE_DIR="$test_root/state" ISLAND_THEME_SCRIPT="$test_root/controller"
if ! QT_QPA_PLATFORM=xcb QT_NO_XDG_DESKTOP_PORTAL=1 GTK_USE_PORTAL=0 WAYLAND_DISPLAY= HYPRLAND_INSTANCE_SIGNATURE= \
    /usr/bin/dbus-run-session -- /usr/bin/xvfb-run -a /usr/bin/timeout 35s /usr/bin/bash "$0" --session "$test_root"; then
    /usr/bin/cat "$test_root/views.log" >&2
    exit 1
fi
if /usr/bin/rg -q 'ERROR|ReferenceError|TypeError|Binding loop' "$test_root/views.log"; then /usr/bin/cat "$test_root/views.log" >&2; exit 1; fi
check_drawer_views
printf 'PASS: UI font, clock/OSD inheritance switches and restored custom fonts, panels, scroll progress and expiry, fixed title geometry, saved settings, slider styling, exclusive attached OSD drawers, per-monitor routing, fallback labels, simultaneous event replacement, percentages, validation and dry-run\n'
