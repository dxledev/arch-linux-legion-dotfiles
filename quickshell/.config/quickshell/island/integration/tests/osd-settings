#!/usr/bin/env bash
set -euo pipefail

test_dir="$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")" && pwd)"
fail() { printf '%s\n' "$*" >&2; exit 1; }

check_settings() {
    local config_home="$test_root/config" settings_file="$test_root/state/settings.json" dry_run=0
    source "$test_dir/../theme-functions"
    read_settings | /usr/bin/jq -e '.clockFontSize == 18 and .osdFontSize == 18 and .osdSliderWidth == 180 and .osdTimeout == 1800' >/dev/null
    read_settings | /usr/bin/jq -e '.uiFontFamily == "Noto Sans" and (.clockInheritUiFont | not) and (.osdInheritUiFont | not)' >/dev/null
    save_setting uiFontFamily 'Noto Sans'
    save_setting clockInheritUiFont true
    save_setting osdInheritUiFont true
    read_settings | /usr/bin/jq -e '.uiFontFamily == "Noto Sans" and .clockInheritUiFont and .osdInheritUiFont' >/dev/null
    save_setting clockInheritUiFont false
    save_setting osdInheritUiFont false
    read_settings | /usr/bin/jq -e '.scrollProgressAlwaysVisible and .scrollProgressVisibleDuration == 1500 and (.scrollProgressShowOnNonScrollable | not) and .scrollProgressAnimationDuration == 180' >/dev/null
    save_setting scrollProgressAlwaysVisible false
    save_setting scrollProgressVisibleDuration 500
    save_setting scrollProgressShowOnNonScrollable true
    save_setting scrollProgressAnimationDuration 0
    read_settings | /usr/bin/jq -e '(.scrollProgressAlwaysVisible | not) and .scrollProgressVisibleDuration == 500 and .scrollProgressShowOnNonScrollable and .scrollProgressAnimationDuration == 0' >/dev/null
    save_setting scrollProgressAlwaysVisible true
    save_setting scrollProgressVisibleDuration 1500
    save_setting scrollProgressShowOnNonScrollable false
    save_setting scrollProgressAnimationDuration 180
    read_settings | /usr/bin/jq -e '.scrollAnimationDuration == 180 and .scrollWheelStep == 64' >/dev/null
    save_setting clockFontFamily 'Noto Sans'
    save_setting osdFontFamily 'JetBrainsMono Nerd Font'
    save_setting clockFontSize 24
    save_setting osdFontSize 20
    save_setting osdSliderWidth 240
    save_setting osdSliderHeight 10
    save_setting osdSliderRadius 5
    save_setting osdSliderAnimationDuration 0
    save_setting osdAnimationDuration 80
    save_setting osdTimeout 1200
    save_setting clockFontBold false
    save_setting osdFontBold false
    read_settings | /usr/bin/jq -e '.clockFontFamily == "Noto Sans" and .clockFontSize == 24 and .osdFontSize == 20 and .osdSliderHeight == 10 and (.clockFontBold | not)' >/dev/null
    local before invalid
    before="$(/usr/bin/sha256sum "$settings_file")"
    dry_run=1
    save_setting osdFontFamily 'Noto Sans' >/dev/null
    save_setting uiFontFamily 'DejaVu Sans' >/dev/null
    save_setting clockInheritUiFont true >/dev/null
    save_setting osdInheritUiFont true >/dev/null
    save_setting scrollProgressAlwaysVisible false >/dev/null
    [[ "$before" == "$(/usr/bin/sha256sum "$settings_file")" ]]
    dry_run=0
    for invalid in 'clockFontSize 7' 'clockFontSize 41' 'clockFontSize 18.5' 'osdFontSize nope' 'osdSliderWidth 59' 'osdSliderWidth 501' 'osdSliderHeight 1' 'osdSliderHeight 25' 'osdSliderRadius 13' 'osdTimeout 499' 'osdTimeout 10001' 'osdAnimationDuration -1' 'osdSliderAnimationDuration 1001' 'osdShowPercentage yes'; do
        if (save_setting "${invalid%% *}" "${invalid#* }") >/dev/null 2>&1; then fail "Accepted: $invalid"; fi
    done
    if (save_setting osdFontFamily '') >/dev/null 2>&1; then fail 'Accepted empty font.'; fi
    if (save_setting osdFontFamily $'bad\nfont') >/dev/null 2>&1; then fail 'Accepted multiline font.'; fi
    if (save_setting uiFontFamily '') >/dev/null 2>&1; then fail 'Accepted empty UI font.'; fi
    if (save_setting uiFontFamily $'bad\nfont') >/dev/null 2>&1; then fail 'Accepted multiline UI font.'; fi
    for invalid in 'clockInheritUiFont yes' 'osdInheritUiFont 1'; do
        if (save_setting "${invalid%% *}" "${invalid#* }") >/dev/null 2>&1; then fail "Accepted: $invalid"; fi
    done
    for invalid in 'scrollProgressAlwaysVisible yes' 'scrollProgressShowOnNonScrollable 1' 'scrollProgressVisibleDuration 99' 'scrollProgressVisibleDuration 10001' 'scrollProgressVisibleDuration 100.5' 'scrollProgressAnimationDuration -1' 'scrollProgressAnimationDuration 1001' 'scrollAnimationDuration -1' 'scrollAnimationDuration 1001' 'scrollWheelStep 15' 'scrollWheelStep 201'; do
        if (save_setting "${invalid%% *}" "${invalid#* }") >/dev/null 2>&1; then fail "Accepted: $invalid"; fi
    done
}


check_publishers() {
    local publisher="$test_dir/../../scripts/publish-brightness-osd.sh"
    local osd_adapter="$test_dir/../osd/swayosd-client"
    cat > "$test_root/hyprctl" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
printf '[{"name":"DP-1"},{"name":"HDMI-A-1"},{"name":"eDP-1"}]\n'
MOCK
    cat > "$test_root/brightnessctl" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1" == -m ]]; then printf 'laptop,backlight,45,45%%,100\n'; fi
MOCK
    /usr/bin/chmod +x "$test_root/hyprctl" "$test_root/brightnessctl"
    export ISLAND_HYPRCTL_BIN="$test_root/hyprctl" ISLAND_BRIGHTNESSCTL_BIN="$test_root/brightnessctl"
    local cache_home="$test_root/publisher-cache"
    XDG_CACHE_HOME="$cache_home" /usr/bin/bash "$publisher" 45 DP-1 --dry-run >/dev/null
    [[ ! -e "$cache_home" ]] || fail 'Publisher dry-run wrote state.'
    if XDG_CACHE_HOME="$cache_home" /usr/bin/bash "$publisher" 101 DP-1 >/dev/null 2>&1; then fail 'Accepted invalid OSD percentage.'; fi
    if XDG_CACHE_HOME="$cache_home" /usr/bin/bash "$publisher" 50 '../bad' >/dev/null 2>&1; then fail 'Accepted invalid OSD monitor.'; fi
    XDG_CACHE_HOME="$cache_home" ISLAND_BRIGHTNESS_CONNECTOR_TYPE=DP /usr/bin/bash "$osd_adapter" --monitor HDMI-A-1 --custom-progress 0.45
    [[ $(<"$cache_home/island/status/event") == 'brightness|45|DP-1|'* ]] || fail 'DP shortcut followed the shared helper hardcoded monitor.'
    XDG_CACHE_HOME="$cache_home" /usr/bin/bash "$osd_adapter" --monitor HDMI-A-1 --custom-progress 0.7
    [[ $(<"$cache_home/island/status/event") == 'brightness|70|HDMI-A-1|'* ]] || fail 'HDMI shortcut lost its monitor.'
    XDG_CACHE_HOME="$cache_home" /usr/bin/bash "$test_dir/../../scripts/brightness.sh" +5%
    [[ $(<"$cache_home/island/status/event") == 'brightness|45|eDP-1|'* ]] || fail 'Backlight shortcut lost its monitor.'
}

