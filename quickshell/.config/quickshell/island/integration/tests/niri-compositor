#!/usr/bin/env bash
set -euo pipefail

# Runs Island's niri support against a mock `niri`: the event stream, outputs, workspace/monitor lookups, the
# recorder records, and the floating spawn. Needs no running niri.
test_dir="$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export QML_IMPORT_PATH="$test_dir/../../../.runtime/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
test_root="$(/usr/bin/mktemp -d /tmp/island-niri-compositor.XXXXXX)"
trap '/usr/bin/rm -rf -- "$test_root"' EXIT

fail() { printf '%s\n' "$*" >&2; exit 1; }

node "$test_dir/niri-model.js"

cat > "$test_root/niri" <<'MOCK'
#!/usr/bin/env bash
# msg --json event-stream|outputs, msg action ARGS...
[[ "$1" == msg ]] || exit 2
shift
if [[ "$1" == action ]]; then
    shift
    printf '%s\n' "$*" >> "$NIRI_TEST_LOG"
    exit 0
fi
[[ "$1" == --json ]] || exit 2
case "$2" in
outputs)
    printf '%s\n' '{"HDMI-A-1":{"name":"HDMI-A-1","make":"A","model":"B","serial":null,"modes":[{"width":1920,"height":1080,"refresh_rate":74973,"is_preferred":true}],"current_mode":0,"logical":{"x":0,"y":0,"width":1536,"height":864,"scale":1.25,"transform":"Normal"}},"DP-1":{"name":"DP-1","make":"C","model":"D","serial":null,"modes":[{"width":2560,"height":1440,"refresh_rate":144000,"is_preferred":true}],"current_mode":0,"logical":{"x":1536,"y":0,"width":2560,"height":1440,"scale":1.0,"transform":"Normal"}}}'
    ;;
event-stream)
    layout='{"pos_in_scrolling_layout":[1,1],"tile_size":[700,500],"window_size":[696,496],"tile_pos_in_workspace_view":[16.0,16.0],"window_offset_in_tile":[2.0,2.0]}'
    window() { printf '{"id":%s,"title":"t","app_id":%s,"pid":%s,"workspace_id":%s,"is_focused":false,"is_floating":false,"is_urgent":false,"layout":%s}' "$1" "$2" "$1" "$3" "$layout"; }
    printf '%s\n' '{"ConfigLoaded":{"failed":false}}'
    printf '%s\n' '{"WorkspacesChanged":{"workspaces":[{"id":10,"idx":1,"name":null,"output":"HDMI-A-1","is_urgent":false,"is_active":true,"is_focused":true,"active_window_id":7},{"id":11,"idx":2,"name":"web","output":"HDMI-A-1","is_urgent":false,"is_active":false,"is_focused":false,"active_window_id":null},{"id":20,"idx":1,"name":null,"output":"DP-1","is_urgent":false,"is_active":true,"is_focused":false,"active_window_id":null}]}}'
    printf '{"WindowsChanged":{"windows":[%s,%s]}}\n' "$(window 7 '"foot"' 10)" "$(window 8 '"foot"' 11)"
    printf '%s\n' '{"KeyboardLayoutsChanged":{"keyboard_layouts":{"names":["English (US)","Persian"],"current_idx":0}}}'
    sleep 1
    printf '%s\n' '{"WorkspaceActivated":{"id":20,"focused":true}}' '{"KeyboardLayoutSwitched":{"idx":1}}'
    # Wait for the spawn under test, then open its window: first without an app id, then with it.
    while [[ ! -e "$NIRI_TEST_TRIGGER" ]]; do sleep 0.05; done
    printf '{"WindowOpenedOrChanged":{"window":%s}}\n' "$(window 98 null 20)"
    sleep 0.2
    printf '{"WindowOpenedOrChanged":{"window":%s}}\n' "$(window 99 '"omafiles"' 20)"
    sleep 0.2
    printf '{"WindowOpenedOrChanged":{"window":%s}}\n' "$(window 99 '"omafiles"' 20)"
    sleep 30
    ;;
*) exit 2 ;;
esac
MOCK
chmod +x "$test_root/niri"

cat > "$test_root/controller" <<'CONTROLLER'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
    ui) printf '%s\n' '{"theme":{"source":"static","mode":"dark","variant":"tonalspot"},"label":"fixture","settings":{},"wallpaper":"","colors":{"background":"#101010","backgroundGray":"#242424","foreground":"#eeeeee","foregroundInactive":"#8a8a8a","muted":"#606060","primary":"#ffab91","border":"#ffab91","danger":"#ee5555","warning":"#eebb55","success":"#66bb66"}}' ;;
    themes) printf '[]\n' ;;
    *) exit 2 ;;
esac
CONTROLLER
chmod +x "$test_root/controller"

mkdir -p "$test_root/runtime" "$test_root/state" "$test_root/cache"
chmod 700 "$test_root/runtime"
sed "s|\"../../|\"file:$test_dir/../../|g" "$test_dir/niri-compositor-views.qml" > "$test_root/views.qml"
export NIRI_TEST_LOG="$test_root/actions.log" NIRI_TEST_TRIGGER="$test_root/spawned"
: > "$NIRI_TEST_LOG"
if ! QT_QPA_PLATFORM=offscreen WAYLAND_DISPLAY= HYPRLAND_INSTANCE_SIGNATURE= NIRI_SOCKET= XDG_CURRENT_DESKTOP=niri \
    ISLAND_COMPOSITOR= ISLAND_NIRI_BIN="$test_root/niri" \
    XDG_RUNTIME_DIR="$test_root/runtime" XDG_CACHE_HOME="$test_root/cache" ISLAND_STATE_DIR="$test_root/state" \
    ISLAND_THEME_SCRIPT="$test_root/controller" \
    /usr/bin/dbus-run-session -- /usr/bin/timeout 20s /usr/bin/quickshell -p "$test_root/views.qml" > "$test_root/views.log" 2>&1; then
    /usr/bin/cat "$test_root/views.log" >&2
    fail 'Could not run niri-compositor-views.qml.'
fi
if ! /usr/bin/grep -q 'PASS: niri compositor service' "$test_root/views.log" || /usr/bin/grep -Eq 'FAIL:|ReferenceError|TypeError' "$test_root/views.log"; then
    /usr/bin/cat "$test_root/views.log" >&2
    fail 'niri-compositor-views.qml failed.'
fi

# Only the new omafiles window was floated, once, with the requested size.
expected=$'move-window-to-floating --id 99\nset-window-width --id 99 1200\nset-window-height --id 99 800\ncenter-window --id 99'
actual="$(/usr/bin/cat "$NIRI_TEST_LOG")"
[[ "$actual" == "$expected" ]] || fail "Unexpected niri actions:
$actual"

printf 'PASS: niri detection, event stream, workspace and monitor lookups, recorder records, keyboard layout and floating spawn\n'
