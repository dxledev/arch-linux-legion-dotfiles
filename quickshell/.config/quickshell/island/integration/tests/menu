#!/usr/bin/env bash
set -euo pipefail

test_dir="$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")" && pwd)"
test_root="$(/usr/bin/mktemp -d /tmp/island-menu.XXXXXX)"
cleanup() {
    local status="$?"
    if (( status )); then
        printf 'Menu test failed; fixture retained at %s\n' "$test_root" >&2
        [[ ! -f "$test_root/views.log" ]] || /usr/bin/tail -80 "$test_root/views.log" >&2
    fi
}
trap cleanup EXIT
config_home="$test_root/config"
settings_file="$test_root/state/settings.json"
dry_run=0
fail() { printf '%s\n' "$*" >&2; exit 1; }
source "$test_dir/../theme-functions"

/usr/bin/node "$test_dir/menu-entries.js"
"$test_dir/menu-pins"
/usr/bin/mkdir -p "$test_root/runtime" "$test_root/cache"
/usr/bin/chmod 700 "$test_root/runtime"
/usr/bin/sed "s|\"../../|\"file://$test_dir/../../|g" "$test_dir/menu-views.qml" > "$test_root/views.qml"
cat > "$test_root/controller" <<'CONTROLLER'
#!/usr/bin/env bash
set -euo pipefail
config_home="$TEST_ROOT/config"
settings_file="$TEST_ROOT/state/settings.json"
dry_run=0
fail() { printf '%s\n' "$*" >&2; exit 1; }
source "$TEST_DIR/../theme-functions"
case "${1:-}" in
    ui) /usr/bin/jq -cn --argjson settings "$(read_settings)" '{theme:{source:"static",mode:"dark",variant:"tonalspot"},label:"test",settings:$settings,wallpaper:"",colors:{background:"#101010",backgroundAlt:"#181818",foreground:"#eeeeee",foregroundInactive:"#aaaaaa",muted:"#777777",primary:"#ffab91",danger:"#ee5555",warning:"#eebb55",success:"#66bb66"}}' ;;
    themes) printf '[]\n' ;;
    setting) save_setting "$2" "$3" ;;
    wallpaper-directory) exit 0 ;;
    *) exit 2 ;;
esac
CONTROLLER
/usr/bin/chmod +x "$test_root/controller"

if ! QT_QPA_PLATFORM=offscreen WAYLAND_DISPLAY= HYPRLAND_INSTANCE_SIGNATURE= \
    QML_IMPORT_PATH="$test_dir/../../../.runtime/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
    TEST_ROOT="$test_root" TEST_DIR="$test_dir" XDG_RUNTIME_DIR="$test_root/runtime" XDG_CACHE_HOME="$test_root/cache" \
    ISLAND_STATE_DIR="$test_root/state" ISLAND_THEME_SCRIPT="$test_root/controller" \
    /usr/bin/dbus-run-session -- /usr/bin/timeout 40s /usr/bin/quickshell -p "$test_root/views.qml" > "$test_root/views.log" 2>&1; then
    fail 'Could not run menu views.'
fi
if ! /usr/bin/rg -q 'PASS: menu layout' "$test_root/views.log" \
    || /usr/bin/rg -q 'FAIL:|ERROR|ReferenceError|TypeError|Binding loop' "$test_root/views.log"; then
    fail 'Menu views failed.'
fi
/usr/bin/jq -e '.menuPinnedEntries == ["shell-mode","control-center","themes","settings"]' "$settings_file" >/dev/null
printf 'PASS: menu registry, persistence, rendered navigation, real pointer/key input, pin limits and routes\n'
