#!/usr/bin/env bash
# Dynamic palette settings with Browse Wallpapers palettes: listing, filtering, labels and commands.
set -euo pipefail
test_dir="$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")" && pwd)"
test_root="$(/usr/bin/mktemp -d /tmp/island-dynamic-palette.XXXXXX)"
trap '/usr/bin/rm -rf -- "$test_root"' EXIT
fail() { printf '%s\n' "$*" >&2; [[ ! -f "$test_root/views.log" ]] || /usr/bin/tail -40 "$test_root/views.log" >&2; [[ ! -f "$test_root/commands.log" ]] || /usr/bin/cat "$test_root/commands.log" >&2; exit 1; }
/usr/bin/mkdir -p "$test_root/runtime" "$test_root/cache" "$test_root/state"
/usr/bin/chmod 700 "$test_root/runtime"
/usr/bin/sed "s|\"../../|\"file://$test_dir/../../|g" "$test_dir/dynamic-palette-views.qml" > "$test_root/views.qml"
cat > "$test_root/controller" <<'CONTROLLER'
#!/usr/bin/env bash
set -euo pipefail
config_home="$TEST_ROOT/config"
settings_file="$TEST_ROOT/state/settings.json"
dry_run=0
fail() { printf '%s\n' "$*" >&2; exit 1; }
source "$TEST_DIR/../theme-functions"
case "${1:-}" in
    ui) /usr/bin/jq -cn --argjson settings "$(read_settings)" '{theme:{source:"dynamic",mode:"dark",variant:"tonalspot",provider:"aether"},label:"dynamic",settings:$settings,wallpaper:"",colors:{background:"#101010",backgroundAlt:"#181818",foreground:"#eeeeee",foregroundInactive:"#aaaaaa",muted:"#777777",primary:"#ffab91",danger:"#ee5555",warning:"#eebb55",success:"#66bb66"}}' ;;
    themes) printf '[]\n' ;;
    aether-list) printf '%s\n' '[{"style":"wh-pastel","mode":"dark","active":true},{"style":"wh-pastel","mode":"light","active":false},{"style":"other-style","mode":"dark","active":false}]' ;;
    aether-select|variant|mode|full) printf '%s\n' "$*" >> "$TEST_ROOT/commands.log" ;;
    setting) save_setting "$2" "$3" ;;
    wallpaper-directory) exit 0 ;;
    *) exit 2 ;;
esac
CONTROLLER
/usr/bin/chmod +x "$test_root/controller"
if ! QT_QPA_PLATFORM=offscreen WAYLAND_DISPLAY= HYPRLAND_INSTANCE_SIGNATURE= \
    QML_IMPORT_PATH="$test_dir/../../../.runtime/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
    TEST_ROOT="$test_root" TEST_DIR="$test_dir" XDG_RUNTIME_DIR="$test_root/runtime" XDG_CACHE_HOME="$test_root/cache" \
    ISLAND_STATE_DIR="$test_root/state" ISLAND_THEME_SCRIPT="$test_root/controller" SHELL_NOTIFICATION_HISTORY="$test_root/notification-history.jsonl" \
    /usr/bin/dbus-run-session -- /usr/bin/timeout 40s /usr/bin/quickshell -p "$test_root/views.qml" > "$test_root/views.log" 2>&1; then
    fail 'Could not run the Dynamic palette view.'
fi
if ! /usr/bin/rg -q 'PASS: dynamic palette view' "$test_root/views.log" || /usr/bin/rg -q 'FAIL:|ReferenceError|TypeError|Binding loop' "$test_root/views.log"; then
    fail 'Dynamic palette view test failed.'
fi
expected=$'aether-select wh-pastel light\nvariant vibrant\naether-select wh-pastel dark\nfull on'
[[ "$(< "$test_root/commands.log")" == "$expected" ]] || fail 'Unexpected controller commands.'
printf 'PASS: dynamic palette lists only Wallhaven palettes and routes mode, palette and Full changes\n'
