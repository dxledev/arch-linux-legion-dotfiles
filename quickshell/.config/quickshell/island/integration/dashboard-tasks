#!/usr/bin/env bash
# Edits the Dashboard's task list (~/.config/dashboard/tasks.json) the way `dashboard add/remove`
# does: re-read the live file, change it with jq, write a temp file in the same directory and
# move it over the original. A file that is not a JSON array is never written.
set -euo pipefail

usage() {
    printf 'Usage: dashboard-tasks add <task> <daily|weekly|date> <value>\n'
    printf '       dashboard-tasks remove <task> <created_at>\n'
    printf 'ISLAND_DASHBOARD_TASKS_FILE overrides ~/.config/dashboard/tasks.json.\n'
}

case "${1:-}" in
    --help) usage; exit 0 ;;
esac

tasks_file="${ISLAND_DASHBOARD_TASKS_FILE:-$HOME/.config/dashboard/tasks.json}"
command -v jq >/dev/null || { printf 'jq is required\n' >&2; exit 4; }

action="${1:-}"
case "$action" in
    add) [[ $# -eq 4 ]] || { usage >&2; exit 2; } ;;
    remove) [[ $# -eq 3 ]] || { usage >&2; exit 2; } ;;
    *) usage >&2; exit 2 ;;
esac

dir="$(dirname -- "$tasks_file")"
mkdir -p "$dir"
[[ -e $tasks_file ]] || printf '[]\n' > "$tasks_file"
jq -e 'type == "array"' "$tasks_file" >/dev/null 2>&1 || { printf 'tasks file is not a JSON array; refusing to write\n' >&2; exit 3; }

tmp="$(mktemp "$dir/.tasks.json.tmp.XXXXXX")"
trap 'rm -f -- "$tmp"' EXIT

case "$action" in
    add)
        task="$(printf '%s' "$2" | tr '\n\r' '  ' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        type="$3"
        value="$4"
        [[ -n $task && ${#task} -le 500 ]] || { printf 'task text must be 1-500 characters\n' >&2; exit 2; }
        case "$type" in
            daily) value=daily ;;
            weekly)
                [[ $value =~ ^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)(,(Mon|Tue|Wed|Thu|Fri|Sat|Sun))*$ ]] \
                    || { printf 'weekly value must be comma separated Mon..Sun\n' >&2; exit 2; }
                ;;
            date)
                [[ $value =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && date -d "$value" >/dev/null 2>&1 \
                    || { printf 'date value must be yyyy-mm-dd\n' >&2; exit 2; }
                ;;
            *) printf 'unknown recurrence %s\n' "$type" >&2; exit 2 ;;
        esac
        jq --arg task "$task" --arg rtype "$type" --arg rval "$value" --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            '. + [{task: $task, recurrence_type: $rtype, recurrence_value: $rval, created_at: $created_at}] | sort_by(.created_at)' \
            "$tasks_file" > "$tmp"
        ;;
    remove)
        jq -e --arg task "$2" --arg created_at "$3" 'any(.[]; .task == $task and .created_at == $created_at)' "$tasks_file" >/dev/null \
            || { printf 'task not found\n' >&2; exit 5; }
        jq --arg task "$2" --arg created_at "$3" \
            'to_entries | (map(select(.value.task == $task and .value.created_at == $created_at)) | .[0].key) as $drop | map(select(.key != $drop)) | map(.value)' \
            "$tasks_file" > "$tmp"
        ;;
esac

chmod --reference="$tasks_file" -- "$tmp" 2>/dev/null || true
mv -- "$tmp" "$tasks_file"
trap - EXIT
